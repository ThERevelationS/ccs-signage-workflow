    {
      "path": "src/components/proofs/proofModel.js",
      "content": "// Pure per-product proof-workflow model. React-free so it is unit-testable\n// under Node. Mirrors COREBRIDGE_MAP §6: proofs are versioned, an approval is\n// tied to the exact proof version it was given for, and a newer version\n// invalidates stale approvals.\nimport { recalculateProductDueDateOnProofApproval } from \"../estimator/workOrderConversion\";\n\nconst num = (value, fallback = 0) => Number.isFinite(Number(value)) ? Number(value) : fallback;\nconst norm = (value) => String(value || \"\").trim().toLowerCase();\n\n// Legal proof_status successors. The value `draft` is reachable from every\n// state through `supersede` (a new file version always returns the proof to\n// draft), and `awaiting_approval` from `revision_requested`/`none`/`draft` via\n// `send_proof`.\nexport const PROOF_TRANSITIONS = {\n  none: [\"draft\", \"awaiting_approval\"],\n  draft: [\"sent\", \"awaiting_approval\"],\n  sent: [\"awaiting_approval\", \"approved\", \"revision_requested\", \"draft\"],\n  awaiting_approval: [\"approved\", \"revision_requested\", \"draft\"],\n  approved: [\"draft\", \"revision_requested\"],\n  revision_requested: [\"draft\", \"sent\", \"awaiting_approval\"],\n};\n\nexport const PROOF_ACTIONS = [\"send_proof\", \"approve\", \"request_revision\", \"supersede\"];\n\n// status_history fields that belong to the proof audit trail.\nexport const PROOF_HISTORY_FIELDS = [\n  \"proof_status\", \"proof_file_url\", \"proof_file_name\", \"proof_version\", \"proof_approved_version\",\n];\n\nexport const proofVersionOf = (product) => num(product?.proof_version, 0);\nexport const approvedVersionOf = (product) => num(product?.proof_approved_version, 0);\n\nconst hasProofFile = (product) =>\n  Boolean(String(product?.proof_file_url || \"\").trim()) || proofVersionOf(product) > 0;\n\nconst canReach = (status, target) => (PROOF_TRANSITIONS[status] || []).includes(target);\n\n// A proof can only be requested/sent for approval when a file exists and the\n// current status has an awaiting_approval transition.\nexport function canRequestApproval(product) {\n  const status = norm(product?.proof_status) || \"none\";\n  return canReach(status, \"awaiting_approval\") && hasProofFile(product);\n}\n\nexport function canApproveProof(product) {\n  const status = norm(product?.proof_status) || \"none\";\n  return canReach(status, \"approved\") && hasProofFile(product);\n}\n\nexport function canRequestRevision(product) {\n  const status = norm(product?.proof_status) || \"none\";\n  return canReach(status, \"revision_requested\");\n}\n\n// The approval applies to an exact file version. Stale = a file exists and its\n// version differs from the approved version while an approval was (or claims\n// to be) in force — i.e. a newer version needs a fresh approval.\nexport function isProofStale(product, fileVersion) {\n  const current = fileVersion !== undefined ? num(fileVersion, 0) : proofVersionOf(product);\n  const approved = approvedVersionOf(product);\n  if (!current || current === approved) return false;\n  return approved > 0 || norm(product?.proof_status) === \"approved\";\n}\n\n// Compact badge descriptor used by ProofPanel and queue rows.\nexport function proofBadge(product) {\n  const status = norm(product?.proof_status) || \"none\";\n  const version = proofVersionOf(product);\n  if (isProofStale(product)) {\n    return { key: \"stale\", label: `Stale — v${version} needs approval`, tone: \"blocked\" };\n  }\n  if (status === \"approved\") {\n    const approved = approvedVersionOf(product) || version;\n    return { key: \"approved\", label: approved ? `Approved v${approved}` : \"Approved\", tone: \"done\" };\n  }\n  if (status === \"awaiting_approval\" || status === \"sent\") {\n    return { key: \"awaiting\", label: `Awaiting v${version || 1}`, tone: \"wip\" };\n  }\n  if (status === \"revision_requested\") {\n    return { key: \"revision\", label: \"Revision requested\", tone: \"blocked\" };\n  }\n  if (status === \"draft\") {\n    return { key: \"draft\", label: `Draft v${version || 1}`, tone: \"muted\" };\n  }\n  return { key: \"none\", label: \"No proof\", tone: \"muted\" };\n}\n\n// Proof-related entries from the product's status_history audit trail,\n// oldest-first, in the same shape applyProductOperationalPatch writes.\nexport function proofHistory(product) {\n  const history = Array.isArray(product?.status_history) ? product.status_history : [];\n  return history\n    .filter((entry) => entry && PROOF_HISTORY_FIELDS.includes(entry.field))\n    .map((entry) => ({\n      at: String(entry.at || \"\"),\n      field: String(entry.field || \"\"),\n      from: entry.from ?? \"\",\n      to: entry.to ?? \"\",\n      by: String(entry.by || \"\"),\n    }));\n}\n\n// Build the operational patch for a proof action. The returned object uses the\n// camelCase input keys of buildProductOperationalPatch so it can be passed\n// straight to transitionProductAndBuilderStatus({ patch }).\nexport function nextProofPatch(product, action, { fileVersion, fileUrl, fileName, leadTimeDays, now } = {}) {\n  const status = norm(product?.proof_status) || \"none\";\n  const name = norm(action);\n\n  if (name === \"send_proof\") {\n    if (!canReach(status, \"awaiting_approval\")) {\n      throw new Error(`A proof cannot be sent for approval while its status is \"${status || \"none\"}\".`);\n    }\n    const url = fileUrl !== undefined ? String(fileUrl || \"\").trim() : String(product?.proof_file_url || \"\").trim();\n    if (!url && !hasProofFile(product)) {\n      throw new Error(\"Upload a proof file before sending it for approval.\");\n    }\n    const version = num(fileVersion, 0) || proofVersionOf(product) || 1;\n    const patch = {\n      proofStatus: \"awaiting_approval\",\n      // CoreBridge parity: the product visibly waits on the customer.\n      operationalStatus: \"awaiting_proof_approval\",\n      proofVersion: version,\n    };\n    if (url) patch.proofFileUrl = url;\n    const resolvedName = fileName !== undefined\n      ? String(fileName || \"\").trim()\n      : String(product?.proof_file_name || \"\").trim();\n    if (resolvedName) patch.proofFileName = resolvedName;\n    return patch;\n  }\n\n  if (name === \"approve\") {\n    if (!canApproveProof(product)) {\n      throw new Error(hasProofFile(product)\n        ? `A proof cannot be approved while its status is \"${status || \"none\"}\".`\n        : \"There is no proof file to approve.\");\n    }\n    const version = num(fileVersion, 0) || proofVersionOf(product);\n    return {\n      proofStatus: \"approved\",\n      operationalStatus: \"proof_approved\",\n      // Due-date recalc honors hard_due_date inside the helper.\n      productDueDate: recalculateProductDueDateOnProofApproval({\n        product: product || {},\n        leadTimeDays,\n        fromDate: now || new Date(),\n      }),\n      proofApprovedVersion: version,\n    };\n  }\n\n  if (name === \"request_revision\") {\n    if (!canReach(status, \"revision_requested\")) {\n      throw new Error(`A revision cannot be requested while the proof status is \"${status || \"none\"}\".`);\n    }\n    return {\n      proofStatus: \"revision_requested\",\n      proofApprovedVersion: 0, // a requested revision invalidates the approval\n    };\n  }\n\n  if (name === \"supersede\") {\n    const url = String(fileUrl || \"\").trim();\n    if (!url) {\n      throw new Error(\"A new proof file is required to supersede the current version.\");\n    }\n    return {\n      proofStatus: \"draft\",\n      proofFileUrl: url,\n      proofFileName: String(fileName || \"\").trim(),\n      proofVersion: num(fileVersion, 0) || proofVersionOf(product) + 1,\n      proofApprovedVersion: 0, // new version invalidates any prior approval\n      // A product that was approved/waiting returns to design for rework.\n      ...([\"proof_approved\", \"awaiting_proof_approval\"].includes(norm(product?.operational_status))\n        ? { operationalStatus: \"in_design\" }\n        : {}),\n    };\n  }\n\n  throw new Error(`Unknown proof action \"${String(action)}\".`);\n}",
      "startLine": 1,
      "endLine": 182,
      "totalLines": 182,
      "truncated": false
    },
    {
      "path": "src/components/proofs/ProofPanel.jsx",
      "content": "import React, { useRef, useState } from \"react\";\nimport { FileCheck2, ExternalLink, History, Loader2, Upload } from \"lucide-react\";\nimport { UploadFile } from \"@/integrations/Core\";\nimport { transitionProductAndBuilderStatus } from \"@/components/estimator/workOrderConversion\";\nimport { NotificationTriggers } from \"@/components/workflow/NotificationService\";\nimport { openExternalHttpUrl, safeExternalHttpUrl } from \"@/utils/safeExternalUrl\";\nimport {\n  canApproveProof,\n  canRequestApproval,\n  canRequestRevision,\n  proofBadge,\n  proofHistory,\n  proofVersionOf,\n  nextProofPatch,\n} from \"./proofModel\";\n\nconst TONE = {\n  wip: \"bg-amber-100 text-amber-800\",\n  done: \"bg-emerald-100 text-emerald-800\",\n  blocked: \"bg-rose-100 text-rose-800\",\n  muted: \"bg-gray-100 text-gray-600\",\n};\n\nconst FIELD_LABELS = {\n  proof_status: \"Proof status\",\n  proof_file_url: \"Proof file\",\n  proof_file_name: \"Proof file name\",\n  proof_version: \"Proof version\",\n  proof_approved_version: \"Approved version\",\n};\n\nconst inp = \"rounded border border-gray-300 bg-white px-1.5 py-1 text-xs\";\nconst lab = \"text-[10px] font-semibold uppercase tracking-wide text-gray-500\";\nconst btn = `${inp} font-semibold`;\n\n// Per-product proof panel: current proof file, approval/version badges and the\n// send/approve/revise/supersede actions. Used by the ProductQueue row editor\n// and reusable by any work-order product view.\nexport default function ProofPanel({ workOrderId, product, actor = \"\", disabled = false, onChanged }) {\n  const fileInputRef = useRef(null);\n  const [busy, setBusy] = useState(false);\n  const [error, setError] = useState(\"\");\n  const [leadTimeDays, setLeadTimeDays] = useState(0);\n  const [showHistory, setShowHistory] = useState(false);\n\n  const p = product || {};\n  const badge = proofBadge(p);\n  const fileUrl = safeExternalHttpUrl(p.proof_file_url);\n  const fileName = String(p.proof_file_name || \"\").trim() || (fileUrl ? \"View proof file\" : \"\");\n  const version = proofVersionOf(p);\n  const history = proofHistory(p);\n  const noId = !String(p.id || \"\").trim();\n  const locked = disabled || busy || noId;\n\n  const apply = async (action, extra = {}) => {\n    setBusy(true);\n    setError(\"\");\n    try {\n      const patch = nextProofPatch(p, action, { leadTimeDays, ...extra });\n      const res = await transitionProductAndBuilderStatus({\n        workOrderId,\n        product: p,\n        patch,\n        actor,\n        label: \"Proof workflow\",\n      });\n      // Unified alerts: proof lifecycle events ride the automation/notify\n      // pipeline — fire-and-forget, they never block the transition.\n      try {\n        const meta = { productId: p.id, productDescription: p.description, proofVersion: version, changedBy: actor };\n        if (action === \"send_proof\") void NotificationTriggers.proofSent(res?.workOrder, meta);\n        else if (action === \"approve\") void NotificationTriggers.proofApproved(res?.workOrder, meta);\n      } catch { /* notify is best-effort */ }\n      onChanged?.();\n    } catch (e) {\n      setError(e?.message || \"Proof update failed.\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  const handleUpload = async (e) => {\n    const file = e.target.files?.[0];\n    if (fileInputRef.current) fileInputRef.current.value = \"\";\n    if (!file) return;\n    setBusy(true);\n    setError(\"\");\n    try {\n      const result = await UploadFile({ file });\n      await apply(\"supersede\", {\n        fileUrl: result?.file_url || \"\",\n        fileName: file.name,\n        fileVersion: version + 1,\n      });\n    } catch (uploadError) {\n      setError(uploadError?.message || \"The proof file could not be uploaded.\");\n      setBusy(false);\n    }\n  };\n\n  return (\n    <div className=\"mt-2 rounded border border-sky-100 bg-white/80 p-2\">\n      <div className=\"flex flex-wrap items-center gap-2\">\n        <span className={lab}>Proof</span>\n        <span className={`inline-block rounded px-1.5 py-0.5 text-[11px] font-medium ${TONE[badge.tone]}`}>\n          {badge.label}\n        </span>\n        {version > 0 && (\n          <span className=\"text-[10px] text-gray-500\">\n            file v{version}{p.proof_approved_version ? ` / approved v${p.proof_approved_version}` : \"\"}\n          </span>\n        )}\n        {fileUrl ? (\n          <button\n            type=\"button\"\n            className=\"inline-flex items-center gap-0.5 text-[11px] text-sky-700 hover:underline\"\n            onClick={() => openExternalHttpUrl(fileUrl)}\n            title={fileName}\n          >\n            <FileCheck2 className=\"h-3 w-3\" />\n            {fileName}\n            <ExternalLink className=\"h-2.5 w-2.5\" />\n          </button>\n        ) : (\n          <span className=\"text-[11px] text-gray-400\">no proof file</span>\n        )}\n        {busy && <Loader2 className=\"h-3 w-3 animate-spin text-gray-400\" />}\n      </div>\n\n      <div className=\"mt-1.5 flex flex-wrap items-center gap-1.5\">\n        <button\n          type=\"button\"\n          className={`${btn} text-sky-700`}\n          disabled={locked || !canRequestApproval(p)}\n          title={noId ? \"Product has no id — reopen the Work Order to repair it\" : \"Send this proof version to the customer for approval\"}\n          onClick={() => apply(\"send_proof\")}\n        >\n          Send for Approval\n        </button>\n        <button\n          type=\"button\"\n          className={`${btn} text-emerald-700`}\n          disabled={locked || !canApproveProof(p)}\n          title={noId ? \"Product has no id — reopen the Work Order to repair it\" : \"Approve the current proof version\"}\n          onClick={() => apply(\"approve\")}\n        >\n          Approve\n        </button>\n        <button\n          type=\"button\"\n          className={`${btn} text-rose-700`}\n          disabled={locked || !canRequestRevision(p)}\n          title={noId ? \"Product has no id — reopen the Work Order to repair it\" : \"Request changes; invalidates any approval\"}\n          onClick={() => apply(\"request_revision\")}\n        >\n          Request Revision\n        </button>\n        <button\n          type=\"button\"\n          className={`${btn} text-gray-700`}\n          disabled={locked}\n          title={noId ? \"Product has no id — reopen the Work Order to repair it\" : \"Upload a new proof file version (supersedes the current one)\"}\n          onClick={() => fileInputRef.current?.click()}\n        >\n          <Upload className=\"mr-0.5 inline h-3 w-3\" />\n          Upload New Version\n        </button>\n        <input\n          ref={fileInputRef}\n          type=\"file\"\n          className=\"hidden\"\n          accept=\"image/*,.pdf\"\n          onChange={handleUpload}\n        />\n        <label className=\"flex items-center gap-1 text-[10px] text-gray-500\" title=\"Part lead time used to recalculate the product due date on approval\">\n          Lead days\n          <input\n            className={`${inp} w-12`}\n            type=\"number\"\n            min=\"0\"\n            disabled={disabled}\n            value={leadTimeDays}\n            onChange={(e) => setLeadTimeDays(Number(e.target.value) || 0)}\n          />\n        </label>\n        {history.length > 0 && (\n          <button\n            type=\"button\"\n            className=\"ml-auto inline-flex items-center gap-0.5 text-[11px] text-gray-500 hover:text-gray-700\"\n            onClick={() => setShowHistory((v) => !v)}\n          >\n            <History className=\"h-3 w-3\" />\n            {showHistory ? \"Hide history\" : `History (${history.length})`}\n          </button>\n        )}\n      </div>\n\n      {showHistory && history.length > 0 && (\n        <div className=\"mt-1.5 max-h-24 overflow-y-auto rounded border border-gray-100 bg-gray-50/60 p-1.5\">\n          {history.slice().reverse().map((entry, i) => (\n            <div key={`${entry.at}-${i}`} className=\"text-[10px] text-gray-500\">\n              {entry.at ? new Date(entry.at).toLocaleString() : \"—\"}\n              {\" · \"}{FIELD_LABELS[entry.field] || entry.field}\n              {entry.from !== \"\" || entry.to !== \"\" ? `: ${String(entry.from || \"—\")} → ${String(entry.to || \"—\")}` : \"\"}\n              {entry.by ? ` · ${entry.by}` : \"\"}\n            </div>\n          ))}\n        </div>\n      )}\n\n      {error && <div className=\"mt-1 text-xs text-rose-700\">{error}</div>}\n    </div>\n  );\n}",
      "startLine": 1,
      "endLine": 214,
      "totalLines": 214,
      "truncated": false
    },
    {
      "path": "base44/shared/pagedEntityRows.ts",
      "content": "// 2,000-row pages cut full-table pulls to ~4x fewer entity_list requests\n// than the old 500 default while keeping each response bounded (~8MB worst\n// case on blob-heavy rows). Callers can still pass a smaller pageSize.\nconst DEFAULT_PAGE_SIZE = 2000;\nconst DEFAULT_MAX_ROWS = 50000;\n\nfunction rowIdentity(row: any, index: number) {\n  const id = String(row?.id || '').trim();\n  return id || `__row_${index}`;\n}\n\nexport async function loadAllEntityRows({\n  entity,\n  query = null,\n  sort = 'created_date',\n  pageSize = DEFAULT_PAGE_SIZE,\n  maxRows = DEFAULT_MAX_ROWS,\n  fields = null,\n  label = 'Entity rows',\n}: {\n  entity: any;\n  query?: Record<string, unknown> | null;\n  sort?: string | null;\n  pageSize?: number;\n  maxRows?: number;\n  // Server-side projection (SDK 5th arg): an allowlist of fields to read.\n  // Omitting it keeps full-row reads — callers passing it must include every\n  // field their downstream code touches, including undeclared stored fields.\n  fields?: string[] | null;\n  label?: string;\n}) {\n  const hasFilter = !!query && typeof query === 'object';\n  const reader = hasFilter ? entity?.filter : entity?.list;\n  if (typeof reader !== 'function') {\n    throw new Error(`${label} could not initialize its paged read.`);\n  }\n\n  // Pages may be up to the platform's 5,000-row list ceiling; callers paging\n  // large tables should opt in explicitly so request count drops ~10x.\n  const safePageSize = Math.max(1, Math.min(5000, Number(pageSize) || DEFAULT_PAGE_SIZE));\n  const safeMaxRows = Math.max(safePageSize, Number(maxRows) || DEFAULT_MAX_ROWS);\n  const rows: any[] = [];\n  const seen = new Set<string>();\n  let skip = 0;\n\n  while (skip < safeMaxRows) {\n    const page = hasFilter\n      ? await entity.filter(query, sort || undefined, safePageSize, skip, fields || undefined)\n      : await entity.list(sort || undefined, safePageSize, skip, fields || undefined);\n\n    if (!Array.isArray(page)) {\n      throw new Error(`${label} could not be verified completely.`);\n    }\n\n    for (let index = 0; index < page.length; index += 1) {\n      const row = page[index];\n      const key = rowIdentity(row, skip + index);\n      if (seen.has(key)) continue;\n      seen.add(key);\n      rows.push(row);\n    }\n\n    if (page.length < safePageSize) return rows;\n    skip += safePageSize;\n  }\n\n  throw new Error(`${label} exceeds the ${safeMaxRows.toLocaleString()}-record verification safety limit.`);\n}",
      "startLine": 1,
      "endLine": 68,
      "totalLines": 68,
      "truncated": false
    }
  ]
}
