    {
      "path": "base44/entities/TaxGroup.jsonc",
      "content": "{\n  \"name\": \"TaxGroup\",\n  \"type\": \"object\",\n  \"description\": \"Sales tax group selectable on an estimate (e.g. 'Ohio - Hamilton County (7.8%)'). Picking a tax group sets the estimate's tax_percent, which the All-In-One pricing waterfall multiplies by the taxable base. Admin-managed on the Estimate Settings page.\",\n  \"properties\": {\n    \"group_name\": {\n      \"type\": \"string\"\n    },\n    \"tax_percent\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"is_default\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"is_active\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"sort_order\": {\n      \"type\": \"number\",\n      \"default\": 0\n    }\n  },\n  \"required\": [\n    \"group_name\"\n  ],\n  \"rls\": {\n    \"create\": { \"user_condition\": { \"role\": \"__taxgroup_backend_only__\" } },\n    \"read\": { \"user_condition\": { \"role\": \"__taxgroup_backend_only__\" } },\n    \"update\": { \"user_condition\": { \"role\": \"__taxgroup_backend_only__\" } },\n    \"delete\": { \"user_condition\": { \"role\": \"__taxgroup_backend_only__\" } }\n  }\n}",
