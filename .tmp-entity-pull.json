    {
      "path": "base44/entities/BuilderPart.jsonc",
      "content": "{\n  \"name\": \"BuilderPart\",\n  \"type\": \"object\",\n  \"description\": \"A frozen-price part inside a Builder Product. Stores the live inventory link plus a complete inventory snapshot and builder/calculation snapshot from the moment the cost became active. Missing/detached inventory never destroys the frozen cost; reattachment is explicit.\",\n  \"properties\": {\n    \"builder_product_id\": {\n      \"type\": \"string\"\n    },\n    \"part_group_id\": {\n      \"type\": \"string\"\n    },\n    \"part_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable key within the product for ordering/copying/reconciliation.\"\n    },\n    \"sort_order\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"part_name\": {\n      \"type\": \"string\"\n    },\n    \"client_label\": {\n      \"type\": \"string\",\n      \"description\": \"Optional customer-facing part label.\"\n    },\n    \"part_type\": {\n      \"type\": \"string\",\n      \"description\": \"Open string by design so additional legacy/master-inventory part types can be added without a schema migration.\"\n    },\n    \"part_subtype\": {\n      \"type\": \"string\"\n    },\n    \"source_module_key\": {\n      \"type\": \"string\"\n    },\n    \"source_template_id\": {\n      \"type\": \"string\",\n      \"description\": \"PartTemplate record this independent copy was instantiated from. Blank for Builder-produced, manual, and clipboard Parts.\"\n    },\n    \"source_template_name\": {\n      \"type\": \"string\"\n    },\n    \"source_template_version\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"template_version of the source PartTemplate snapshot; 0 when the Part did not come from the Part Library.\"\n    },\n    \"source_path\": {\n      \"type\": \"string\",\n      \"description\": \"Path inside the detailed builder snapshot that produced this part, e.g. items[0].materials[2].\"\n    },\n    \"builder_sync_state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"linked\",\n        \"detached_override\",\n        \"manual\",\n        \"manual_addon\"\n      ],\n      \"default\": \"linked\",\n      \"description\": \"Whether this Part continues to synchronize from its Builder. detached_override freezes a Builder-produced Part until reattachment; manual is a Custom Product Part; manual_addon is an independent Part intentionally added to a Builder Product and remains outside Builder reconciliation.\"\n    },\n    \"builder_detached_at\": {\n      \"type\": \"string\"\n    },\n    \"builder_detached_reason\": {\n      \"type\": \"string\"\n    },\n    \"builder_detached_by\": {\n      \"type\": \"string\",\n      \"description\": \"Display name or email of the user who detached this Part from its Builder. Cleared on reattach.\"\n    },\n    \"builder_detached_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Builder-produced Part state captured when an override was detached, used for audit and reattachment review.\",\n      \"additionalProperties\": true\n    },\n    \"inventory_entity\": {\n      \"type\": \"string\",\n      \"description\": \"Master Inventory entity currently linked to this part.\"\n    },\n    \"inventory_item_id\": {\n      \"type\": \"string\",\n      \"description\": \"Current linked inventory record id. May be blank while detached.\"\n    },\n    \"original_inventory_item_id\": {\n      \"type\": \"string\",\n      \"description\": \"Inventory id used when the frozen snapshot was created; never overwritten during reattachment.\"\n    },\n    \"inventory_item_name\": {\n      \"type\": \"string\"\n    },\n    \"inventory_link_state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"attached\",\n        \"detached\",\n        \"reattach_available\",\n        \"manual\"\n      ],\n      \"default\": \"manual\"\n    },\n    \"reattach_candidate_id\": {\n      \"type\": \"string\"\n    },\n    \"reattach_candidate_name\": {\n      \"type\": \"string\"\n    },\n    \"frozen_inventory_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Complete inventory row as it existed when this part's cost was frozen.\",\n      \"additionalProperties\": true\n    },\n    \"current_inventory_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Last current inventory row seen during price/detach checking. Does not alter frozen pricing by itself.\",\n      \"additionalProperties\": true\n    },\n    \"detail_overrides\": {\n      \"type\": \"object\",\n      \"description\": \"Estimate-specific type/detail overrides layered over frozen_inventory_snapshot for this Part only. Never mutates the Master Inventory snapshot and is cleared when a detached Builder Part is reattached.\",\n      \"additionalProperties\": true\n    },\n    \"builder_data\": {\n      \"type\": \"object\",\n      \"description\": \"Complete module-specific part/builder inputs.\",\n      \"additionalProperties\": true\n    },\n    \"calculation_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Complete module-specific calculated outputs/breakdown for this part.\",\n      \"additionalProperties\": true\n    },\n    \"pricing_basis_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Pricing mode, rate fields, dimensions, units, and other data necessary to explain/reproduce the frozen cost.\",\n      \"additionalProperties\": true\n    },\n    \"quantity\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"unit\": {\n      \"type\": \"string\"\n    },\n    \"frozen_unit_cost\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"frozen_extended_cost\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"current_unit_cost\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"current_extended_cost\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"price_state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unchecked\",\n        \"current\",\n        \"changed\",\n        \"detached\",\n        \"manual\",\n        \"legacy_frozen\"\n      ],\n      \"default\": \"unchecked\"\n    },\n    \"price_delta\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"price_delta_percent\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"inventory_updated_date_snapshot\": {\n      \"type\": \"string\",\n      \"description\": \"Inventory updated_date at the moment the frozen price was accepted.\"\n    },\n    \"last_price_check_at\": {\n      \"type\": \"string\"\n    },\n    \"last_price_update_at\": {\n      \"type\": \"string\"\n    },\n    \"manual_cost_override\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"manual_cost\": {\n      \"type\": \"number\"\n    },\n    \"manual_cost_override_reason\": {\n      \"type\": \"string\",\n      \"description\": \"User-entered reason recorded when a manual/detached Part cost was overridden.\"\n    },\n    \"is_active\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"builder_product_id\",\n    \"part_name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__builderpart_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__builderpart_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__builderpart_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__builderpart_backend_only__\"\n      }\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 238,
      "totalLines": 238,
      "truncated": false
    },
    {
      "path": "base44/entities/PartTemplate.jsonc",
      "content": "{\n  \"name\": \"PartTemplate\",\n  \"type\": \"object\",\n  \"description\": \"Permanent reusable estimator Part Library. Stores either one complete BuilderPart snapshot or a Part Group plus all child BuilderPart snapshots. Templates are distinct from Master Inventory: inventory remains the central raw resource/cost library, while PartTemplate preserves reusable estimate/component configuration and frozen pricing context. Instantiating a template always creates new independent Product Parts so future Builder recalculation cannot overwrite the saved component.\",\n  \"properties\": {\n    \"template_name\": {\n      \"type\": \"string\"\n    },\n    \"idempotency_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable creation receipt used to converge retries of the same Saved Part / Part Group save without creating duplicates.\"\n    },\n    \"template_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"template_family_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable lineage key shared by every saved revision of the same source Part/Part Group name. Each new save appends the next template_version; prior versions remain immutable snapshots.\"\n    },\n    \"template_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"part\",\n        \"part_group\"\n      ],\n      \"default\": \"part\"\n    },\n    \"product_group\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"my\",\n        \"global\"\n      ],\n      \"default\": \"my\",\n      \"description\": \"'my' = creator-owned reusable Part; 'global' = shared company reusable Part.\"\n    },\n    \"category\": {\n      \"type\": \"string\"\n    },\n    \"tags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"source_module_key\": {\n      \"type\": \"string\"\n    },\n    \"source_part_type\": {\n      \"type\": \"string\"\n    },\n    \"source_part_subtype\": {\n      \"type\": \"string\"\n    },\n    \"created_from_estimate_id\": {\n      \"type\": \"string\"\n    },\n    \"created_from_product_id\": {\n      \"type\": \"string\"\n    },\n    \"created_from_part_group_id\": {\n      \"type\": \"string\"\n    },\n    \"created_from_part_id\": {\n      \"type\": \"string\"\n    },\n    \"part_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Lossless BuilderPart snapshot for a single-Part template, including inventory links, frozen/current inventory snapshots, detail overrides, calculation/pricing snapshots and frozen pricing.\",\n      \"additionalProperties\": true\n    },\n    \"group_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Lossless BuilderPartGroup snapshot when template_type is part_group.\",\n      \"additionalProperties\": true\n    },\n    \"parts_snapshot\": {\n      \"type\": \"array\",\n      \"description\": \"Lossless ordered BuilderPart snapshots for a Part Group template.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": true\n      }\n    },\n    \"part_count\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"frozen_cost\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"current_cost\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"contains_detached_parts\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"description\": {\n      \"type\": \"string\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"search_text\": {\n      \"type\": \"string\"\n    },\n    \"is_active\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"income_account\": {\n      \"type\": \"string\",\n      \"description\": \"GL income account code this saved part's sales post to on accounting export (CoreBridge-style Manage Accounts mapping).\"\n    },\n    \"cogs_account\": {\n      \"type\": \"string\",\n      \"description\": \"GL cost-of-goods-sold account code this saved part's material cost posts to on accounting export.\"\n    }\n  },\n  \"required\": [\n    \"template_name\",\n    \"template_type\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__admin_settings_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"$or\": [\n        {\n          \"data.product_group\": \"global\"\n        },\n        {\n          \"created_by_id\": \"{{user.id}}\"\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        }\n      ]\n    },\n    \"update\": {\n      \"$or\": [\n        {\n          \"created_by_id\": \"{{user.id}}\"\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        }\n      ]\n    },\n    \"delete\": {\n      \"$or\": [\n        {\n          \"created_by_id\": \"{{user.id}}\"\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        }\n      ]\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 174,
      "totalLines": 174,
      "truncated": false
    },
    {
      "path": "base44/entities/Customer.jsonc",
      "content": "{\n  \"name\": \"Customer\",\n  \"type\": \"object\",\n  \"description\": \"Shared Client record for the whole app. Used by the estimator (Step 1 of the estimate workflow, Customers area) AND by the workflow side \\u2014 WorkOrders and Orders link to it via customer_id, so estimates, work orders and material orders all hang off the same client.\",\n  \"properties\": {\n    \"company_name\": {\n      \"type\": \"string\"\n    },\n    \"estimator_creation_key\": {\n      \"type\": \"string\",\n      \"description\": \"Internal receipt used only to converge simultaneous creation of the same new Customer from Estimate Step 1. Historical Customers are never assigned or merged by this field.\"\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Internal random receipt for retry-safe explicit New Customer creation. It is not derived from company name, so separate intentional Customer records remain possible.\"\n    },\n    \"company_phone\": {\n      \"type\": \"string\"\n    },\n    \"company_fax\": {\n      \"type\": \"string\"\n    },\n    \"website\": {\n      \"type\": \"string\"\n    },\n    \"additional_phone\": {\n      \"type\": \"string\"\n    },\n    \"additional_phone_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"\",\n        \"office\",\n        \"cell\",\n        \"fax\",\n        \"home\",\n        \"other\"\n      ],\n      \"default\": \"\"\n    },\n    \"last_contacted_at\": {\n      \"type\": \"string\",\n      \"description\": \"UTC timestamp of the most recent real customer contact (quote sent, portal message).\"\n    },\n    \"merged_into_customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Set when this Customer was merged into another canonical Customer \\u2014 linked records were relinked and this row is kept for audit.\"\n    },\n    \"customer_status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"prospect\",\n        \"active\",\n        \"inactive\"\n      ],\n      \"default\": \"prospect\",\n      \"description\": \"Account status shown in the customer header.\"\n    },\n    \"tags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Freeform customer labels (e.g. wholesale, repeat, VIP) \\u2014 filterable on the customer list.\"\n    },\n    \"contact_first_name\": {\n      \"type\": \"string\"\n    },\n    \"contact_last_name\": {\n      \"type\": \"string\"\n    },\n    \"contact_position\": {\n      \"type\": \"string\"\n    },\n    \"contact_email\": {\n      \"type\": \"string\"\n    },\n    \"contact_office_phone\": {\n      \"type\": \"string\"\n    },\n    \"contact_office_ext\": {\n      \"type\": \"string\"\n    },\n    \"contact_cell_phone\": {\n      \"type\": \"string\"\n    },\n    \"contact_additional_phone\": {\n      \"type\": \"string\"\n    },\n    \"contact_additional_phone_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"\",\n        \"office\",\n        \"cell\",\n        \"fax\",\n        \"home\",\n        \"other\"\n      ],\n      \"default\": \"\"\n    },\n    \"contact_status\": {\n      \"type\": \"string\"\n    },\n    \"job_authority\": {\n      \"type\": \"string\"\n    },\n    \"billing_contact_same\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"billing_contact_name\": {\n      \"type\": \"string\"\n    },\n    \"billing_contact_email\": {\n      \"type\": \"string\"\n    },\n    \"billing_contact_phone\": {\n      \"type\": \"string\"\n    },\n    \"additional_contacts\": {\n      \"type\": \"array\",\n      \"description\": \"Extra people at this customer, managed on the Contacts tab.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"first_name\": {\n            \"type\": \"string\"\n          },\n          \"last_name\": {\n            \"type\": \"string\"\n          },\n          \"position\": {\n            \"type\": \"string\"\n          },\n          \"email\": {\n            \"type\": \"string\"\n          },\n          \"office_phone\": {\n            \"type\": \"string\"\n          },\n          \"office_ext\": {\n            \"type\": \"string\"\n          },\n          \"cell_phone\": {\n            \"type\": \"string\"\n          },\n          \"contact_status\": {\n            \"type\": \"string\"\n          },\n          \"job_authority\": {\n            \"type\": \"string\"\n          },\n          \"is_active\": {\n            \"type\": \"boolean\",\n            \"default\": true\n          }\n        }\n      }\n    },\n    \"billing_address_1\": {\n      \"type\": \"string\"\n    },\n    \"billing_address_2\": {\n      \"type\": \"string\"\n    },\n    \"billing_city\": {\n      \"type\": \"string\"\n    },\n    \"billing_state\": {\n      \"type\": \"string\"\n    },\n    \"billing_postal_code\": {\n      \"type\": \"string\"\n    },\n    \"billing_postal_ext\": {\n      \"type\": \"string\"\n    },\n    \"billing_country\": {\n      \"type\": \"string\",\n      \"default\": \"United States\"\n    },\n    \"location_same_as_billing\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"location_address_1\": {\n      \"type\": \"string\"\n    },\n    \"location_address_2\": {\n      \"type\": \"string\"\n    },\n    \"location_city\": {\n      \"type\": \"string\"\n    },\n    \"location_state\": {\n      \"type\": \"string\"\n    },\n    \"location_postal_code\": {\n      \"type\": \"string\"\n    },\n    \"salesperson\": {\n      \"type\": \"string\",\n      \"description\": \"Screen name of the user assigned to this account.\"\n    },\n    \"location\": {\n      \"type\": \"string\",\n      \"description\": \"Sales center / location this customer belongs to.\"\n    },\n    \"default_tax_group\": {\n      \"type\": \"string\"\n    },\n    \"quote_valid_days\": {\n      \"type\": \"number\",\n      \"description\": \"Per-customer quote validity window in days (overrides the estimate default of 30 when set).\"\n    },\n    \"customer_origination\": {\n      \"type\": \"string\"\n    },\n    \"industry_type\": {\n      \"type\": \"string\"\n    },\n    \"master_account\": {\n      \"type\": \"string\"\n    },\n    \"terms\": {\n      \"type\": \"string\"\n    },\n    \"tax_exempt\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"tax_id_number\": {\n      \"type\": \"string\"\n    },\n    \"tax_exempt_expiration\": {\n      \"type\": \"string\",\n      \"description\": \"YYYY-MM-DD\"\n    },\n    \"tax_exempt_reason\": {\n      \"type\": \"string\"\n    },\n    \"require_purchase_order\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"shipping_account\": {\n      \"type\": \"string\"\n    },\n    \"credit_limit\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"credit_hold\": {\n      \"type\": \"boolean\",\n      \"description\": \"When true, new estimates warn that the customer is on credit hold \\u2014 a visible badge on the new-estimate and detail views.\"\n    },\n    \"in_store_credit\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Unapplied in-store credit balance owed to this customer (CoreBridge 'In-Store Credit'). Distinct from credit_limit, which caps open account charges.\"\n    },\n    \"pricing_tier\": {\n      \"type\": \"number\",\n      \"default\": 1,\n      \"description\": \"Overall markup pricing tier applied to this customer's estimates.\"\n    },\n    \"send_monthly_statements\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"is_active\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"auto_inactive_after_months\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Months without activity after which this customer auto-marks inactive (CoreBridge 'auto-inactive'). 0 disables the automation.\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"legacy_client_names\": {\n      \"type\": \"array\",\n      \"description\": \"Workflow client_name strings reconciled into this Customer record, used to match existing WorkOrders and Orders.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"company_name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__customer_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__customer_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__customer_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__customer_backend_only__\"\n      }\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 317,
      "totalLines": 317,
      "truncated": false
    },
    {
      "path": "base44/entities/CustomerContact.jsonc",
      "content": "{\n  \"name\": \"CustomerContact\",\n  \"type\": \"object\",\n  \"description\": \"Canonical person/contact record belonging to a shared Customer. Owns contact-level roles and authority. Opportunity, EstimatingRequest, and future flows link here by contact_id once resolved. Never merge contacts by name alone.\",\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable retry-safe receipt for one contact create.\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Owning canonical Customer id.\"\n    },\n    \"first_name\": {\n      \"type\": \"string\"\n    },\n    \"last_name\": {\n      \"type\": \"string\"\n    },\n    \"display_name\": {\n      \"type\": \"string\",\n      \"description\": \"Preferred display name; falls back to first+last when blank.\"\n    },\n    \"position\": {\n      \"type\": \"string\",\n      \"description\": \"Job title/role at the customer (e.g. Owner, Facilities Manager).\"\n    },\n    \"email\": {\n      \"type\": \"string\"\n    },\n    \"phone\": {\n      \"type\": \"string\"\n    },\n    \"phone_ext\": {\n      \"type\": \"string\"\n    },\n    \"mobile_phone\": {\n      \"type\": \"string\"\n    },\n    \"authority_role\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"decision_maker\",\n        \"influencer\",\n        \"accounts_payable\",\n        \"site_contact\",\n        \"tenant\",\n        \"owner_rep\",\n        \"property_manager\",\n        \"other\"\n      ],\n      \"default\": \"unknown\",\n      \"description\": \"Contact-level authority for approvals, invoicing and site access.\"\n    },\n    \"is_primary\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Primary point of contact for the account.\"\n    },\n    \"is_billing_contact\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"is_site_contact\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"preferred_contact_method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"phone\",\n        \"mobile\",\n        \"email\",\n        \"text\"\n      ],\n      \"default\": \"unknown\"\n    },\n    \"source_summary\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"description\": \"Provenance: which record/import promoted this contact (e.g. Customer embedded contact fields, WorkOrder representative, OpportunityIntake capture).\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"is_active\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    }\n  },\n  \"required\": [\n    \"customer_id\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__admin_settings_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__admin_settings_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"admin\"\n      }\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 131,
      "totalLines": 131,
      "truncated": false
    },
    {
      "path": "base44/entities/OpportunityActivity.jsonc",
      "content": "{\n  \"name\": \"OpportunityActivity\",\n  \"type\": \"object\",\n  \"description\": \"Append-only audit log for an Opportunity: stage transitions, field edits, links, estimating handoffs, and reconciliation advances \\u2014 written by opportunityWorkspaceAction via service role. Also carries typed CRM contact events (calls, e-mails, visits, consultations) created from the CRM Events queue: those rows use the CoreBridge-style event_type taxonomy values plus subject/due_at/assigned_to/outcome fields, are written through the staffEntityWrite gateway, and may omit opportunity_id.\",\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable retry-safe receipt for one activity entry.\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked Opportunity for audit rows. Optional for standalone CRM events (prospecting calls, customer follow-ups) that have no pursuit yet.\"\n    },\n    \"event_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"created\",\n        \"updated\",\n        \"stage_changed\",\n        \"linked_work_order\",\n        \"estimate_requested\",\n        \"estimate_attached\",\n        \"estimate_status_changed\",\n        \"estimator_assigned\",\n        \"reconciled\",\n        \"note\",\n        \"Call: Accounts Receivable\",\n        \"Call: Collections\",\n        \"Call: Estimate Follow Up\",\n        \"Call: Install Scheduling\",\n        \"Call: Post delivery follow up\",\n        \"Call: Proof\",\n        \"Call: Prospecting\",\n        \"Call: Sales Follow Up\",\n        \"Consultation\",\n        \"E-Mail: Estimate\",\n        \"E-Mail: Follow Up\",\n        \"E-Mail: Information Request\",\n        \"ReDo Work\",\n        \"Visit: Installation\",\n        \"Visit: Networking/Marketing\",\n        \"Visit: Sales Appointment\",\n        \"Visit: Sales Cold Call\",\n        \"Visit: Sales Relationship\",\n        \"Visit: Site Survey\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"actor\": {\n      \"type\": \"string\"\n    },\n    \"details\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true\n    },\n    \"subject\": {\n      \"type\": \"string\",\n      \"description\": \"CRM event subject line (CoreBridge 'Event Name'). Falls back to the event_type label in the queue when blank.\"\n    },\n    \"notes\": {\n      \"type\": \"string\",\n      \"description\": \"Free-form CRM event notes.\"\n    },\n    \"contact_name\": {\n      \"type\": \"string\",\n      \"description\": \"Display name of the person this CRM event touches.\"\n    },\n    \"contact_id\": {\n      \"type\": \"string\",\n      \"description\": \"Canonical CustomerContact id when resolved.\"\n    },\n    \"company_name\": {\n      \"type\": \"string\",\n      \"description\": \"Display company/customer name for queue rendering.\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Canonical Customer id when resolved \\u2014 deep-links the queue row to the customer record.\"\n    },\n    \"work_order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked WorkOrder when the CRM event concerns an active job.\"\n    },\n    \"assigned_to\": {\n      \"type\": \"string\",\n      \"description\": \"Staff user (email or screen name) responsible for this CRM event \\u2014 the queue's salesperson filter.\"\n    },\n    \"due_at\": {\n      \"type\": \"string\",\n      \"description\": \"ISO timestamp the CRM event is due; overdue rows sort first in the queue.\"\n    },\n    \"completed_at\": {\n      \"type\": \"string\",\n      \"description\": \"ISO timestamp the CRM event was marked complete. Blank while open.\"\n    },\n    \"outcome\": {\n      \"type\": \"string\",\n      \"description\": \"Close-out result for a completed CRM event (completed, cancelled, no_answer, left_message, rescheduled).\"\n    },\n    \"source\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"manual\",\n        \"auto_followup\",\n        \"system\"\n      ],\n      \"default\": \"manual\",\n      \"description\": \"How the CRM event was created \\u2014 manual queue entry, automated follow-up generation, or system.\"\n    }\n  },\n  \"required\": [\n    \"event_type\",\n    \"summary\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__opportunity_activity_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__opportunity_activity_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__opportunity_activity_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__opportunity_activity_backend_only__\"\n      }\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 143,
      "totalLines": 143,
      "truncated": false
    },
    {
      "path": "base44/entities/WorkOrder.jsonc",
      "content": "{\n  \"name\": \"WorkOrder\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"Work order title\"\n    },\n    \"client_name\": {\n      \"type\": \"string\",\n      \"description\": \"Client name\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked shared Customer (Client) record id.\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional transitional link to the canonical Opportunity. Blank on legacy/unmigrated WorkOrders.\"\n    },\n    \"estimating_request_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional link to the EstimatingRequest that produced or is associated with this WorkOrder. Blank is valid during compatibility migration.\"\n    },\n    \"estimate_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked AllInOneEstimate id, when this job was created from an estimate.\"\n    },\n    \"estimate_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Every AllInOneEstimate id merged into this job. Populated by combined multi-estimate conversion; the primary estimate also remains in estimate_id for backward-compatible single-link lookups.\"\n    },\n    \"materials\": {\n      \"type\": \"array\",\n      \"description\": \"Flattened materials manifest built at estimate conversion from the estimate's BuilderPart frozen-cost snapshots. Each row carries its full provenance (source_estimate_id, estimate_line_id, builder_product_id, module_key, section_name) so section-level pricing origin survives the merge onto the WorkOrder.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"builder_part_id\": {\n            \"type\": \"string\"\n          },\n          \"part_key\": {\n            \"type\": \"string\"\n          },\n          \"part_name\": {\n            \"type\": \"string\"\n          },\n          \"part_type\": {\n            \"type\": \"string\"\n          },\n          \"part_subtype\": {\n            \"type\": \"string\"\n          },\n          \"quantity\": {\n            \"type\": \"number\"\n          },\n          \"unit\": {\n            \"type\": \"string\"\n          },\n          \"unit_cost\": {\n            \"type\": \"number\"\n          },\n          \"extended_cost\": {\n            \"type\": \"number\"\n          },\n          \"inventory_item_id\": {\n            \"type\": \"string\"\n          },\n          \"inventory_item_name\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\",\n            \"description\": \"Origin marker \\u2014 'estimate_conversion' for rows seeded from a converted estimate.\"\n          },\n          \"source_estimate_id\": {\n            \"type\": \"string\"\n          },\n          \"source_estimate_number\": {\n            \"type\": \"string\"\n          },\n          \"estimate_line_id\": {\n            \"type\": \"string\"\n          },\n          \"builder_product_id\": {\n            \"type\": \"string\"\n          },\n          \"module_key\": {\n            \"type\": \"string\"\n          },\n          \"section_name\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": true\n      }\n    },\n    \"description\": {\n      \"type\": \"string\",\n      \"description\": \"Detailed description of the work\"\n    },\n    \"image_url\": {\n      \"type\": \"string\",\n      \"description\": \"URL of the work order image\"\n    },\n    \"attachment_refs\": {\n      \"type\": \"array\",\n      \"description\": \"References to files/photos carried over from the linked estimate (no binary copies).\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"files\": {\n      \"type\": \"array\",\n      \"description\": \"Uploaded files for this work order\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"type\": {\n            \"type\": \"string\"\n          },\n          \"size\": {\n            \"type\": \"number\"\n          },\n          \"uploaded_by\": {\n            \"type\": \"string\"\n          },\n          \"uploaded_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          }\n        }\n      }\n    },\n    \"google_drive_folder_url\": {\n      \"type\": \"string\",\n      \"description\": \"Google Drive folder URL for this work order\"\n    },\n    \"google_drive_file_ids\": {\n      \"type\": \"array\",\n      \"description\": \"Array of Google Drive file IDs\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"current_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"estimating\",\n        \"sales\",\n        \"permitting\",\n        \"design\",\n        \"production\",\n        \"fabrication\",\n        \"installation\",\n        \"completed\"\n      ],\n      \"default\": \"estimating\",\n      \"description\": \"Current workflow stage\"\n    },\n    \"priority\": {\n      \"type\": \"number\",\n      \"description\": \"Priority order\"\n    },\n    \"assigned_to\": {\n      \"type\": \"string\",\n      \"description\": \"Email of assigned user\"\n    },\n    \"notes\": {\n      \"type\": \"array\",\n      \"description\": \"Array of tasks with timestamps, completion status, and dependencies\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"created_by\": {\n            \"type\": \"string\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"assigned_to\": {\n            \"type\": \"string\"\n          },\n          \"estimated_hours\": {\n            \"type\": \"number\"\n          },\n          \"actual_hours\": {\n            \"type\": \"number\"\n          },\n          \"due_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"start_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"depends_on\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"is_milestone\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"is_critical_path\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"checklist_context\": {\n            \"type\": \"string\"\n          },\n          \"sub_tasks\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"text\": {\n                  \"type\": \"string\"\n                },\n                \"completed\": {\n                  \"type\": \"boolean\",\n                  \"default\": false\n                },\n                \"assigned_to\": {\n                  \"type\": \"string\"\n                },\n                \"details\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"text\": {\n                        \"type\": \"string\"\n                      },\n                      \"completed\": {\n                        \"type\": \"boolean\",\n                        \"default\": false\n                      },\n                      \"assigned_to\": {\n                        \"type\": \"string\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"milestones\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"due_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"completed_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"linked_task_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    },\n    \"project_health\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"on_track\",\n        \"at_risk\",\n        \"delayed\",\n        \"blocked\"\n      ],\n      \"default\": \"on_track\"\n    },\n    \"health_override\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"health_notes\": {\n      \"type\": \"string\"\n    },\n    \"work_notes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"number\"\n          },\n          \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"admin\",\n              \"fabrication\",\n              \"vinyl\",\n              \"permitting\",\n              \"design\",\n              \"installation\",\n              \"client\",\n              \"other\"\n            ]\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"sub_tasks\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": {\n                  \"type\": \"number\"\n                },\n                \"text\": {\n                  \"type\": \"string\"\n                },\n                \"completed\": {\n                  \"type\": \"boolean\",\n                  \"default\": false\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"follow_up\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"created_by\": {\n            \"type\": \"string\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          }\n        }\n      }\n    },\n    \"due_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"start_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"is_rider\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"parent_work_order_id\": {\n      \"type\": \"string\"\n    },\n    \"rider_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"estimating\",\n        \"sales\",\n        \"permitting\",\n        \"design\",\n        \"production\",\n        \"fabrication\",\n        \"installation\"\n      ]\n    },\n    \"completed\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"asap\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"dependencies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\"\n      }\n    },\n    \"in_pipeline\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"sales_import_source_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable external source row identity used by repeat Sales Pipeline spreadsheet imports.\"\n    },\n    \"sales_import_last_synced_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the last successful Sales Pipeline spreadsheet sync for this WorkOrder.\"\n    },\n    \"sales_import_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Last imported values for spreadsheet-owned Sales fields, used to detect stale spreadsheet overwrites.\"\n    },\n    \"smartsheet_sheet_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable Smartsheet sheet identity for the linked mirror record. Never derived from row or column position.\"\n    },\n    \"smartsheet_row_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable Smartsheet row identity for the linked mirror record. Used instead of visible row position, customer name, or sorting.\"\n    },\n    \"smartsheet_parent_row_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable parent-row identity from the Workflow Smartsheet hierarchy. Order Form uses this to suppress automatic child/rider rows without relying on row position or customer-name guessing.\"\n    },\n    \"smartsheet_last_synced_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the last fully verified Smartsheet synchronization for this WorkOrder.\"\n    },\n    \"smartsheet_sync_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Last successfully synchronized mapped values used for three-way Smartsheet/Base44 conflict detection.\"\n    },\n    \"smartsheet_create_attempt\": {\n      \"type\": \"object\",\n      \"description\": \"Sales-only durable Smartsheet row creation reservation. Stores a pre-POST mapped snapshot and, if confirmed, a permanent row ID for verified one-time recovery. Never auto-repeat an uncertain create or infer row identity from its values.\"\n    },\n    \"automation_deadline_fired\": {\n      \"type\": \"object\",\n      \"description\": \"Durable deadline-automation claim markers. Keys are ruleId|triggerType|dueDate, values are the ISO date the rule last fired for that combination, so daily reminder runs never re-fire the same rule for the same deadline.\"\n    },\n    \"sales_status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"lead\",\n        \"quoted\",\n        \"follow_up\",\n        \"won\",\n        \"lost\",\n        \"on_hold\"\n      ],\n      \"default\": \"lead\"\n    },\n    \"sales_neutral_closed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Explicit user-confirmed neutral Sales archive timestamp for Closed - Did not Lose. Never counted as Won or Lost; no legacy task inference.\"\n    },\n    \"lead_source\": {\n      \"type\": \"string\"\n    },\n    \"current_task_deadline\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"current_task_assigned_to\": {\n      \"type\": \"string\"\n    },\n    \"designer\": {\n      \"type\": \"string\"\n    },\n    \"surveyor\": {\n      \"type\": \"string\"\n    },\n    \"site_survey_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"site_survey_time\": {\n      \"type\": \"string\"\n    },\n    \"site_survey_am_pm\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"AM\",\n        \"PM\"\n      ]\n    },\n    \"project_manager\": {\n      \"type\": \"string\"\n    },\n    \"estimator\": {\n      \"type\": \"string\"\n    },\n    \"est_inv_at\": {\n      \"type\": \"string\"\n    },\n    \"corbridge_invoice_number\": {\n      \"type\": \"string\"\n    },\n    \"corbridge_link\": {\n      \"type\": \"string\"\n    },\n    \"estimate_amount\": {\n      \"type\": \"number\"\n    },\n    \"estimate_revision_required\": {\n      \"type\": \"boolean\",\n      \"description\": \"Set when the linked estimate's quote total diverges from the amount this Work Order was built on. Sticky until manually reviewed.\"\n    },\n    \"current_task_description\": {\n      \"type\": \"string\"\n    },\n    \"date_initial_contact\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"date_estimate_sent\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"sales_quote_sent_verified_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp proving the current date_estimate_sent was explicitly confirmed by a verified Base44 Sales/Estimator action. Blank means the stored date is legacy or otherwise unverified and must not drive quote-aging analytics.\"\n    },\n    \"date_order_created\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"project_install_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"install_route_order\": {\n      \"type\": \"number\",\n      \"description\": \"Per-day install route stop ordering managed by the InstallRouteMap page.\"\n    },\n    \"permit_submitted_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"permit_receipt_confirmed_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"permit_number\": {\n      \"type\": \"string\"\n    },\n    \"permit_approved_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"actual_cost\": {\n      \"type\": \"number\"\n    },\n    \"profit_margin\": {\n      \"type\": \"number\"\n    },\n    \"contact_name\": {\n      \"type\": \"string\"\n    },\n    \"contact_email\": {\n      \"type\": \"string\"\n    },\n    \"contact_phone\": {\n      \"type\": \"string\"\n    },\n    \"representative\": {\n      \"type\": \"string\"\n    },\n    \"additional_contact\": {\n      \"type\": \"string\"\n    },\n    \"follow_up_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"sales_last_follow_up_completed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the latest completed Sales Pipeline follow-up. Each change is preserved in CellHistory.\"\n    },\n    \"sales_last_follow_up_outcome\": {\n      \"type\": \"string\",\n      \"description\": \"Business-readable outcome of the latest completed Sales Pipeline follow-up. Each change is preserved in CellHistory.\"\n    },\n    \"close_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"expected_close_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Expected sales close date for an open opportunity.\"\n    },\n    \"sales_last_activity_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the latest verified sales-specific activity. Used for stale-opportunity reporting going forward.\"\n    },\n    \"sales_stage_changed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the latest verified Sales Pipeline status change.\"\n    },\n    \"lost_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Sales reason captured when an opportunity is marked Lost. Preserved in change history when reopened.\"\n    },\n    \"project_type\": {\n      \"type\": \"string\"\n    },\n    \"install_location\": {\n      \"type\": \"string\"\n    },\n    \"address_line_2\": {\n      \"type\": \"string\"\n    },\n    \"billing_address\": {\n      \"type\": \"string\"\n    },\n    \"billing_address_line_2\": {\n      \"type\": \"string\"\n    },\n    \"billing_schedule\": {\n      \"type\": \"array\",\n      \"description\": \"Progress (milestone) billing schedule. Each row is a percentage of contract value; saved schedules are normalized so cumulative pct never exceeds 100.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"label\": {\n            \"type\": \"string\"\n          },\n          \"pct\": {\n            \"type\": \"number\"\n          },\n          \"note\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": true\n      }\n    },\n    \"deposit_required\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"When true, this job requires a deposit before production work begins. Product moves into production statuses prompt a deposit warning until deposit_invoiced is set.\"\n    },\n    \"deposit_amount\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Deposit amount required on this order, in dollars.\"\n    },\n    \"deposit_invoiced\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Deposit has been invoiced \\u2014 maintained from the Job Workspace financials card with a compare-and-set write.\"\n    },\n    \"sales_rep\": {\n      \"type\": \"string\"\n    },\n    \"permitting\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ]\n    },\n    \"township_city\": {\n      \"type\": \"string\"\n    },\n    \"county\": {\n      \"type\": \"string\"\n    },\n    \"permit_code\": {\n      \"type\": \"string\"\n    },\n    \"permit_class\": {\n      \"type\": \"string\"\n    },\n    \"property_owner\": {\n      \"type\": \"string\"\n    },\n    \"pud\": {\n      \"type\": \"string\"\n    },\n    \"parcel_number\": {\n      \"type\": \"string\"\n    },\n    \"electrical_ibi\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_nkyei\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_nec\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_city\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_county\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"customer_is_building_owner\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"customer_is_tenant\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"customer_is_marketing_co\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"business_co_coo_reminder\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"business_co_coo_date\": {\n      \"type\": \"string\"\n    },\n    \"install_yes\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"install_no\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"budget_less_than\": {\n      \"type\": \"number\"\n    },\n    \"removal_yes\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"removal_no\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"service_repair\": {\n      \"type\": \"string\"\n    },\n    \"origination\": {\n      \"type\": \"string\"\n    },\n    \"patch\": {\n      \"type\": \"string\"\n    },\n    \"paint\": {\n      \"type\": \"string\"\n    },\n    \"color\": {\n      \"type\": \"string\"\n    },\n    \"products\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"product_type\": {\n            \"type\": \"string\"\n          },\n          \"estimate_line_id\": {\n            \"type\": \"string\",\n            \"description\": \"Source All-In-One estimate Product line id when this product was carried from the estimator.\"\n          },\n          \"builder_product_id\": {\n            \"type\": \"string\",\n            \"description\": \"Linked BuilderProduct id. BuilderProduct/BuilderPart remain the authoritative production BOM/configuration.\"\n          },\n          \"source_project_id\": {\n            \"type\": \"string\",\n            \"description\": \"Source Builder project/entity record id.\"\n          },\n          \"module_key\": {\n            \"type\": \"string\",\n            \"description\": \"Estimator Builder module key.\"\n          },\n          \"source_estimate_id\": {\n            \"type\": \"string\",\n            \"description\": \"AllInOneEstimate id this product row came from \\u2014 set on every conversion row so combined multi-estimate jobs keep per-estimate section provenance.\"\n          },\n          \"source_estimate_number\": {\n            \"type\": \"string\",\n            \"description\": \"Estimate number of the source estimate at conversion time (display aid alongside source_estimate_id).\"\n          },\n          \"quantity\": {\n            \"type\": \"number\"\n          },\n          \"quoted_unit_price\": {\n            \"type\": \"number\",\n            \"description\": \"Accepted customer unit price at WorkOrder conversion; never internal Product cost.\"\n          },\n          \"quoted_total\": {\n            \"type\": \"number\",\n            \"description\": \"Customer Product total after quantity and Product adjustment at WorkOrder conversion.\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"customer_description\": {\n            \"type\": \"string\"\n          },\n          \"estimator_notes\": {\n            \"type\": \"string\"\n          },\n          \"operational_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"order_review\",\n              \"site_survey\",\n              \"awaiting_customer_action\",\n              \"awaiting_proof_approval\",\n              \"permitting\",\n              \"proof_approved\",\n              \"design_review\",\n              \"in_design\",\n              \"in_production\",\n              \"quality_control\",\n              \"service_repair\",\n              \"install_or_removal_only\",\n              \"vended\",\n              \"none\"\n            ],\n            \"description\": \"CoreBridge-style WIP operational state for this product, independent of the work-order stage.\"\n          },\n          \"operational_substatus\": {\n            \"type\": \"string\"\n          },\n          \"customer_facing_status\": {\n            \"type\": \"string\"\n          },\n          \"fulfillment_state\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"none\",\n              \"awaiting_pickup\",\n              \"awaiting_installation\",\n              \"awaiting_shipping\",\n              \"awaiting_delivery\",\n              \"picked_up\",\n              \"installed\",\n              \"shipped\",\n              \"delivered\"\n            ]\n          },\n          \"design_due_date\": {\n            \"type\": \"string\"\n          },\n          \"product_due_date\": {\n            \"type\": \"string\"\n          },\n          \"hard_due_date\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"designer\": {\n            \"type\": \"string\"\n          },\n          \"assigned_to\": {\n            \"type\": \"string\"\n          },\n          \"responsibility\": {\n            \"type\": \"string\"\n          },\n          \"queue_priority\": {\n            \"type\": \"number\"\n          },\n          \"proof_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"none\",\n              \"draft\",\n              \"sent\",\n              \"awaiting_approval\",\n              \"approved\",\n              \"revision_requested\"\n            ]\n          },\n          \"proof_file_url\": {\n            \"type\": \"string\",\n            \"description\": \"URL of the current proof file version for this product.\"\n          },\n          \"proof_file_name\": {\n            \"type\": \"string\",\n            \"description\": \"Display name of the current proof file.\"\n          },\n          \"proof_version\": {\n            \"type\": \"number\",\n            \"description\": \"Current proof file version (1-based). 0 means no proof file.\"\n          },\n          \"proof_approved_version\": {\n            \"type\": \"number\",\n            \"description\": \"Proof version the current approval applies to. 0 means no versioned approval; approvals do not carry to newer versions.\"\n          },\n          \"operational_status_changed_at\": {\n            \"type\": \"string\",\n            \"description\": \"ISO timestamp of the last operational_status change on this product.\"\n          },\n          \"status_history\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"at\": {\n                  \"type\": \"string\"\n                },\n                \"field\": {\n                  \"type\": \"string\"\n                },\n                \"by\": {\n                  \"type\": \"string\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"product_1\": {\n      \"type\": \"string\"\n    },\n    \"product_2\": {\n      \"type\": \"string\"\n    },\n    \"product_3\": {\n      \"type\": \"string\"\n    },\n    \"product_4\": {\n      \"type\": \"string\"\n    },\n    \"product_5\": {\n      \"type\": \"string\"\n    },\n    \"product_6\": {\n      \"type\": \"string\"\n    },\n    \"cb_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"cf_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"cc_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"sms_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"deleted\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"deleted_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"deleted_by\": {\n      \"type\": \"string\"\n    },\n    \"production_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"inhouse\",\n        \"outsource\"\n      ]\n    },\n    \"sip_checklist\": {\n      \"type\": \"array\",\n      \"description\": \"SIP meeting checklist with product groupings and hierarchy\",\n      \"items\": {\n        \"type\": \"object\"\n      }\n    },\n    \"mmm_sip_checklist\": {\n      \"type\": \"array\",\n      \"description\": \"Monday Morning Meeting checklist - completely separate from SIPs\",\n      \"items\": {\n        \"type\": \"object\"\n      }\n    },\n    \"mmm_checklist\": {\n      \"type\": \"array\",\n      \"description\": \"Legacy Monday Morning Meeting checklist items\",\n      \"items\": {\n        \"type\": \"object\"\n      }\n    },\n    \"sip_completed\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Whether this item has been completed/discussed in SIPs or MMM meeting\"\n    },\n    \"sip_revisit_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Date to revisit this project in SIPs - jobs with a future date are separated from the active list\"\n    },\n    \"mmm_last_discussed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the last Monday Morning Meeting discussion mark. Rows move to the Discussed section for the current week (Mon-Sun) and return to the active list next Monday. Independent of sip_completed.\"\n    },\n    \"mmm_defer_until\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Monday Morning Meeting snooze date - rows with a future date are parked in the Discussed & Scheduled section and return automatically when it passes\"\n    },\n    \"mmm_tasks\": {\n      \"type\": \"array\",\n      \"description\": \"Monday Morning Meeting task list - MMM-only items shown inline under the board row until completed. Separate from the shared notes task list.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"assigned_to\": {\n            \"type\": \"string\"\n          },\n          \"due_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"created_by\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"title\",\n    \"client_name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"read\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"update\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"admin\"\n      }\n    }\n  }\n}",
