    {
      "path": "base44/entities/EstimateQuoteDelivery.jsonc",
      "content": "{\n  \"name\": \"EstimateQuoteDelivery\",\n  \"type\": \"object\",\n  \"description\": \"Immutable delivery audit for customer quote versions. One record is created after a quote email is successfully accepted by Gmail. Delivery history is separate from EstimateRevision lifecycle history and BuilderPriceRevision pricing history.\",\n  \"properties\": {\n    \"estimate_id\": {\n      \"type\": \"string\",\n      \"description\": \"AllInOneEstimate id whose customer quote was delivered.\"\n    },\n    \"idempotency_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable internal receipt for retry-safe persistence of a Gmail-confirmed delivery audit.\"\n    },\n    \"work_order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional linked WorkOrder id at the time of delivery.\"\n    },\n    \"quote_issue_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable identity shared by all deliveries, lifecycle revisions, and acceptance records for one issued customer quote version.\"\n    },\n    \"quote_version\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"description\": \"Customer-facing quote version actually attached to this delivery.\"\n    },\n    \"quote_issue_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Issue date printed on the attached customer quote.\"\n    },\n    \"quote_valid_days\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"default\": 30,\n      \"description\": \"Validity period printed on this delivered quote version.\"\n    },\n    \"quote_expiration_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Exact valid-through date printed on this delivered quote version.\"\n    },\n    \"quote_total\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Customer quote total delivered; never internal cost.\"\n    },\n    \"recipient_email\": {\n      \"type\": \"string\"\n    },\n    \"cc_emails\": {\n      \"type\": \"string\"\n    },\n    \"bcc_emails\": {\n      \"type\": \"string\"\n    },\n    \"subject\": {\n      \"type\": \"string\"\n    },\n    \"delivery_method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"email\"\n      ],\n      \"default\": \"email\"\n    },\n    \"delivery_status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"sent\"\n      ],\n      \"default\": \"sent\"\n    },\n    \"sent_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"gmail_message_id\": {\n      \"type\": \"string\",\n      \"description\": \"Gmail API message id returned after successful delivery submission.\"\n    },\n    \"attachment_filename\": {\n      \"type\": \"string\"\n    },\n    \"attachment_file_url\": {\n      \"type\": \"string\",\n      \"description\": \"Base44 file-storage URL for the exact PDF bytes attached to this delivery.\"\n    },\n    \"attachment_sha256\": {\n      \"type\": \"string\",\n      \"description\": \"SHA-256 fingerprint of the exact archived/emailed PDF bytes.\"\n    },\n    \"attachment_size_bytes\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"description\": \"Exact PDF attachment size in bytes.\"\n    },\n    \"is_resend\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"True when an already-issued quote version is delivered again without creating a new customer quote version.\"\n    },\n    \"delivery_n\": {\n      \"type\": \"number\",\n      \"minimum\": 1,\n      \"description\": \"Ordinal count of deliveries for this quote issue \\u2014 1 on first send, then 2, 3... on resends.\"\n    },\n    \"source_status\": {\n      \"type\": \"string\",\n      \"description\": \"Persisted estimate status immediately before this delivery.\"\n    }\n  },\n  \"required\": [\n    \"estimate_id\",\n    \"quote_version\",\n    \"recipient_email\",\n    \"delivery_method\",\n    \"delivery_status\",\n    \"sent_at\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__estimate_audit_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__estimate_audit_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__estimate_audit_backend_only__\"\n      }\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 152,
