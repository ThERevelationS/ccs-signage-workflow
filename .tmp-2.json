er acceptance of Quote Version ${Math.max(0, Math.floor(Number(before.quote_version || 0)))} superseded${String(reason || \"\").trim() ? `: ${String(reason).trim()}` : \"\"}`,\n        revisionType: \"status_transition\",\n        quoteTotalBefore: before.quote_total,\n        quoteTotalAfter: after.quote_total ?? before.quote_total,\n        internalCostBefore: before.total_cost,\n        internalCostAfter: after.total_cost ?? before.total_cost,\n        workOrderId: after.work_order_id || before.work_order_id || \"\",\n      });\n    } catch (revisionError) {\n      setEstimate(after);\n      setPersistedEstimate(after);\n      setRevisionRefreshKey((value) => value + 1);\n      throw new Error(`The acceptance is superseded, but its lifecycle revision could not be saved: ${revisionError?.message || \"unknown error\"}`);\n    }\n\n    try {\n      await syncEstimateEverywhere(after, { previousEstimateStatus: before.status || \"approved\", syncCustomer: false, sessionToken });\n    } catch (syncError) {\n      const message = String(syncError?.message || \"Customer/Sales Pipeline synchronization failed.\");\n      const recovered = await saveEstimateFieldsSafely({\n        baseline: after,\n        nextFields: {\n          pipeline_sync_pending: true,\n          pipeline_sync_error: message,\n        },\n        label: \"Acceptance supersede pipeline recovery marker\",\n      }).catch(() => null) || await staffEntities.AllInOneEstimate.get(estimate.id).catch(() => after);\n      after = { ...after, ...(recovered || {}), pipeline_sync_pending: true, pipeline_sync_error: message };\n      await rememberServerVersion(after);\n      setEstimate(after);\n      setPersistedEstimate(after);\n      setRevisionRefreshKey((value) => value + 1);\n      window.alert(`The acceptance is superseded and its lifecycle history is saved, but Sales Pipeline synchronization is pending.\\n\\n${message}\\n\\nUse Retry Pipeline Sync in Finalize Estimate.`);\n      return;\n    }\n\n    const refreshed = await staffEntities.AllInOneEstimate.get(estimate.id).catch(() => after);\n    const savedAfter = { ...after, ...(refreshed || {}), status: \"sent\", edit_reason: \"\" };\n    if (savedAfter.updated_date) serverUpdatedAtRef.current = savedAfter.updated_date;\n    setEstimate(savedAfter);\n    setPersistedEstimate(savedAfter);\n    setRevisionRefreshKey((value) => value + 1);\n  };\n\n  const handleCancel = async (reason) => {\n    if (openRevision) {\n      window.alert(\"Save the open estimate revision before cancelling the estimate.\");\n      return;\n    }\n    const before = await staffEntities.AllInOneEstimate.get(estimate.id);\n    assertNoPendingPriceAcceptance(before, \"cancelling the estimate\");\n    if (hasServerConflict(before)) {\n      window.alert(\"This estimate changed in another session. Reload before cancelling so newer work is not cancelled from a stale page.\");\n      return;\n    }\n    if (before.pipeline_sync_pending) {\n      window.alert(\"Sales Pipeline synchronization is still pending. Retry that synchronization before cancelling this estimate.\");\n      return;\n    }\n    if (before.work_order_id) {\n      throw new Error(\"This estimate is already linked to a Work Order. Cancel or close the job from the workflow instead of cancelling the source estimate.\");\n    }\n    const cancelled = await saveEstimateFieldsSafely({\n      baseline: before,\n      nextFields: {\n        status: \"cancelled\",\n        cancel_reason: reason,\n        cancelled_at: new Date().toISOString(),\n        edit_reason: \"\",\n      },\n      label: \"Estimate cancellation\",\n      guardWholeVersion: true,\n    });\n    let after = { ...before, ...(cancelled || {}), status: \"cancelled\", cancel_reason: reason, cancelled_at: new Date().toISOString(), edit_reason: \"\" };\n    await rememberServerVersion(after);\n\n    try {\n      await ensureEstimateLifecycleRevision({\n        idempotencyKey: `cancel:${estimate.id}:${before.updated_date || \"unknown\"}`,\n        sessionToken,\n        estimateBefore: before,\n        estimateAfter: after,\n        reason,\n        revisionType: \"cancel\",\n        quoteTotalBefore: before.quote_total,\n        quoteTotalAfter: before.quote_total,\n        internalCostBefore: before.total_cost,\n        internalCostAfter: before.total_cost,\n        workOrderId: \"\",\n      });\n    } catch (revisionError) {\n      setEstimate(after);\n      setPersistedEstimate(after);\n      setShowCancel(false);\n      setRevisionRefreshKey((value) => value + 1);\n      throw new Error(`The estimate is cancelled, but its cancellation lifecycle revision could not be saved: ${revisionError?.message || \"unknown error\"}`);\n    }\n\n    try {\n      await syncEstimateEverywhere(after, { previousEstimateStatus: before.status || \"\", syncCustomer: false, sessionToken });\n    } catch (syncError) {\n      const message = String(syncError?.message || \"Customer/Sales Pipeline synchronization failed.\");\n      const recovered = await saveEstimateFieldsSafely({\n        baseline: after,\n        nextFields: {\n          pipeline_sync_pending: true,\n          pipeline_sync_error: message,\n        },\n        label: \"Estimate cancellation pipeline recovery marker\",\n      }).catch(() => null) || await staffEntities.AllInOneEstimate.get(estimate.id).catch(() => after);\n      after = { ...after, ...(recovered || {}), pipeline_sync_pending: true, pipeline_sync_error: message };\n      await rememberServerVersion(after);\n      setEstimate(after);\n      setPersistedEstimate(after);\n      setShowCancel(false);\n      setRevisionRefreshKey((value) => value + 1);\n      window.alert(`The estimate is cancelled and its lifecycle history is saved, but Sales Pipeline synchronization is pending.\\n\\n${message}\\n\\nUse Retry Pipeline Sync in Finalize Estimate.`);\n      return;\n    }\n\n    setShowCancel(false);\n    navigate(\"/Estimator\");\n  };\n\n  const counts = lines.reduce((acc, l) => {\n    acc[l.module_key] = (acc[l.module_key] || 0) + 1;\n    return acc;\n  }, {});\n\n  const WorkspaceNav = ({ compact = false }) => (\n    <div className={`${compact ? \"pt-1\" : \"sticky top-0 z-20 -mx-1 px-1 py-1.5 bg-gray-50/95 backdrop-blur-sm\"}`}>\n      <div className=\"bg-white border border-gray-300 rounded-sm shadow-sm flex items-center justify-between gap-3 px-2.5 py-2\">\n        <div className=\"min-w-0\">\n          <div className=\"text-[10px] font-bold tracking-wider uppercase text-gray-400\">Estimate Workspace</div>\n          <div className=\"flex items-center gap-2 min-w-0\">\n            <span className=\"text-[14px] font-bold text-gray-900 truncate\">{WORKSPACE_TITLES[step]}</span>\n            {step === 2 && (\n              <span className=\"text-[10px] px-2 py-0.5 rounded-sm bg-gray-100 text-gray-600 border border-gray-200 whitespace-nowrap\">\n                {lines.length} product{lines.length === 1 ? \"\" : \"s\"}\n              </span>\n            )}\n          </div>\n        </div>\n        <div className=\"inline-flex items-stretch rounded-sm border border-gray-300 overflow-hidden bg-gray-50 flex-shrink-0\">\n          {WORKSPACE_TABS.map((tab) => {\n            const active = tab.n === step;\n            return (\n              <button\n                key={tab.n}\n                type=\"button\"\n                onClick={() => setStep(tab.n)}\n                aria-current={active ? \"page\" : undefined}\n                className={`h-[32px] px-3 text-[11px] font-bold border-r border-gray-300 last:border-r-0 transition-colors ${\n                  active\n                    ? \"bg-lime-200 text-gray-950 shadow-inner\"\n                    : \"bg-white text-gray-600 hover:bg-gray-100 hover:text-gray-900\"\n                }`}\n              >\n                {tab.label}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"min-h-full bg-gray-50\">\n      {celebration ? <div role=\"status\" aria-live=\"polite\" className=\"fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-xl border border-emerald-300 bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-xl\">&#10003; {celebration}</div> : null}\n      <AioEstimateHeader\n        title={estimate.project_name || \"Estimate\"}\n        subtitle={`One page, one set of project info, every estimator. · Totals synced ${new Date().toLocaleTimeString()}`}\n        status={estimate.status || \"draft\"}\n        quoteTotal={pricing.quoteTotal}\n        onSave={handleSave}\n        saving={saving}\n        readOnly={readOnly}\n        onEdit={canEditWithRevision ? handleEditProtected : null}\n        editStarting={editStarting}\n        onDuplicate={handleDuplicate}\n        duplicating={duplicating}\n        onMerge={() => setMergeOpen(true)}\n      />\n\n      {estimate.opportunity_id && (\n        <div className=\"px-3 pb-2\">\n          <a href={`/Opportunities?open=${estimate.opportunity_id}`}\n            className=\"inline-flex items-center gap-1.5 rounded border border-sky-200 bg-sky-50 px-2 py-0.5 text-[11px] font-semibold text-sky-700 hover:bg-sky-100\">\n            From opportunity{estimate.estimating_request_id ? \" via estimating request\" : \"\"} — open pipeline record\n          </a>\n        </div>\n      )}\n      {estimate.work_order_id && (\n        <div className=\"px-3 pb-2\">\n          <a href={`/JobWorkspace?wo=${estimate.work_order_id}`}\n            className=\"inline-flex items-center gap-1.5 rounded border border-sky-200 bg-sky-50 px-2 py-0.5 text-[11px] font-semibold text-sky-700 hover:bg-sky-100\">\n            Open Job Workspace\n          </a>\n        </div>\n      )}\n\n      {/* Watch rule (#349): \"tell me when this estimate is approved\" — the\n          rule persists in GlobalSettings and `check_watches` surfaces hits. */}\n      {/* Bulk re-markup flag (#145): when the admin changes this estimate's\n          pricing tier, open estimates get pricing_stale — recompute + re-save\n          clears it. */}\n      {estimate.pricing_stale && (\n        <div role=\"alert\" className=\"mx-3 mb-2 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-[11px] font-semibold text-amber-800\">\n          {estimate.pricing_stale_reason || \"The pricing tier changed — recompute and re-save this estimate before sending.\"}\n        </div>\n      )}\n      {estimate.id && persistedStatus !== \"approved\" && (\n        <div className=\"px-3 pb-2\">\n          <button type=\"button\" disabled={watchBusy} onClick={async () => {\n            if (watchBusy) return;\n            setWatchBusy(true);\n            try {\n              const sessionToken = localStorage.getItem(\"signShopSessionToken\") || sessionStorage.getItem(\"signShopSessionToken\") || \"\";\n              const res = await base44.functions.invoke(\"opportunityWorkspaceAction\", { session_token: sessionToken, action: \"set_watch\", entity: \"AllInOneEstimate\", record_id: estimate.id, field: \"status\", value: \"approved\", label: estimate.project_name || estimate.estimate_number || \"this estimate\" });\n              if ((res?.data || res)?.success) setWatchNote(\"Watching — you'll see a notice when it's approved.\");\n            } catch (e) { setWatchNote(e?.message || \"Couldn't set the watch.\"); } finally { setWatchBusy(false); }\n          }}\n            className=\"inline-flex items-center gap-1.5 rounded border border-violet-200 bg-violet-50 px-2 py-0.5 text-[11px] font-semibold text-violet-700 hover:bg-violet-100 disabled:opacity-50\">\n            <Eye className=\"w-3.5 h-3.5\" aria-hidden=\"true\" /> Watch for approval\n          </button>\n          {watchNote ? <span className=\"ml-2 text-[10px] text-violet-600\">{watchNote}</span> : null}\n          <button type=\"button\" onClick={async () => {\n            try {\n              const sessionToken = localStorage.getItem(\"signShopSessionToken\") || sessionStorage.getItem(\"signShopSessionToken\") || \"\";\n              const res = await base44.functions.invoke(\"opportunityWorkspaceAction\", { session_token: sessionToken, action: \"export_estimate\", estimate_id: estimate.id });\n              const d = res?.data || res;\n              if (!d?.success || !d?.bundle) throw new Error(d?.error || \"Export failed.\");\n              const blob = new Blob([JSON.stringify(d.bundle, null, 2)], { type: \"application/json\" });\n              const a = document.createElement(\"a\");\n              a.href = URL.createObjectURL(blob);\n              a.download = `estimate-${estimate.estimate_number || estimate.id}.json`;\n              a.click();\n              setTimeout(() => URL.revokeObjectURL(a.href), 5000);\n            } catch (e) { window.alert(e?.message || \"Export failed.\"); }\n          }}\n            className=\"ml-2 inline-flex items-center gap-1 rounded border border-gray-300 bg-white px-2 py-0.5 text-[11px] font-semibold text-gray-600 hover:bg-gray-50\" title=\"Export this estimate + parts + audit as re-importable JSON (#451)\">\n            Export JSON\n          </button>\n          <button type=\"button\" onClick={async () => {\n            const raw = window.prompt(\"Copy BOM (parts + products) from which estimate id or number?\", \"\");\n            const q = String(raw || \"\").trim();\n            if (!q) return;\n            try {\n              const sessionToken = localStorage.getItem(\"signShopSessionToken\") || sessionStorage.getItem(\"signShopSessionToken\") || \"\";\n              // Resolve an estimate_number or raw id to a source estimate.\n              let src = await staffEntities.AllInOneEstimate.filter({ estimate_number: q }, undefined, 1).catch(() => []);\n              if (!Array.isArray(src) || !src.length) src = await staffEntities.AllInOneEstimate.get(q).catch(() => null);\n              const srcRow = Array.isArray(src) ? src[0] : src;\n              if (!srcRow?.id) throw new Error(\"No estimate found with that id or number.\");\n              if (!window.confirm(`Copy ${srcRow.project_name || srcRow.id}'s BOM (products + parts) into this estimate?`)) return;\n              const res = await base44.functions.invoke(\"opportunityWorkspaceAction\", { session_token: sessionToken, action: \"copy_bom\", from_estimate_id: srcRow.id, to_estimate_id: estimate.id });\n              const d = res?.data || res;\n              window.alert(d?.success ? `Copied ${d.copied_products || 0} products + ${d.copied_parts || 0} parts.` : (d?.error || \"Copy failed.\"));\n            } catch (e) { window.alert(e?.message || \"Copy failed.\"); }\n          }}\n            className=\"ml-2 inline-flex items-center gap-1 rounded border border-indigo-300 bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700 hover:bg-indigo-100\" title=\"Copy this estimate's BOM (products + parts) from another estimate (#464)\">\n            Copy BOM from…\n          </button>\n          <button type=\"button\" onClick={async () => {\n            const raw = window.prompt(\"Copy sections from which estimate id or number?\", \"\");\n            const q = String(raw || \"\").trim();\n            if (!q) return;\n            try {\n              const sessionToken = localStorage.getItem(\"signShopSessionToken\") || sessionStorage.getItem(\"signShopSessionToken\") || \"\";\n              let src = await staffEntities.AllInOneEstimate.filter({ estimate_number: q }, undefined, 1).catch(() => []);\n              if (!Array.isArray(src) || !src.length) src = await staffEntities.AllInOneEstimate.get(q).catch(() => null);\n              const srcRow = Array.isArray(src) ? src[0] : src;\n              if (!srcRow?.id) throw new Error(\"No estimate found with that id or number.\");\n              if (!window.confirm(`Copy ${srcRow.project_name || srcRow.id}'s sections (module projects + builder products) into this estimate?`)) return;\n              const res = await base44.functions.invoke(\"opportunityWorkspaceAction\", { session_token: sessionToken, action: \"copy_sections\", from_estimate_id: srcRow.id, to_estimate_id: estimate.id });\n              const d = res?.data || res;\n              window.alert(d?.success ? `Copied ${d.copied_sections || 0} section(s).` : (d?.error || \"Copy failed.\"));\n            } catch (e) { window.alert(e?.message || \"Copy failed.\"); }\n          }}\n            className=\"ml-2 inline-flex items-center gap-1 rounded border border-sky-300 bg-sky-50 px-2 py-0.5 text-[11px] font-semibold text-sky-700 hover:bg-sky-100\" title=\"Copy sections (module projects + builder products) from another estimate (#467)\">\n            Copy sections…\n          </button>\n        </div>\n      )}\n\n      <div className=\"flex gap-3 px-3 pb-6\">\n        <AioStepRail\n          activeStep={step}\n          onStepClick={setStep}\n          estimateNumber={estimate.estimate_number}\n          stepDone={{\n            details: !!(estimate.project_name && estimate.client_name),\n            build: lines.length > 0,\n            customer: estimate.status === \"sent\" || estimate.status === \"approved\",\n          }}\n          clientName={estimate.client_name}\n          description={estimate.project_name}\n          taxPercent={estimate.tax_percent}\n          summary={{\n            subtotal: pricing.subtotal,\n            discount: pricing.discount,\n            contingency: pricing.contingency,\n            contingencyPct: estimate.contingency_percent,\n            shipping: estimate.shipping_fee,\n            permits: estimate.permit_fee,\n            newSubtotal: pricing.subtotal - pricing.discount + pricing.contingency + pricing.fees,\n            tax: pricing.tax,\n            total: pricing.quoteTotal,\n            deposit: pricing.deposit,\n            depositPct: estimate.deposit_percent,\n          }}\n          onSaveProgress={handleSave}\n          saving={saving}\n          readOnly={readOnly}\n          onEdit={canEditWithRevision ? handleEditProtected : null}\n          editStarting={editStarting}\n        />\n\n        <div className=\"flex-1 min-w-0 space-y-3\">\n          <WorkspaceNav />\n\n          {reconciliationWarnings.length > 0 && (\n            <div role=\"alert\" className=\"rounded border border-amber-300 bg-amber-50 px-3 py-2 text-[10px] text-amber-900\">\n              <div className=\"font-bold\">Live Product pricing could not be fully verified.</div>\n              <div className=\"mt-0.5\">Saved estimate pricing was retained for {reconciliationWarnings.length} Product{reconciliationWarnings.length === 1 ? \"\" : \"s\"}. Reload to retry before accepting new pricing.</div>\n              <div className=\"mt-1 text-[9px] text-amber-700 truncate\" title={reconciliationWarnings.map((item) => `${item.product_name}: ${item.message}`).join(\"\\n\")}>\n                {reconciliationWarnings.map((item) => item.product_name).join(\" · \")}\n              </div>\n            </div>\n          )}\n\n          {readOnly && (\n            <div className=\"rounded border border-amber-200 bg-amber-50 px-3 py-2 flex items-center justify-between gap-3\">\n              <div className=\"flex items-center gap-2 text-[11px] text-amber-800\"><LockKeyhole className=\"w-4 h-4\" aria-hidden=\"true\" /><span><strong>Protected {persistedStatus} estimate.</strong> {canEditWithRevision ? \"Click Edit to open a recorded revision and make changes.\" : \"Viewing is available; a cancelled estimate stays permanently locked.\"}</span></div>\n              {canEditWithRevision ? (\n                <button type=\"button\" onClick={handleEditProtected} disabled={editStarting} className=\"h-[28px] px-3 inline-flex items-center gap-1 rounded border border-amber-300 bg-white text-[10px] font-bold text-amber-800 hover:bg-amber-100 disabled:opacity-50\"><PencilLine className=\"w-3 h-3\" aria-hidden=\"true\" /> {editStarting ? \"Opening…\" : \"Edit\"}</button>\n              ) : (\n                <button type=\"button\" onClick={() => setStep(3)} className=\"h-[28px] px-3 rounded border border-amber-300 bg-white text-[10px] font-bold text-amber-800 hover:bg-amber-100\">Open Finalize / History</button>\n              )}\n            </div>\n          )}\n\n          {quoteDaysLeft !== null && quoteDaysLeft < 0 && (\n            <div role=\"alert\" className=\"rounded border border-red-300 bg-red-50 px-3 py-2 flex items-center gap-2 text-[11px] text-red-800\">\n              <AlertTriangle className=\"w-4 h-4\" aria-hidden=\"true\" /><span><strong>Quote EXPIRED {formatQuoteIssueDate(expiresOn)}</strong> — re-issue or request a revision.</span>\n            </div>\n          )}\n\n          {quoteDaysLeft !== null && quoteDaysLeft >= 0 && quoteDaysLeft <= 7 && (\n            <div role=\"status\" className=\"rounded border border-amber-300 bg-amber-50 px-3 py-2 flex items-center gap-2 text-[11px] text-amber-800\">\n              <Clock className=\"w-4 h-4\" aria-hidden=\"true\" /><span><strong>Quote expires {formatQuoteIssueDate(expiresOn)}</strong> ({quoteDaysLeft} days left)</span>\n            </div>\n          )}\n\n          {step === 1 && <EstimateHeaderForm estimate={estimate} onChange={patch} readOnly={readOnly} />}\n          {step === 1 && <div className=\"mt-3\"><EstimateNotesTimeline estimate={estimate} onChange={patch} readOnly={readOnly} /></div>}\n\n          {step === 2 && (\n            activeProduct ? (\n              <InlineProductEditor\n                line={activeProduct}\n                lines={lines}\n                estimateId={estimate.id}\n                expectedEstimateUpdatedAt={serverUpdatedAtRef.current}\n                onClose={async () => {\n                  await refreshProducts();\n                  setActiveProduct(null);\n                }}\n                onSaved={refreshProducts}\n                onSwitchLine={(next) => setActiveProduct(next)}\n              />\n            ) : (\n              <>\n                {!readOnly && <div className=\"flex justify-end\">\n                  <AddProductGrid counts={counts} onAdd={addSection} onAddCustom={addCustomSection} onAddQuickProduct={addQuickProduct} onAddKit={addKit} />\n                </div>}\n                <EstimateProductsList\n                  lines={lines.map((l) => ({ ...l, estimate_id: estimate.id, estimate_updated_date: serverUpdatedAtRef.current }))}\n                  rawTotal={pricing.rawTotal}\n                  onChange={patchLine}\n                  onRemove={removeLine}\n                  onEdit={(line) => setActiveProduct(line)}\n                  onUpdatePrice={updateProductPrice}\n                  onProductRefresh={refreshProducts}\n                  onClone={cloneProduct}\n                  onSaveNotes={updateProductNotes}\n                  onCreateQuickProduct={createQuickProduct}\n                  onPersistSettings={persistProductSettings}\n                  onSplit={handleSplit}\n                  readOnly={readOnly}\n                />\n                <div className=\"flex items-center justify-between gap-2 pt-1\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setClipboardOpen(true)}\n                    disabled={readOnly}\n                    className=\"h-[32px] px-3 inline-flex items-center gap-1.5 rounded-sm border border-gray-300 bg-white text-gray-700 text-[12px] font-semibold shadow-sm hover:bg-gray-100 disabled:opacity-40\"\n                    title=\"Open 30-day estimator clipboard\"\n                  >\n                    <ClipboardPaste className=\"w-3.5 h-3.5 text-gray-500\" aria-hidden=\"true\" /> Clipboard\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={repriceAllProducts}\n                    disabled={readOnly || saving || trashing || duplicating || refreshing}\n                    aria-label=\"Reprice all products against current Master Inventory\"\n                    title=\"Re-run current live pricing across every Product in this estimate\"\n                    className=\"h-[32px] px-3 inline-flex items-center gap-1.5 rounded-sm border border-gray-300 bg-white text-gray-700 text-[12px] font-semibold shadow-sm hover:bg-gray-100 disabled:opacity-40\"\n                  >\n                    <RefreshCw className={`w-3.5 h-3.5 text-gray-500 ${refreshing ? \"animate-spin\" : \"\"}`} aria-hidden=\"true\" />\n                    {refreshing ? \"Repricing…\" : \"Reprice products\"}\n                  </button>\n                  {!readOnly && <AddProductGrid counts={counts} onAdd={addSection} onAddCustom={addCustomSection} onAddQuickProduct={addQuickProduct} onAddKit={addKit} />}\n                </div>\n              </>\n            )\n          )}\n\n          {step === 3 && (\n            <>\n              {estimate.status !== \"cancelled\" && !estimate.work_order_id && (\n                <button type=\"button\"\n                  onClick={() => setShowCancel(true)}\n                  disabled={!!openRevision}\n                  className=\"w-full flex items-center gap-2 px-3 py-2 mb-3 bg-white border border-gray-300 rounded-sm hover:bg-gray-50 transition-colors text-left disabled:opacity-50 disabled:cursor-not-allowed\"\n                  title={openRevision ? \"Save the open revision before cancelling this estimate.\" : \"Cancel Estimate\"}\n                >\n                  <FileMinus className=\"w-4 h-4\" style={{ color: \"#8b1e1e\" }} aria-hidden=\"true\" />\n                  <span className=\"text-sm font-medium text-gray-800\">{openRevision ? \"Save Revision Before Cancelling\" : \"Cancel Estimate\"}</span>\n                </button>\n              )}\n              {!estimate.work_order_id && (\n                <button type=\"button\"\n                  onClick={handleMoveToTrash}\n                  disabled={!!openRevision || trashing}\n                  className=\"w-full flex items-center gap-2 px-3 py-2 mb-3 bg-white border border-red-200 rounded-sm hover:bg-red-50 transition-colors text-left disabled:opacity-50 disabled:cursor-not-allowed\"\n                  title={openRevision ? \"Save the open revision before moving this estimate to Trash.\" : \"Move to Trash\"}\n                >\n                  <Trash2 className=\"w-4 h-4\" style={{ color: \"#8b1e1e\" }} aria-hidden=\"true\" />\n                  <span className=\"text-sm font-medium text-gray-800\">{trashing ? \"Moving to Trash…\" : \"Move to Trash\"}</span>\n                </button>\n              )}\n              {estimate.status !== \"cancelled\" && estimate.work_order_id && (\n                <div className=\"w-full flex items-start gap-2 px-3 py-2 mb-3 bg-gray-50 border border-gray-200 rounded-sm text-left\">\n                  <LockKeyhole className=\"w-4 h-4 mt-0.5 text-gray-500 flex-shrink-0\" aria-hidden=\"true\" />\n                  <div>\n                    <div className=\"text-sm font-medium text-gray-800\">Cancellation managed from the Work Order</div>\n                    <div className=\"mt-0.5 text-[10px] text-gray-500\">This estimate has already been converted. Cancel or close the linked job in the workflow so the production record is not left active while its source estimate is cancelled.</div>\n                  </div>\n                </div>\n              )}\n              <EstimateRevisionPanel\n                estimate={estimate}\n                persistedEstimate={persistedEstimate}\n                openRevision={openRevision}\n                onStartRevision={handleStartRevision}\n                onChange={patch}\n                onRetryPipelineSync={handleRetryPipelineSync}\n                retryingPipelineSync={saving}\n                onRepairConversionTracking={handleRepairConversionTracking}\n                repairingConversionTracking={repairingConversionTracking}\n                refreshKey={revisionRefreshKey}\n              />\n              <EstimateQuoteDeliveryPanel estimate={estimate} refreshKey={deliveryRefreshKey + revisionRefreshKey} />\n              <div className=\"flex flex-wrap items-center gap-1.5 rounded border border-gray-200 bg-gray-50 px-2 py-1.5\">\n                <span className=\"text-[9px] font-bold tracking-wide text-gray-500\">IMPORT / EXPORT</span>\n                <ExportEstimateJsonButton estimate={estimate} />\n                <ImportLineItemsButton estimate={estimate} onApplied={load} />\n                <ImportTemplateSectionsButton estimate={estimate} onApplied={load} />\n                <ExportJobCostingCsvButton estimate={estimate} />\n              </div>\n              <EstimateAcceptancePanel\n                estimate={estimate}\n                persistedEstimate={persistedEstimate}\n                onRecordAcceptance={handleRecordAcceptance}\n                onRejectQuote={handleRejectQuote}\n                onSupersedeAcceptance={handleSupersedeAcceptance}\n                refreshKey={revisionRefreshKey + deliveryRefreshKey}\n                isRegistered={isRegistered}\n              />\n              <EstimateActivityPanel estimate={estimate} refreshKey={revisionRefreshKey + deliveryRefreshKey} />\n              {/* Matrix pricing suggestions (#pricing-engine): per-Product unit\n                  price advice from the PricingTierMatrix — writes into the\n                  line draft (patchLine → customer_price_snapshot), persisted\n                  only by the normal Save. Hidden in read-only Apply state. */}\n              <MatrixSuggestPanel\n                estimate={estimate}\n                lines={lines}\n                readOnly={readOnly}\n                onApplyLine={patchLine}\n              />\n              <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-3\">\n                <PricingSummary estimate={estimate} pricing={pricing} onChange={patch} readOnly={readOnly} />\n                <ConvertToWorkOrder\n                  estimate={estimate}\n                  pricing={pricing}\n                  onConverted={(woId) => {\n                    const converted = { ...estimate, work_order_id: woId, status: \"approved\", edit_reason: \"\" };\n                    setEstimate(converted);\n                    setPersistedEstimate(converted);\n                    setRevisionRefreshKey((value) => value + 1);\n                  }}\n                  disabled={!!openRevision || !!estimate.pipeline_sync_pending}\n                  disabledReason={estimate.pipeline_sync_pending ? \"Retry Pipeline Sync Before Converting\" : \"Save Revision First\"}\n                  persistedStatus={persistedStatus}\n                  sessionToken={sessionToken}\n                />\n              </div>\n              <CustomerQuotePanel\n                estimate={estimate}\n                pricing={pricing}\n                onChange={patch}\n                readOnly={readOnly}\n                revisionInProgress={!!openRevision}\n                persistedStatus={persistedStatus}\n                sessionToken={sessionToken}\n                onQuoteDelivered={handleQuoteDelivered}\n                onDeliveryLogged={() => setDeliveryRefreshKey((value) => value + 1)}\n                onDeliveryEvidenceReady={handleDeliveryEvidenceReady}\n              />\n            </>\n          )}\n\n          <WorkspaceNav compact />\n        </div>\n      </div>\n\n      <ClipboardManagerModal\n        open={clipboardOpen}\n        estimateId={estimate.id}\n        expectedEstimateUpdatedAt={serverUpdatedAtRef.current}\n        lines={lines}\n        onClose={() => setClipboardOpen(false)}\n        onPasted={refreshProducts}\n      />\n\n      <CancelEstimateModal\n        open={showCancel}\n        onClose={() => setShowCancel(false)}\n        onConfirm={handleCancel}\n        estimateName={estimate.project_name}\n      />\n\n      <MergeEstimateDialog\n        open={mergeOpen}\n        currentEstimateId={estimate.id}\n        onClose={() => setMergeOpen(false)}\n        onMerge={handleMerge}\n      />\n\n      <AlertDialog open={duplicateChoiceOpen} onOpenChange={setDuplicateChoiceOpen}>\n        <AlertDialogContent>\n          <AlertDialogHeader>\n            <AlertDialogTitle>Duplicate this estimate?</AlertDialogTitle>\n            <AlertDialogDescription>\n              Choose whether the copy gets a new estimate number or keeps {estimate.estimate_number ? `#${estimate.estimate_number}` : \"the same number\"} (useful when reworking the same quote). Either way it starts as a new draft and the original is unchanged.\n            </AlertDialogDescription>\n          </AlertDialogHeader>\n          <AlertDialogFooter className=\"flex-col gap-2 sm:flex-row\">\n            <AlertDialogCancel>Cancel</AlertDialogCancel>\n            <AlertDialogAction onClick={() => runDuplicate(true)}>Keep same number</AlertDialogAction>\n            <AlertDialogAction onClick={() => runDuplicate(false)}>New number</AlertDialogAction>\n          </AlertDialogFooter>\n        </AlertDialogContent>\n      </AlertDialog>\n    </div>\n  );\n}",
      "startLine": 1,
      "endLine": 2065,
      "totalLines": 2065,
      "truncated": false
    },
    {
      "path": "src/pages/InstallRouteMap.jsx",
      "content": "import { useEffect, useMemo, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { base44 } from \"@/api/base44Client\";\nimport { useAllWorkOrders } from \"@/lib/workOrderCache\";\nimport { createPageUrl } from \"@/utils\";\nimport { CcsDateField } from \"@/components/ui/ccs-date-field\";\nimport { AlertTriangle, ArrowDown, ArrowUp, CalendarDays, ChevronLeft, ChevronRight, ExternalLink, Loader2, MapPin, Navigation } from \"lucide-react\";\n\nconst clean = (v) => String(v ?? \"\").trim();\nconst DAY_MS = 86400000;\nconst dayKey = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, \"0\")}-${String(d.getDate()).padStart(2, \"0\")}`;\nconst parseDay = (s) => { const d = s ? new Date(`${s}T00:00:00`) : null; return d && !Number.isNaN(d.getTime()) ? d : null; };\nconst fmtDay = (d) => d.toLocaleDateString(\"en-US\", { weekday: \"long\", month: \"long\", day: \"numeric\" });\nconst ORIGIN_KEY = \"installRouteMap.origin\";\n\nconst urlParam = (name) => {\n  try { return new URLSearchParams(window.location.search).get(name); } catch { return null; }\n};\n\nexport default function InstallRouteMap() {\n  const { data: allWorkOrders, isLoading, error, refetch } = useAllWorkOrders();\n  const [date, setDate] = useState(() => parseDay(urlParam(\"date\")) || new Date());\n  const [origin, setOrigin] = useState(() => { try { return localStorage.getItem(ORIGIN_KEY) || \"\"; } catch { return \"\"; } });\n  const [busy, setBusy] = useState(false);\n  const [reorderErr, setReorderErr] = useState(\"\");\n\n  // Keep ?date= in the address bar so a day's route can be linked/shared.\n  useEffect(() => {\n    try {\n      const p = new URLSearchParams(window.location.search);\n      p.set(\"date\", dayKey(date));\n      window.history.replaceState(null, \"\", `${window.location.pathname}?${p.toString()}`);\n    } catch { /* no-op outside the browser */ }\n  }, [date]);\n\n  useEffect(() => {\n    try { localStorage.setItem(ORIGIN_KEY, clean(origin)); } catch { /* private mode */ }\n  }, [origin]);\n\n  const stops = useMemo(() => {\n    const key = dayKey(date);\n    return (allWorkOrders || [])\n      .filter((wo) =>\n        wo && !wo.completed && !wo.deleted\n        && wo.current_stage !== \"completed\"\n        && wo.sales_status !== \"lost\"\n        && clean(wo.project_install_date) === key)\n      .map((wo, i) => {\n        const ord = Number(wo.install_route_order);\n        return { wo, hasLoc: !!clean(wo.install_location), ord: Number.isFinite(ord) ? ord : 10000 + i };\n      })\n      .sort((a, b) => a.ord - b.ord || clean(a.wo.title).localeCompare(clean(b.wo.title)));\n  }, [allWorkOrders, date]);\n\n  const routable = stops.filter((s) => s.hasLoc);\n  const needsLocation = stops.filter((s) => !s.hasLoc);\n\n  const move = async (idx, dir) => {\n    const next = routable.slice();\n    const swap = idx + dir;\n    if (idx < 0 || swap < 0 || swap >= next.length) return;\n    next.splice(swap, 0, next.splice(idx, 1)[0]);\n    setBusy(true);\n    setReorderErr(\"\");\n    try {\n      // Persist sequential stop numbers; only write rows whose order actually changed.\n      const writes = [];\n      next.forEach((s, i) => {\n        const want = i + 1;\n        if (Number(s.wo.install_route_order) !== want) {\n          writes.push(base44.entities.WorkOrder.update(s.wo.id, { install_route_order: want }));\n        }\n      });\n      if (writes.length) await Promise.all(writes);\n      await refetch();\n    } catch (e) {\n      setReorderErr(e?.message || \"Could not save the stop order.\");\n    } finally {\n      setBusy(false);\n    }\n  };\n\n  // Google Maps URL API: destination = last stop, earlier stops become waypoints.\n  // No origin → the crew's current location is the start, which is what install\n  // crews want on the road; the origin field lets dispatchers pin the shop.\n  const mapsUrl = useMemo(() => {\n    const locs = routable.map((s) => clean(s.wo.install_location)).filter(Boolean);\n    if (!locs.length) return \"\";\n    const p = new URLSearchParams({ api: \"1\", destination: locs[locs.length - 1] });\n    if (clean(origin)) p.set(\"origin\", clean(origin));\n    const waypoints = locs.slice(0, -1);\n    if (waypoints.length) p.set(\"waypoints\", waypoints.join(\"|\"));\n    return `https://www.google.com/maps/dir/?${p.toString()}`;\n  }, [routable, origin]);\n\n  const todayKey = dayKey(new Date());\n  const isToday = dayKey(date) === todayKey;\n\n  return (\n    <div className=\"mx-auto max-w-3xl px-4 py-6\">\n      <div className=\"mb-4 flex flex-wrap items-center justify-between gap-3\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <MapPin className=\"h-5 w-5 text-violet-600\" />\n            <h1 className=\"text-2xl font-bold text-slate-900 dark:text-slate-100\">Install Route Map</h1>\n          </div>\n          <p className=\"text-sm text-slate-500 dark:text-slate-400\">\n            Ordered install stops for {isToday ? \"today\" : fmtDay(date)} — send the crew a multi-stop route.\n          </p>\n        </div>\n        <Link\n          to={createPageUrl(\"ProductionSchedule\")}\n          className=\"inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300\"\n        >\n          <CalendarDays className=\"h-3.5 w-3.5\" /> Production Schedule\n        </Link>\n      </div>\n\n      <div className=\"mb-4 flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900\">\n        <button type=\"button\" onClick={() => setDate(new Date(date.getTime() - DAY_MS))}\n          className=\"rounded-lg border border-slate-300 p-2 text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300\" aria-label=\"Previous day\">\n          <ChevronLeft className=\"h-4 w-4\" /></button>\n        <button type=\"button\" onClick={() => setDate(new Date())}\n          className=\"rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300\">\n          Today</button>\n        <button type=\"button\" onClick={() => setDate(new Date(date.getTime() + DAY_MS))}\n          className=\"rounded-lg border border-slate-300 p-2 text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300\" aria-label=\"Next day\">\n          <ChevronRight className=\"h-4 w-4\" /></button>\n        <CcsDateField\n          value={dayKey(date)}\n          onChange={(e) => { const d = parseDay(e.target.value); if (d) setDate(d); }}\n          className=\"min-h-9 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs text-slate-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300\" />\n        <input\n          value={origin}\n          onChange={(e) => setOrigin(e.target.value)}\n          placeholder=\"Route origin (blank = current location)\"\n          aria-label=\"Route origin address\"\n          className=\"min-h-9 min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-xs text-slate-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300\" />\n        <a\n          href={mapsUrl || undefined}\n          target=\"_blank\" rel=\"noreferrer\"\n          aria-disabled={!mapsUrl}\n          className={`inline-flex min-h-9 items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-semibold ${mapsUrl ? \"bg-violet-600 text-white hover:bg-violet-700\" : \"cursor-not-allowed bg-slate-200 text-slate-400 dark:bg-slate-800 dark:text-slate-600\"}`}\n          onClick={(e) => { if (!mapsUrl) e.preventDefault(); }}\n        >\n          <Navigation className=\"h-3.5 w-3.5\" /> Open in Google Maps <ExternalLink className=\"h-3 w-3 opacity-70\" />\n        </a>\n      </div>\n\n      {reorderErr ? (\n        <div className=\"mb-3 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-300\" role=\"alert\">\n          {reorderErr}\n        </div>\n      ) : null}\n\n      {isLoading ? (\n        <div className=\"flex items-center gap-2 text-sm text-slate-500\"><Loader2 className=\"h-4 w-4 animate-spin\" /> Loading work orders…</div>\n      ) : error ? (\n        <div className=\"rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-300\" role=\"alert\">\n          Could not load work orders: {error?.message || \"unknown error\"}\n        </div>\n      ) : stops.length === 0 ? (\n        <div className=\"rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400\">\n          No installs scheduled for {fmtDay(date)}. Set a work order's install date on its job workspace to route it.\n        </div>\n      ) : (\n        <>\n          <ol className=\"space-y-2\">\n            {routable.map((s, i) => (\n              <li key={s.wo.id} className=\"flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-900\">\n                <div className=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-violet-600 text-xs font-bold text-white\">{i + 1}</div>\n                <div className=\"min-w-0 flex-1\">\n                  <div className=\"flex flex-wrap items-center gap-2\">\n                    <span className=\"truncate text-sm font-semibold text-slate-900 dark:text-slate-100\">{s.wo.title || s.wo.work_order_number || \"Untitled job\"}</span>\n                    {clean(s.wo.client_name) ? <span className=\"text-xs text-slate-500 dark:text-slate-400\">{s.wo.client_name}</span> : null}\n                  </div>\n                  <div className=\"mt-0.5 flex items-start gap-1 text-xs text-slate-500 dark:text-slate-400\">\n                    <MapPin className=\"mt-0.5 h-3 w-3 shrink-0\" /><span className=\"break-words\">{s.wo.install_location}</span>\n                  </div>\n                </div>\n                <Link\n                  to={`${createPageUrl(\"JobWorkspace\")}?wo=${encodeURIComponent(s.wo.id)}`}\n                  className=\"shrink-0 rounded-lg border border-slate-300 px-2 py-1.5 text-[11px] font-semibold text-slate-600 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-300\"\n                >Job</Link>\n                <div className=\"flex shrink-0 flex-col\">\n                  <button type=\"button\" disabled={busy || i === 0} onClick={() => move(i, -1)} aria-label={`Move ${s.wo.title || \"stop\"} earlier`}\n                    className=\"rounded p-1 text-slate-500 hover:bg-slate-100 disabled:opacity-30 dark:hover:bg-slate-800\"><ArrowUp className=\"h-4 w-4\" /></button>\n                  <button type=\"button\" disabled={busy || i === routable.length - 1} onClick={() => move(i, 1)} aria-label={`Move ${s.wo.title || \"stop\"} later`}\n                    className=\"rounded p-1 text-slate-500 hover:bg-slate-100 disabled:opacity-30 dark:hover:bg-slate-800\"><ArrowDown className=\"h-4 w-4\" /></button>\n                </div>\n              </li>\n            ))}\n          </ol>\n\n          {needsLocation.length ? (\n            <div className=\"mt-6\">\n              <div className=\"mb-2 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-amber-600 dark:text-amber-400\">\n                <AlertTriangle className=\"h-3.5 w-3.5\" /> Needs install location ({needsLocation.length})\n              </div>\n              <ul className=\"space-y-2\">\n                {needsLocation.map((s) => (\n                  <li key={s.wo.id} className=\"flex items-center gap-3 rounded-xl border border-dashed border-amber-300 bg-amber-50/50 p-3 dark:border-amber-800 dark:bg-amber-950/20\">\n                    <div className=\"min-w-0 flex-1\">\n                      <span className=\"truncate text-sm font-semibold text-slate-900 dark:text-slate-100\">{s.wo.title || s.wo.work_order_number || \"Untitled job\"}</span>\n                      {clean(s.wo.client_name) ? <span className=\"ml-2 text-xs text-slate-500 dark:text-slate-400\">{s.wo.client_name}</span> : null}\n                    </div>\n                    <Link\n                      to={`${createPageUrl(\"JobWorkspace\")}?wo=${encodeURIComponent(s.wo.id)}`}\n                      className=\"shrink-0 rounded-lg border border-amber-300 px-2 py-1.5 text-[11px] font-semibold text-amber-700 hover:bg-amber-100 dark:border-amber-700 dark:text-amber-300\"\n                    >Add location</Link>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ) : null}\n        </>\n      )}\n    </div>\n  );\n}",
      "startLine": 1,
      "endLine": 220,
      "totalLines": 220,
      "truncated": false
    }
  ]
}
