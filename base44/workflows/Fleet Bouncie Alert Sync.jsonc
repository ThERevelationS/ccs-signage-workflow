{
  "name": "Fleet Bouncie Alert Sync",
  "description": "Evaluates CCS-local Fleet alert thresholds from Bouncie vehicle stats every 5 minutes. Uses durable per-vehicle runtime state so persistent threshold breaches do not create repeated alerts. Does not modify Bouncie-owned settings or webhooks.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fleet_bouncie_alert_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_fleet_bouncie_alerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "bouncieSyncNotifications",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}