{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smartsheet_scheduled_order_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_order_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "smartsheetSyncAction",
            "args": {
              "action": "run_order_sync",
              "_workflow_capability": "PkqkW1Iclz6ucp1fDEYC3Vxx-rxRGl6gFDbm5wiPLyr0VvCk40iucbbdS1fXHsSV"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run scheduled Order Form sync",
            "description": "Runs the configured Order Form pull/push directions on its own coordinator. Push writes only Orders durably marked for sync; Save & Sync remains available for immediate explicit writes."
          }
        }
      }
    ]
  },
  "name": "Smartsheet Scheduled Order Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "8,23,38,53 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Runs every 15 minutes server-side, offset 8 minutes after the Sales Pipeline sync so the two pipelines do not compete for the Smartsheet read budget. Order Form follows its enabled pull/push directions: pull may create Base44 Orders from new verified Smartsheet rows; push writes only Orders durably marked for sync and may create a linked Smartsheet row for a new pending Order when creation is enabled. Save & Sync remains available for immediate explicit writes. Only runs when global sync is enabled and observation mode is off."
}