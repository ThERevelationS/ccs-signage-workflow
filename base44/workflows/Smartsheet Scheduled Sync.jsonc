{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smartsheet_scheduled_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "smartsheetSyncAction",
            "args": {
              "action": "run_sync"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run Smartsheet bidirectional sync",
            "description": "Pulls Smartsheet \u2192 Base44 and pushes Base44 \u2192 Smartsheet for both Sales Pipeline and Order Form datasets."
          }
        }
      }
    ]
  },
  "name": "Smartsheet Scheduled Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Automatically syncs Base44 \u2194 Smartsheet every 15 minutes, both directions (push and pull) for Sales Pipeline and Order Form. Runs server-side \u2014 continues even when no one has the app open. Only runs when global sync is enabled and observation mode is off."
}