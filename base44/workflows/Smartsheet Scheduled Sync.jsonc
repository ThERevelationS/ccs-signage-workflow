{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smartsheet_scheduled_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "smartsheetSyncAction",
            "args": {
              "action": "run_sync",
              "_workflow_capability": "PkqkW1Iclz6ucp1fDEYC3Vxx-rxRGl6gFDbm5wiPLyr0VvCk40iucbbdS1fXHsSV"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run scheduled Smartsheet sync",
            "description": "Runs configured Sales Pipeline pull/push directions and Order Form pull only. Order Form background push is locked OFF; use explicit Save & Sync for Base44 \u2192 Smartsheet Order writes."
          }
        }
      }
    ]
  },
  "name": "Smartsheet Scheduled Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Runs every 15 minutes server-side. Sales Pipeline follows its enabled pull/push directions. Order Form can pull automatically when enabled, but background push and automatic record creation are locked OFF; Order writes use explicit Save & Sync. Only runs when global sync is enabled and observation mode is off."
}