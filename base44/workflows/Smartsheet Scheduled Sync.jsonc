{
  "name": "Smartsheet Scheduled Sales Sync",
  "description": "Runs every 15 minutes server-side. Sales Pipeline follows its enabled pull/push directions and reports to its own smartsheetSalesSyncStatus coordinator. Order Form sync runs separately on its own schedule. Only runs when global sync is enabled and observation mode is off.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "29 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "smartsheet_scheduled_sales_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_sales_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "smartsheetSyncAction",
            "args": {
              "action": "run_sales_sync",
              "_workflow_capability": "${secret:WORKFLOW_CAPABILITY_SMARTSHEET_SYNC_ACTION}"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run scheduled Sales Pipeline sync",
            "description": "Runs configured Sales Pipeline pull/push directions only, on its own coordinator. The Order Form sync runs on a separate schedule and status record."
          }
        }
      }
    ]
  }
}