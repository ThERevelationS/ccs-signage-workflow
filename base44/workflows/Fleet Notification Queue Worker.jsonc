{
  "name": "Fleet Notification Queue Worker",
  "description": "Processes due Fleet email notifications every 10 minutes. Safe before cutover because FleetSettings.notifications_enabled defaults to false.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fleet_notification_queue_worker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_worker": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fleetNotificationWorker",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}