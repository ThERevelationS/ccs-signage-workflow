{
  "name": "MarkupCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Stable key used by MarkupTier.markups and the categorization library."
    },
    "category_name": {
      "type": "string",
      "description": "Display label, e.g. 'Outsourced Fabrication and Sign Components'."
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "category_key",
    "category_name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "__markupcategory_backend_only__" } },
    "read": { "user_condition": { "role": "__markupcategory_backend_only__" } },
    "update": { "user_condition": { "role": "__markupcategory_backend_only__" } },
    "delete": { "user_condition": { "role": "__markupcategory_backend_only__" } }
  }
}