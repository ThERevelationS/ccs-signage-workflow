{
  "name": "MarkupCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Stable key used by MarkupTier.markups and the categorization library."
    },
    "category_name": {
      "type": "string",
      "description": "Display label, e.g. 'Outsourced Fabrication and Sign Components'."
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "volume_discount_eligible": {
      "type": "boolean",
      "description": "When false, this category is excluded from volume discounts even if listed in the global eligible-keys setting."
    },
    "gl_code": {
      "type": "string",
      "description": "General ledger income account code this category posts to on accounting export (CoreBridge-style Manage Accounts mapping)."
    },
    "gl_parent": {
      "type": "string",
      "description": "Optional parent GL account code/grouping for rollup reporting."
    },
    "gl_active": {
      "type": "boolean",
      "default": true,
      "description": "When false, this category's GL mapping is inactive and exports should flag its lines for review."
    }
  },
  "required": [
    "category_key",
    "category_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}