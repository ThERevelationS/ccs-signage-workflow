{
  "name": "MarkupCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Stable key used by MarkupTier.markups and the categorization library."
    },
    "category_name": {
      "type": "string",
      "description": "Display label, e.g. 'Outsourced Fabrication and Sign Components'."
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "category_key",
    "category_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}