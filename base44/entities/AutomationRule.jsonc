{
  "name": "AutomationRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the automation rule"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending"
      ],
      "default": "approved",
      "description": "Pending rules are proposed but never run until an admin approves them."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this automation is active"
    },
    "triggers": {
      "type": "array",
      "description": "Array of trigger conditions",
      "items": {
        "type": "object",
        "properties": {
          "trigger_type": {
            "type": "string"
          },
          "trigger_condition": {
            "type": "object"
          },
          "logic": {
            "type": "string",
            "enum": [
              "or",
              "and"
            ],
            "default": "or",
            "description": "How this trigger relates to the previous one"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "Array of actions to perform (all executed)",
      "items": {
        "type": "object",
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "send_email",
              "change_stage",
              "set_asap",
              "assign_to",
              "add_task",
              "add_note",
              "set_due_date",
              "set_priority",
              "create_rider",
              "mark_complete"
            ]
          },
          "action_config": {
            "type": "object"
          }
        }
      }
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Order of execution"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this rule fired (stamped by the trigger engine)"
    },
    "last_run_status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "error"
      ],
      "description": "Outcome of the last run"
    },
    "last_run_detail": {
      "type": "string",
      "description": "Per-action outcome summary of the last run"
    },
    "run_count": {
      "type": "number",
      "default": 0,
      "description": "Total times this rule has fired"
    },
    "recent_runs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Last 20 executions: { at, status, detail, actions[] }"
    },
    "owner": {
      "type": "string",
      "description": "Team member responsible for maintaining this rule"
    },
    "group": {
      "type": "string",
      "description": "Optional folder/group label for organizing rules"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Last 10 saved versions: { at, snapshot: {name,triggers,actions,enabled,priority} }"
    }
  },
  "required": [
    "name",
    "triggers",
    "actions"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    }
  }
}