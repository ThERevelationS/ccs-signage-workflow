{
  "name": "JurisdictionProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the county or locality"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation (e.g. KY, OH)"
    },
    "type": {
      "type": "string",
      "enum": [
        "county",
        "city",
        "township",
        "municipality"
      ],
      "default": "county"
    },
    "website_url": {
      "type": "string",
      "description": "Official government website"
    },
    "permitting_url": {
      "type": "string",
      "description": "Direct link to permitting/zoning page"
    },
    "cagis_database_url": {
      "type": "string",
      "description": "Property/parcel lookup database URL (CAGIS or equivalent)"
    },
    "notes": {
      "type": "string",
      "description": "Manual notes about this jurisdiction"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of sign permit requirements"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "auto_refresh": {
      "type": "boolean",
      "default": true
    },
    "activity_log": {
      "type": "array",
      "description": "History of changes to this jurisdiction profile",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "ai_refresh",
              "manual_edit",
              "document_added",
              "document_removed",
              "created"
            ]
          },
          "description": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "object"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "Permitting documents for this jurisdiction",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "doc_type": {
            "type": "string",
            "enum": [
              "sign_ordinance",
              "permit_application",
              "zoning_code",
              "fee_schedule",
              "checklist",
              "other"
            ]
          },
          "extracted_text": {
            "type": "string"
          },
          "ai_summary": {
            "type": "string"
          },
          "last_fetched": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "ai_discovered"
            ]
          }
        }
      }
    },
    "contact_info": {
      "type": "object",
      "properties": {
        "department": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "permit_requirements": {
      "type": "object",
      "description": "Structured permit requirements extracted by AI",
      "properties": {
        "requires_permit": {
          "type": "boolean"
        },
        "max_sign_area_sqft": {
          "type": "number"
        },
        "max_height_ft": {
          "type": "number"
        },
        "setback_requirements": {
          "type": "string"
        },
        "illumination_allowed": {
          "type": "boolean"
        },
        "electronic_signs_allowed": {
          "type": "boolean"
        },
        "fee_range": {
          "type": "string"
        },
        "processing_time": {
          "type": "string"
        }
      }
    },
    "sqft_width_height_rules": {
      "type": "string",
      "description": "Detailed SQFT/Width/Height allowance rules"
    },
    "height_allowances": {
      "type": "string",
      "description": "Height allowances and rules"
    },
    "setback_rules": {
      "type": "string",
      "description": "Setback requirements and rules"
    },
    "lighting_allowances": {
      "type": "string",
      "description": "Lighting allowances and restrictions"
    },
    "parent_county": {
      "type": "object",
      "description": "Parent county information for non-county jurisdictions",
      "properties": {
        "name": {
          "type": "string"
        },
        "website_url": {
          "type": "string"
        },
        "permitting_url": {
          "type": "string"
        },
        "contact_info": {
          "type": "object"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "_manual_website_url": {
      "type": "boolean",
      "description": "Flag: website_url was manually edited"
    },
    "_manual_permitting_url": {
      "type": "boolean",
      "description": "Flag: permitting_url was manually edited"
    },
    "_manual_requirements": {
      "type": "boolean",
      "description": "Flag: permit requirements were manually edited"
    },
    "_manual_documents": {
      "type": "boolean",
      "description": "Flag: documents were manually edited"
    }
  },
  "required": [
    "name",
    "state"
  ]
}