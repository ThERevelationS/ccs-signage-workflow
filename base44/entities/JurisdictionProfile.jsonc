{
  "name": "JurisdictionProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the county or locality"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation (e.g. KY, OH)"
    },
    "type": {
      "type": "string",
      "enum": [
        "county",
        "city",
        "village",
        "township",
        "municipality"
      ],
      "default": "county"
    },
    "html_evidence_state": {
      "type": "object",
      "additionalProperties": true,
      "description": "Durable manual HTML evidence reservation/receipt. Unknown creates reconcile the same source hash without repeating creation. Does not modify documents, reviewed authority or automated queue accounting."
    },
    "office_research": {
      "type": "object",
      "additionalProperties": true,
      "description": "Unverified role-by-role office and electrical research findings. No canonical office assignment, authority approval or client/job change is implied."
    },
    "office_authority_review_state": {
      "type": "object",
      "additionalProperties": true,
      "description": "Durable reservation and committed sequence for immutable PermittingOfficeAuthorityReview events. Creating/uncertain reservations reconcile only by the same saved request; no blind repeated create. Office identity/role/scope never resolves an address automatically."
    },
    "website_url": {
      "type": "string",
      "description": "Official government website"
    },
    "permitting_url": {
      "type": "string",
      "description": "Direct link to permitting/zoning page"
    },
    "cagis_database_url": {
      "type": "string",
      "description": "Property/parcel lookup database URL (CAGIS or equivalent)"
    },
    "fips_code": {
      "type": "string",
      "description": "Federal FIPS place/county code \u2014 machine-verifiable identity, not just a name."
    },
    "ordinance_citation": {
      "type": "string",
      "description": "The governing code section \u2014 'Milford Codified \u00a7153.042' \u2014 as structured data, not buried in notes."
    },
    "required_documents": {
      "type": "string",
      "description": "The office's own required-fields/documents list \u2014 'drawings, site plan, contractor license' \u2014 stored verbatim so staff know what the application needs."
    },
    "notes": {
      "type": "string",
      "description": "Manual notes about this jurisdiction"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of sign permit requirements"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "auto_refresh": {
      "type": "boolean",
      "default": true
    },
    "activity_log": {
      "type": "array",
      "description": "History of changes to this jurisdiction profile",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "ai_refresh",
              "manual_edit",
              "document_added",
              "document_removed",
              "created"
            ]
          },
          "description": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "object"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "Permitting documents for this jurisdiction",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "doc_type": {
            "type": "string",
            "enum": [
              "sign_ordinance",
              "permit_application",
              "zoning_code",
              "fee_schedule",
              "checklist",
              "other"
            ]
          },
          "extracted_text": {
            "type": "string"
          },
          "ai_summary": {
            "type": "string"
          },
          "last_fetched": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "ai_discovered",
              "official_page_harvest"
            ]
          },
          "catalog_state": {
            "type": "object",
            "additionalProperties": true,
            "description": "Durable evidence-catalog registration receipt. creating/create_uncertain may only reconcile an existing catalog row; never repeat creation blindly."
          },
          "archive_state": {
            "type": "object",
            "additionalProperties": true,
            "description": "Durable archival receipt and lease. uploading/upload_uncertain must never auto-retry; uploaded resumes readback of the same file. No regulatory authority is implied."
          },
          "address_research_review": {
            "type": "object",
            "additionalProperties": true,
            "description": "Administrator-reviewed immutable original snapshot link; not rule or office authority approval."
          },
          "archive_pinned": {
            "type": "boolean",
            "description": "Prevents automatic archival changes to this document."
          },
          "source_sha256": {
            "type": "string"
          },
          "source_bytes": {
            "type": "integer"
          },
          "stored_sha256": {
            "type": "string"
          },
          "stored_bytes": {
            "type": "integer"
          },
          "downloaded_at": {
            "type": "string",
            "format": "date-time"
          },
          "external_referral_provenance": {
            "type": "object",
            "additionalProperties": true,
            "description": "Exact official-page external document referral and collection recheck; authority and applicability remain unapproved."
          },
          "resource_classification": {
            "type": "object",
            "additionalProperties": true,
            "description": "Deterministic MIME/signature routing hint bound to source_url. Not an archive, currentness, applicability or authority approval."
          }
        }
      }
    },
    "contact_info": {
      "type": "object",
      "properties": {
        "department": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      }
    },
    "permit_requirements": {
      "type": "object",
      "description": "Structured permit requirements extracted by AI",
      "properties": {
        "requires_permit": {
          "type": "boolean"
        },
        "max_sign_area_sqft": {
          "type": "number"
        },
        "max_height_ft": {
          "type": "number"
        },
        "setback_requirements": {
          "type": "string"
        },
        "illumination_allowed": {
          "type": "boolean"
        },
        "electronic_signs_allowed": {
          "type": "boolean"
        },
        "fee_range": {
          "type": "string"
        },
        "processing_time": {
          "type": "string"
        }
      }
    },
    "sqft_width_height_rules": {
      "type": "string",
      "description": "Detailed SQFT/Width/Height allowance rules"
    },
    "height_allowances": {
      "type": "string",
      "description": "Height allowances and rules"
    },
    "setback_rules": {
      "type": "string",
      "description": "Setback requirements and rules"
    },
    "lighting_allowances": {
      "type": "string",
      "description": "Lighting allowances and restrictions"
    },
    "parent_county": {
      "type": "object",
      "description": "Parent county information for non-county jurisdictions",
      "properties": {
        "name": {
          "type": "string"
        },
        "website_url": {
          "type": "string"
        },
        "permitting_url": {
          "type": "string"
        },
        "contact_info": {
          "type": "object"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "_manual_website_url": {
      "type": "boolean",
      "description": "Flag: website_url was manually edited"
    },
    "_manual_permitting_url": {
      "type": "boolean",
      "description": "Flag: permitting_url was manually edited"
    },
    "_manual_requirements": {
      "type": "boolean",
      "description": "Flag: permit requirements were manually edited"
    },
    "_manual_documents": {
      "type": "boolean",
      "description": "Flag: documents were manually edited"
    },
    "rewrite_authority": {
      "type": "object",
      "description": "Jurisdiction-specific authority evidence for a comprehensive zoning/sign-regulation rewrite. Permitting Intelligence must retain currently adopted authority unless adoption and effective-date/applicability are both independently verified for this same jurisdiction.",
      "properties": {
        "jurisdiction_id": {
          "type": "string",
          "description": "Canonical JurisdictionProfile record ID this authority evidence applies to. When present it must match this record before rewrite promotion."
        },
        "jurisdiction_name": {
          "type": "string",
          "description": "Jurisdiction name recorded with the authority evidence for review and name-based matching when no canonical ID is available."
        },
        "adoptionStatus": {
          "type": "string",
          "enum": [
            "not_verified",
            "verified"
          ],
          "default": "not_verified",
          "description": "Verified only after reviewed official legislative adoption evidence for this jurisdiction."
        },
        "adoption_evidence_url": {
          "type": "string",
          "description": "Official legislative adoption record URL, such as an enacted ordinance or approved action record."
        },
        "adoption_evidence_reference": {
          "type": "string",
          "description": "Ordinance number, resolution number, meeting action, or other stable adoption reference."
        },
        "adoption_verified_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the adoption evidence was reviewed and verified."
        },
        "adoption_verified_by": {
          "type": "string",
          "description": "Admin reviewer who verified the legislative adoption evidence."
        },
        "effectiveDateStatus": {
          "type": "string",
          "enum": [
            "not_verified",
            "verified"
          ],
          "default": "not_verified",
          "description": "Verified only after reviewed official evidence establishes the rewrite's effective date or present applicability for this jurisdiction."
        },
        "effective_date": {
          "type": "string",
          "description": "Officially established effective date when known. The status must remain not_verified if applicability/effectiveness is unresolved."
        },
        "effective_date_evidence_url": {
          "type": "string",
          "description": "Official source establishing the effective date or current applicability."
        },
        "effective_date_verified_at": {
          "type": "string",
          "format": "date-time",
          "description": "When effective-date/applicability evidence was reviewed and verified."
        },
        "effective_date_verified_by": {
          "type": "string",
          "description": "Admin reviewer who verified the effective-date/applicability evidence."
        },
        "verification_notes": {
          "type": "string",
          "description": "Authority-review notes and jurisdiction-specific caveats. Drafts, agendas, recommendations, placeholders, and narrow amendments must not be treated as comprehensive rewrite adoption."
        }
      },
      "required": [
        "adoptionStatus",
        "effectiveDateStatus"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "needs_verification",
        "verified",
        "historical"
      ],
      "description": "Human review status. Verified means staff confirmed the record against official/current sources; historical means retain as reference but re-verify before use."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When staff last marked this jurisdiction verified against official/current sources."
    },
    "verified_by": {
      "type": "string",
      "description": "Employee who last verified this jurisdiction."
    },
    "verification_notes": {
      "type": "string",
      "description": "Optional staff notes describing verification scope, source, or caveats."
    },
    "discovery_scan_state": {
      "type": "object",
      "additionalProperties": true,
      "description": "URL-bound deterministic discovery frontier. Pending pages, visited URLs and unresolved gaps commit atomically with retained documents using profile version guards. No authority or locality completeness is implied."
    }
  },
  "required": [
    "name",
    "state"
  ]
}