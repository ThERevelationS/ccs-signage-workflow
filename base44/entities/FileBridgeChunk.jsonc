{
  "name": "FileBridgeChunk",
  "type": "object",
  "description": "In-flight chunk reassembly for >48MB deliveries. Rows expire quickly \u2014 TTL-swept.",
  "properties": {
    "schema_version": {
      "type": "number",
      "default": 1
    },
    "command_id": {
      "type": "string"
    },
    "seq": {
      "type": "number"
    },
    "file_url": {
      "type": "string"
    },
    "data_b64": {
      "type": "string",
      "description": "Inline chunk bytes (base64) \u2014 replaces UploadFile blob staging; assembly reads this first, falls back to legacy file_url rows."
    },
    "bytes": {
      "type": "number"
    },
    "sha256": {
      "type": "string"
    },
    "received_at": {
      "type": "number"
    }
  },
  "required": [
    "command_id",
    "seq"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__filebridge_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__filebridge_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__filebridge_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__filebridge_backend_only__"
      }
    }
  }
}