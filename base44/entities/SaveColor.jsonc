{
  "name": "SaveColor",
  "type": "object",
  "description": "A user-saved color swatch reused across estimator modules.",
  "properties": {
    "color_hex": {
      "type": "string",
      "description": "Hex color code, e.g. #ef4444"
    },
    "color_name": {
      "type": "string",
      "description": "Friendly name of the color"
    }
  },
  "required": [
    "color_hex"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}