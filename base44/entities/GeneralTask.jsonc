{
  "type": "object",
  "name": "GeneralTask",
  "description": "General office task not tied to a client or work order. Mirrors the task object shape used inside WorkOrder.notes so it can be assigned and tracked the same way. When `stage` is set, the task also appears on the matching workflow stage page (Estimating, Design, etc.).",
  "properties": {
    "text": {
      "type": "string",
      "description": "Task description"
    },
    "stage": {
      "type": "string",
      "description": "Workflow stage this task is assigned to, so it surfaces on that workflow page. Empty means a general office task not tied to a stage page.",
      "enum": [
        "estimating",
        "sales",
        "permitting",
        "design",
        "production",
        "fabrication",
        "installation"
      ]
    },
    "assigned_to": {
      "type": "array",
      "description": "Users assigned to this task (full_name or email, matching WorkOrder task assignment convention).",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "sub_tasks": {
      "type": "array",
      "description": "Sub-tasks under this task, same structure as WorkOrder note sub_tasks.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "assigned_to": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            }
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "completed": {
                  "type": "boolean",
                  "default": false
                },
                "assigned_to": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "description": "Task is blocked and cannot proceed until unblocked"
    },
    "blocked_reason": {
      "type": "string",
      "description": "Why the task is blocked"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "created_by_name": {
      "type": "string",
      "description": "Display name of the user who created the task"
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__generaltask_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__generaltask_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__generaltask_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__generaltask_backend_only__"
      }
    }
  }
}