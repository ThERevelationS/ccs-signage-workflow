{
  "name": "TimeClockEmployeePreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Employee email these Time Clock preferences belong to"
    },
    "user_name": {
      "type": "string",
      "description": "Employee display name snapshot"
    },
    "tracker_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Show the Time Tracker pill in the app navigation bars"
    },
    "daily_goal_minutes": {
      "type": "number",
      "default": 480,
      "description": "Daily paid-time goal in minutes (default 8 hours)"
    },
    "weekly_goal_minutes": {
      "type": "number",
      "default": 2400,
      "description": "Weekly paid-time goal in minutes (default 40 hours)"
    },
    "show_week_strip": {
      "type": "boolean",
      "default": true,
      "description": "Show the Mon-Sun weekly progress strip in the tracker popover"
    },
    "display_style": {
      "type": "string",
      "enum": [
        "ring",
        "bar",
        "minimal",
        "flip"
      ],
      "default": "ring"
    },
    "count_mode": {
      "type": "string",
      "enum": [
        "paid",
        "elapsed"
      ],
      "default": "paid",
      "description": "paid = worked time only; elapsed = wall-clock since Clock In"
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ],
      "default": "up",
      "description": "up = count up elapsed; down = count down remaining to goal"
    },
    "milestones_mode": {
      "type": "string",
      "enum": [
        "off",
        "goal",
        "custom"
      ],
      "default": "goal"
    },
    "milestone_behavior": {
      "type": "string",
      "enum": [
        "silent",
        "pulse",
        "toast",
        "toast_sound"
      ],
      "default": "pulse"
    },
    "milestone_thresholds": {
      "type": "array",
      "description": "Custom milestone thresholds as fractions of the daily goal (0-1.5)",
      "items": {
        "type": "number"
      }
    },
    "overtime_warning": {
      "type": "boolean",
      "default": false,
      "description": "Fire a milestone alert when paid time passes the daily goal"
    },
    "milestone_sound": {
      "type": "string",
      "enum": [
        "chime",
        "bell",
        "ding",
        "fanfare",
        "alert"
      ],
      "default": "chime"
    },
    "show_overtime": {
      "type": "boolean",
      "default": true,
      "description": "Show +M:MM OT counter once past the daily goal"
    },
    "show_projected_finish": {
      "type": "boolean",
      "default": true
    },
    "show_pace": {
      "type": "boolean",
      "default": true
    },
    "accent_color": {
      "type": "string",
      "enum": [
        "indigo",
        "emerald",
        "amber",
        "violet",
        "rose",
        "sky"
      ],
      "default": "indigo"
    },
    "privacy_blur": {
      "type": "boolean",
      "default": false,
      "description": "Blur tracker values until the control is hovered or focused"
    },
    "size": {
      "type": "string",
      "enum": [
        "compact",
        "expanded"
      ],
      "default": "compact"
    },
    "location": {
      "type": "string",
      "enum": [
        "both",
        "top",
        "side",
        "hidden"
      ],
      "default": "both",
      "description": "Which navigation bars render the tracker pill"
    },
    "scale": {
      "type": "number",
      "default": 1,
      "description": "Render scale of the tracker pill (0.8-1.3)"
    },
    "opacity": {
      "type": "number",
      "default": 1,
      "description": "Pill opacity (0.4-1)"
    },
    "font": {
      "type": "string",
      "enum": [
        "default",
        "mono",
        "rounded",
        "serif"
      ],
      "default": "default"
    },
    "background_style": {
      "type": "string",
      "enum": [
        "glass",
        "solid",
        "minimal"
      ],
      "default": "glass"
    },
    "update_interval_seconds": {
      "type": "number",
      "default": 60,
      "description": "Authoritative snapshot refresh interval (15-300 seconds)"
    },
    "animation_style": {
      "type": "string",
      "enum": [
        "smooth",
        "pulse",
        "none"
      ],
      "default": "smooth"
    },
    "time_format": {
      "type": "string",
      "enum": [
        "hh_mm_ss",
        "hours_minutes",
        "decimal"
      ],
      "default": "hh_mm_ss",
      "description": "hh_mm_ss = 7:42:18, hours_minutes = 7h 42m, decimal = 7.71h"
    },
    "hide_when_idle_minutes": {
      "type": "number",
      "default": 0,
      "description": "Hide the tracker after this many minutes of mouse/keyboard inactivity (0 = never hide)"
    },
    "daily_goal_overrides": {
      "type": "object",
      "description": "Optional per-day-of-week goal overrides in minutes, keyed sun-sat; missing days use daily_goal_minutes",
      "properties": {
        "sun": {
          "type": "number"
        },
        "mon": {
          "type": "number"
        },
        "tue": {
          "type": "number"
        },
        "wed": {
          "type": "number"
        },
        "thu": {
          "type": "number"
        },
        "fri": {
          "type": "number"
        },
        "sat": {
          "type": "number"
        }
      }
    },
    "low_data_mode": {
      "type": "boolean",
      "default": false,
      "description": "Reduce polling frequency and skip secondary fetches on metered connections"
    },
    "last_request_id": {
      "type": "string",
      "description": "Idempotency request id of the most recent preference update"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    }
  }
}