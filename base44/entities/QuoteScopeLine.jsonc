{
  "name": "QuoteScopeLine",
  "type": "object",
  "description": "Reusable library line for the customer quote's scope lists. kind = 'inclusion' (Included in this estimate) or 'exclusion' (Not included). Selected from the Scope dropdowns in Quote Settings. When always_include is true the line is auto-added to every quote; when auto_modules lists estimator module keys, the line is auto-added as soon as a section of that module exists on the estimate.",
  "properties": {
    "text": {
      "type": "string",
      "description": "The scope line exactly as it prints on the quote."
    },
    "kind": {
      "type": "string",
      "enum": [
        "inclusion",
        "exclusion"
      ],
      "default": "inclusion"
    },
    "category": {
      "type": "string",
      "description": "Grouping label shown in the scope dropdown (e.g. Fabrication, Install, Permits, Electrical, Warranty)."
    },
    "always_include": {
      "type": "boolean",
      "default": false,
      "description": "Auto-added to every quote regardless of which products are on the estimate."
    },
    "auto_modules": {
      "type": "array",
      "description": "Estimator module keys that trigger this line automatically when a section of that module is added.",
      "items": {
        "type": "string"
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "text",
    "kind"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}