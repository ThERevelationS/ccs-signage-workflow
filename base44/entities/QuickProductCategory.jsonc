{
  "name": "QuickProductCategory",
  "type": "object",
  "description": "Category (or subcategory) used to organize Quick Products. Categories belong to a product group ('my' = this user's products, 'global' = shared). A category with parent_category set is a subcategory of that category name.",
  "properties": {
    "category_name": {
      "type": "string"
    },
    "product_group": {
      "type": "string",
      "enum": [
        "my",
        "global"
      ],
      "default": "my"
    },
    "parent_category": {
      "type": "string",
      "description": "Name of the parent category when this is a subcategory. Empty for top-level categories."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "category_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {}
  }
}