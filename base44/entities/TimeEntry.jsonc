{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the employee"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the employee"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time",
      "description": "Official clock-in timestamp"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time",
      "description": "Official clock-out timestamp"
    },
    "clock_in_request_id": {
      "type": "string",
      "description": "Idempotency request id for the confirmed clock-in"
    },
    "clock_out_request_id": {
      "type": "string",
      "description": "Idempotency request id for the confirmed clock-out"
    },
    "payroll_hold": {
      "type": "boolean",
      "default": false,
      "description": "Contested-entry flag set by managers; blocks payroll inclusion until cleared"
    },
    "payroll_hold_reason": {
      "type": "string",
      "description": "Why the entry is on hold"
    },
    "clock_in_geo": {
      "type": "object",
      "description": "Kiosk device geolocation captured at clock-in (lat/lng/accuracy in meters)",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        }
      }
    },
    "clock_out_geo": {
      "type": "object",
      "description": "Kiosk device geolocation captured at clock-out",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        }
      }
    },
    "clock_source": {
      "type": "string",
      "enum": [
        "server",
        "legacy_client",
        "admin_correction",
        "employee_attested_missed_clock_in"
      ],
      "description": "Authority/source used for punch timestamps"
    },
    "lunch_minutes": {
      "type": "number",
      "default": 0,
      "description": "Lunch break duration in minutes"
    },
    "total_hours": {
      "type": "number",
      "description": "Total hours worked (minus lunch)"
    },
    "status": {
      "type": "string",
      "enum": [
        "clocked_in",
        "clocked_out",
        "needs_resolution"
      ],
      "default": "clocked_in",
      "description": "Current status"
    },
    "job_allocations": {
      "type": "array",
      "description": "Time allocated to each job",
      "items": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "string"
          },
          "work_order_title": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "minutes": {
            "type": "number"
          },
          "is_inhouse": {
            "type": "boolean",
            "default": false
          },
          "inhouse_task": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "last_notes_request_id": {
      "type": "string",
      "description": "Idempotency request id for the most recent authoritative notes update"
    },
    "last_notes_payload_hash": {
      "type": "string",
      "description": "SHA-256 fingerprint binding the most recent notes update request to its TimeEntry version and note text"
    },
    "last_notes_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp of the most recent authoritative notes update"
    },
    "last_notes_updated_by": {
      "type": "string",
      "description": "Signed-in employee email that performed the most recent authoritative notes update"
    },
    "archived_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Pre-production Time Clock test record excluded from live timekeeping"
    },
    "archived_admin": {
      "type": "boolean",
      "default": false,
      "description": "Administrative archival flag; archived records remain preserved but are excluded from normal timekeeping"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this TimeEntry was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "Administrator email that archived this TimeEntry"
    },
    "archive_reason": {
      "type": "string",
      "description": "Required reason for administrative archival"
    },
    "last_corrected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp of the latest administrator correction"
    },
    "last_corrected_by": {
      "type": "string",
      "description": "Administrator email that made the latest correction"
    },
    "last_correction_reason": {
      "type": "string",
      "description": "Required reason for the latest administrator correction"
    },
    "last_correction_request_id": {
      "type": "string",
      "description": "Correction request record that most recently changed this TimeEntry"
    },
    "break_tracking_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether this shift used authoritative tracked break records"
    },
    "tracked_break_minutes": {
      "type": "number",
      "default": 0,
      "description": "Total completed tracked break minutes"
    },
    "tracked_paid_break_minutes": {
      "type": "number",
      "default": 0,
      "description": "Completed tracked paid break minutes"
    },
    "tracked_unpaid_break_minutes": {
      "type": "number",
      "default": 0,
      "description": "Completed tracked unpaid break minutes deducted from worked time"
    },
    "work_pause_tracking_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether this shift used authoritative Work Pause records"
    },
    "tracked_work_pause_minutes": {
      "type": "number",
      "default": 0,
      "description": "Completed Work Pause minutes excluded from actual worked time"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "approved",
        "needs_review"
      ],
      "default": "unreviewed",
      "description": "Manager review state for this completed shift; does not itself mean payroll-finalized"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp of the latest approval"
    },
    "approved_by": {
      "type": "string",
      "description": "Administrator email that approved this completed shift"
    },
    "approval_note": {
      "type": "string",
      "description": "Optional manager note stored with approval"
    },
    "approval_request_id": {
      "type": "string",
      "description": "Idempotency key for the latest manager approval action"
    },
    "correction_needs_review_request_id": {
      "type": "string",
      "description": "Employee correction submission request that most recently returned an approved shift to Needs Review"
    },
    "correction_needs_review_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp of the latest correction-triggered Needs Review transition"
    },
    "pay_period_id": {
      "type": "string",
      "description": "Finalized TimeClockPayPeriod that locked this TimeEntry"
    },
    "pay_period_locked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp when this TimeEntry was locked by pay-period finalization"
    },
    "pay_period_locked_by": {
      "type": "string",
      "description": "Administrator that finalized the pay period containing this TimeEntry"
    },
    "punch_exception_id": {
      "type": "string",
      "description": "Open or most recent TimeClockPunchException associated with this shift"
    },
    "missed_clock_in_reported_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp when an employee reported a missing Clock In and supplied the reconstructed start"
    },
    "punch_resolution_pending_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp when an old active shift was detached for missed-punch manager review"
    },
    "punch_resolution_request_id": {
      "type": "string",
      "description": "Employee request id that moved this shift into Needs Punch Resolution"
    },
    "stale_shift_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend time when the employee affirmed they were still continuously working"
    },
    "stale_shift_acknowledged_request_id": {
      "type": "string",
      "description": "Idempotency request id for the latest worked-through acknowledgement"
    }
  },
  "required": [
    "user_email",
    "clock_in"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    }
  }
}