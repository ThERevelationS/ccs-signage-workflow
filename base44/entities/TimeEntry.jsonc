{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the employee"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the employee"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time",
      "description": "Official clock-in timestamp"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time",
      "description": "Official clock-out timestamp"
    },
    "clock_in_request_id": {
      "type": "string",
      "description": "Idempotency request id for the confirmed clock-in"
    },
    "clock_out_request_id": {
      "type": "string",
      "description": "Idempotency request id for the confirmed clock-out"
    },
    "clock_source": {
      "type": "string",
      "enum": [
        "server",
        "legacy_client",
        "admin_correction"
      ],
      "description": "Authority/source used for punch timestamps"
    },
    "lunch_minutes": {
      "type": "number",
      "default": 0,
      "description": "Lunch break duration in minutes"
    },
    "total_hours": {
      "type": "number",
      "description": "Total hours worked (minus lunch)"
    },
    "status": {
      "type": "string",
      "enum": [
        "clocked_in",
        "clocked_out"
      ],
      "default": "clocked_in",
      "description": "Current status"
    },
    "job_allocations": {
      "type": "array",
      "description": "Time allocated to each job",
      "items": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "string"
          },
          "work_order_title": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "minutes": {
            "type": "number"
          },
          "is_inhouse": {
            "type": "boolean",
            "default": false
          },
          "inhouse_task": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "archived_test_data": {
      "type": "boolean",
      "default": false,
      "description": "Pre-production Time Clock test record excluded from live timekeeping"
    },
    "archived_admin": {
      "type": "boolean",
      "default": false,
      "description": "Administrative archival flag; archived records remain preserved but are excluded from normal timekeeping"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this TimeEntry was archived"
    },
    "archived_by": {
      "type": "string",
      "description": "Administrator email that archived this TimeEntry"
    },
    "archive_reason": {
      "type": "string",
      "description": "Required reason for administrative archival"
    },
    "last_corrected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp of the latest administrator correction"
    },
    "last_corrected_by": {
      "type": "string",
      "description": "Administrator email that made the latest correction"
    },
    "last_correction_reason": {
      "type": "string",
      "description": "Required reason for the latest administrator correction"
    }
  },
  "required": [
    "user_email",
    "clock_in"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    }
  }
}