{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "clock_in"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    }
  }
}