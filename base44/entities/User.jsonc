{
  "name": "User",
  "type": "object",
  "properties": {
    "google_drive_token": {
      "type": "string",
      "description": "Google Drive access token"
    },
    "google_drive_refresh_token": {
      "type": "string",
      "description": "Google Drive refresh token"
    }
  },
  "required": [
    "google_drive_token",
    "google_drive_refresh_token"
  ]
}