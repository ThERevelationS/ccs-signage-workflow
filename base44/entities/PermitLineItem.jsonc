{
  "type": "object",
  "name": "PermitLineItem",
  "properties": {
    "work_order_id": {
      "type": "string",
      "description": "Linked work order ID"
    },
    "work_order_title": {
      "type": "string",
      "description": "Cached work order title/client name"
    },
    "work_order_description": {
      "type": "string",
      "description": "Cached work order description"
    },
    "row_name": {
      "type": "string",
      "description": "Custom name for this permit line item row"
    },
    "locality_id": {
      "type": "string",
      "description": "Reference to PermitLocality"
    },
    "locality_name": {
      "type": "string",
      "description": "Cached locality display name"
    },
    "locality_office_id": {
      "type": "string",
      "description": "Optional stable ID of the office in PermitLocality.offices. Blank for legacy or unresolved rows; never a shared government office/catalog ID."
    },
    "office_type": {
      "type": "string",
      "description": "LEGACY \u2014 single office type. Use office_types (array) instead."
    },
    "office_types": {
      "type": "array",
      "description": "Office categories this line represents (e.g. ['Zoning', 'Building']).",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "description": "Current status of this line item",
      "enum": [
        "active",
        "waiting",
        "completed"
      ],
      "default": "active"
    },
    "priority": {
      "type": "number",
      "description": "Sort order",
      "default": 0
    },
    "steps": {
      "type": "array",
      "description": "Custom workflow steps with checkboxes and dates",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "checkbox",
              "submitted_date",
              "followup_date",
              "permit_received_date",
              "text"
            ]
          },
          "value": {
            "type": "string"
          },
          "checked": {
            "type": "boolean",
            "default": false
          },
          "followup_interval_days": {
            "type": "number",
            "default": 14
          },
          "next_followup_date": {
            "type": "string",
            "format": "date"
          },
          "tied_to_step_id": {
            "type": "string",
            "description": "Optional \u2014 links a non-checkbox step to a checkbox step that marks completion."
          }
        }
      }
    },
    "submitted_date": {
      "type": "string",
      "description": "When the permit was submitted",
      "format": "date"
    },
    "next_followup_date": {
      "type": "string",
      "description": "Next follow-up date (drives sorting)",
      "format": "date"
    },
    "permit_received_date": {
      "type": "string",
      "description": "When the permit was received \u2014 marks complete",
      "format": "date"
    },
    "application_reference_number": {
      "type": "string",
      "description": "Application, case, tracking, or reference number for this individual permit/office line. Line-level; does not overwrite legacy WorkOrder permit fields."
    },
    "permit_number": {
      "type": "string",
      "description": "Issued permit number for this individual permit/office line. Line-level; does not overwrite the legacy WorkOrder permit_number field."
    },
    "approval_date": {
      "type": "string",
      "description": "Date this individual permit/office line was approved, when approval is distinct from permit receipt/issuance.",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "description": "Expiration date for this individual permit/office line, when provided by the issuing authority.",
      "format": "date"
    },
    "jurisdiction_fee_amount": {
      "type": "number",
      "description": "Actual known jurisdiction/permit-office fee for this individual line, entered or reconciled by staff. Never auto-filled from repository fee guidance or estimator permit_fee."
    },
    "jurisdiction_fee_status": {
      "type": "string",
      "description": "Staff-recorded payment state for the actual jurisdiction fee. Blank means not recorded; no status is inferred from repository data.",
      "enum": [
        "due",
        "paid",
        "waived"
      ]
    },
    "jurisdiction_fee_paid_date": {
      "type": "string",
      "description": "Date the actual jurisdiction fee for this permit line was paid, when known.",
      "format": "date"
    },
    "correction_status": {
      "type": "string",
      "description": "Staff-recorded correction/resubmission state for this individual permit line. Blank means no correction state is currently recorded.",
      "enum": [
        "corrections_received",
        "working_corrections",
        "resubmitted"
      ]
    },
    "corrections_received_date": {
      "type": "string",
      "description": "Date the issuing authority sent or communicated the latest correction request for this permit line.",
      "format": "date"
    },
    "resubmitted_date": {
      "type": "string",
      "description": "Date the latest corrected package was resubmitted for this permit line.",
      "format": "date"
    },
    "closeout_status": {
      "type": "string",
      "description": "Optional staff-recorded post-issuance inspection/closeout state for this individual permit line. Blank preserves legacy completion behavior and does not imply an inspection is required.",
      "enum": [
        "inspection_required",
        "inspection_scheduled",
        "inspection_failed",
        "inspection_passed",
        "closed_out"
      ]
    },
    "inspection_date": {
      "type": "string",
      "description": "Scheduled or most recent inspection date for this individual permit line, as recorded by staff.",
      "format": "date"
    },
    "closeout_date": {
      "type": "string",
      "description": "Date staff confirmed the permit line's required inspection/closeout work was completed.",
      "format": "date"
    },
    "last_submitted_trigger_date": {
      "type": "string",
      "description": "Exact submitted_date value already claimed for workflow automation. Prevents duplicate permit_submitted actions while allowing a later corrected date to fire once.",
      "format": "date"
    },
    "last_permit_received_trigger_date": {
      "type": "string",
      "description": "Exact permit_received_date value already claimed for workflow automation. Prevents duplicate permit_received actions while allowing a later corrected date to fire once.",
      "format": "date"
    },
    "last_followup_fired_date": {
      "type": "string",
      "description": "Date the follow-up reminder was last fired (dedupe guard)",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "Notes for this line item"
    },
    "assigned_to": {
      "type": "string",
      "description": "Person responsible"
    }
  },
  "required": [
    "work_order_id"
  ]
  "rls": {
    "create": { "user_condition": { "role": "__permitlineitem_backend_only__" } },
    "read": { "user_condition": { "role": "__permitlineitem_backend_only__" } },
    "update": { "user_condition": { "role": "__permitlineitem_backend_only__" } },
    "delete": { "user_condition": { "role": "__permitlineitem_backend_only__" } }
  }
}