{
  "name": "TimeClockPayPeriodCreateGate",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "company"
      ],
      "description": "Singleton coordinator: exactly one company row must be provisioned before enabling pay-period creation."
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "creating"
      ],
      "description": "Backend-only CAS creation gate."
    },
    "request_id": {
      "type": "string"
    },
    "payload_hash": {
      "type": "string"
    },
    "claim_token": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "scope",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "read": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    }
  }
}