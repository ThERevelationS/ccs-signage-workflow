{
  "name": "Payment",
  "type": "object",
  "description": "Canonical payment applied to an Invoice. Always written by invoicingAction so invoice balances stay consistent \u2014 never edited directly. Void/refund rather than delete to preserve the audit trail.",
  "properties": {
    "schema_version": {
      "type": "number",
      "default": 1
    },
    "creation_request_key": {
      "type": "string",
      "description": "Stable retry-safe receipt for one payment record."
    },
    "invoice_id": {
      "type": "string",
      "description": "Invoice this payment applies to."
    },
    "customer_id": {
      "type": "string",
      "description": "Denormalized from the invoice for AR queries."
    },
    "opportunity_id": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Signed amount applied to the invoice: positive for payments, negative for credit-memo and refund rows. Invoice amount_paid is the net sum of recorded + refunded rows."
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "check",
        "card",
        "ach",
        "financing",
        "other",
        "credit_memo"
      ],
      "default": "other"
    },
    "reference_number": {
      "type": "string",
      "description": "Check number, card auth, ACH trace, or other external reference."
    },
    "paid_date": {
      "type": "string",
      "description": "Date the money was received."
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "void",
        "refunded"
      ],
      "default": "recorded",
      "description": "recorded = live row (payments positive, credit memos negative); refunded = a negative refund row or a fully-refunded original payment; void = reversed."
    },
    "void_reason": {
      "type": "string"
    },
    "voided_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "refund_of_payment_id": {
      "type": "string",
      "description": "On refund rows: id of the original Payment this refund reverses."
    },
    "refunded_amount": {
      "type": "number",
      "default": 0,
      "description": "On original payments: cumulative refunded dollars so far (partial refunds allowed)."
    },
    "reconciliation_batch_id": {
      "type": "string",
      "description": "ReconciliationBatch this payment was swept into at cash close. Empty = still unreconciled. Set only by manageReconciliation."
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "invoice_id",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__payment_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__payment_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__payment_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__payment_backend_only__"
      }
    }
  }
}