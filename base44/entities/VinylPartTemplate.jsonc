{
  "name": "VinylPartTemplate",
  "type": "object",
  "description": "Saved/favorited vinyl part definition. Users can save common part sizes (e.g. '12x12 cooler decal') and re-add them with one click.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Friendly label shown in the parts library picker."
    },
    "description": {
      "type": "string"
    },
    "width_inches": {
      "type": "number",
      "default": 12
    },
    "height_inches": {
      "type": "number",
      "default": 12
    },
    "bleed_inches": {
      "type": "number",
      "default": 0
    },
    "allow_rotation": {
      "type": "boolean",
      "default": true
    },
    "default_quantity": {
      "type": "number",
      "default": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}