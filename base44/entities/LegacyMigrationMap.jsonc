{
  "name": "LegacyMigrationMap",
  "type": "object",
  "description": "Internal audit map for one-time legacy SignEstimate Pro migrations. Keeps source record IDs mapped to their CCS record IDs so migrations can be resumed safely without creating duplicates.",
  "properties": {
    "source_app_id": {
      "type": "string"
    },
    "source_entity": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "target_entity": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "source_created_date": {
      "type": "string"
    },
    "source_updated_date": {
      "type": "string"
    },
    "migration_batch": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "source_app_id",
    "source_entity",
    "source_id",
    "target_entity",
    "target_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}