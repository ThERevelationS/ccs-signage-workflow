{
  "name": "AllInOneEstimate",
  "type": "object",
  "description": "A multifaceted estimate BUILT from sections. Each section is a dedicated sub-estimate created by (and owned by) this estimate in its module's own entity, edited with that module's full estimator INLINE on the same page. Project info (client, estimate #, hyperlink, site address) is shared down to every owned section automatically. Totals live-sync from the source projects via real-time subscriptions and refresh-on-open. Customer pricing waterfall (per-section adjustments \u2192 discount \u2192 contingency \u2192 fees \u2192 tax \u2192 deposit) is computed by components/estimator/allInOne/aioPricing.js. Step 1 fields come from the shared Customer / TaxGroup / EstimateOption entities. Links to the workflow through customer_id (shared Client) and work_order_id.",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Estimate description shown in Step 1."
    },
    "client_name": {
      "type": "string",
      "description": "Customer company name."
    },
    "customer_id": {
      "type": "string",
      "description": "Linked shared Customer record id."
    },
    "work_order_id": {
      "type": "string",
      "description": "Optional linked WorkOrder id \u2014 ties this estimate to a job in the workflow."
    },
    "estimate_number": {
      "type": "string"
    },
    "po_number": {
      "type": "string",
      "description": "Customer purchase order number, shown on the customer quote."
    },
    "terms": {
      "type": "string",
      "description": "Payment terms selected from the admin-managed terms list."
    },
    "order_contact": {
      "type": "string",
      "description": "Contact on the order (from the customer's contacts)."
    },
    "office_phone": {
      "type": "string"
    },
    "office_phone_ext": {
      "type": "string"
    },
    "salesperson": {
      "type": "string"
    },
    "sales_center": {
      "type": "string"
    },
    "tax_group": {
      "type": "string",
      "description": "Name of the selected TaxGroup \u2014 sets tax_percent."
    },
    "hyperlink": {
      "type": "string"
    },
    "site_address": {
      "type": "string",
      "description": "Job site address \u2014 shared down to sections whose module supports it."
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "target_install_date": {
      "type": "string",
      "description": "Target install/completion date (YYYY-MM-DD)."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "rush"
      ],
      "default": "normal"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags for filtering/search (e.g. 'pylon, rebrand, phase 1')."
    },
    "tax_percent": {
      "type": "number",
      "default": 0,
      "description": "Sales tax % \u2014 tax = taxable base \u00d7 tax%."
    },
    "deposit_percent": {
      "type": "number",
      "default": 50,
      "description": "Deposit % \u2014 deposit = quote total \u00d7 deposit%."
    },
    "discount_percent": {
      "type": "number",
      "default": 0,
      "description": "Project-level discount % applied to the adjusted sections subtotal."
    },
    "contingency_percent": {
      "type": "number",
      "default": 0,
      "description": "Contingency % applied AFTER discount: contingency = (subtotal \u2212 discount) \u00d7 contingency%."
    },
    "shipping_fee": {
      "type": "number",
      "default": 0,
      "description": "Flat project-level shipping/freight fee added before tax."
    },
    "permit_fee": {
      "type": "number",
      "default": 0,
      "description": "Flat project-level permit/admin fee added before tax."
    },
    "quote_valid_days": {
      "type": "number",
      "default": 30,
      "description": "How many days the customer quote stays valid."
    },
    "quote_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Customer-facing issue date of the currently issued quote version. Updated when the estimate transitions into sent or when an intentional revision is completed while remaining sent; historical sent estimates are not automatically backfilled."
    },
    "quote_version": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Customer-facing quote issue version. Starts at 1 on the first transition into sent and increments on each later transition into sent or completed revision that remains sent. Separate from EstimateRevision.revision_number."
    },
    "payment_terms": {
      "type": "string",
      "description": "Payment terms text shown on the customer quote."
    },
    "scope_inclusions": {
      "type": "string",
      "description": "Newline-separated list of what's INCLUDED \u2014 rendered as bullets on the customer quote."
    },
    "scope_exclusions": {
      "type": "string",
      "description": "Newline-separated list of what's EXCLUDED \u2014 rendered as bullets on the customer quote."
    },
    "scope_auto_apply": {
      "type": "boolean",
      "default": true,
      "description": "When true, scope library lines flagged always_include, or whose auto_modules match a section on this estimate, are added automatically."
    },
    "hide_section_prices": {
      "type": "boolean",
      "default": false,
      "description": "When true the customer quote shows ONE bundled project price instead of per-section pricing."
    },
    "company_name": {
      "type": "string",
      "description": "Your company name shown in the customer quote header."
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_address": {
      "type": "string"
    },
    "company_website": {
      "type": "string"
    },
    "company_license": {
      "type": "string",
      "description": "License / registration number printed under the company block."
    },
    "company_logo_url": {
      "type": "string"
    },
    "quote_title": {
      "type": "string",
      "default": "Project Estimate",
      "description": "Headline printed at the top of the quote."
    },
    "quote_accent_color": {
      "type": "string",
      "default": "#4f46e5",
      "description": "Hex accent color for the quote header rule and highlight text."
    },
    "quote_intro_text": {
      "type": "string",
      "description": "Optional paragraph printed above the pricing table."
    },
    "quote_footer_text": {
      "type": "string",
      "description": "Optional paragraph printed at the very bottom of the quote."
    },
    "quote_terms_conditions": {
      "type": "string",
      "description": "Terms & conditions block printed on the quote."
    },
    "warranty_text": {
      "type": "string",
      "description": "Warranty statement printed on the quote."
    },
    "lead_time_text": {
      "type": "string",
      "description": "Production / install lead time statement printed on the quote."
    },
    "show_company_block": {
      "type": "boolean",
      "default": true
    },
    "show_logo": {
      "type": "boolean",
      "default": false
    },
    "show_contact_block": {
      "type": "boolean",
      "default": true
    },
    "show_estimate_number": {
      "type": "boolean",
      "default": true
    },
    "show_po_number": {
      "type": "boolean",
      "default": true
    },
    "show_site_address": {
      "type": "boolean",
      "default": true
    },
    "show_dates": {
      "type": "boolean",
      "default": true
    },
    "show_category_column": {
      "type": "boolean",
      "default": true
    },
    "show_section_descriptions": {
      "type": "boolean",
      "default": true
    },
    "show_quantity_column": {
      "type": "boolean",
      "default": false
    },
    "show_scope_lists": {
      "type": "boolean",
      "default": true
    },
    "show_subtotal_line": {
      "type": "boolean",
      "default": true
    },
    "show_discount_line": {
      "type": "boolean",
      "default": true
    },
    "show_fees_line": {
      "type": "boolean",
      "default": true
    },
    "show_tax_line": {
      "type": "boolean",
      "default": true
    },
    "show_deposit_lines": {
      "type": "boolean",
      "default": true
    },
    "show_notes_on_quote": {
      "type": "boolean",
      "default": false,
      "description": "When true, estimate-level notes are included on the customer quote. Defaults off because estimate notes may contain internal project context."
    },
    "show_terms_block": {
      "type": "boolean",
      "default": true
    },
    "show_warranty_block": {
      "type": "boolean",
      "default": true
    },
    "show_lead_time_block": {
      "type": "boolean",
      "default": true
    },
    "show_signature_block": {
      "type": "boolean",
      "default": true
    },
    "show_validity_footer": {
      "type": "boolean",
      "default": true
    },
    "round_prices_to_dollar": {
      "type": "boolean",
      "default": false,
      "description": "Display-only: rounds every price shown on the customer quote to the nearest dollar."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "sent",
        "approved",
        "archived",
        "cancelled"
      ],
      "default": "draft"
    },
    "cancel_reason": {
      "type": "string",
      "description": "Reason captured when the estimate is cancelled (from the Cancel Estimate modal)."
    },
    "line_items": {
      "type": "array",
      "description": "Estimate sections. Totals are refreshed from the source projects whenever the estimate is opened, and in real time while it is open.",
      "items": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "description": "Stable id for this estimate product line. Used to link the persistent BuilderProduct record."
          },
          "builder_product_id": {
            "type": "string",
            "description": "Persistent BuilderProduct id for frozen pricing, parts, groups, and full builder snapshots."
          },
          "module_key": {
            "type": "string",
            "description": "Key from the estimator registry (e.g. 'painting', 'foundation')."
          },
          "builder_name": {
            "type": "string",
            "description": "Internal/estimator-facing builder identity or product type."
          },
          "client_product_name": {
            "type": "string",
            "description": "Editable client-facing name for this product; kept distinct from builder_name/project_name."
          },
          "product_category": {
            "type": "string",
            "description": "User-defined Product Category used for estimate organization and customer quote categorization."
          },
          "production_product_type": {
            "type": "string",
            "description": "Optional production/SIP Product Type selected from GlobalSettings.productTypes. Blank means intentionally unclassified."
          },
          "product_notes": {
            "type": "string",
            "description": "Estimator-facing Product notes. Separate from customer_description."
          },
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "total_snapshot": {
            "type": "number",
            "default": 0,
            "description": "Accepted/frozen UNIT Product cost snapshot. Estimate pricing extends this unit amount by customer_quantity, then applies adjustment_percent. Live inventory changes do not replace it until Update Price is accepted."
          },
          "live_total_snapshot": {
            "type": "number",
            "default": 0,
            "description": "Most recently detected/recalculated live cost used only for price-change comparison."
          },
          "price_state": {
            "type": "string",
            "enum": [
              "unchecked",
              "current",
              "changed",
              "detached_parts",
              "legacy_frozen",
              "manual"
            ],
            "default": "unchecked"
          },
          "price_recalc_required": {
            "type": "boolean",
            "default": false,
            "description": "True when Master Inventory changed after this Builder was last calculated and Update Price must wait until the Builder is reopened/saved."
          },
          "price_recalc_reason": {
            "type": "string",
            "description": "Human-readable reason this Product requires Builder recalculation before Update Price."
          },
          "price_acceptance_pending": {
            "type": "object",
            "additionalProperties": true,
            "description": "Durable retry marker for a Builder/Product multi-record mutation such as initial freeze, Update Price, detached-Part changes, Saved Part insertion, or whole Quick Product insertion. Stores the exact recovery target until the final Estimate line write completes."
          },
          "quick_product_insert_key": {
            "type": "string",
            "description": "Stable provenance/idempotency key retained only after a Quick Product or copied Product insertion completes successfully."
          },
          "quick_product_source_type": {
            "type": "string",
            "description": "Origin of a completed reusable Product insertion, such as quick_product or clipboard_product."
          },
          "quick_product_source_id": {
            "type": "string",
            "description": "Source QuickProduct or EstimateClipboardItem id for a completed reusable Product insertion when available."
          },
          "last_part_group_mutation_key": {
            "type": "string",
            "description": "Idempotency receipt for the most recently completed structural Part Group create/dissolve action on this Product."
          },
          "last_part_group_mutation_kind": {
            "type": "string",
            "description": "Kind of the most recently completed structural Part Group action, such as create or dissolve."
          },
          "blank_product_insert_key": {
            "type": "string",
            "description": "Idempotency receipt for a completed blank Builder-backed or Custom Product insertion."
          },
          "blank_product_insert_kind": {
            "type": "string",
            "description": "Completed blank Product insertion type: builder or custom."
          },
          "detached_part_count": {
            "type": "number",
            "default": 0
          },
          "needs_reattach_review": {
            "type": "boolean",
            "default": false
          },
          "last_price_check_at": {
            "type": "string"
          },
          "last_price_update_at": {
            "type": "string"
          },
          "adjustment_percent": {
            "type": "number",
            "default": 0,
            "description": "Per-section price adjustment %. Positive = markup, negative = discount. adjusted = total \u00d7 (1 + adj%/100)."
          },
          "section_status": {
            "type": "string",
            "enum": [
              "in_progress",
              "complete"
            ],
            "default": "in_progress",
            "description": "Estimating workflow status of this section."
          },
          "section_note": {
            "type": "string",
            "description": "Internal note about this section (not shown to the customer)."
          },
          "customer_description": {
            "type": "string",
            "description": "Customer-facing description shown under the section on the quote."
          },
          "customer_quantity": {
            "type": "number",
            "default": 1,
            "description": "Product quantity. Estimate pricing extends each Product as total_snapshot \u00d7 customer_quantity before adjustment_percent; this quantity can also be shown on the customer quote when the quantity column is enabled."
          },
          "include_in_customer": {
            "type": "boolean",
            "default": true,
            "description": "When false, this section's price is bundled into a single 'Additional project scope' quote line instead of being listed."
          },
          "owned": {
            "type": "boolean",
            "default": false,
            "description": "True when this sub-estimate was created BY this All-In-One estimate (a built-in section). Owned sections are deleted together with the section / estimate."
          },
          "linked_date": {
            "type": "string"
          },
          "updated_date_snapshot": {
            "type": "string",
            "description": "Last-known updated_date of the source sub-estimate."
          }
        }
      }
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Sum of raw section totals (before adjustments/discount/tax)."
    },
    "quote_total": {
      "type": "number",
      "default": 0,
      "description": "Customer-facing quote total after the full pricing waterfall (adjustments, discount, contingency, fees, tax)."
    },
    "notes": {
      "type": "string"
    },
    "edit_reason": {
      "type": "string",
      "description": "Pending lifecycle reason used when a draft/calculated estimate is moved into or out of a protected status. The reason is written to EstimateRevision history and this temporary field is cleared after save."
    },
    "pipeline_sync_pending": {
      "type": "boolean",
      "default": false,
      "description": "True only when the estimate/lifecycle audit saved successfully but synchronization to the shared Customer/Sales Pipeline did not complete. Cleared after a successful retry."
    },
    "pipeline_sync_error": {
      "type": "string",
      "description": "Last downstream Customer/Sales Pipeline synchronization error for a pending retry. Internal recovery metadata; never shown on the customer quote."
    },
    "last_product_removal_key": {
      "type": "string",
      "description": "Idempotency receipt for the most recently completed Estimate Product removal."
    },
    "last_product_removal_line_id": {
      "type": "string",
      "description": "Estimate line id removed by the most recently completed Product removal."
    },
    "last_product_removal_at": {
      "type": "string",
      "description": "Timestamp of the most recently completed Product removal."
    }
  },
  "required": [
    "project_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}