{
  "name": "EmailGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the email group"
    },
    "description": {
      "type": "string",
      "description": "Description of the email group"
    },
    "permission_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin sections granted to group members \u2014 members inherit these on top of their own admin_permissions."
    },
    "emails": {
      "type": "array",
      "description": "List of email addresses in this group",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "emails"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    }
  }
}