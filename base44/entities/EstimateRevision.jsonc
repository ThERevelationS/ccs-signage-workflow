{
  "name": "EstimateRevision",
  "type": "object",
  "description": "Estimate-level audit trail for customer-facing lifecycle transitions and revisions. Product/Part pricing history remains in BuilderPriceRevision; this entity records the whole-estimate before/after snapshot, reason, status and quote totals when an estimate is sent, approved, archived, cancelled, converted, or intentionally revised after protection.",
  "properties": {
    "estimate_id": {
      "type": "string"
    },
    "revision_number": {
      "type": "number"
    },
    "quote_version": {
      "type": "number",
      "minimum": 0,
      "description": "Customer quote version associated with this lifecycle revision, when one has been issued."
    },
    "quote_issue_key": {
      "type": "string",
      "description": "Stable identity linking this lifecycle revision to the corresponding issued customer quote version and delivery/acceptance audit records."
    },
    "revision_type": {
      "type": "string",
      "enum": [
        "manual_revision",
        "status_transition",
        "cancel",
        "conversion"
      ],
      "default": "manual_revision"
    },
    "revision_status": {
      "type": "string",
      "enum": [
        "open",
        "completed"
      ],
      "default": "open"
    },
    "reason": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "previous_quote_total": {
      "type": "number",
      "default": 0
    },
    "new_quote_total": {
      "type": "number",
      "default": 0
    },
    "previous_total_cost": {
      "type": "number",
      "default": 0
    },
    "new_total_cost": {
      "type": "number",
      "default": 0
    },
    "change_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimate_snapshot_before": {
      "type": "object",
      "additionalProperties": true
    },
    "estimate_snapshot_after": {
      "type": "object",
      "additionalProperties": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "work_order_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "estimate_id",
    "revision_number",
    "reason"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}