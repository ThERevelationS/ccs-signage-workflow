{
  "name": "EstimatorProject",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "description": "The original project ID from the estimator app"
    },
    "client_name": {
      "type": "string",
      "description": "Client name - used for matching to WorkOrders"
    },
    "project_name": {
      "type": "string",
      "description": "Project name from the estimator"
    },
    "estimate_number": {
      "type": "string",
      "description": "Estimate number"
    },
    "hyperlink": {
      "type": "string",
      "description": "Corebridge link"
    },
    "notes": {
      "type": "string",
      "description": "Project notes"
    },
    "excavation_method": {
      "type": "string",
      "description": "Excavation method used"
    },
    "total_labor_cost": {
      "type": "number",
      "description": "Total labor cost"
    },
    "total_concrete_cost": {
      "type": "number",
      "description": "Total concrete cost"
    },
    "total_rebar_cost": {
      "type": "number",
      "description": "Total rebar cost"
    },
    "total_pole_cost": {
      "type": "number",
      "description": "Total pole cost"
    },
    "total_brick_cost": {
      "type": "number",
      "description": "Total brick cost"
    },
    "total_wall_cost": {
      "type": "number",
      "description": "Total wall cost"
    },
    "total_forming_materials_cost": {
      "type": "number",
      "description": "Total forming materials cost"
    },
    "total_pole_painting_cost": {
      "type": "number",
      "description": "Total pole painting cost"
    },
    "concrete_cost_per_cy": {
      "type": "number",
      "description": "Concrete cost per cubic yard"
    },
    "rebar_cost_per_ft": {
      "type": "number",
      "description": "Rebar cost per foot"
    },
    "hand_dig_excavation_cost_per_cy": {
      "type": "number",
      "description": "Hand dig excavation cost per CY"
    },
    "equipment_excavation_labor_rate": {
      "type": "number",
      "description": "Equipment excavation labor rate"
    },
    "forming_materials_cost_spread_foot": {
      "type": "number",
      "description": "Forming materials cost for spread foot"
    },
    "forming_materials_cost_pillar": {
      "type": "number",
      "description": "Forming materials cost for pillar"
    },
    "walls": {
      "type": "array",
      "description": "Wall/footing specifications",
      "items": {
        "type": "object"
      }
    },
    "selected_equipment": {
      "type": "array",
      "description": "Selected equipment list",
      "items": {
        "type": "object"
      }
    },
    "selected_concrete_id": {
      "type": "string",
      "description": "Selected concrete type ID"
    },
    "work_order_id": {
      "type": "string",
      "description": "Linked WorkOrder ID in this app (set when matched)"
    },
    "estimator_app_url": {
      "type": "string",
      "description": "Direct URL to open this project in the estimator app"
    },
    "source_created_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the project was created in the estimator app"
    },
    "source_updated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the project was last updated in the estimator app"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was last synced from the estimator"
    },
    "raw_data": {
      "type": "object",
      "description": "Complete raw data from the estimator app for reference"
    }
  },
  "required": [
    "source_id",
    "client_name"
  ]
}