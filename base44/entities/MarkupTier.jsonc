{
  "name": "MarkupTier",
  "type": "object",
  "properties": {
    "tier_number": {
      "type": "number",
      "description": "Tier number 1-8. 1 = General Public (highest markup), 8 = Friends & Family (lowest)."
    },
    "tier_name": {
      "type": "string",
      "description": "Display name, e.g. 'General Public', 'Charities', 'Friends & Family'."
    },
    "description": {
      "type": "string",
      "description": "Optional notes about when to use this tier."
    },
    "markups": {
      "type": "object",
      "description": "Markup multiplier per category_key. Stored as numbers, e.g. 1.50 = 50% markup. Keys come from MarkupCategory.category_key.",
      "additionalProperties": {
        "type": "number"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tier_number",
    "tier_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}