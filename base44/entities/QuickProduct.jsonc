{
  "name": "QuickProduct",
  "type": "object",
  "description": "A reusable 'Quick Product' \u2014 a saved, pre-priced product built from a list of parts (fabrication, materials, design, service, install, etc.). Each part line = override ?? (part_price + modifier_price) x part_qty; parts total + setup fee - discount = product retail (x product_quantity for the extended total).",
  "properties": {
    "product_name": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Stable creation receipt used to converge retries of the same Quick Product save without creating duplicates."
    },
    "template_version": {
      "type": "number",
      "default": 2,
      "description": "Quick Product package version. Version 2+ stores a lossless Product/Builder/Parts/Groups snapshot."
    },
    "source_product_class": {
      "type": "string",
      "enum": [
        "custom",
        "builder",
        "legacy"
      ],
      "default": "custom"
    },
    "source_module_key": {
      "type": "string"
    },
    "source_entity": {
      "type": "string",
      "description": "Dedicated Builder source entity, e.g. FoundationProject. Blank for Custom Products."
    },
    "source_builder_name": {
      "type": "string"
    },
    "product_category": {
      "type": "string"
    },
    "production_product_type": {
      "type": "string",
      "description": "Optional production/SIP Product Type preserved when this reusable Product is inserted into an estimate."
    },
    "created_from_product_id": {
      "type": "string"
    },
    "created_from_estimate_id": {
      "type": "string"
    },
    "product_group": {
      "type": "string",
      "enum": [
        "my",
        "global"
      ],
      "default": "my",
      "description": "'my' = this user's products, 'global' = shared company products."
    },
    "categories": {
      "type": "array",
      "description": "Category names this product belongs to (matches QuickProductCategory.category_name).",
      "items": {
        "type": "string"
      }
    },
    "product_quantity": {
      "type": "number",
      "default": 1
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "setup_fee": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Flat dollar discount subtracted from the parts total."
    },
    "price_override": {
      "type": "number",
      "description": "When set, replaces the calculated product retail price."
    },
    "product_notes": {
      "type": "string"
    },
    "client_description": {
      "type": "string"
    },
    "product_snapshot": {
      "type": "object",
      "description": "Complete normalized BuilderProduct + estimate-line metadata needed to recreate the Product losslessly.",
      "additionalProperties": true
    },
    "builder_snapshot": {
      "type": "object",
      "description": "Complete dedicated Builder/source-project payload. For Builder Products this is the full estimator configuration, not a flattened price summary.",
      "additionalProperties": true
    },
    "builder_snapshot_hash": {
      "type": "string"
    },
    "parts_snapshot": {
      "type": "array",
      "description": "Complete BuilderPart records, including master inventory references, frozen/current inventory snapshots, calculation snapshots and detach state.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "part_groups_snapshot": {
      "type": "array",
      "description": "Complete Part Group records. Child Part group links are remapped when the Quick Product is instantiated.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "price_snapshot": {
      "type": "object",
      "description": "Frozen/current Product pricing state at the time the Quick Product was saved.",
      "additionalProperties": true
    },
    "detached_part_count": {
      "type": "number",
      "default": 0
    },
    "needs_reattach_review": {
      "type": "boolean",
      "default": false
    },
    "parts": {
      "type": "array",
      "description": "Ordered parts that make up the product.",
      "items": {
        "type": "object",
        "properties": {
          "part_label": {
            "type": "string",
            "description": "Editable label shown on the part header (e.g. 'Channel Letters')."
          },
          "part_name": {
            "type": "string",
            "description": "Underlying part name (e.g. 'Fabricated Part')."
          },
          "part_type": {
            "type": "string",
            "enum": [
              "fabrication",
              "material",
              "design_production",
              "service",
              "installation",
              "equipment",
              "permit",
              "other"
            ],
            "default": "fabrication"
          },
          "part_qty": {
            "type": "number",
            "default": 1
          },
          "vendor_info": {
            "type": "string"
          },
          "modifiers": {
            "type": "array",
            "description": "Free-form modifier/spec lines shown in the Modifier Information column.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "part_price": {
            "type": "number",
            "default": 0
          },
          "modifier_price": {
            "type": "number",
            "default": 0
          },
          "price_override": {
            "type": "number",
            "description": "When set, replaces this part's calculated line total."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_price": {
      "type": "number",
      "default": 0,
      "description": "Last-saved product retail price (extended, includes product quantity)."
    }
  },
  "required": [
    "product_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.product_group": "global"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}