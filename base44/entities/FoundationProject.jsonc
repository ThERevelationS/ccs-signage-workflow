{
  "name": "FoundationProject",
  "type": "object",
  "description": "Concrete | Masonry | Poles estimator project. Holds foundation items (spread footings / pillars) with concrete, rebar, excavation, forming and finishing costs, plus placed poles, masonry walls, wall caps, signage cabinets, site landscaping, selected equipment and the rolled-up totals.",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "Linked shared Customer record id."
    },
    "estimate_number": {
      "type": "string"
    },
    "hyperlink": {
      "type": "string"
    },
    "creation_request_key": {
      "type": "string",
      "description": "Internal retry receipt used only to make the first create of this Builder source project idempotent."
    },
    "builder_sync_attempt": {
      "type": "object",
      "description": "Internal source-save receipt; synchronization is acknowledged by the linked estimate line at the same source updated_date.",
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "source_project_id": {
          "type": "string"
        },
        "estimate_id": {
          "type": "string"
        },
        "requested_at": {
          "type": "string"
        }
      }
    },
    "assembly_schema_version": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "archived"
      ],
      "default": "draft"
    },
    "project_concrete_type": {
      "type": "string"
    },
    "project_concrete_admixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string"
          },
          "foundation_type": {
            "type": "string",
            "enum": [
              "spread_foot",
              "pillar"
            ],
            "default": "spread_foot"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "length_inches": {
            "type": "number",
            "default": 0
          },
          "width_inches": {
            "type": "number",
            "default": 0
          },
          "diameter": {
            "type": "number",
            "default": 0
          },
          "depth_inches": {
            "type": "number",
            "default": 0
          },
          "grade_offset_inches": {
            "type": "number",
            "default": 0
          },
          "rotation_degrees": {
            "type": "number",
            "default": 0
          },
          "x_inches": {
            "type": "number",
            "default": 0,
            "description": "Left/right position on the layout canvas, in inches."
          },
          "z_inches": {
            "type": "number",
            "default": 0,
            "description": "Front/back position on the layout canvas, in inches."
          },
          "include_rebar": {
            "type": "boolean",
            "default": false
          },
          "reinforcement_calculation_version": {
            "type": "integer",
            "description": "Absent or 1 uses legacy reinforcement; 2 uses the explicitly accepted preliminary model. Unsupported versions must not fall back to legacy pricing."
          },
          "reinforcement_design": {
            "type": "object",
            "description": "Accepted versioned raw reinforcement geometry. Not engineering approval, structural capacity or a stock purchasing schedule.",
            "additionalProperties": true
          },
          "reinforcement_material": {
            "type": "object",
            "description": "Explicit stable catalog identity or authored manual per-foot material basis for the accepted reinforcement design.",
            "additionalProperties": true
          },
          "reinforcement_proposal": {
            "type": "object",
            "description": "Unapplied versioned editor draft, including incomplete raw text. Never authoritative for live pricing or downstream material handoff.",
            "additionalProperties": true
          },
          "reinforcement_cost_snapshot": {
            "type": "object",
            "description": "Latest deterministic version-2 steel quantities, material/labor amounts and basis. Builder frozen pricing is separate; engineering and procurement approval remain false.",
            "additionalProperties": true
          },
          "reinforcement_acceptance": {
            "type": "object",
            "description": "Historical local model-acceptance receipt with origin actor, source, component, revision, timestamp and warnings. Audit metadata only, never authorization or engineering approval.",
            "additionalProperties": true
          },
          "include_forming": {
            "type": "boolean",
            "default": true
          },
          "selected_forming_id": {
            "type": "string"
          },
          "include_finishing": {
            "type": "boolean",
            "default": true
          },
          "rebar_size": {
            "type": "string",
            "default": "#4"
          },
          "rebar_spacing_length": {
            "type": "number"
          },
          "rebar_spacing_width": {
            "type": "number"
          },
          "selected_pole_id": {
            "type": "string",
            "description": "LEGACY item-level pole selection (CMP-E01). Never priced \u2014 the canonical representation is project.poles; migrate via the Poles panel."
          },
          "pole_offset_from_bottom_inches": {
            "type": "number",
            "default": 0,
            "description": "LEGACY item-level pole offset above the footing bottom. Not interpreted as embedment."
          },
          "pole_total_height_inches": {
            "type": "number",
            "default": 0,
            "description": "LEGACY item-level total pole height in inches. Never priced \u2014 see project.poles."
          },
          "include_pole_painting": {
            "type": "boolean",
            "default": false,
            "description": "LEGACY item-level pole-painting flag; the canonical flag lives on project.poles rows."
          },
          "include_wall_material": {
            "type": "boolean",
            "default": false
          },
          "wall_length_inches": {
            "type": "number",
            "default": 0
          },
          "wall_width_inches": {
            "type": "number",
            "default": 8
          },
          "wall_height_inches": {
            "type": "number",
            "default": 0
          },
          "selected_brick_id": {
            "type": "string"
          },
          "mortar_gap_inches": {
            "type": "number",
            "default": 0.375
          },
          "brick_layer_offset_inches": {
            "type": "number"
          },
          "include_fill_material": {
            "type": "boolean",
            "default": false
          },
          "selected_fill_material_id": {
            "type": "string"
          },
          "concrete_volume_cy": {
            "type": "number"
          },
          "excavation_volume_cy": {
            "type": "number"
          },
          "concrete_bags": {
            "type": "number"
          },
          "concrete_rate": {
            "type": "number"
          },
          "rebar_feet": {
            "type": "number"
          },
          "rebar_weight_lbs": {
            "type": "number"
          },
          "rebar_rate": {
            "type": "number"
          },
          "excavation_hours": {
            "type": "number"
          },
          "forming_qty": {
            "type": "number"
          },
          "concrete_cost": {
            "type": "number"
          },
          "rebar_cost": {
            "type": "number"
          },
          "rebar_material_cost": {
            "type": "number",
            "description": "Calculated version-2 steel material cost, separate from reinforcement labor."
          },
          "rebar_labor_cost": {
            "type": "number",
            "description": "Calculated version-2 reinforcement labor cost."
          },
          "rebar_labor_hours": {
            "type": "number",
            "description": "Recorded version-2 reinforcement labor hours; absent is unknown, not zero."
          },
          "rebar_geometry_feet": {
            "type": "number",
            "description": "Physical modeled steel footage, distinct from the priced rebar_feet override."
          },
          "rebar_geometry_weight_lbs": {
            "type": "number",
            "description": "Physical modeled steel weight, distinct from the priced rebar_weight_lbs."
          },
          "rebar_connection_count": {
            "type": "integer",
            "description": "Modeled reinforcement connections, independent of an aggregate priced-footage override."
          },
          "excavation_cost": {
            "type": "number"
          },
          "forming_hours": {
            "type": "number"
          },
          "forming_cost": {
            "type": "number"
          },
          "forming_materials_cost": {
            "type": "number"
          },
          "pouring_hours": {
            "type": "number"
          },
          "pouring_cost": {
            "type": "number"
          },
          "finishing_hours": {
            "type": "number"
          },
          "finishing_cost": {
            "type": "number"
          },
          "pole_cost": {
            "type": "number",
            "description": "LEGACY item-level pole cost snapshot \u2014 never summed into totals (poles are priced on project.poles only, CMP-E01)."
          },
          "pole_painting_cost": {
            "type": "number",
            "description": "LEGACY item-level pole painting cost snapshot \u2014 never summed into totals."
          },
          "brick_count": {
            "type": "number"
          },
          "brick_cost": {
            "type": "number"
          },
          "fill_volume_cy": {
            "type": "number"
          },
          "fill_cost": {
            "type": "number"
          },
          "item_total_cost": {
            "type": "number"
          },
          "custom_concrete_cost_per_cy": {
            "type": "number"
          },
          "custom_rebar_cost_per_ft": {
            "type": "number"
          },
          "custom_concrete_qty": {
            "type": "number"
          },
          "custom_rebar_qty": {
            "type": "number"
          },
          "custom_forming_rate": {
            "type": "number"
          },
          "custom_forming_qty": {
            "type": "number"
          },
          "custom_finishing_rate": {
            "type": "number"
          },
          "custom_finishing_hours": {
            "type": "number"
          },
          "custom_excavation_rate": {
            "type": "number"
          },
          "custom_excavation_hours": {
            "type": "number"
          },
          "rebar_layers": {
            "type": "number"
          },
          "rebar_layer_separation_inches": {
            "type": "number"
          },
          "pillar_rebar_size": {
            "type": "string"
          },
          "pillar_rebar_hoop_diameter": {
            "type": "number"
          },
          "pillar_rebar_layer_separation_inches": {
            "type": "number"
          },
          "pillar_rebar_layers": {
            "type": "number"
          },
          "pillar_vertical_rebar_count": {
            "type": "number"
          },
          "selected_concrete_id": {
            "type": "string"
          },
          "excavation_method": {
            "type": "string",
            "enum": [
              "hand_dig",
              "equipment_excavation"
            ]
          },
          "is_new_sign_location": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "beautify_data_url": {
      "type": "string"
    },
    "poles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pole_id": {
            "type": "string"
          },
          "x_inches": {
            "type": "number"
          },
          "z_inches": {
            "type": "number"
          },
          "height_inches": {
            "type": "number",
            "description": "Height of the pole above finished grade in inches \u2014 a distinct required quantity (CMP-E02)."
          },
          "y_offset_inches": {
            "type": "number",
            "description": "Legacy spelling of embedment below grade in inches; the canonical field is embedment_inches. When both are recorded they must agree."
          },
          "embedment_inches": {
            "type": "number",
            "description": "Canonical depth of the pole below finished grade in inches; supersedes the legacy y_offset_inches spelling of the same quantity."
          },
          "base_offset_inches": {
            "type": "number",
            "description": "Height of the pole's base above finished grade (wall/pier mounting). Placement metadata only \u2014 never contributes to billed material length."
          },
          "total_length_inches": {
            "type": "number",
            "description": "Explicit purchased/billed total stock length override; when recorded it is the billed length instead of height above grade plus embedment."
          },
          "required_length_inches": {
            "type": "number",
            "description": "Calculated billed material length snapshot \u2014 the explicit total stock length when recorded, else height above grade plus embedment."
          },
          "stock_pieces": {
            "type": "integer",
            "description": "Calculated stock-piece count under the catalog stock_price pricing mode; null under per-foot pricing."
          },
          "pole_shape": {
            "type": "string",
            "description": "Actual cross-section shape (round/square/rectangular/elliptical/other or a catalog value); falls back to the catalog row's pole_shape when unrecorded."
          },
          "component_id": {
            "type": "string"
          },
          "foundation_component_id": {
            "type": "string"
          },
          "foundation_idx": {
            "type": "number"
          },
          "paint": {
            "type": "boolean"
          },
          "include_pole_painting": {
            "type": "boolean",
            "default": false,
            "description": "Canonical pole-painting flag consumed by the priced path (the 'paint' boolean is a legacy alias not read by pricing)."
          },
          "custom_cost_per_unit": {
            "type": "number",
            "description": "Per-pole rate override \u2014 $/linear foot or $/stock piece depending on the catalog row's pole_pricing_mode."
          },
          "pole_name": {
            "type": "string",
            "description": "Calculated snapshot of the resolved catalog material name."
          },
          "pole_cost": {
            "type": "number",
            "description": "Calculated pole material cost snapshot."
          },
          "pole_painting_cost": {
            "type": "number",
            "description": "Calculated pole painting cost snapshot."
          },
          "total_cost": {
            "type": "number",
            "description": "Calculated pole + painting cost snapshot."
          },
          "migrated_from": {
            "type": "string",
            "description": "Provenance marker; 'legacy_item' when the row was created from legacy item-level pole fields (CMP-E01)."
          },
          "source_item_component_id": {
            "type": "string",
            "description": "Foundation item this pole was migrated from, when migrated_from is set."
          },
          "legacy_pole_offset_from_bottom_inches": {
            "type": "number",
            "description": "Preserved legacy item field \u2014 offset of the pole above the footing bottom. Never interpreted as embedment."
          },
          "rotation_degrees": {
            "type": "number"
          },
          "signs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "heightInches": {
            "type": "number",
            "default": 24
          },
          "materialId": {
            "type": "string"
          },
          "internalMaterialId": {
            "type": "string"
          },
          "includeInternalWall": {
            "type": "boolean"
          },
          "internalWallHeightInches": {
            "type": "number"
          },
          "internalMortarGapInches": {
            "type": "number"
          },
          "useExistingFoundation": {
            "type": "boolean",
            "default": false
          },
          "mortarGapInches": {
            "type": "number",
            "default": 0.375
          },
          "offsetFraction": {
            "type": "number",
            "default": 0.5
          },
          "shape": {
            "type": "object",
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "closed": {
                "type": "boolean"
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "calculatedCosts": {
            "type": "object",
            "properties": {
              "totalBricks": {
                "type": "number"
              },
              "materialCost": {
                "type": "number"
              },
              "mortarCost": {
                "type": "number"
              },
              "laborHours": {
                "type": "number"
              },
              "laborCost": {
                "type": "number"
              },
              "totalCost": {
                "type": "number"
              },
              "totalLinearInches": {
                "type": "number"
              },
              "numCourses": {
                "type": "number"
              },
              "internalTotalBricks": {
                "type": "number"
              },
              "internalMaterialCost": {
                "type": "number"
              },
              "internalMortarCost": {
                "type": "number"
              },
              "internalLaborCost": {
                "type": "number"
              },
              "internalLaborHours": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "wall_caps": {
      "type": "array",
      "description": "Wall cap pieces placed on top of outer walls.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cap_inventory_id": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "wall_component_id": {
            "type": "string"
          },
          "segment_component_id": {
            "type": "string"
          },
          "wall_index": {
            "type": "number"
          },
          "segment_index": {
            "type": "number"
          },
          "position_along_segment_inches": {
            "type": "number"
          },
          "length_inches": {
            "type": "number",
            "description": "Actual cut length used. May be shorter than stock; full stock is still charged."
          },
          "rotation_offset_degrees": {
            "type": "number",
            "default": 0
          },
          "lateral_offset_inches": {
            "type": "number",
            "default": 0,
            "description": "Side-to-side offset from wall centerline (negative = outer side)"
          }
        }
      }
    },
    "signage_cabinets": {
      "type": "array",
      "description": "Signage cabinets mounted directly on a foundation or on a placed pole.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "mount": {
            "type": "string",
            "enum": [
              "foundation",
              "pole"
            ],
            "default": "foundation"
          },
          "component_id": {
            "type": "string"
          },
          "foundation_component_id": {
            "type": "string"
          },
          "pole_component_id": {
            "type": "string"
          },
          "foundation_index": {
            "type": "number"
          },
          "pole_index": {
            "type": "number"
          },
          "width_inches": {
            "type": "number",
            "default": 48
          },
          "height_inches": {
            "type": "number",
            "default": 24
          },
          "depth_inches": {
            "type": "number",
            "default": 8
          },
          "mount_height_inches": {
            "type": "number",
            "default": 0
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_cost": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "landscape": {
      "type": "object",
      "description": "Site landscaping painted on the landscape designer grid. cells maps 'x,y' grid keys to a material key; cell_size_inches is the size of one cell.",
      "additionalProperties": true
    },
    "customer_markup_percent": {
      "type": "number",
      "default": 0,
      "description": "Markup applied to this section's cost to reach the customer price."
    },
    "customer_price_override": {
      "type": "number",
      "description": "Manual customer price for this section; overrides the markup calculation when set."
    },
    "customer_pricing": {
      "type": "object",
      "description": "Optional saved customer sell-price snapshot from the shared Markup Tier engine. Manual Foundation markup/override remains the fallback until a tier is explicitly applied.",
      "additionalProperties": true
    },
    "pricing_engine": {
      "type": "object",
      "description": "F-23h: optional pricing-engine context block \u2014 {customer_tier, tier_rules[], templates[], default_markup_pct, tax_percent, setup_fee, minimum_charge}. When present, foundationPricingWire routes the sell side through the shared engine; absent = legacy pricing verbatim.",
      "additionalProperties": true
    },
    "selected_equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "equipment_id": {
            "type": "string"
          },
          "rental_period": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month"
            ]
          },
          "rental_duration": {
            "type": "number"
          },
          "include_delivery": {
            "type": "boolean"
          },
          "equipment_cost": {
            "type": "number"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "selected_concrete_id": {
      "type": "string"
    },
    "excavation_method": {
      "type": "string",
      "enum": [
        "hand_dig",
        "equipment_excavation"
      ]
    },
    "concrete_cost_per_cy": {
      "type": "number",
      "default": 135
    },
    "rebar_cost_per_ft": {
      "type": "number",
      "default": 0.75
    },
    "forming_materials_cost_spread_foot": {
      "type": "number",
      "default": 0.5
    },
    "forming_materials_cost_pillar": {
      "type": "number",
      "default": 0.75
    },
    "min_excavation_time_hours": {
      "type": "number",
      "default": 1
    },
    "hand_dig_excavation_cost_per_cy": {
      "type": "number",
      "default": 10
    },
    "equipment_excavation_cost_per_cy": {
      "type": "number",
      "default": 15
    },
    "forming_labor_rate": {
      "type": "number",
      "default": 55
    },
    "pouring_labor_rate": {
      "type": "number",
      "default": 60
    },
    "finishing_labor_rate": {
      "type": "number",
      "default": 50
    },
    "hand_dig_labor_rate": {
      "type": "number",
      "default": 45
    },
    "equipment_excavation_labor_rate": {
      "type": "number",
      "default": 35
    },
    "total_concrete_cost": {
      "type": "number"
    },
    "concrete_delivery_snapshot": {
      "type": "object",
      "description": "Versioned historical order snapshot saved atomically with the source design; never current pricing when catalog items are unavailable.",
      "properties": {
        "version": {
          "type": "integer"
        },
        "concrete_total": {
          "type": "number"
        },
        "rounded_yards": {
          "type": "number"
        },
        "rate_per_yard": {
          "type": "number"
        },
        "additional_stops_cost": {
          "type": "number"
        },
        "trucks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "yards": {
                "type": "number"
              },
              "rounded_yards": {
                "type": "number"
              },
              "cost": {
                "type": "number"
              },
              "small_order_fee": {
                "type": "number"
              },
              "fuel_fee": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "total_rebar_cost": {
      "type": "number"
    },
    "total_excavation_cost": {
      "type": "number"
    },
    "total_labor_cost": {
      "type": "number"
