{
  "name": "PermitLocality",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Locality name"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation"
    },
    "zip": {
      "type": "string",
      "description": "ZIP / postal code"
    },
    "governing_body": {
      "type": "string",
      "description": "LEGACY \u2014 Governing body name"
    },
    "office_type": {
      "type": "string",
      "description": "LEGACY \u2014 Default office type"
    },
    "contact_phone": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_email": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_website": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_address": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_department": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_notes": {
      "type": "string",
      "description": "LEGACY"
    },
    "offices": {
      "type": "array",
      "description": "Offices belonging to this locality. Each office has its own workflow steps and is applied as a separate line when the locality is selected.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Display name for this office (e.g. 'Hamilton County Zoning')"
          },
          "office_type": {
            "type": "string",
            "description": "LEGACY single office category. Use office_types (array) for multi-select."
          },
          "office_types": {
            "type": "array",
            "description": "Office categories this office covers (e.g. ['Zoning', 'Building']).",
            "items": {
              "type": "string"
            }
          },
          "contact_phone": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "contact_website": {
            "type": "string"
          },
          "contact_address": {
            "type": "string"
          },
          "contact_notes": {
            "type": "string"
          },
          "workflow_steps": {
            "type": "array",
            "description": "Workflow steps for this office",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "checkbox",
                    "submitted_date",
                    "followup_date",
                    "permit_received_date",
                    "text"
                  ]
                },
                "followup_interval_days": {
                  "type": "number",
                  "default": 14
                },
                "order": {
                  "type": "number"
                },
                "tied_to_step_id": {
                  "type": "string",
                  "description": "Optional \u2014 links a non-checkbox step to a checkbox step that marks completion."
                }
              }
            }
          },
          "order": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "workflow_steps": {
      "type": "array",
      "description": "LEGACY \u2014 kept for backwards compatibility. New data lives in offices[].workflow_steps.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "checkbox",
              "submitted_date",
              "followup_date",
              "permit_received_date",
              "text"
            ]
          },
          "followup_interval_days": {
            "type": "number",
            "default": 14
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "description": "LEGACY \u2014 kept for backwards compatibility.",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}