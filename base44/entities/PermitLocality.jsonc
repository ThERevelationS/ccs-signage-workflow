{
  "name": "PermitLocality",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Locality name"
    },
    "state": {
      "type": "string",
      "description": "State abbreviation"
    },
    "county_name": {
      "type": "string",
      "description": "County this jurisdiction sits in (multi-county municipalities: ' / '-joined, e.g. 'Boyle County / Lincoln County'). Identity field \u2014 same-name localities in different counties are different jurisdictions and must never merge."
    },
    "jurisdiction_type": {
      "type": "string",
      "enum": [
        "county",
        "city",
        "village",
        "township",
        "municipality",
        "unincorporated_community"
      ],
      "description": "Kind of jurisdiction, from the linked JurisdictionProfile.type. Township vs city/village never merge."
    },
    "zip": {
      "type": "string",
      "description": "ZIP / postal code"
    },
    "jurisdiction_profile_id": {
      "type": "string",
      "description": "Optional canonical JurisdictionProfile ID this tracker locality was explicitly created from. Existing legacy localities may remain unlinked until staff verifies the relationship."
    },
    "office_change_log": {
      "type": "array",
      "description": "Append-only (cap 20) log of detected changes to this locality's offices[] \u2014 entries {at, summary, office_count, verified_count} written by the office-diff worker. Powers the 'offices updated' alerts.",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "office_count": {
            "type": "number"
          },
          "verified_count": {
            "type": "number"
          }
        }
      }
    },
    "observed_outcomes": {
      "type": "object",
      "description": "MP-11.4 \u2014 observed-vs-claimed aggregation from real filed permits: {permits_observed, avg_decision_days, fee_min, fee_max, fee_avg, denial_count, computed_at, sample_window}. Stamped by the office-diff worker from the PermitLineItem mirror.",
      "properties": {
        "permits_observed": {
          "type": "number"
        },
        "avg_decision_days": {
          "type": "number"
        },
        "fee_min": {
          "type": "number"
        },
        "fee_max": {
          "type": "number"
        },
        "fee_avg": {
          "type": "number"
        },
        "denial_count": {
          "type": "number"
        },
        "computed_at": {
          "type": "string"
        },
        "sample_window": {
          "type": "string"
        }
      }
    },
    "governing_body": {
      "type": "string",
      "description": "LEGACY \u2014 Governing body name"
    },
    "office_type": {
      "type": "string",
      "description": "LEGACY \u2014 Default office type"
    },
    "contact_phone": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_email": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_website": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_address": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_department": {
      "type": "string",
      "description": "LEGACY"
    },
    "contact_notes": {
      "type": "string",
      "description": "LEGACY"
    },
    "zoning_authority": {
      "type": "string",
      "enum": [
        "township_own",
        "county",
        "municipal",
        "joint_commission",
        "regional"
      ],
      "description": "How this locality is zoned: township_own = township adopted its own zoning resolution (ORC 519); county = defers to county zoning; joint_commission/regional = shared authority. Records the MODEL, not just which office \u2014 distinguishes 'not found yet' from 'correctly county'."
    },
    "sign_code_url": {
      "type": "string",
      "description": "URL of this locality's sign ordinance/code section (code library or local code page)."
    },
    "permit_required_summary": {
      "type": "string",
      "description": "Whether/when a sign permit is required here, from ordinance or official pages (e.g. 'required for signs >6 sqft; exempt: temporary <32 sqft')."
    },
    "overlay_flags": {
      "type": "array",
      "description": "Special-district overlays that change permitting: historic_district, state_route_row, airport, floodway, scenic_byway.",
      "items": {
        "type": "string"
      }
    },
    "offices": {
      "type": "array",
      "description": "Offices belonging to this locality. Each office has its own workflow steps and is applied as a separate line when the locality is selected.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "catalog_office_id": {
            "type": "string",
            "description": "Optional ID of the reusable office catalog entry copied into this locality. Provenance only; not verification of legal permitting authority."
          },
          "government_office_id": {
            "type": "string",
            "description": "Stable canonical identity of the government office represented by this locality-specific workflow copy. This identity does not itself prove that the office has authority for this locality."
          },
          "authority_roles": {
            "type": "array",
            "description": "Explicit staff-reviewed authority roles this office performs for this locality. Empty or absent means authority has not been established; office_type/office_types must not be treated as legal authority.",
            "items": {
              "type": "string",
              "enum": [
                "sign_permit",
                "zoning",
                "building",
                "electrical",
                "electrical_permit",
                "electrical_inspection",
                "right_of_way",
                "historic_review",
                "planning",
                "transportation",
                "other"
              ]
            }
          },
          "authority_verification_status": {
            "type": "string",
            "enum": [
              "needs_verification",
              "staff_verified",
              "needs_recheck"
            ],
            "description": "Review state for this locality-to-office authority relationship. staff_verified means staff confirmed the listed authority_roles; it does not verify unrelated office contact or repository facts."
          },
          "recheck_reason": {
            "type": "string",
            "description": "Why this office was moved to needs_recheck (failed strict re-verification sub-check or audit demotion reason)."
          },
          "recheck_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this office was moved to needs_recheck."
          },
          "authority_verified_at": {
            "type": "string",
            "format": "date-time",
            "description": "When staff last verified this locality-to-office authority relationship."
          },
          "authority_verified_by": {
            "type": "string",
            "description": "Employee who last verified this locality-to-office authority relationship."
          },
          "authority_verification_notes": {
            "type": "string",
            "description": "Optional staff notes or source context supporting this locality-to-office authority relationship."
          },
          "corroboration_tier": {
            "type": "string",
            "enum": [
              "verified",
              "single_source"
            ],
            "description": "MP-5.2 \u2014 'verified' only when every proven role is backed by \u22652 distinct official evidence hosts; otherwise 'single_source'."
          },
          "corroboration_tiers": {
            "type": "object",
            "additionalProperties": true,
            "description": "Per-role corroboration tier map: {role: 'verified'|'single_source'}."
          },
          "name": {
            "type": "string",
            "description": "Display name for this office (e.g. 'Hamilton County Zoning')"
          },
          "office_type": {
            "type": "string",
            "description": "LEGACY single office category. Use office_types (array) for multi-select."
          },
          "office_types": {
            "type": "array",
            "description": "Office categories this office covers (e.g. ['Zoning', 'Building']).",
            "items": {
              "type": "string"
            }
          },
          "contact_phone": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "contact_website": {
            "type": "string"
          },
          "contact_address": {
            "type": "string"
          },
          "hours": {
            "type": "string",
            "description": "Office hours in plain text ('Mon-Fri 8a-4:30p') \u2014 'open now?' is a display concern."
          },
          "contact_notes": {
            "type": "string"
          },
          "application_form_url": {
            "type": "string",
            "description": "Direct URL to this office's permit application form (usually a PDF on the official site)."
          },
          "application_form_name": {
            "type": "string",
            "description": "Human-readable form name as published (e.g. 'Sign Permit Application')."
          },
          "fee_schedule_text": {
            "type": "string",
            "description": "Fee/cost language found on the official permit page or PDF (verbatim excerpt)."
          },
          "fee_schedule_url": {
            "type": "string",
            "description": "URL of the published fee schedule page or document."
          },
          "fee_structured": {
            "type": "object",
            "description": "Machine-readable fee model when extractable: {flat, per_sqft, base, per, notes}."
          },
          "submission_methods": {
            "type": "array",
            "description": "How applications are accepted: mail/drop_off/online_portal/email/fax/in_person.",
            "items": {
              "type": "string"
            }
          },
          "typical_review_time": {
            "type": "string",
            "description": "Published review/turnaround language (e.g. 'permits issued within 10 business days')."
          },
          "contact_person": {
            "type": "string",
            "description": "Named staff contact for this office when published (e.g. 'Jane Smith, Zoning Inspector')."
          },
          "canonical_provider_id": {
            "type": "string",
            "description": "Links this locality-specific office to the shared canonical provider record (e.g. a county dept serving many jurisdictions). Identity link, not a merge."
          },
          "provider_type": {
            "type": "string",
            "enum": [
              "government",
              "county",
              "regional",
              "joint_commission",
              "state_certified_private",
              "utility"
            ],
            "description": "What kind of provider this office is \u2014 determines where research should look (e.g. state_certified_private = a certified private inspection agency, not a government)."
          },
          "field_confidence": {
            "type": "object",
            "description": "Per-field reliability map: {contact_phone:'high|low', contact_email:...} based on where the data was found (dept page=high, footer=low, PDF letterhead=high)."
          },
          "data_as_of": {
            "type": "string",
            "format": "date-time",
            "description": "When this office's contact data was last confirmed against its source."
          },
          "service_area": {
            "type": "string",
            "description": "Service-area note when the provider serves beyond this locality (e.g. 'county-administered for X')."
          },
          "ordinance_url": {
            "type": "string",
            "description": "URL of the controlling sign/zoning ordinance section (code library or local code page)."
          },
          "required_documents": {
            "type": "array",
            "description": "Items the application requires (site plan, drawings, insurance cert, contractor license...).",
            "items": {
              "type": "string"
            }
          },
          "meeting_schedule_text": {
            "type": "string",
            "description": "Board/commission meeting and submission-deadline language for variance paths."
          },
          "installer_registration_required": {
            "type": "boolean",
            "description": "Sign contractor/installer must register or be licensed with this jurisdiction before erecting."
          },
          "overlay_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Derived overlay contexts on this office: historic_district, row_permit_possible, etc."
          },
          "inspection_contact": {
            "type": "string",
            "description": "How to schedule the inspection (phone/portal/text) when published."
          },
          "permit_expiry_text": {
            "type": "string",
            "description": "Permit validity/expiry language from official text (\"valid for 180 days\", \"expires\")."
          },
          "preferred_contact_method": {
            "type": "string",
            "description": "The contact channel the office itself prefers when stated."
          },
          "workflow_steps": {
            "type": "array",
            "description": "Workflow steps for this office",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "checkbox",
                    "submitted_date",
                    "followup_date",
                    "permit_received_date",
                    "text"
                  ]
                },
                "followup_interval_days": {
                  "type": "number",
                  "default": 14
                },
                "order": {
                  "type": "number"
                },
                "tied_to_step_id": {
                  "type": "string",
                  "description": "Optional \u2014 links a non-checkbox step to a checkbox step that marks completion."
                }
              }
            }
          },
          "order": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "workflow_steps": {
      "type": "array",
      "description": "LEGACY \u2014 kept for backwards compatibility. New data lives in offices[].workflow_steps.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "checkbox",
              "submitted_date",
              "followup_date",
              "permit_received_date",
              "text"
            ]
          },
          "followup_interval_days": {
            "type": "number",
            "default": 14
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "description": "LEGACY \u2014 kept for backwards compatibility.",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "changed_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Audit trail of edits to this jurisdiction \u2014 server-appended on each gateway update: {at, by, changed_fields}."
    },
    "pending_applies": {
      "type": "array",
      "description": "Deferred office applies \u2014 Apply-when-verified queues {work_order_id, requested_by, requested_at, exclude_electrical} here; the verification worker creates the permit lines the moment sign+zoning verify, then removes the entry.",
      "items": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "string"
          },
          "requested_by": {
            "type": "string"
          },
          "requested_at": {
            "type": "string"
          },
          "exclude_electrical": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__permitlocality_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__permitlocality_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__permitlocality_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__permitlocality_backend_only__"
      }
    }
  }
}