{
  "name": "PricingTierMatrix",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display label for this matrix row, e.g. 'Retail / Banners qty breaks'."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Inactive rows are ignored by the pricing engine."
    },
    "customer_tier": {
      "type": "string",
      "description": "MarkupTier this row applies to \u2014 tier_name, tier_number, or record id. Blank means the row is a category-wide default that applies to every tier."
    },
    "category": {
      "type": "string",
      "description": "Sign category key (MarkupCategory.category_key) this row prices. Blank means the row is a tier-wide default covering every category."
    },
    "markup_pct": {
      "type": "number",
      "default": 0,
      "description": "Markup percent over unit cost. 50 = sell at cost x 1.50. Ignored when a matching per_unit_breaks bracket applies."
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "markup",
        "market"
      ],
      "default": "markup",
      "description": "Pricing path for this row. 'markup' prices at markup_pct over unit cost. 'market' prices at market_retail less market_discount_pct; a qualifying per_unit_breaks bracket still wins when it prices lower than the market price."
    },
    "market_retail": {
      "type": "number",
      "description": "Market-based pricing: prevailing retail unit price this row tracks. Required for pricing_mode = 'market'; a market row without it falls back to markup pricing."
    },
    "market_discount_pct": {
      "type": "number",
      "default": 0,
      "description": "Market-based pricing: percent off market_retail. 10 = sell at 90% of retail."
    },
    "minimum_charge": {
      "type": "number",
      "default": 0,
      "description": "Line-level floor price. When the computed extension lands above zero but below this amount, the line is raised to the minimum."
    },
    "per_unit_breaks": {
      "type": "array",
      "description": "Quantity price breaks: when qty >= bracket qty, the bracket unit_price replaces markup_pct pricing.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "qty": {
            "type": "number",
            "description": "Minimum quantity that unlocks this bracket."
          },
          "unit_price": {
            "type": "number",
            "description": "Sell price per unit inside this bracket."
          }
        }
      }
    },
    "formula_modifiers": {
      "type": "array",
      "description": "Ordered unit-price adjustments applied after markup/market/break resolution, evaluated left to right. Each item: {type: 'add_pct'|'mul'|'add_flat'|'min'|'max', value} \u2014 add_pct: price x (1+value/100); mul: price x value; add_flat: price + value; min: floor at value; max: cap at value.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "add_pct",
              "mul",
              "add_flat",
              "min",
              "max"
            ]
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date",
      "description": "First date (YYYY-MM-DD) this row is effective. Blank = no start bound."
    },
    "effective_to": {
      "type": "string",
      "format": "date",
      "description": "Last date (YYYY-MM-DD, inclusive) this row is effective. Blank = no end bound."
    },
    "updated_by": {
      "type": "string",
      "description": "Email of the staff user who last saved this row (audit)."
    },
    "updated_note": {
      "type": "string",
      "description": "Optional change note left by the last editor (audit)."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__pricingtiermatrix_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__pricingtiermatrix_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__pricingtiermatrix_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__pricingtiermatrix_backend_only__"
      }
    }
  }
}