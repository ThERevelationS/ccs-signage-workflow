{
  "name": "QuoteDefaults",
  "type": "object",
  "description": "Company-wide default Quote Settings. One record ('default'). Every field mirrors a quote setting on AllInOneEstimate \u2014 the Quote Settings panel can load these onto an estimate, and new estimates start from them.",
  "properties": {
    "config_name": {
      "type": "string",
      "default": "default"
    },
    "company_name": {
      "type": "string"
    },
    "company_phone": {
      "type": "string"
    },
    "company_email": {
      "type": "string"
    },
    "company_address": {
      "type": "string"
    },
    "company_website": {
      "type": "string"
    },
    "company_license": {
      "type": "string",
      "description": "License / registration number printed under the company block."
    },
    "company_logo_url": {
      "type": "string"
    },
    "quote_title": {
      "type": "string",
      "default": "Project Estimate"
    },
    "quote_accent_color": {
      "type": "string",
      "default": "#4f46e5"
    },
    "quote_valid_days": {
      "type": "number",
      "default": 30
    },
    "payment_terms": {
      "type": "string"
    },
    "quote_intro_text": {
      "type": "string"
    },
    "quote_footer_text": {
      "type": "string"
    },
    "quote_terms_conditions": {
      "type": "string"
    },
    "warranty_text": {
      "type": "string"
    },
    "lead_time_text": {
      "type": "string"
    },
    "scope_auto_apply": {
      "type": "boolean",
      "default": true
    },
    "hide_section_prices": {
      "type": "boolean",
      "default": false
    },
    "show_company_block": {
      "type": "boolean",
      "default": true
    },
    "show_logo": {
      "type": "boolean",
      "default": false
    },
    "show_contact_block": {
      "type": "boolean",
      "default": true
    },
    "show_estimate_number": {
      "type": "boolean",
      "default": true
    },
    "show_po_number": {
      "type": "boolean",
      "default": true
    },
    "show_site_address": {
      "type": "boolean",
      "default": true
    },
    "show_dates": {
      "type": "boolean",
      "default": true
    },
    "show_category_column": {
      "type": "boolean",
      "default": true
    },
    "show_section_descriptions": {
      "type": "boolean",
      "default": true
    },
    "show_quantity_column": {
      "type": "boolean",
      "default": false
    },
    "show_scope_lists": {
      "type": "boolean",
      "default": true
    },
    "show_subtotal_line": {
      "type": "boolean",
      "default": true
    },
    "show_discount_line": {
      "type": "boolean",
      "default": true
    },
    "show_fees_line": {
      "type": "boolean",
      "default": true
    },
    "show_tax_line": {
      "type": "boolean",
      "default": true
    },
    "show_deposit_lines": {
      "type": "boolean",
      "default": true
    },
    "show_notes_on_quote": {
      "type": "boolean",
      "default": false,
      "description": "When true, estimate-level notes are included on the customer quote. Defaults off because estimate notes may contain internal project context."
    },
    "show_terms_block": {
      "type": "boolean",
      "default": true
    },
    "show_warranty_block": {
      "type": "boolean",
      "default": true
    },
    "show_lead_time_block": {
      "type": "boolean",
      "default": true
    },
    "show_signature_block": {
      "type": "boolean",
      "default": true
    },
    "show_validity_footer": {
      "type": "boolean",
      "default": true
    },
    "round_prices_to_dollar": {
      "type": "boolean",
      "default": false
    },
    "custom_statuses": {
      "type": "string",
      "description": "JSON slug array of custom estimate statuses (K-11), e.g. [\"on_hold\",\"in_prod\"]. Empty string = none."
    },
    "status_transitions": {
      "type": "string",
      "description": "JSON {from:[to,...]} transition-override map \u2014 replaces a source row wholesale, never merges."
    },
    "custom_status_meta": {
      "type": "string",
      "description": "Optional JSON {key:{label,color,terminal,bucket,roles,allow_builtin_reentry}} rich status metadata (customStatusModel)."
    },
    "email_signature": {
      "type": "string",
      "description": "Signature block appended to quote delivery emails (K-10; stored key in QUOTE_DEFAULT_KEYS)."
    },
    "email_subject_template": {
      "type": "string",
      "description": "Quote email subject template; supports the 7 deployed interpolateQuoteTemplate tokens."
    },
    "email_message_template": {
      "type": "string",
      "description": "Quote email body template; supports the deployed interpolateQuoteTemplate tokens."
    },
    "estimate_number_format": {
      "type": "string",
      "description": "Estimate numbering pattern for this config (K-09 numberingModel; e.g. EST-{seq})."
    },
    "order_number_format": {
      "type": "string",
      "description": "Work-order numbering pattern for this config (K-09)."
    },
    "doc_number_padding": {
      "type": "number",
      "description": "Zero-padding width for {seq} in numbering patterns (K-09)."
    },
    "module_number_prefixes": {
      "type": "string",
      "description": "JSON {module:prefix} per-module numbering prefix map (K-09)."
    },
    "display_timezone": {
      "type": "string",
      "description": "IANA timezone for quote/print date rendering (K-12 user-defaults host; e.g. America/New_York)."
    },
    "default_tax_group": {
      "type": "string",
      "description": "TaxGroup name applied by default when an estimate has no manual pick (K-10 resolution chain: manual > customer > this > TaxGroup.is_default)."
    },
    "number_reissue_policy": {
      "type": "string",
      "description": "Whether voided/deleted doc numbers may be reused: never|on_void|always (K-09)."
    },
    "signature_text": {
      "type": "string",
      "description": "Print-surface signature block text (K-10 proposed slot \u2014 distinct from email_signature used in delivery emails)."
    },
    "disclaimer_text": {
      "type": "string",
      "description": "Optional disclaimer line in the ordered print footer (K-10 proposed slot 2; renders after warranty/terms)."
    },
    "tax_rate_source": {
      "type": "string",
      "enum": [
        "auto",
        "customer_default",
        "shop_default",
        "group_default",
        "manual",
        "none"
      ],
      "description": "Tax-rate source picker (K-10): which hop of the resolution chain this config prefers."
    }
  },
  "required": [
    "config_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__quotedefaults_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__quotedefaults_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__quotedefaults_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__quotedefaults_backend_only__"
      }
    }
  }
}