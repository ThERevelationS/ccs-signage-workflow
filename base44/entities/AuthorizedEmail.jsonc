{
  "name": "AuthorizedEmail",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Authorized email address"
    },
    "full_name": {
      "type": "string",
      "description": "User's full name"
    },
    "access_expires_on": {
      "type": "string",
      "format": "date",
      "description": "Temporary-access expiry date \u2014 admins review and revoke at or before this date"
    },
    "reports_to": {
      "type": "string",
      "description": "Manager / supervisor this user reports to (name or email)"
    },
    "username": {
      "type": "string",
      "description": "Unique username for time clock login"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent successful staff sign-in \u2014 drives last-active display and inactive-user flags"
    },
    "password_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the password was last set or rehashed \u2014 drives password-age expiry warnings"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password for time clock login",
      "rls": {
        "create": {
          "user_condition": {
            "role": "__authorizedemail_backend_only__"
          }
        },
        "read": {
          "user_condition": {
            "role": "__authorizedemail_backend_only__"
          }
        },
        "update": {
          "user_condition": {
            "role": "__authorizedemail_backend_only__"
          }
        },
        "delete": {
          "user_condition": {
            "role": "__authorizedemail_backend_only__"
          }
        }
      }
    },
    "password_reset_token": {
      "type": "string",
      "description": "Legacy raw password reset token. New reset links store only password_reset_token_hash.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "password_reset_token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the active password reset bearer token",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "password_reset_expires": {
      "type": "string",
      "format": "date-time",
      "description": "When the password reset token expires",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "session_not_before": {
      "type": "string",
      "format": "date-time",
      "description": "Custom sign-shop sessions issued before this timestamp are invalid. Advanced on password changes and credential resets."
    },
    "failed_login_count": {
      "type": "integer",
      "default": 0,
      "description": "Consecutive failed sign-in attempts. Reset on success or credential change.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "login_locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Sign-in attempts are refused until this time after repeated failures.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "User role"
    },
    "sales_roles": {
      "type": "array",
      "description": "Sales pipeline roles this user can be assigned to",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sales_pipeline_preferences": {
      "type": "object",
      "description": "User-specific Sales Pipeline filter and column-view selections restored across sessions",
      "properties": {
        "information_filter": {
          "type": "string"
        },
        "attention_filter": {
          "type": "string"
        },
        "column_preset_id": {
          "type": "string"
        }
      }
    },
    "can_import_export": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user can import/export data"
    },
    "can_order_export": {
      "type": "boolean",
      "default": false,
      "description": "Explicit admin-assigned permission to display the Order Form Export button. Requires admin role."
    },
    "can_view_resources": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user can view the Resources page"
    },
    "can_approve_quotes": {
      "type": "boolean",
      "default": false,
      "description": "User can approve quotes above the internal approval threshold."
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "hourly",
        "salary"
      ],
      "default": "hourly",
      "description": "Employment classification for Time Clock/reporting context only"
    },
    "can_work_pause": {
      "type": "boolean",
      "default": false,
      "description": "Admin-assigned permission to pause counted work time without clocking out"
    },
    "face_descriptors": {
      "type": "array",
      "description": "Stored face recognition descriptors for this user",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "default": []
    },
    "hr_data": {
      "type": "object",
      "description": "HR and personal data (admin access only)",
      "properties": {
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "personal_email": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "marital_status": {
          "type": "string",
          "enum": [
            "single",
            "married",
            "divorced",
            "widowed",
            "domestic_partnership",
            "prefer_not_to_say"
          ]
        },
        "nationality": {
          "type": "string"
        },
        "emergency_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "relationship": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "phone_alt": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "education": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "previous_experience": {
          "type": "string"
        },
        "clothing_sizes": {
          "type": "object",
          "properties": {
            "shirt": {
              "type": "string"
            },
            "hoodie": {
              "type": "string"
            },
            "pants_waist": {
              "type": "string"
            },
            "pants_length": {
              "type": "string"
            },
            "hat": {
              "type": "string"
            },
            "shoe": {
              "type": "string"
            }
          }
        },
        "hire_date": {
          "type": "string",
          "format": "date"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "onboarding_token": {
      "type": "string",
      "description": "Legacy raw onboarding token. New invitations store only onboarding_token_hash.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the active onboarding bearer token",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_expires": {
      "type": "string",
      "format": "date-time",
      "description": "When the onboarding token expires",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has completed onboarding"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}