{
  "name": "AuthorizedEmail",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Authorized email address"
    },
    "full_name": {
      "type": "string",
      "description": "User's full name"
    },
    "username": {
      "type": "string",
      "description": "Unique username for time clock login"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password for time clock login",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "password_reset_token": {
      "type": "string",
      "description": "Token for password reset",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "password_reset_expires": {
      "type": "string",
      "format": "date-time",
      "description": "When the password reset token expires",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "session_not_before": {
      "type": "string",
      "format": "date-time",
      "description": "Custom sign-shop sessions issued before this timestamp are invalid. Advanced on password changes and credential resets."
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "User role"
    },
    "sales_roles": {
      "type": "array",
      "description": "Sales pipeline roles this user can be assigned to",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "can_import_export": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user can import/export data"
    },
    "can_view_resources": {
      "type": "boolean",
      "default": false,
      "description": "Whether this user can view the Resources page"
    },
    "face_descriptors": {
      "type": "array",
      "description": "Stored face recognition descriptors for this user",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "default": []
    },
    "hr_data": {
      "type": "object",
      "description": "HR and personal data (admin access only)",
      "properties": {
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "personal_email": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string",
          "format": "date"
        },
        "marital_status": {
          "type": "string",
          "enum": [
            "single",
            "married",
            "divorced",
            "widowed",
            "domestic_partnership",
            "prefer_not_to_say"
          ]
        },
        "nationality": {
          "type": "string"
        },
        "emergency_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "relationship": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "phone_alt": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "education": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "previous_experience": {
          "type": "string"
        },
        "clothing_sizes": {
          "type": "object",
          "properties": {
            "shirt": {
              "type": "string"
            },
            "hoodie": {
              "type": "string"
            },
            "pants_waist": {
              "type": "string"
            },
            "pants_length": {
              "type": "string"
            },
            "hat": {
              "type": "string"
            },
            "shoe": {
              "type": "string"
            }
          }
        },
        "hire_date": {
          "type": "string",
          "format": "date"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "onboarding_token": {
      "type": "string",
      "description": "Token for new user onboarding",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_expires": {
      "type": "string",
      "format": "date-time",
      "description": "When the onboarding token expires",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has completed onboarding"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}