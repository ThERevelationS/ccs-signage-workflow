{
  "name": "PermittingSourceTextSegment",
  "type": "object",
  "description": "Append-only physical PDF page evidence batches. Segments become usable only after the parent source receipt commits their page range. Text extraction does not establish adopted authority.",
  "properties": {
    "registration_key": {
      "type": "string",
      "description": "Deterministic identity: source record, exact archive hash, parser method, and first physical page."
    },
    "source_document_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "archived_file_url": {
      "type": "string"
    },
    "file_bytes": {
      "type": "number"
    },
    "method": {
      "type": "string"
    },
    "page_start": {
      "type": "integer"
    },
    "page_end": {
      "type": "integer"
    },
    "total_pages": {
      "type": "integer"
    },
    "payload_sha256": {
      "type": "string",
      "description": "SHA-256 of canonical identity, page range, and page evidence."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "source_document_id": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string"
          },
          "text_sha256": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "extracted_at": {
            "type": "string",
            "format": "date-time"
          },
          "truncated": {
            "type": "boolean"
          },
          "needs_ocr_review": {
            "type": "boolean"
          }
        },
        "required": [
          "page",
          "text",
          "source_document_id",
          "source_sha256",
          "text_sha256",
          "method",
          "truncated",
          "needs_ocr_review"
        ]
      }
    }
  },
  "required": [
    "registration_key",
    "source_document_id",
    "source_sha256",
    "archived_file_url",
    "file_bytes",
    "method",
    "page_start",
    "page_end",
    "total_pages",
    "payload_sha256",
    "pages"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}