{
  "name": "EstimateOption",
  "type": "object",
  "description": "Admin-managed dropdown list values used by the estimate workflow and the customer dialogs. One record per option, grouped by option_type (salesperson, sales_center, terms, customer_origination, industry_type, contact_status, job_authority, master_account, phone_type).",
  "properties": {
    "option_type": {
      "type": "string",
      "enum": [
        "salesperson",
        "sales_center",
        "terms",
        "customer_origination",
        "industry_type",
        "contact_status",
        "job_authority",
        "master_account",
        "phone_type"
      ]
    },
    "label": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Optional \u2014 used for salesperson options."
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "option_type",
    "label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}