{
  "name": "BuilderPartGroup",
  "type": "object",
  "description": "A named, ordered group of Builder Parts inside one Builder Product. Groups can be collapsed and copied/moved as a single unit while retaining every child part.",
  "properties": {
    "builder_product_id": {
      "type": "string"
    },
    "group_key": {
      "type": "string",
      "description": "Stable client-generated key used while editing/copying before/after persistence."
    },
    "group_name": {
      "type": "string",
      "default": "Part Group"
    },
    "client_label": {
      "type": "string",
      "description": "Optional customer-facing label distinct from the internal group name."
    },
    "description": {
      "type": "string"
    },
    "parent_group_id": {
      "type": "string",
      "description": "Optional parent for future nested grouping."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "copy_as_unit": {
      "type": "boolean",
      "default": true,
      "description": "When true copy/move actions operate on the group and all child parts together."
    },
    "is_collapsed": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "group_snapshot": {
      "type": "object",
      "description": "Lossless group-level builder metadata/settings when a module has group-specific configuration.",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "builder_product_id",
    "group_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}