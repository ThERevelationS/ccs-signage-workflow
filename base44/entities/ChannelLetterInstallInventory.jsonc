{
  "name": "ChannelLetterInstallInventory",
  "type": "object",
  "description": "Install materials catalog for the Channel Letter Installation estimator, with per-letter / by-size / per-raceway-foot / flat pricing, quantity tiers and price history. Also shareable with the Maintenance and Foundation material pickers.",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "flush_mount",
        "halo_lit",
        "raceway",
        "dimensional_lettering",
        "backer",
        "all"
      ],
      "default": "all",
      "description": "Legacy single-value field. Use applies_to_list for multi-select."
    },
    "applies_to_list": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "flush_mount",
          "halo_lit",
          "raceway",
          "dimensional_lettering",
          "backer"
        ]
      },
      "description": "Installation types this material applies to. Empty array = applies to all."
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "per_letter_flat",
        "per_letter_by_size",
        "per_raceway_foot",
        "per_project_flat"
      ],
      "default": "per_letter_flat"
    },
    "cost_per_letter": {
      "type": "number",
      "default": 0
    },
    "cost_extra_small": {
      "type": "number",
      "default": 0
    },
    "cost_small": {
      "type": "number",
      "default": 0
    },
    "cost_medium": {
      "type": "number",
      "default": 0
    },
    "cost_large": {
      "type": "number",
      "default": 0
    },
    "cost_extra_large": {
      "type": "number",
      "default": 0
    },
    "cost_extra_extra_large": {
      "type": "number",
      "default": 0
    },
    "cost_per_foot": {
      "type": "number",
      "default": 0
    },
    "cost_flat": {
      "type": "number",
      "default": 0
    },
    "quantity_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "min_qty": {
            "type": "number"
          },
          "max_qty": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          }
        }
      }
    },
    "price_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "changed_at": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "pricing_mode": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "unit": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "show_in_install_materials": {
      "type": "boolean",
      "default": true,
      "description": "Show in the Channel Letter Install \u2014 Materials picker"
    },
    "show_in_maintenance_materials": {
      "type": "boolean",
      "default": false,
      "description": "Show in the Sign Maintenance \u2014 Maintenance Materials picker (Supplies / Parts / Install Materials)"
    },
    "show_in_foundation_materials": {
      "type": "boolean",
      "default": false,
      "description": "Show in the Concrete | Masonry | Poles estimator supplies/materials pickers."
    }
  },
  "required": [
    "item_name",
    "pricing_mode"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}