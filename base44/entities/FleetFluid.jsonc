{
  "name": "FleetFluid",
  "type": "object",
  "description": "Fleet-specific fluids inventory. Separate from all signage/master/estimator inventories.",
  "properties": {
    "fluid_name": {
      "type": "string"
    },
    "fluid_type": {
      "type": "string",
      "description": "Canonical or historical Fleet fluid type. Historical blank/legacy values are preserved exactly during migration; the future UI should offer canonical choices for new records."
    },
    "viscosity": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "description": "Current stock quantity in unit. Legacy missing values remain unset during migration."
    },
    "unit": {
      "type": "string",
      "enum": [
        "quarts",
        "gallons",
        "pints",
        "ounces"
      ]
    },
    "minimum_stock": {
      "type": "number",
      "minimum": 0
    },
    "minimum_stock_unit": {
      "type": "string",
      "enum": [
        "quarts",
        "gallons",
        "pints",
        "ounces"
      ]
    },
    "cost_per_unit": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "enable_low_stock_alerts": {
      "type": "boolean"
    },
    "compatible_equipment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked FleetEquipment ids."
    },
    "created_from_request_id": {
      "type": "string",
      "description": "FleetPartFluidRequest id that created this inventory row, when applicable."
    },
    "receive_receipt_key": {
      "type": "string",
      "description": "Deterministic receive receipt key used to prevent duplicate inventory creation on retries."
    },
    "migration_source_app_id": {
      "type": "string"
    },
    "migration_source_entity": {
      "type": "string"
    },
    "migration_source_id": {
      "type": "string"
    },
    "migration_source_created_date": {
      "type": "string"
    },
    "migration_source_updated_date": {
      "type": "string"
    },
    "migration_batch": {
      "type": "string"
    }
  },
  "required": [
    "fluid_name",
    "fluid_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}