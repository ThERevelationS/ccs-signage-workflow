{
  "name": "FleetPartFluidRequest",
  "type": "object",
  "description": "Fleet-specific parts/fluids request workflow. Separate from signage Orders and estimator inventory.",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "part",
        "fluid"
      ]
    },
    "part_number": {
      "type": "string"
    },
    "manufacturer_brand": {
      "type": "string"
    },
    "quantity_needed": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "equipment_id": {
      "type": "string",
      "description": "Optional linked FleetEquipment id."
    },
    "requested_by_person": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "vendor_link": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ordered",
        "received",
        "cancelled"
      ],
      "default": "pending"
    },
    "requester_email": {
      "type": "string"
    },
    "creation_key": {
      "type": "string",
      "description": "Stable client-generated idempotency key for a logical Fleet request create operation."
    },
    "estimated_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "quantity_received": {
      "type": "number"
    },
    "received_unit": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_by": {
      "type": "string"
    },
    "inventory_item_id": {
      "type": "string",
      "description": "Optional exact FleetPart/FleetFluid identity for a reorder; also records the item updated or created when received."
    },
    "receipt_key": {
      "type": "string",
      "description": "Idempotency receipt so retries cannot add the same received quantity twice."
    },
    "receipt_applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "migration_source_app_id": {
      "type": "string"
    },
    "migration_source_entity": {
      "type": "string"
    },
    "migration_source_id": {
      "type": "string"
    },
    "migration_source_created_date": {
      "type": "string"
    },
    "migration_source_updated_date": {
      "type": "string"
    },
    "migration_batch": {
      "type": "string"
    }
  },
  "required": [
    "item_name",
    "item_type",
    "quantity_needed",
    "justification"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    }
  }
}