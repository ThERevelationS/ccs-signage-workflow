{
  "name": "TimeClockEmployeeState",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Employee email; one authoritative Time Clock state row per employee"
    },
    "user_name": {
      "type": "string",
      "description": "Employee display name snapshot"
    },
    "status": {
      "type": "string",
      "enum": [
        "clocked_out",
        "clocking_in",
        "clocked_in",
        "clocking_out"
      ],
      "default": "clocked_out"
    },
    "active_entry_id": {
      "type": "string",
      "description": "Current or pending TimeEntry id"
    },
    "last_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp of the last confirmed clock action"
    },
    "last_request_id": {
      "type": "string",
      "description": "Client request id of the last confirmed or in-progress clock action"
    },
    "pending_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp when an in-progress transition began"
    },
    "break_status": {
      "type": "string",
      "enum": [
        "working",
        "starting_break",
        "on_break",
        "ending_break"
      ],
      "default": "working",
      "description": "Authoritative break state while the employee is clocked in"
    },
    "active_break_id": {
      "type": "string",
      "description": "Current or pending TimeClockBreak id"
    },
    "last_break_request_id": {
      "type": "string",
      "description": "Client request id of the last confirmed or in-progress break action"
    },
    "break_pending_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp when an in-progress break transition began"
    },
    "work_pause_status": {
      "type": "string",
      "enum": [
        "working",
        "pausing",
        "paused",
        "resuming"
      ],
      "default": "working",
      "description": "Authoritative work-pause state while the employee is clocked in"
    },
    "active_work_pause_id": {
      "type": "string",
      "description": "Current or pending TimeClockWorkPause record id"
    },
    "last_work_pause_request_id": {
      "type": "string",
      "description": "Client request id of the last confirmed or in-progress work-pause action"
    },
    "work_pause_pending_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trusted backend timestamp when an in-progress work-pause transition began"
    }
  },
  "required": [
    "user_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "timeclock_backend_only"
      }
    }
  }
}