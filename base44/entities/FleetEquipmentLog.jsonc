{
  "name": "FleetEquipmentLog",
  "type": "object",
  "description": "Fleet-specific equipment usage/history log for parts and fluids.",
  "properties": {
    "equipment_id": {
      "type": "string",
      "description": "Linked FleetEquipment id."
    },
    "item_id": {
      "type": "string",
      "description": "Linked FleetPart or FleetFluid id when inventory-backed."
    },
    "item_name": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "part",
        "fluid"
      ]
    },
    "quantity_used": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string",
      "description": "Optional linked FleetMaintenanceWorkOrder id."
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "usage_receipt_key": {
      "type": "string",
      "description": "Idempotency receipt preventing duplicate usage/history entries from a retried operation."
    },
    "migration_source_app_id": {
      "type": "string"
    },
    "migration_source_entity": {
      "type": "string"
    },
    "migration_source_id": {
      "type": "string"
    },
    "migration_source_created_date": {
      "type": "string"
    },
    "migration_source_updated_date": {
      "type": "string"
    },
    "migration_batch": {
      "type": "string"
    }
  },
  "required": [
    "equipment_id",
    "item_name",
    "item_type",
    "quantity_used"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}