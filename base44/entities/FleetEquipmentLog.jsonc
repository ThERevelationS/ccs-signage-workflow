{
  "name": "FleetEquipmentLog",
  "type": "object",
  "description": "Fleet-specific equipment usage/history log for parts and fluids.",
  "properties": {
    "equipment_id": {
      "type": "string",
      "description": "Linked FleetEquipment id."
    },
    "source_equipment_id": {
      "type": "string",
      "description": "Original FleetMaster Equipment id retained for migration audit."
    },
    "item_id": {
      "type": "string",
      "description": "Linked FleetPart or FleetFluid id when inventory-backed."
    },
    "source_item_id": {
      "type": "string",
      "description": "Original FleetMaster Parts/Fluids id retained even if that inventory row no longer exists."
    },
    "item_name": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "part",
        "fluid"
      ]
    },
    "quantity_used": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "work_order_id": {
      "type": "string",
      "description": "Optional linked FleetMaintenanceWorkOrder id."
    },
    "source_work_order_id": {
      "type": "string",
      "description": "Original FleetMaster WorkOrder id retained even if no destination link is available."
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "usage_receipt_key": {
      "type": "string",
      "description": "Idempotency receipt preventing duplicate usage/history entries from a retried operation."
    },
    "migration_source_app_id": {
      "type": "string"
    },
    "migration_source_entity": {
      "type": "string"
    },
    "migration_source_id": {
      "type": "string"
    },
    "migration_source_created_date": {
      "type": "string"
    },
    "migration_source_updated_date": {
      "type": "string"
    },
    "migration_batch": {
      "type": "string"
    }
  },
  "required": [
    "equipment_id",
    "item_name",
    "item_type",
    "quantity_used"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    }
  }
}