{
  "type": "object",
  "description": "Server-owned revocable bearer-link access for the standalone external Fleet mechanic portal. Raw access tokens are never stored; only SHA-256 hashes are persisted.",
  "properties": {
    "name": {
      "type": "string"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the raw mechanic bearer token. Raw token is shown only when generated and is never persisted."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "token_hash",
    "enabled"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__fleet_mechanic_service_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "__fleet_mechanic_service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__fleet_mechanic_service_only__"
      }
    }
  },
  "name": "FleetMechanicAccess"
}