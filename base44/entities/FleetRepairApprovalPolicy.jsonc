{
  "name": "FleetRepairApprovalPolicy",
  "type": "object",
  "description": "Fleet repair estimate approval thresholds. Separate from estimator pricing/settings.",
  "properties": {
    "name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "minimum_amount": {
      "type": "number",
      "minimum": 0
    },
    "maximum_amount": {
      "type": "number",
      "minimum": 0
    },
    "approval_tier": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "approver_role": {
      "type": "string",
      "enum": [
        "admin",
        "fleet_admin"
      ],
      "default": "admin"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "creation_key": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "minimum_amount",
    "approval_required"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    }
  }
}