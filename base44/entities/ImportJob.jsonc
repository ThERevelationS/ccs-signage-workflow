{
  "name": "ImportJob",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user running the import"
    },
    "import_type": {
      "type": "string",
      "enum": [
        "sales_pipeline",
        "orders"
      ],
      "description": "Type of import"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "running",
      "description": "Current import status"
    },
    "total_items": {
      "type": "number",
      "description": "Total items to import"
    },
    "processed_items": {
      "type": "number",
      "default": 0,
      "description": "Items processed so far"
    },
    "current_item": {
      "type": "string",
      "description": "Currently processing item description"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When import started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When import completed"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if failed"
    },
    "file_name": {
      "type": "string",
      "description": "Original spreadsheet filename."
    },
    "file_hash": {
      "type": "string",
      "description": "Canonical spreadsheet content fingerprint used to detect exact repeat imports."
    },
    "file_size_bytes": {
      "type": "number",
      "description": "Uploaded spreadsheet size in bytes."
    },
    "phase": {
      "type": "string",
      "description": "Current importer phase such as validating, matching, applying, or verifying."
    },
    "created_items": {
      "type": "number",
      "default": 0
    },
    "updated_items": {
      "type": "number",
      "default": 0
    },
    "unchanged_items": {
      "type": "number",
      "default": 0
    },
    "skipped_items": {
      "type": "number",
      "default": 0
    },
    "conflict_items": {
      "type": "number",
      "default": 0
    },
    "ambiguous_items": {
      "type": "number",
      "default": 0
    },
    "invalid_items": {
      "type": "number",
      "default": 0
    },
    "duration_ms": {
      "type": "number",
      "description": "Total server processing time in milliseconds."
    },
    "result_message": {
      "type": "string",
      "description": "Compact human-readable import result summary."
    }
  },
  "required": [
    "user_email",
    "import_type",
    "total_items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}