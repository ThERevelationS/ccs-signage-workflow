{
  "name": "PricingMode",
  "type": "object",
  "properties": {
    "active_mode": {
      "type": "string",
      "enum": [
        "tier",
        "cost_plus"
      ],
      "default": "tier",
      "description": "Which pricing system is currently active. 'tier' = % Tier Markups (default). 'cost_plus' = Cost-Plus."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "active_mode"
  ],
  "rls": {
    "create": { "user_condition": { "role": "__pricingmode_backend_only__" } },
    "read": { "user_condition": { "role": "__pricingmode_backend_only__" } },
    "update": { "user_condition": { "role": "__pricingmode_backend_only__" } },
    "delete": { "user_condition": { "role": "__pricingmode_backend_only__" } }
  }
}