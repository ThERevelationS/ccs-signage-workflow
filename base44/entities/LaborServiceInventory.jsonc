{
  "name": "LaborServiceInventory",
  "type": "object",
  "description": "Catalog of outsourced services and labor line items. Each row's `service_category` drives a category-specific set of optional pricing/spec fields (defined in components/masterInventory/laborServiceCategorySchema.js). When service_category='concrete_service', the row carries the concrete supplier pricing matrix read by the Concrete | Masonry | Poles estimator.",
  "properties": {
    "service_name": {
      "type": "string"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "permitting",
        "engineering",
        "design_art",
        "delivery_freight",
        "subcontractor_labor",
        "electrical_hookup",
        "crane_lift_service",
        "rental_service",
        "inspection",
        "consulting",
        "shop_labor",
        "field_labor",
        "concrete_service",
        "other"
      ],
      "default": "subcontractor_labor"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "per_hour",
        "per_day",
        "per_week",
        "per_month",
        "per_job",
        "per_unit",
        "per_sqft",
        "per_mile",
        "per_cy",
        "per_lb",
        "per_pallet",
        "flat"
      ],
      "default": "per_hour"
    },
    "default_rate": {
      "type": "number",
      "default": 0
    },
    "minimum_charge": {
      "type": "number",
      "default": 0
    },
    "typical_duration_hours": {
      "type": "number",
      "default": 0
    },
    "vendor_name": {
      "type": "string"
    },
    "vendor_contact": {
      "type": "string"
    },
    "vendor_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "show_in_channel_letters": {
      "type": "boolean",
      "default": true
    },
    "show_in_sign_maintenance": {
      "type": "boolean",
      "default": true
    },
    "show_in_foundation": {
      "type": "boolean",
      "default": true
    },
    "show_in_vinyl_estimator": {
      "type": "boolean",
      "default": true
    },
    "permit_jurisdiction": {
      "type": "string"
    },
    "permit_type": {
      "type": "string",
      "enum": [
        "zoning",
        "building",
        "sign",
        "electrical",
        "encroachment",
        "variance",
        "demolition",
        "other"
      ]
    },
    "permit_application_fee": {
      "type": "number",
      "default": 0
    },
    "permit_review_fee": {
      "type": "number",
      "default": 0
    },
    "permit_inspection_fee": {
      "type": "number",
      "default": 0
    },
