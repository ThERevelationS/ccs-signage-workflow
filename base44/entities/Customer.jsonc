{
  "name": "Customer",
  "type": "object",
  "description": "Shared Client record for the whole app. Used by the estimator (Step 1 of the estimate workflow, Customers area) AND by the workflow side \u2014 WorkOrders and Orders link to it via customer_id, so estimates, work orders and material orders all hang off the same client.",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "estimator_creation_key": {
      "type": "string",
      "description": "Internal receipt used only to converge simultaneous creation of the same new Customer from Estimate Step 1. Historical Customers are never assigned or merged by this field."
    },
    "creation_request_key": {
      "type": "string",
      "description": "Internal random receipt for retry-safe explicit New Customer creation. It is not derived from company name, so separate intentional Customer records remain possible."
    },
    "company_phone": {
      "type": "string"
    },
    "company_fax": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "additional_phone": {
      "type": "string"
    },
    "additional_phone_type": {
      "type": "string",
      "enum": [
        "",
        "office",
        "cell",
        "fax",
        "home",
        "other"
      ],
      "default": ""
    },
    "last_contacted_at": {
      "type": "string",
      "description": "UTC timestamp of the most recent real customer contact (quote sent, portal message)."
    },
    "merged_into_customer_id": {
      "type": "string",
      "description": "Set when this Customer was merged into another canonical Customer \u2014 linked records were relinked and this row is kept for audit."
    },
    "customer_status": {
      "type": "string",
      "enum": [
        "prospect",
        "active",
        "inactive"
      ],
      "default": "prospect",
      "description": "Account status shown in the customer header."
    },
    "status": {
      "type": "string",
      "description": "CRM lifecycle status string \u2014 Lead | Prospect | Active | Inactive (CoreBridge 'Status'). Parallel to the legacy customer_status enum; kept as a free string for import fidelity."
    },
    "customer_type": {
      "type": "string",
      "description": "Customer classification (CoreBridge 'Customer Type', e.g. retail, wholesale, contractor)."
    },
    "warning_flags": {
      "type": "array",
      "description": "Warning flags raised on this account (e.g. credit_hold, do_not_mail, tax_expired) \u2014 surfaced as badges on customer views.",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Freeform customer labels (e.g. wholesale, repeat, VIP) \u2014 filterable on the customer list."
    },
    "contact_first_name": {
      "type": "string"
    },
    "contact_last_name": {
      "type": "string"
    },
    "contact_position": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_office_phone": {
      "type": "string"
    },
    "contact_office_ext": {
      "type": "string"
    },
    "contact_cell_phone": {
      "type": "string"
    },
    "contact_additional_phone": {
      "type": "string"
    },
    "contact_additional_phone_type": {
      "type": "string",
      "enum": [
        "",
        "office",
        "cell",
        "fax",
        "home",
        "other"
      ],
      "default": ""
    },
    "contact_status": {
      "type": "string"
    },
    "job_authority": {
      "type": "string"
    },
    "billing_contact_same": {
      "type": "boolean",
      "default": true
    },
    "billing_contact_name": {
      "type": "string"
    },
    "billing_contact_email": {
      "type": "string"
    },
    "billing_contact_phone": {
      "type": "string"
    },
    "additional_contacts": {
      "type": "array",
      "description": "Extra people at this customer, managed on the Contacts tab.",
      "items": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "office_phone": {
            "type": "string"
          },
          "office_ext": {
            "type": "string"
          },
          "cell_phone": {
            "type": "string"
          },
          "contact_status": {
            "type": "string"
          },
          "job_authority": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "billing_address_1": {
      "type": "string"
    },
    "billing_address_2": {
      "type": "string"
    },
    "billing_city": {
      "type": "string"
    },
    "billing_state": {
      "type": "string"
    },
    "billing_postal_code": {
      "type": "string"
    },
    "billing_postal_ext": {
      "type": "string"
    },
    "billing_country": {
      "type": "string",
      "default": "United States"
    },
    "location_same_as_billing": {
      "type": "boolean",
      "default": true
    },
    "location_address_1": {
      "type": "string"
    },
    "location_address_2": {
      "type": "string"
    },
    "location_city": {
      "type": "string"
    },
    "location_state": {
      "type": "string"
    },
    "location_postal_code": {
      "type": "string"
    },
    "salesperson": {
      "type": "string",
      "description": "Screen name of the user assigned to this account."
    },
    "location": {
      "type": "string",
      "description": "Sales center / location this customer belongs to."
    },
    "default_tax_group": {
      "type": "string"
    },
    "quote_valid_days": {
      "type": "number",
      "description": "Per-customer quote validity window in days (overrides the estimate default of 30 when set)."
    },
    "customer_origination": {
      "type": "string"
    },
    "origination_path": {
      "type": "string",
      "description": "Hierarchical origination path (CoreBridge 'Origination', e.g. \"Networking Group : BNI - Carl - Tier 1\"). Complements the flat customer_origination label."
    },
    "industry_type": {
      "type": "string"
    },
    "master_account": {
      "type": "string"
    },
    "master_account_id": {
      "type": "string",
      "description": "Customer id of the master/parent account this record rolls up to (CoreBridge 'Master Account' link). master_account holds the display label."
    },
    "terms": {
      "type": "string"
    },
    "credit_terms_days": {
      "type": "number",
      "description": "Net credit terms in days for invoicing (e.g. 30 = Net 30). Complements the free-text terms field."
    },
    "tax_exempt": {
      "type": "boolean",
      "default": false
    },
    "tax_id_number": {
      "type": "string"
    },
    "tax_exempt_expiration": {
      "type": "string",
      "description": "YYYY-MM-DD"
    },
    "tax_exempt_reason": {
      "type": "string"
    },
    "tax_exempt_id": {
      "type": "string",
      "description": "Tax-exempt certificate / exemption id number (CoreBridge 'Tax Exempt ID'). Complements tax_id_number."
    },
    "tax_exempt_expires": {
      "type": "string",
      "description": "Tax-exempt certificate expiry date (YYYY-MM-DD). Complements tax_exempt_expiration."
    },
    "require_purchase_order": {
      "type": "boolean",
      "default": false
    },
    "po_required": {
      "type": "boolean",
      "default": false,
      "description": "When true, orders for this customer require a purchase order number (CoreBridge 'PO Required'). Parallel to require_purchase_order."
    },
    "po_required_note": {
      "type": "string",
      "description": "Free-text detail about this customer's PO requirement (e.g. \"PO required on all orders\") \u2014 surfaced to estimators when the PO gate blocks quote send or approval."
    },
    "shipping_account": {
      "type": "string"
    },
    "credit_limit": {
      "type": "number",
      "default": 0
    },
    "credit_hold": {
      "type": "boolean",
      "description": "When true, new estimates warn that the customer is on credit hold \u2014 a visible badge on the new-estimate and detail views."
    },
    "in_store_credit": {
      "type": "number",
      "default": 0,
      "description": "Unapplied in-store credit balance owed to this customer (CoreBridge 'In-Store Credit'). Distinct from credit_limit, which caps open account charges."
    },
    "in_store_credit_balance": {
      "type": "number",
      "default": 0,
      "description": "Current in-store credit balance owed to this customer (CoreBridge 'In-Store Credit' balance). Parallel to in_store_credit."
    },
    "pricing_tier": {
      "type": "number",
      "default": 1,
      "description": "Overall markup pricing tier applied to this customer's estimates."
    },
    "send_monthly_statements": {
      "type": "boolean",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "auto_inactive_after_months": {
      "type": "number",
      "default": 0,
      "description": "Months without activity after which this customer auto-marks inactive (CoreBridge 'auto-inactive'). 0 disables the automation."
    },
    "auto_inactive_months": {
      "type": "number",
      "default": 0,
      "description": "Months without activity before this customer auto-marks inactive (CoreBridge 'Auto Inactive' months). 0 disables. Parallel to auto_inactive_after_months."
    },
    "notes": {
      "type": "string"
    },
    "legacy_client_names": {
      "type": "array",
      "description": "Workflow client_name strings reconciled into this Customer record, used to match existing WorkOrders and Orders.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__customer_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__customer_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__customer_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__customer_backend_only__"
      }
    }
  }
}