{
  "name": "Invoice",
  "type": "object",
  "description": "Canonical accounts-receivable invoice. Money fields are computed server-side by invoicingAction \u2014 clients never write totals directly. Links upstream by customer_id plus optional opportunity_id / estimate_id / work_order_id so one job's financials can be traced end to end.",
  "properties": {
    "schema_version": {
      "type": "number",
      "default": 1
    },
    "creation_request_key": {
      "type": "string",
      "description": "Stable retry-safe receipt for one invoice create."
    },
    "invoice_number": {
      "type": "string",
      "description": "Human-facing invoice number (e.g. INV-1042). Generated server-side when omitted."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partially_paid",
        "paid",
        "void"
      ],
      "default": "draft"
    },
    "billing_type": {
      "type": "string",
      "enum": [
        "standard",
        "deposit",
        "progress",
        "final"
      ],
      "default": "standard",
      "description": "Progress-billing classification. deposit/progress/final are produced by create_from_estimate; standard is a free-standing invoice."
    },
    "customer_id": {
      "type": "string",
      "description": "Canonical Customer being billed."
    },
    "customer_display_name": {
      "type": "string",
      "description": "Frozen customer name at issue time for display and audit."
    },
    "opportunity_id": {
      "type": "string"
    },
    "estimating_request_id": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string",
      "description": "AllInOneEstimate the invoice was generated from, when applicable."
    },
    "work_order_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string",
      "description": "CustomerContact the invoice is addressed to, when resolved."
    },
    "location_id": {
      "type": "string",
      "description": "CustomerLocation (job site) the invoice covers, when resolved."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "taxable": {
            "type": "boolean"
          }
        }
      },
      "description": "Billing lines; server recomputes extended totals."
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0,
      "description": "Decimal rate (0.0825 = 8.25%). Applied to taxable lines less discount."
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "deposit_applied": {
      "type": "number",
      "default": 0,
      "description": "Customer deposit credited against this invoice."
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "pay_url": {
      "type": "string",
      "description": "Online payment link for this invoice (Stripe-integration-ready placeholder \u2014 populated when a payment provider is wired)."
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Sum of recorded (non-void) Payments; maintained server-side only."
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "issue_date": {
      "type": "string"
    },
    "due_date": {
      "type": "string"
    },
    "terms": {
      "type": "string",
      "description": "Payment terms label (e.g. Net 30, Due on receipt)."
    },
    "sent_date": {
      "type": "string"
    },
    "paid_date": {
      "type": "string"
    },
    "voided_date": {
      "type": "string"
    },
    "void_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Customer-facing notes printed on the invoice."
    },
    "internal_notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "source_summary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Provenance: which record generated this invoice and under what review."
    }
  },
  "required": [
    "customer_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__invoice_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__invoice_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__invoice_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__invoice_backend_only__"
      }
    }
  }
}