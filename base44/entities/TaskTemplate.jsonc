{
  "type": "object",
  "name": "TaskTemplate",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "tasks": {
      "type": "array",
      "description": "List of task texts",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "sub_tasks": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "details": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name",
    "tasks"
  ]
}