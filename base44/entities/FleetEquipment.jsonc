{
  "name": "FleetEquipment",
  "type": "object",
  "description": "Fleet maintenance/asset identity for road vehicles and non-road equipment. Separate from Bouncie tracking and estimator equipment inventories.",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "car",
        "truck",
        "boom_lift",
        "forklift",
        "generator",
        "excavator",
        "bulldozer",
        "crane",
        "compressor",
        "other"
      ]
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "serial_number": {
      "type": "string",
      "description": "Original VIN or serial number exactly as migrated from FleetMaster."
    },
    "vin": {
      "type": "string",
      "description": "Normalized VIN used for Bouncie linking when applicable."
    },
    "bouncie_imei": {
      "type": "string"
    },
    "bouncie_link_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "unlinked",
        "matched",
        "ambiguous",
        "manual"
      ],
      "default": "unlinked"
    },
    "license_plate": {
      "type": "string"
    },
    "engine_details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "maintenance",
        "down",
        "retired"
      ],
      "default": "operational"
    },
    "location": {
      "type": "string"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "mileage_hours": {
      "type": "number"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "next_service_due": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "migration_source_app_id": {
      "type": "string"
    },
    "migration_source_entity": {
      "type": "string"
    },
    "migration_source_id": {
      "type": "string"
    },
    "migration_source_created_date": {
      "type": "string"
    },
    "migration_source_updated_date": {
      "type": "string"
    },
    "migration_batch": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}