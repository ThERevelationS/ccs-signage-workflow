{
  "name": "VinylWorkflowTemplate",
  "type": "object",
  "description": "Saved workflow recipe (vinyl + laminate + machine combo) the user can apply to a fresh workflow in one click.",
  "properties": {
    "name": {
      "type": "string",
      "description": "e.g. '3M IJ180 + 8508 on HP360+Graphtec'"
    },
    "description": {
      "type": "string"
    },
    "vinyl_id": {
      "type": "string"
    },
    "laminate_id": {
      "type": "string"
    },
    "printer_id": {
      "type": "string"
    },
    "cutter_id": {
      "type": "string"
    },
    "laminator_id": {
      "type": "string"
    },
    "apply_print": {
      "type": "boolean",
      "default": true
    },
    "apply_cut": {
      "type": "boolean",
      "default": true
    },
    "apply_laminate": {
      "type": "boolean",
      "default": false
    },
    "preset_key": {
      "type": "string"
    },
    "color_tag": {
      "type": "string",
      "description": "Hex color for the workflow header pill"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}