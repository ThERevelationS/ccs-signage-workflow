{
  "name": "TimeClockBadge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Employee email for this Time Clock badge"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 hash of the badge bearer secret; raw token is never stored"
    },
    "badge_version": {
      "type": "number",
      "default": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "token_hash",
    "badge_version",
    "issued_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}