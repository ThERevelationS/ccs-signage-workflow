      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_at": {
      "type": "string"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": true
    },
    "before_fields": {
      "type": "object",
      "additionalProperties": true
    },
    "next_fields": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "request_key",
    "source_document_id",
    "payload_sha256",
    "action",
    "requested_by",
    "source_identity",
    "profile",
    "before_fields",
    "next_fields"
  ],
  "rls": {
