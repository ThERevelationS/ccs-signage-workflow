{
  "name": "UserCredential",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Lowercase username \u2014 unique per user"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the AuthorizedEmail record this credential belongs to"
    },
    "password_hash": {
      "type": "string",
      "description": "bcrypt hash of the password \u2014 never sent to frontend"
    }
  },
  "required": [
    "username",
    "user_email",
    "password_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}