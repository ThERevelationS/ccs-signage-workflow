{
  "name": "TaxGroup",
  "type": "object",
  "description": "Sales tax group selectable on an estimate (e.g. 'Ohio - Hamilton County (7.8%)'). Picking a tax group sets the estimate's tax_percent, which the All-In-One pricing waterfall multiplies by the taxable base. Admin-managed on the Estimate Settings page.",
  "properties": {
    "group_name": {
      "type": "string"
    },
    "tax_percent": {
      "type": "number",
      "default": 0
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "group_name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "__taxgroup_backend_only__" } },
    "read": { "user_condition": { "role": "__taxgroup_backend_only__" } },
    "update": { "user_condition": { "role": "__taxgroup_backend_only__" } },
    "delete": { "user_condition": { "role": "__taxgroup_backend_only__" } }
  }
}