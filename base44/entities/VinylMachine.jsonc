{
  "name": "VinylMachine",
  "type": "object",
  "description": "A production machine used by the Vinyl Estimator: large-format printer (HP Latex 360, etc.), vinyl cutter / plotter (Graphtec), laminator, or print-and-cut combo. Holds machine geometry, run-cost settings, and ink / blade economics.",
  "properties": {
    "machine_name": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "printer",
        "cutter",
        "print_and_cut",
        "laminator"
      ],
      "default": "printer"
    },
    "max_media_width_inches": {
      "type": "number",
      "default": 54
    },
    "min_media_width_inches": {
      "type": "number",
      "default": 10
    },
    "left_margin_inches": {
      "type": "number",
      "default": 0.5
    },
    "right_margin_inches": {
      "type": "number",
      "default": 0.5
    },
    "leading_edge_inches": {
      "type": "number",
      "default": 4
    },
    "trailing_edge_inches": {
      "type": "number",
      "default": 2
    },
    "default_gutter_horizontal_inches": {
      "type": "number",
      "default": 0.25
    },
    "default_gutter_vertical_inches": {
      "type": "number",
      "default": 0.25
    },
    "default_bleed_inches": {
      "type": "number",
      "default": 0
    },
    "print_cost_per_sqin": {
      "type": "number",
      "default": 0.025,
      "description": "Legacy/fallback ink + consumable cost per sq-in. Now superseded by tiered rates if set."
    },
    "print_cost_per_sqin_draft": {
      "type": "number",
      "default": 0.012,
      "description": "Draft / fast-mode ink cost per sq-in."
    },
    "print_cost_per_sqin_production": {
      "type": "number",
      "default": 0.018,
      "description": "Production / standard ink cost per sq-in."
    },
    "print_cost_per_sqin_high_quality": {
      "type": "number",
      "default": 0.025,
      "description": "High-quality / outdoor ink cost per sq-in. This is the DEFAULT print mode."
    },
    "default_print_quality": {
      "type": "string",
      "enum": [
        "draft",
        "production",
        "high_quality"
      ],
      "default": "high_quality",
      "description": "Pre-selected print quality for new workflows."
    },
    "print_speed_sqft_per_hour": {
      "type": "number",
      "default": 110
    },
    "warmup_minutes": {
      "type": "number",
      "default": 5
    },
    "media_load_minutes": {
      "type": "number",
      "default": 4
    },
    "calibration_minutes_per_job": {
      "type": "number",
      "default": 3
    },
    "machine_hourly_rate": {
      "type": "number",
      "default": 35
    },
    "cut_speed_inches_per_second": {
      "type": "number",
      "default": 30
    },
    "cut_blade_cost": {
      "type": "number",
      "default": 25
    },
    "cut_blade_life_minutes": {
      "type": "number",
      "default": 6000
    },
    "cut_setup_minutes_per_job": {
      "type": "number",
      "default": 3
    },
    "cut_pull_off_inches_per_job": {
      "type": "number",
      "default": 6
    },
    "laminator_speed_inches_per_minute": {
      "type": "number",
      "default": 100
    },
    "laminator_setup_minutes_per_job": {
      "type": "number",
      "default": 4
    },
    "laminator_hourly_rate": {
      "type": "number",
      "default": 25
    },
    "operator_hourly_rate": {
      "type": "number",
      "default": 45
    },
    "is_default_for_type": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "machine_name",
    "machine_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}