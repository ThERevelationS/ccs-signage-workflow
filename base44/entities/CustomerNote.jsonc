{
  "name": "CustomerNote",
  "type": "object",
  "description": "A note or a flag attached to a Customer. Notes are internal history entries; flags are short warnings shown on the customer header and on estimates for that customer (e.g. 'Credit hold', 'Prepay only').",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "note",
        "flag"
      ],
      "default": "note"
    },
    "text": {
      "type": "string"
    },
    "flag_color": {
      "type": "string",
      "enum": [
        "red",
        "amber",
        "blue",
        "green"
      ],
      "default": "amber",
      "description": "Badge color used when kind = flag."
    }
  },
  "required": [
    "customer_id",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__customer_note_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__customer_note_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__customer_note_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__customer_note_backend_only__"
      }
    }
  }
}