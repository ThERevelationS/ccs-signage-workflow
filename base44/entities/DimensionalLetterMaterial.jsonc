{
  "name": "DimensionalLetterMaterial",
  "type": "object",
  "description": "Sheet-goods catalog for dimensional letters, lobby sign backers, and sign-maintenance face/return/vinyl replacement material pickers.",
  "properties": {
    "material_name": {
      "type": "string",
      "description": "Friendly name shown in dropdowns (e.g., '1/2\" PVC Sintra White')"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "acrylic",
        "pvc",
        "aluminum_composite",
        "aluminum_solid",
        "aluminum_sheet",
        "steel_sheet",
        "stainless_sheet",
        "galvanized_sheet",
        "polycarbonate",
        "styrene",
        "coroplast",
        "gatorboard",
        "wood",
        "mdf",
        "hdu",
        "foam",
        "other"
      ],
      "default": "pvc"
    },
    "thickness_inches": {
      "type": "number",
      "default": 0.5,
      "description": "Sheet thickness in inches"
    },
    "sheet_length_inches": {
      "type": "number",
      "default": 96,
      "description": "Sheet length (e.g., 96 for 4x8)"
    },
    "sheet_width_inches": {
      "type": "number",
      "default": 48,
      "description": "Sheet width (e.g., 48 for 4x8)"
    },
    "cost_per_sheet": {
      "type": "number",
      "default": 0,
      "description": "Cost for one full sheet at the listed dimensions"
    },
    "yield_factor": {
      "type": "number",
      "default": 0.7,
      "description": "Estimated usable yield after nesting waste (0.5 = 50% usable)."
    },
    "color": {
      "type": "string",
      "description": "Stock color, if applicable"
    },
    "supplier": {
      "type": "string"
    },
    "needs_painting": {
      "type": "boolean",
      "default": true,
      "description": "If false, default to skipping paint cost"
    },
    "allow_laser": {
      "type": "boolean",
      "default": true,
      "description": "Whether this material can be cut on the laser"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "show_in_dimensional_letters": {
      "type": "boolean",
      "default": true,
      "description": "Show in the Dimensional Letters fab/material picker (Channel Letter Estimator)"
    },
    "show_in_lobby_sign_backer": {
      "type": "boolean",
      "default": true,
      "description": "Show in the Lobby Sign Backer picker"
    },
    "show_in_vinyl_replacement": {
      "type": "boolean",
      "default": false,
      "description": "Show in Sign Maintenance \u2014 Vinyl Replacement action material picker"
    },
    "show_in_replace_returns": {
      "type": "boolean",
      "default": false,
      "description": "Show in Sign Maintenance \u2014 Replace Returns action material picker"
    },
    "show_in_replace_face": {
      "type": "boolean",
      "default": false,
      "description": "Show in Sign Maintenance \u2014 Replace Face action material picker"
    }
  },
  "required": [
    "material_name",
    "material_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}