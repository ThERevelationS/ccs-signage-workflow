{
  "type": "object",
  "name": "UserSession",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email the session belongs to."
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 fingerprint of the session token \u2014 the raw token is never stored."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "token_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}