{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Saved name for this announcement template"
    },
    "title": {
      "type": "string",
      "description": "Announcement title/headline"
    },
    "message": {
      "type": "string",
      "description": "Announcement body text"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image to display with announcement"
    },
    "sound_type": {
      "type": "string",
      "enum": [
        "none",
        "chime",
        "bell",
        "alert",
        "fanfare",
        "ding",
        "custom"
      ],
      "default": "chime",
      "description": "Sound to play with announcement"
    },
    "custom_sound_url": {
      "type": "string",
      "description": "URL for custom uploaded sound file"
    },
    "customer_ids": {
      "type": "array",
      "description": "Restrict this announcement to these customer IDs on the customer portal (empty = all customers).",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "display_pages": {
      "type": "array",
      "description": "Pages to show announcement on (empty = all pages)",
      "items": {
        "type": "string"
      }
    },
    "target_users": {
      "type": "array",
      "description": "User emails to target (empty = all users)",
      "items": {
        "type": "string"
      }
    },
    "duration_seconds": {
      "type": "number",
      "default": 10,
      "description": "How long to show announcement (0 = until dismissed)"
    },
    "background_color": {
      "type": "string",
      "default": "#FFF9C4",
      "description": "Background color for announcement banner"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this announcement is currently being broadcast"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this was last sent"
    },
    "sent_by": {
      "type": "string",
      "description": "Email of admin who sent it"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Broadcast stops after this time (required to publish)"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "Broadcast goes live at this time (empty = immediately when published)"
    },
    "display_mode": {
      "type": "string",
      "enum": [
        "once",
        "repeat"
      ],
      "default": "once",
      "description": "once = show a single time per viewer; repeat = re-show while live"
    },
    "repeat_interval_minutes": {
      "type": "number",
      "default": 0,
      "description": "Minutes between re-shows when display_mode is repeat (0 = every poll cycle)"
    },
    "requires_ack": {
      "type": "boolean",
      "default": false,
      "description": "Viewers must press the acknowledge button to dismiss"
    },
    "acknowledged_viewers": {
      "type": "array",
      "description": "Viewer keys (emails or device ids) that acknowledged this broadcast",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__announcement_backend_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__announcement_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__announcement_backend_only__"
      }
    }
  }
}