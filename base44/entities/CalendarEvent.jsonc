{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description / notes"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Start date and time (ISO)"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "End date and time (ISO)"
    },
    "all_day": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is an all-day event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "company",
        "install",
        "survey",
        "meeting",
        "deadline",
        "holiday",
        "personal",
        "other"
      ],
      "default": "company",
      "description": "Category of event"
    },
    "color": {
      "type": "string",
      "description": "Hex color for this event"
    },
    "location": {
      "type": "string",
      "description": "Physical or virtual location"
    },
    "assigned_to": {
      "type": "array",
      "description": "List of user emails assigned to this event",
      "items": {
        "type": "string"
      }
    },
    "work_order_id": {
      "type": "string",
      "description": "Linked work order ID (optional)"
    },
    "work_order_title": {
      "type": "string",
      "description": "Cached work order title"
    },
    "is_universal": {
      "type": "boolean",
      "default": true,
      "description": "Visible to all users on the universal company calendar"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly",
        "yearly"
      ],
      "default": "none"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date"
    },
    "external_id": {
      "type": "string",
      "description": "ID from external calendar (Outlook/Google) for dedup"
    },
    "external_source": {
      "type": "string",
      "enum": [
        "manual",
        "outlook",
        "google"
      ],
      "default": "manual"
    },
    "reminder_minutes": {
      "type": "number",
      "description": "Reminder in minutes before event",
      "default": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "tentative",
        "cancelled"
      ],
      "default": "confirmed"
    }
  },
  "required": [
    "title",
    "start_datetime"
  ]
}