{
  "name": "GlobalSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "description": "Unique key for the setting (e.g., 'salesLeadSources', 'salesTaskDescriptions', 'deadlineGradientSettings')"
    },
    "setting_value": {
      "type": "object",
      "description": "The setting value as JSON object"
    }
  },
  "required": [
    "setting_key"
  ],
  "rls": {
    "create": { "user_condition": { "role": "__globalsettings_backend_only__" } },
    "read": { "user_condition": { "role": "__globalsettings_backend_only__" } },
    "update": { "user_condition": { "role": "__globalsettings_backend_only__" } },
    "delete": { "user_condition": { "role": "__globalsettings_backend_only__" } }
  }
}