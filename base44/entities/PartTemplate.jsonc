{
  "name": "PartTemplate",
  "type": "object",
  "description": "Permanent reusable estimator Part Library. Stores either one complete BuilderPart snapshot or a Part Group plus all child BuilderPart snapshots. Templates are distinct from Master Inventory: inventory remains the central raw resource/cost library, while PartTemplate preserves reusable estimate/component configuration and frozen pricing context. Instantiating a template always creates new independent Product Parts so future Builder recalculation cannot overwrite the saved component.",
  "properties": {
    "template_name": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Stable creation receipt used to converge retries of the same Saved Part / Part Group save without creating duplicates."
    },
    "template_version": {
      "type": "number",
      "default": 1
    },
    "template_family_key": {
      "type": "string",
      "description": "Stable lineage key shared by every saved revision of the same source Part/Part Group name. Each new save appends the next template_version; prior versions remain immutable snapshots."
    },
    "template_type": {
      "type": "string",
      "enum": [
        "part",
        "part_group"
      ],
      "default": "part"
    },
    "product_group": {
      "type": "string",
      "enum": [
        "my",
        "global"
      ],
      "default": "my",
      "description": "'my' = creator-owned reusable Part; 'global' = shared company reusable Part."
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_module_key": {
      "type": "string"
    },
    "source_part_type": {
      "type": "string"
    },
    "source_part_subtype": {
      "type": "string"
    },
    "created_from_estimate_id": {
      "type": "string"
    },
    "created_from_product_id": {
      "type": "string"
    },
    "created_from_part_group_id": {
      "type": "string"
    },
    "created_from_part_id": {
      "type": "string"
    },
    "part_snapshot": {
      "type": "object",
      "description": "Lossless BuilderPart snapshot for a single-Part template, including inventory links, frozen/current inventory snapshots, detail overrides, calculation/pricing snapshots and frozen pricing.",
      "additionalProperties": true
    },
    "group_snapshot": {
      "type": "object",
      "description": "Lossless BuilderPartGroup snapshot when template_type is part_group.",
      "additionalProperties": true
    },
    "parts_snapshot": {
      "type": "array",
      "description": "Lossless ordered BuilderPart snapshots for a Part Group template.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "part_count": {
      "type": "number",
      "default": 1
    },
    "frozen_cost": {
      "type": "number",
      "default": 0
    },
    "current_cost": {
      "type": "number",
      "default": 0
    },
    "contains_detached_parts": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "search_text": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "income_account": {
      "type": "string",
      "description": "GL income account code this saved part's sales post to on accounting export (CoreBridge-style Manage Accounts mapping)."
    },
    "cogs_account": {
      "type": "string",
      "description": "GL cost-of-goods-sold account code this saved part's material cost posts to on accounting export."
    },
    "income_account_code": {
      "type": "string",
      "description": "GL income account code this part's sales post to on accounting export."
    },
    "cogs_account_code": {
      "type": "string",
      "description": "GL cost-of-goods-sold account code this part's material cost posts to on accounting export."
    },
    "pricing_template_id": {
      "type": "string",
      "description": "PricingTemplate record applied to this part's pricing."
    },
    "part_group_id": {
      "type": "string",
      "description": "Part group this part belongs to."
    },
    "design_lead_days": {
      "type": "number",
      "description": "Lead-time days attributed to design work for this part."
    },
    "product_lead_days": {
      "type": "number",
      "description": "Lead-time days attributed to production for this part."
    },
    "labor_level_id": {
      "type": "string",
      "description": "Labor level/skill tier used to price this part's labor."
    },
    "machine_ids": {
      "type": "array",
      "description": "Machine records this part routes through in production.",
      "items": {
        "type": "string"
      }
    },
    "taxable": {
      "type": "boolean",
      "description": "Whether this part's charges are taxable."
    },
    "separate_on_invoice": {
      "type": "boolean",
      "description": "Whether this part is broken out as its own invoice line."
    },
    "double_sided": {
      "type": "boolean",
      "description": "Whether this part is produced double-sided."
    },
    "min_charge": {
      "type": "number",
      "description": "Minimum charge floor applied to this part."
    },
    "parent_sizes": {
      "type": "array",
      "description": "Parent sheet/stock size labels this part can be cut from.",
      "items": {
        "type": "string"
      }
    },
    "vendor_id": {
      "type": "string",
      "description": "Vendor record supplying this part or its primary material."
    },
    "mfg_part_number": {
      "type": "string",
      "description": "Manufacturer/vendor part number used for ordering."
    },
    "size_discounts": {
      "type": "array",
      "description": "Per-size discount rows applied to this part; row shape is module-defined.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": [
    "template_name",
    "template_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__admin_settings_backend_only__"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.product_group": "global"
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}