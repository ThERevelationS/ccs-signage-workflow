{
  "name": "BuilderPriceRevision",
  "type": "object",
  "description": "Immutable audit revision created when a Builder Product is first frozen or when the user explicitly accepts an Update Price / reattachment / manual pricing action. Keeps before/after builder and price snapshots so historical pricing is never silently lost.",
  "properties": {
    "builder_product_id": {
      "type": "string"
    },
    "estimate_id": {
      "type": "string"
    },
    "revision_number": {
      "type": "number",
      "default": 1
    },
    "reason": {
      "type": "string",
      "enum": [
        "initial_freeze",
        "update_price",
        "reattach",
        "manual_adjustment",
        "migration"
      ],
      "default": "initial_freeze"
    },
    "previous_total_cost": {
      "type": "number",
      "default": 0
    },
    "new_total_cost": {
      "type": "number",
      "default": 0
    },
    "previous_customer_price": {
      "type": "number",
      "default": 0
    },
    "new_customer_price": {
      "type": "number",
      "default": 0
    },
    "changed_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Part-level old/new pricing and link changes included in this revision."
    },
    "builder_snapshot_before": {
      "type": "object",
      "additionalProperties": true
    },
    "builder_snapshot_after": {
      "type": "object",
      "additionalProperties": true
    },
    "price_snapshot_before": {
      "type": "object",
      "additionalProperties": true
    },
    "price_snapshot_after": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "builder_product_id",
    "revision_number"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}