{
  "name": "BuilderPart",
  "type": "object",
  "description": "A frozen-price part inside a Builder Product. Stores the live inventory link plus a complete inventory snapshot and builder/calculation snapshot from the moment the cost became active. Missing/detached inventory never destroys the frozen cost; reattachment is explicit.",
  "properties": {
    "builder_product_id": {
      "type": "string"
    },
    "part_group_id": {
      "type": "string"
    },
    "part_key": {
      "type": "string",
      "description": "Stable key within the product for ordering/copying/reconciliation."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "part_name": {
      "type": "string"
    },
    "client_label": {
      "type": "string",
      "description": "Optional customer-facing part label."
    },
    "part_type": {
      "type": "string",
      "description": "Open string by design so additional legacy/master-inventory part types can be added without a schema migration."
    },
    "part_subtype": {
      "type": "string"
    },
    "source_module_key": {
      "type": "string"
    },
    "source_path": {
      "type": "string",
      "description": "Path inside the detailed builder snapshot that produced this part, e.g. items[0].materials[2]."
    },
    "inventory_entity": {
      "type": "string",
      "description": "Master Inventory entity currently linked to this part."
    },
    "inventory_item_id": {
      "type": "string",
      "description": "Current linked inventory record id. May be blank while detached."
    },
    "original_inventory_item_id": {
      "type": "string",
      "description": "Inventory id used when the frozen snapshot was created; never overwritten during reattachment."
    },
    "inventory_item_name": {
      "type": "string"
    },
    "inventory_link_state": {
      "type": "string",
      "enum": [
        "attached",
        "detached",
        "reattach_available",
        "manual"
      ],
      "default": "manual"
    },
    "reattach_candidate_id": {
      "type": "string"
    },
    "reattach_candidate_name": {
      "type": "string"
    },
    "frozen_inventory_snapshot": {
      "type": "object",
      "description": "Complete inventory row as it existed when this part's cost was frozen.",
      "additionalProperties": true
    },
    "current_inventory_snapshot": {
      "type": "object",
      "description": "Last current inventory row seen during price/detach checking. Does not alter frozen pricing by itself.",
      "additionalProperties": true
    },
    "builder_data": {
      "type": "object",
      "description": "Complete module-specific part/builder inputs.",
      "additionalProperties": true
    },
    "calculation_snapshot": {
      "type": "object",
      "description": "Complete module-specific calculated outputs/breakdown for this part.",
      "additionalProperties": true
    },
    "pricing_basis_snapshot": {
      "type": "object",
      "description": "Pricing mode, rate fields, dimensions, units, and other data necessary to explain/reproduce the frozen cost.",
      "additionalProperties": true
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit": {
      "type": "string"
    },
    "frozen_unit_cost": {
      "type": "number",
      "default": 0
    },
    "frozen_extended_cost": {
      "type": "number",
      "default": 0
    },
    "current_unit_cost": {
      "type": "number",
      "default": 0
    },
    "current_extended_cost": {
      "type": "number",
      "default": 0
    },
    "price_state": {
      "type": "string",
      "enum": [
        "unchecked",
        "current",
        "changed",
        "detached",
        "manual",
        "legacy_frozen"
      ],
      "default": "unchecked"
    },
    "price_delta": {
      "type": "number",
      "default": 0
    },
    "price_delta_percent": {
      "type": "number",
      "default": 0
    },
    "inventory_updated_date_snapshot": {
      "type": "string",
      "description": "Inventory updated_date at the moment the frozen price was accepted."
    },
    "last_price_check_at": {
      "type": "string"
    },
    "last_price_update_at": {
      "type": "string"
    },
    "manual_cost_override": {
      "type": "boolean",
      "default": false
    },
    "manual_cost": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "builder_product_id",
    "part_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}