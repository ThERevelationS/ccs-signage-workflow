{
  "name": "BuilderPart",
  "type": "object",
  "description": "A frozen-price part inside a Builder Product. Stores the live inventory link plus a complete inventory snapshot and builder/calculation snapshot from the moment the cost became active. Missing/detached inventory never destroys the frozen cost; reattachment is explicit.",
  "properties": {
    "builder_product_id": {
      "type": "string"
    },
    "part_group_id": {
      "type": "string"
    },
    "part_key": {
      "type": "string",
      "description": "Stable key within the product for ordering/copying/reconciliation."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "part_name": {
      "type": "string"
    },
    "client_label": {
      "type": "string",
      "description": "Optional customer-facing part label."
    },
    "part_type": {
      "type": "string",
      "description": "Open string by design so additional legacy/master-inventory part types can be added without a schema migration."
    },
    "part_subtype": {
      "type": "string"
    },
    "source_module_key": {
      "type": "string"
    },
    "source_template_id": {
      "type": "string",
      "description": "PartTemplate record this independent copy was instantiated from. Blank for Builder-produced, manual, and clipboard Parts."
    },
    "source_template_name": {
      "type": "string"
    },
    "source_template_version": {
      "type": "number",
      "default": 0,
      "description": "template_version of the source PartTemplate snapshot; 0 when the Part did not come from the Part Library."
    },
    "source_path": {
      "type": "string",
      "description": "Path inside the detailed builder snapshot that produced this part, e.g. items[0].materials[2]."
    },
    "builder_sync_state": {
      "type": "string",
      "enum": [
        "linked",
        "detached_override",
        "manual",
        "manual_addon"
      ],
      "default": "linked",
      "description": "Whether this Part continues to synchronize from its Builder. detached_override freezes a Builder-produced Part until reattachment; manual is a Custom Product Part; manual_addon is an independent Part intentionally added to a Builder Product and remains outside Builder reconciliation."
    },
    "builder_detached_at": {
      "type": "string"
    },
    "builder_detached_reason": {
      "type": "string"
    },
    "builder_detached_by": {
      "type": "string",
      "description": "Display name or email of the user who detached this Part from its Builder. Cleared on reattach."
    },
    "builder_detached_snapshot": {
      "type": "object",
      "description": "Builder-produced Part state captured when an override was detached, used for audit and reattachment review.",
      "additionalProperties": true
    },
    "inventory_entity": {
      "type": "string",
      "description": "Master Inventory entity currently linked to this part."
    },
    "inventory_item_id": {
      "type": "string",
      "description": "Current linked inventory record id. May be blank while detached."
    },
    "original_inventory_item_id": {
      "type": "string",
      "description": "Inventory id used when the frozen snapshot was created; never overwritten during reattachment."
    },
    "inventory_item_name": {
      "type": "string"
    },
    "inventory_link_state": {
      "type": "string",
      "enum": [
        "attached",
        "detached",
        "reattach_available",
        "manual"
      ],
      "default": "manual"
    },
    "reattach_candidate_id": {
      "type": "string"
    },
    "reattach_candidate_name": {
      "type": "string"
    },
    "frozen_inventory_snapshot": {
      "type": "object",
      "description": "Complete inventory row as it existed when this part's cost was frozen.",
      "additionalProperties": true
    },
    "current_inventory_snapshot": {
      "type": "object",
      "description": "Last current inventory row seen during price/detach checking. Does not alter frozen pricing by itself.",
      "additionalProperties": true
    },
    "detail_overrides": {
      "type": "object",
      "description": "Estimate-specific type/detail overrides layered over frozen_inventory_snapshot for this Part only. Never mutates the Master Inventory snapshot and is cleared when a detached Builder Part is reattached.",
      "additionalProperties": true
    },
    "builder_data": {
      "type": "object",
      "description": "Complete module-specific part/builder inputs.",
      "additionalProperties": true
    },
    "calculation_snapshot": {
      "type": "object",
      "description": "Complete module-specific calculated outputs/breakdown for this part.",
      "additionalProperties": true
    },
    "pricing_basis_snapshot": {
      "type": "object",
      "description": "Pricing mode, rate fields, dimensions, units, and other data necessary to explain/reproduce the frozen cost.",
      "additionalProperties": true
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit": {
      "type": "string"
    },
    "frozen_unit_cost": {
      "type": "number",
      "default": 0
    },
    "frozen_extended_cost": {
      "type": "number",
      "default": 0
    },
    "current_unit_cost": {
      "type": "number",
      "default": 0
    },
    "current_extended_cost": {
      "type": "number",
      "default": 0
    },
    "price_state": {
      "type": "string",
      "enum": [
        "unchecked",
        "current",
        "changed",
        "detached",
        "manual",
        "legacy_frozen"
      ],
      "default": "unchecked"
    },
    "price_delta": {
      "type": "number",
      "default": 0
    },
    "price_delta_percent": {
      "type": "number",
      "default": 0
    },
    "inventory_updated_date_snapshot": {
      "type": "string",
      "description": "Inventory updated_date at the moment the frozen price was accepted."
    },
    "last_price_check_at": {
      "type": "string"
    },
    "last_price_update_at": {
      "type": "string"
    },
    "manual_cost_override": {
      "type": "boolean",
      "default": false
    },
    "manual_cost": {
      "type": "number"
    },
    "manual_cost_override_reason": {
      "type": "string",
      "description": "User-entered reason recorded when a manual/detached Part cost was overridden."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "income_account_code": {
      "type": "string",
      "description": "GL income account code this part's sales post to on accounting export."
    },
    "cogs_account_code": {
      "type": "string",
      "description": "GL cost-of-goods-sold account code this part's material cost posts to on accounting export."
    },
    "pricing_template_id": {
      "type": "string",
      "description": "PricingTemplate record applied to this part's pricing."
    },
    "design_lead_days": {
      "type": "number",
      "description": "Lead-time days attributed to design work for this part."
    },
    "product_lead_days": {
      "type": "number",
      "description": "Lead-time days attributed to production for this part."
    },
    "labor_level_id": {
      "type": "string",
      "description": "Labor level/skill tier used to price this part's labor."
    },
    "machine_ids": {
      "type": "array",
      "description": "Machine records this part routes through in production.",
      "items": {
        "type": "string"
      }
    },
    "taxable": {
      "type": "boolean",
      "description": "Whether this part's charges are taxable."
    },
    "separate_on_invoice": {
      "type": "boolean",
      "description": "Whether this part is broken out as its own invoice line."
    },
    "double_sided": {
      "type": "boolean",
      "description": "Whether this part is produced double-sided."
    },
    "min_charge": {
      "type": "number",
      "description": "Minimum charge floor applied to this part."
    },
    "parent_sizes": {
      "type": "array",
      "description": "Parent sheet/stock size labels this part can be cut from.",
      "items": {
        "type": "string"
      }
    },
    "vendor_id": {
      "type": "string",
      "description": "Vendor record supplying this part or its primary material."
    },
    "vendor_name": {
      "type": "string",
      "description": "Display name of the supplying vendor (denormalized; catalog import lane already stores it)."
    },
    "vendor_cost": {
      "type": "number",
      "description": "Vendor-quoted unit cost for this part \u2014 outranks vendor default_cost and generic cost in vendorCostModel retail resolution."
    },
    "vendor_markup_percent": {
      "type": "number",
      "description": "Retail markup percent applied to the resolved vendor cost for this part; outranks vendor defaults and generic markup_* fields."
    },
    "vendor_markup_flat": {
      "type": "number",
      "description": "Flat markup added after the percent markup for this part's vended retail."
    },
    "is_vended": {
      "type": "boolean",
      "description": "Explicit vended flag \u2014 one of the vendorCostModel vended-part signals (flag | vendor_id | vendor_name | vendor_cost)."
    },
    "mfg_part_number": {
      "type": "string",
      "description": "Manufacturer/vendor part number used for ordering."
    },
    "size_discounts": {
      "type": "array",
      "description": "F-14: Volume/size discount threshold rows applied post-tier. Each row grants discount_pct off the tier-priced base when the part's measure on threshold_basis (sqft|width_in|height_in|area_sqin|perimeter_in) reaches threshold_value; the largest qualifying threshold wins (ties \u2192 highest pct). Resolution lives in base44/shared/sizeDiscounts.ts.",
      "items": {
        "type": "object",
        "properties": {
          "threshold_basis": {
            "type": "string",
            "enum": [
              "sqft",
              "width_in",
              "height_in",
              "area_sqin",
              "perimeter_in"
            ]
          },
          "threshold_value": {
            "type": "number"
          },
          "discount_pct": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": [
    "builder_product_id",
    "part_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__builderpart_backend_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__builderpart_backend_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__builderpart_backend_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__builderpart_backend_only__"
      }
    }
  }
}