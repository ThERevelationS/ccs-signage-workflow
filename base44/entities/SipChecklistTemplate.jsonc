{
  "name": "SipChecklistTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "items": {
      "type": "array",
      "description": "Checklist items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the default template"
    }
  },
  "required": [
    "name",
    "items"
  ]
  "rls": {
    "create": { "user_condition": { "role": "__sipchecklisttemplate_backend_only__" } },
    "read": { "user_condition": { "role": "__sipchecklisttemplate_backend_only__" } },
    "update": { "user_condition": { "role": "__sipchecklisttemplate_backend_only__" } },
    "delete": { "user_condition": { "role": "__sipchecklisttemplate_backend_only__" } }
  }
}