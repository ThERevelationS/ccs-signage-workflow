{
  "name": "ChecklistSubItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Sub-item name/text"
    },
    "applies_to_product_types": {
      "type": "array",
      "description": "Product types this sub-item applies to",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number",
      "description": "Display order",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "__checklistsubitem_backend_only__" } },
    "read": { "user_condition": { "role": "__checklistsubitem_backend_only__" } },
    "update": { "user_condition": { "role": "__checklistsubitem_backend_only__" } },
    "delete": { "user_condition": { "role": "__checklistsubitem_backend_only__" } }
  }
}