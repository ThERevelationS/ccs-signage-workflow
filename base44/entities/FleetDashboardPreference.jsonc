{
  "name": "FleetDashboardPreference",
  "type": "object",
  "description": "Per-user Fleet dashboard layout/preferences. Server-managed; users only read their own preference row.",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "widget_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_widgets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "density": {
      "type": "string",
      "enum": [
        "comfortable",
        "compact"
      ],
      "default": "comfortable"
    },
    "layout_version": {
      "type": "number",
      "default": 1
    },
    "creation_key": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__fleet_server_only__"
      }
    }
  }
}