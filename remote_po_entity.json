ition\": {\n        \"role\": \"__purchase_order_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__purchase_order_backend_only__\"\n      }\n    }\n  }\n}",
