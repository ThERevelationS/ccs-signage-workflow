      "path": "base44/entities/EstimateAcceptance.jsonc",
      "content": "{\n  \"name\": \"EstimateAcceptance\",\n  \"type\": \"object\",\n  \"description\": \"Immutable audit record that a customer accepted a specific issued customer quote version. This records the acceptance evidence/method; EstimateRevision continues to record the resulting whole-estimate lifecycle transition to approved.\",\n  \"properties\": {\n    \"estimate_id\": {\n      \"type\": \"string\"\n    },\n    \"work_order_id\": {\n      \"type\": \"string\"\n    },\n    \"delivery_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional exact EstimateQuoteDelivery record the customer accepted; blank when acceptance is not tied to a specific delivery.\"\n    },\n    \"quote_issue_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable identity shared with the issued quote version, its deliveries, and related EstimateRevision records.\"\n    },\n    \"quote_version\": {\n      \"type\": \"number\",\n      \"minimum\": 1\n    },\n    \"quote_issue_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"quote_expiration_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Valid-through date of the customer quote version that was accepted.\"\n    },\n    \"quote_total\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Customer quote total accepted; never internal cost.\"\n    },\n    \"accepted_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"accepted_by_name\": {\n      \"type\": \"string\"\n    },\n    \"accepted_by_email\": {\n      \"type\": \"string\"\n    },\n    \"acceptance_method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"signed_quote\",\n        \"email\",\n        \"verbal\",\n        \"in_person\",\n        \"portal\",\n        \"other\"\n      ]\n    },\n    \"evidence_reference\": {\n      \"type\": \"string\",\n      \"description\": \"Short reference to the evidence, such as signed quote received, customer email, PO, or conversation reference.\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"recorded_by_email\": {\n      \"type\": \"string\",\n      \"description\": \"Internal staff email that recorded the acceptance through the authenticated acceptance service.\"\n    },\n    \"recorded_by_name\": {\n      \"type\": \"string\",\n      \"description\": \"Internal staff display name that recorded the acceptance.\"\n    }\n  },\n  \"required\": [\n    \"estimate_id\",\n    \"quote_version\",\n    \"accepted_at\",\n    \"accepted_by_name\",\n    \"acceptance_method\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__estimate_audit_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__estimate_audit_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__estimate_audit_backend_only__\"\n      }\n    }\n  }\n}",
