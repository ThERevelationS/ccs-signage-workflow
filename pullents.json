      "path": "base44/entities/EstimatingRequest.jsonc",
      "content": "{\n  \"name\": \"EstimatingRequest\",\n  \"type\": \"object\",\n  \"description\": \"Controlled, auditable handoff from Opportunity/Intake into Estimating. The verified handoff_snapshot freezes what Sales knew when the request was submitted while current Customer/Contact/Location records remain live.\",\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable retry-safe receipt for one Estimating Request.\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\"\n    },\n    \"contact_id\": {\n      \"type\": \"string\",\n      \"description\": \"Future canonical CustomerContact id when resolved.\"\n    },\n    \"location_id\": {\n      \"type\": \"string\",\n      \"description\": \"Future canonical CustomerLocation/site id when resolved.\"\n    },\n    \"estimate_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked AllInOneEstimate once the request creates or is attached to an Estimate.\"\n    },\n    \"compatibility_work_order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Transitional WorkOrder-backed Sales Pipeline link during compatibility migration.\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"draft\",\n        \"ready\",\n        \"in_progress\",\n        \"completed\",\n        \"cancelled\"\n      ],\n      \"default\": \"draft\"\n    },\n    \"requested_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"requested_by\": {\n      \"type\": \"string\"\n    },\n    \"submitted_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"assigned_estimator\": {\n      \"type\": \"string\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"normal\",\n        \"high\",\n        \"rush\"\n      ],\n      \"default\": \"normal\"\n    },\n    \"desired_completion_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"desired_install_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"request_notes\": {\n      \"type\": \"string\"\n    },\n    \"survey_requirement\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ],\n      \"default\": \"unknown\"\n    },\n    \"permit_requirement\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ],\n      \"default\": \"unknown\"\n    },\n    \"installation_requirement\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ],\n      \"default\": \"unknown\"\n    },\n    \"removal_requirement\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ],\n      \"default\": \"unknown\"\n    },\n    \"electrical_requirement\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unknown\",\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ],\n      \"default\": \"unknown\"\n    },\n    \"handoff_snapshot_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"handoff_snapshot\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true,\n      \"description\": \"Point-in-time verified packet delivered to Estimating. Persistence guards freeze this once the request leaves draft.\"\n    },\n    \"attachment_refs\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          },\n          \"source_id\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"completed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"cancelled_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"cancel_reason\": {\n      \"type\": \"string\"\n    },\n    \"due_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Optional estimate-request due date; the attention feed flags open requests past this date as overdue.\"\n    }\n  },\n  \"required\": [\n    \"creation_request_key\",\n    \"opportunity_id\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__estimating_request_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__estimating_request_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__estimating_request_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__estimating_request_backend_only__\"\n      }\n    }\n  }\n}",
