      "path": "base44/entities/WorkOrder.jsonc",
      "content": "{\n  \"name\": \"WorkOrder\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"Work order title\"\n    },\n    \"client_name\": {\n      \"type\": \"string\",\n      \"description\": \"Client name\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked shared Customer (Client) record id.\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional transitional link to the canonical Opportunity. Blank on legacy/unmigrated WorkOrders.\"\n    },\n    \"estimating_request_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional link to the EstimatingRequest that produced or is associated with this WorkOrder. Blank is valid during compatibility migration.\"\n    },\n    \"estimate_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked AllInOneEstimate id, when this job was created from an estimate.\"\n    },\n    \"description\": {\n      \"type\": \"string\",\n      \"description\": \"Detailed description of the work\"\n    },\n    \"image_url\": {\n      \"type\": \"string\",\n      \"description\": \"URL of the work order image\"\n    },\n    \"attachment_refs\": {\n      \"type\": \"array\",\n      \"description\": \"References to files/photos carried over from the linked estimate (no binary copies).\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"files\": {\n      \"type\": \"array\",\n      \"description\": \"Uploaded files for this work order\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"type\": {\n            \"type\": \"string\"\n          },\n          \"size\": {\n            \"type\": \"number\"\n          },\n          \"uploaded_by\": {\n            \"type\": \"string\"\n          },\n          \"uploaded_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          }\n        }\n      }\n    },\n    \"google_drive_folder_url\": {\n      \"type\": \"string\",\n      \"description\": \"Google Drive folder URL for this work order\"\n    },\n    \"google_drive_file_ids\": {\n      \"type\": \"array\",\n      \"description\": \"Array of Google Drive file IDs\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"current_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"estimating\",\n        \"sales\",\n        \"permitting\",\n        \"design\",\n        \"production\",\n        \"fabrication\",\n        \"installation\",\n        \"completed\"\n      ],\n      \"default\": \"estimating\",\n      \"description\": \"Current workflow stage\"\n    },\n    \"priority\": {\n      \"type\": \"number\",\n      \"description\": \"Priority order\"\n    },\n    \"assigned_to\": {\n      \"type\": \"string\",\n      \"description\": \"Email of assigned user\"\n    },\n    \"notes\": {\n      \"type\": \"array\",\n      \"description\": \"Array of tasks with timestamps, completion status, and dependencies\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"created_by\": {\n            \"type\": \"string\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"assigned_to\": {\n            \"type\": \"string\"\n          },\n          \"estimated_hours\": {\n            \"type\": \"number\"\n          },\n          \"actual_hours\": {\n            \"type\": \"number\"\n          },\n          \"due_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"start_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"depends_on\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"is_milestone\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"is_critical_path\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"checklist_context\": {\n            \"type\": \"string\"\n          },\n          \"sub_tasks\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"text\": {\n                  \"type\": \"string\"\n                },\n                \"completed\": {\n                  \"type\": \"boolean\",\n                  \"default\": false\n                },\n                \"assigned_to\": {\n                  \"type\": \"string\"\n                },\n                \"details\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"text\": {\n                        \"type\": \"string\"\n                      },\n                      \"completed\": {\n                        \"type\": \"boolean\",\n                        \"default\": false\n                      },\n                      \"assigned_to\": {\n                        \"type\": \"string\"\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"milestones\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"due_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"completed_date\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"linked_task_ids\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    },\n    \"project_health\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"on_track\",\n        \"at_risk\",\n        \"delayed\",\n        \"blocked\"\n      ],\n      \"default\": \"on_track\"\n    },\n    \"health_override\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"health_notes\": {\n      \"type\": \"string\"\n    },\n    \"work_notes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"number\"\n          },\n          \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"admin\",\n              \"fabrication\",\n              \"vinyl\",\n              \"permitting\",\n              \"design\",\n              \"installation\",\n              \"client\",\n              \"other\"\n            ]\n          },\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"sub_tasks\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": {\n                  \"type\": \"number\"\n                },\n                \"text\": {\n                  \"type\": \"string\"\n                },\n                \"completed\": {\n                  \"type\": \"boolean\",\n                  \"default\": false\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"follow_up\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"created_by\": {\n            \"type\": \"string\"\n          },\n          \"completed\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          }\n        }\n      }\n    },\n    \"due_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"start_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"is_rider\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"parent_work_order_id\": {\n      \"type\": \"string\"\n    },\n    \"rider_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"estimating\",\n        \"sales\",\n        \"permitting\",\n        \"design\",\n        \"production\",\n        \"fabrication\",\n        \"installation\"\n      ]\n    },\n    \"completed\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"asap\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"dependencies\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\"\n      }\n    },\n    \"in_pipeline\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"sales_import_source_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable external source row identity used by repeat Sales Pipeline spreadsheet imports.\"\n    },\n    \"sales_import_last_synced_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the last successful Sales Pipeline spreadsheet sync for this WorkOrder.\"\n    },\n    \"sales_import_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Last imported values for spreadsheet-owned Sales fields, used to detect stale spreadsheet overwrites.\"\n    },\n    \"smartsheet_sheet_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable Smartsheet sheet identity for the linked mirror record. Never derived from row or column position.\"\n    },\n    \"smartsheet_row_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable Smartsheet row identity for the linked mirror record. Used instead of visible row position, customer name, or sorting.\"\n    },\n    \"smartsheet_parent_row_id\": {\n      \"type\": \"string\",\n      \"description\": \"Stable parent-row identity from the Workflow Smartsheet hierarchy. Order Form uses this to suppress automatic child/rider rows without relying on row position or customer-name guessing.\"\n    },\n    \"smartsheet_last_synced_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the last fully verified Smartsheet synchronization for this WorkOrder.\"\n    },\n    \"smartsheet_sync_snapshot\": {\n      \"type\": \"object\",\n      \"description\": \"Last successfully synchronized mapped values used for three-way Smartsheet/Base44 conflict detection.\"\n    },\n    \"smartsheet_create_attempt\": {\n      \"type\": \"object\",\n      \"description\": \"Sales-only durable Smartsheet row creation reservation. Stores a pre-POST mapped snapshot and, if confirmed, a permanent row ID for verified one-time recovery. Never auto-repeat an uncertain create or infer row identity from its values.\"\n    },\n    \"automation_deadline_fired\": {\n      \"type\": \"object\",\n      \"description\": \"Durable deadline-automation claim markers. Keys are ruleId|triggerType|dueDate, values are the ISO date the rule last fired for that combination, so daily reminder runs never re-fire the same rule for the same deadline.\"\n    },\n    \"sales_status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"lead\",\n        \"quoted\",\n        \"follow_up\",\n        \"won\",\n        \"lost\",\n        \"on_hold\"\n      ],\n      \"default\": \"lead\"\n    },\n    \"sales_neutral_closed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Explicit user-confirmed neutral Sales archive timestamp for Closed - Did not Lose. Never counted as Won or Lost; no legacy task inference.\"\n    },\n    \"lead_source\": {\n      \"type\": \"string\"\n    },\n    \"current_task_deadline\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"current_task_assigned_to\": {\n      \"type\": \"string\"\n    },\n    \"designer\": {\n      \"type\": \"string\"\n    },\n    \"surveyor\": {\n      \"type\": \"string\"\n    },\n    \"site_survey_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"site_survey_time\": {\n      \"type\": \"string\"\n    },\n    \"site_survey_am_pm\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"AM\",\n        \"PM\"\n      ]\n    },\n    \"project_manager\": {\n      \"type\": \"string\"\n    },\n    \"estimator\": {\n      \"type\": \"string\"\n    },\n    \"est_inv_at\": {\n      \"type\": \"string\"\n    },\n    \"corbridge_invoice_number\": {\n      \"type\": \"string\"\n    },\n    \"corbridge_link\": {\n      \"type\": \"string\"\n    },\n    \"estimate_amount\": {\n      \"type\": \"number\"\n    },\n    \"estimate_revision_required\": {\n      \"type\": \"boolean\",\n      \"description\": \"Set when the linked estimate's quote total diverges from the amount this Work Order was built on. Sticky until manually reviewed.\"\n    },\n    \"current_task_description\": {\n      \"type\": \"string\"\n    },\n    \"date_initial_contact\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"date_estimate_sent\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"sales_quote_sent_verified_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp proving the current date_estimate_sent was explicitly confirmed by a verified Base44 Sales/Estimator action. Blank means the stored date is legacy or otherwise unverified and must not drive quote-aging analytics.\"\n    },\n    \"date_order_created\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"project_install_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"permit_submitted_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"permit_receipt_confirmed_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"permit_number\": {\n      \"type\": \"string\"\n    },\n    \"permit_approved_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"actual_cost\": {\n      \"type\": \"number\"\n    },\n    \"profit_margin\": {\n      \"type\": \"number\"\n    },\n    \"contact_name\": {\n      \"type\": \"string\"\n    },\n    \"contact_email\": {\n      \"type\": \"string\"\n    },\n    \"contact_phone\": {\n      \"type\": \"string\"\n    },\n    \"representative\": {\n      \"type\": \"string\"\n    },\n    \"additional_contact\": {\n      \"type\": \"string\"\n    },\n    \"follow_up_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"sales_last_follow_up_completed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the latest completed Sales Pipeline follow-up. Each change is preserved in CellHistory.\"\n    },\n    \"sales_last_follow_up_outcome\": {\n      \"type\": \"string\",\n      \"description\": \"Business-readable outcome of the latest completed Sales Pipeline follow-up. Each change is preserved in CellHistory.\"\n    },\n    \"close_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"expected_close_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Expected sales close date for an open opportunity.\"\n    },\n    \"sales_last_activity_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the latest verified sales-specific activity. Used for stale-opportunity reporting going forward.\"\n    },\n    \"sales_stage_changed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the latest verified Sales Pipeline status change.\"\n    },\n    \"lost_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Sales reason captured when an opportunity is marked Lost. Preserved in change history when reopened.\"\n    },\n    \"project_type\": {\n      \"type\": \"string\"\n    },\n    \"install_location\": {\n      \"type\": \"string\"\n    },\n    \"address_line_2\": {\n      \"type\": \"string\"\n    },\n    \"billing_address\": {\n      \"type\": \"string\"\n    },\n    \"billing_address_line_2\": {\n      \"type\": \"string\"\n    },\n    \"billing_schedule\": {\n      \"type\": \"array\",\n      \"description\": \"Progress (milestone) billing schedule. Each row is a percentage of contract value; saved schedules are normalized so cumulative pct never exceeds 100.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"label\": {\n            \"type\": \"string\"\n          },\n          \"pct\": {\n            \"type\": \"number\"\n          },\n          \"note\": {\n            \"type\": \"string\"\n          }\n        },\n        \"additionalProperties\": true\n      }\n    },\n    \"deposit_required\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"When true, this job requires a deposit before production work begins. Product moves into production statuses prompt a deposit warning until deposit_invoiced is set.\"\n    },\n    \"deposit_amount\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Deposit amount required on this order, in dollars.\"\n    },\n    \"deposit_invoiced\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Deposit has been invoiced \\u2014 maintained from the Job Workspace financials card with a compare-and-set write.\"\n    },\n    \"sales_rep\": {\n      \"type\": \"string\"\n    },\n    \"permitting\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yes\",\n        \"no\",\n        \"maybe\",\n        \"na\"\n      ]\n    },\n    \"township_city\": {\n      \"type\": \"string\"\n    },\n    \"county\": {\n      \"type\": \"string\"\n    },\n    \"permit_code\": {\n      \"type\": \"string\"\n    },\n    \"permit_class\": {\n      \"type\": \"string\"\n    },\n    \"property_owner\": {\n      \"type\": \"string\"\n    },\n    \"pud\": {\n      \"type\": \"string\"\n    },\n    \"parcel_number\": {\n      \"type\": \"string\"\n    },\n    \"electrical_ibi\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_nkyei\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_nec\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_city\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"electrical_county\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"customer_is_building_owner\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"customer_is_tenant\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"customer_is_marketing_co\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"business_co_coo_reminder\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"business_co_coo_date\": {\n      \"type\": \"string\"\n    },\n    \"install_yes\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"install_no\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"budget_less_than\": {\n      \"type\": \"number\"\n    },\n    \"removal_yes\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"removal_no\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"service_repair\": {\n      \"type\": \"string\"\n    },\n    \"origination\": {\n      \"type\": \"string\"\n    },\n    \"patch\": {\n      \"type\": \"string\"\n    },\n    \"paint\": {\n      \"type\": \"string\"\n    },\n    \"color\": {\n      \"type\": \"string\"\n    },\n    \"products\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"product_type\": {\n            \"type\": \"string\"\n          },\n          \"estimate_line_id\": {\n            \"type\": \"string\",\n            \"description\": \"Source All-In-One estimate Product line id when this product was carried from the estimator.\"\n          },\n          \"builder_product_id\": {\n            \"type\": \"string\",\n            \"description\": \"Linked BuilderProduct id. BuilderProduct/BuilderPart remain the authoritative production BOM/configuration.\"\n          },\n          \"source_project_id\": {\n            \"type\": \"string\",\n            \"description\": \"Source Builder project/entity record id.\"\n          },\n          \"module_key\": {\n            \"type\": \"string\",\n            \"description\": \"Estimator Builder module key.\"\n          },\n          \"quantity\": {\n            \"type\": \"number\"\n          },\n          \"quoted_unit_price\": {\n            \"type\": \"number\",\n            \"description\": \"Accepted customer unit price at WorkOrder conversion; never internal Product cost.\"\n          },\n          \"quoted_total\": {\n            \"type\": \"number\",\n            \"description\": \"Customer Product total after quantity and Product adjustment at WorkOrder conversion.\"\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"customer_description\": {\n            \"type\": \"string\"\n          },\n          \"estimator_notes\": {\n            \"type\": \"string\"\n          },\n          \"operational_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"order_review\",\n              \"site_survey\",\n              \"awaiting_customer_action\",\n              \"awaiting_proof_approval\",\n              \"permitting\",\n              \"proof_approved\",\n              \"design_review\",\n              \"in_design\",\n              \"in_production\",\n              \"quality_control\",\n              \"service_repair\",\n              \"install_or_removal_only\",\n              \"vended\",\n              \"none\"\n            ],\n            \"description\": \"CoreBridge-style WIP operational state for this product, independent of the work-order stage.\"\n          },\n          \"operational_substatus\": {\n            \"type\": \"string\"\n          },\n          \"customer_facing_status\": {\n            \"type\": \"string\"\n          },\n          \"fulfillment_state\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"none\",\n              \"awaiting_pickup\",\n              \"awaiting_installation\",\n              \"awaiting_shipping\",\n              \"awaiting_delivery\",\n              \"picked_up\",\n              \"installed\",\n              \"shipped\",\n              \"delivered\"\n            ]\n          },\n          \"design_due_date\": {\n            \"type\": \"string\"\n          },\n          \"product_due_date\": {\n            \"type\": \"string\"\n          },\n          \"hard_due_date\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"designer\": {\n            \"type\": \"string\"\n          },\n          \"assigned_to\": {\n            \"type\": \"string\"\n          },\n          \"responsibility\": {\n            \"type\": \"string\"\n          },\n          \"queue_priority\": {\n            \"type\": \"number\"\n          },\n          \"proof_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"none\",\n              \"draft\",\n              \"sent\",\n              \"awaiting_approval\",\n              \"approved\",\n              \"revision_requested\"\n            ]\n          },\n          \"proof_file_url\": {\n            \"type\": \"string\",\n            \"description\": \"URL of the current proof file version for this product.\"\n          },\n          \"proof_file_name\": {\n            \"type\": \"string\",\n            \"description\": \"Display name of the current proof file.\"\n          },\n          \"proof_version\": {\n            \"type\": \"number\",\n            \"description\": \"Current proof file version (1-based). 0 means no proof file.\"\n          },\n          \"proof_approved_version\": {\n            \"type\": \"number\",\n            \"description\": \"Proof version the current approval applies to. 0 means no versioned approval; approvals do not carry to newer versions.\"\n          },\n          \"operational_status_changed_at\": {\n            \"type\": \"string\",\n            \"description\": \"ISO timestamp of the last operational_status change on this product.\"\n          },\n          \"status_history\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"at\": {\n                  \"type\": \"string\"\n                },\n                \"field\": {\n                  \"type\": \"string\"\n                },\n                \"by\": {\n                  \"type\": \"string\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"product_1\": {\n      \"type\": \"string\"\n    },\n    \"product_2\": {\n      \"type\": \"string\"\n    },\n    \"product_3\": {\n      \"type\": \"string\"\n    },\n    \"product_4\": {\n      \"type\": \"string\"\n    },\n    \"product_5\": {\n      \"type\": \"string\"\n    },\n    \"product_6\": {\n      \"type\": \"string\"\n    },\n    \"cb_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"cf_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"cc_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"sms_complete\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"deleted\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"deleted_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"deleted_by\": {\n      \"type\": \"string\"\n    },\n    \"production_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"inhouse\",\n        \"outsource\"\n      ]\n    },\n    \"sip_checklist\": {\n      \"type\": \"array