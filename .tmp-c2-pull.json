      "path": "base44/entities/PurchaseOrder.jsonc",
      "content": "{\n  \"name\": \"PurchaseOrder\",\n  \"type\": \"object\",\n  \"description\": \"Canonical vendor purchase order for job materials and services. Distinct from the Smartsheet-synced Order spreadsheet. Totals and per-line received quantities are maintained server-side by purchaseOrderAction.\",\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable retry-safe receipt for one PO create.\"\n    },\n    \"po_number\": {\n      \"type\": \"string\",\n      \"description\": \"Human-facing number (e.g. PO-1042). Generated server-side.\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"draft\",\n        \"sent\",\n        \"partially_received\",\n        \"received\",\n        \"cancelled\"\n      ],\n      \"default\": \"draft\"\n    },\n    \"payment_status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"unpaid\",\n        \"invoiced\",\n        \"paid\"\n      ],\n      \"default\": \"unpaid\",\n      \"description\": \"Vendor payment state: unpaid \\u2192 invoiced (vendor bill received) \\u2192 paid.\"\n    },\n    \"vendor_invoice_number\": {\n      \"type\": \"string\",\n      \"description\": \"Vendor's bill/invoice number recorded when marked invoiced.\"\n    },\n    \"paid_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\"\n    },\n    \"paid_amount\": {\n      \"type\": \"number\"\n    },\n    \"vendor_name\": {\n      \"type\": \"string\"\n    },\n    \"vendor_contact\": {\n      \"type\": \"string\"\n    },\n    \"vendor_email\": {\n      \"type\": \"string\"\n    },\n    \"vendor_phone\": {\n      \"type\": \"string\"\n    },\n    \"work_order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Job this PO buys for \\u2014 feeds job material costing.\"\n    },\n    \"estimate_id\": {\n      \"type\": \"string\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\"\n    },\n    \"line_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": true,\n        \"properties\": {\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"quantity\": {\n            \"type\": \"number\"\n          },\n          \"unit_cost\": {\n            \"type\": \"number\"\n          },\n          \"quantity_received\": {\n            \"type\": \"number\"\n          },\n          \"inventory_item_id\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"subtotal\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"shipping_fee\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"total\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"order_date\": {\n      \"type\": \"string\"\n    },\n    \"expected_date\": {\n      \"type\": \"string\"\n    },\n    \"sent_date\": {\n      \"type\": \"string\"\n    },\n    \"received_date\": {\n      \"type\": \"string\"\n    },\n    \"ship_to\": {\n      \"type\": \"string\"\n    },\n    \"vendor_reference\": {\n      \"type\": \"string\",\n      \"description\": \"Vendor's confirmation/quote number.\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"internal_notes\": {\n      \"type\": \"string\"\n    },\n    \"created_by\": {\n      \"type\": \"string\"\n    },\n    \"updated_by\": {\n      \"type\": \"string\"\n    },\n    \"source_summary\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true\n    }\n  },\n  \"required\": [\n    \"vendor_name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__purchase_order_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__purchase_order_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__purchase_order_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__purchase_order_backend_only__\"\n      }\n    }\n  }\n}",
