      "path": "base44/entities/Payment.jsonc",
      "content": "{\n  \"name\": \"Payment\",\n  \"type\": \"object\",\n  \"description\": \"Canonical payment applied to an Invoice. Always written by invoicingAction so invoice balances stay consistent \\u2014 never edited directly. Void/refund rather than delete to preserve the audit trail.\",\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Stable retry-safe receipt for one payment record.\"\n    },\n    \"invoice_id\": {\n      \"type\": \"string\",\n      \"description\": \"Invoice this payment applies to.\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Denormalized from the invoice for AR queries.\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\"\n    },\n    \"estimate_id\": {\n      \"type\": \"string\"\n    },\n    \"work_order_id\": {\n      \"type\": \"string\"\n    },\n    \"amount\": {\n      \"type\": \"number\",\n      \"description\": \"Signed amount applied to the invoice: positive for payments, negative for credit-memo and refund rows. Invoice amount_paid is the net sum of recorded + refunded rows.\"\n    },\n    \"method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"cash\",\n        \"check\",\n        \"card\",\n        \"ach\",\n        \"financing\",\n        \"other\",\n        \"credit_memo\"\n      ],\n      \"default\": \"other\"\n    },\n    \"reference_number\": {\n      \"type\": \"string\",\n      \"description\": \"Check number, card auth, ACH trace, or other external reference.\"\n    },\n    \"paid_date\": {\n      \"type\": \"string\",\n      \"description\": \"Date the money was received.\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"recorded\",\n        \"void\",\n        \"refunded\"\n      ],\n      \"default\": \"recorded\",\n      \"description\": \"recorded = live row (payments positive, credit memos negative); refunded = a negative refund row or a fully-refunded original payment; void = reversed.\"\n    },\n    \"void_reason\": {\n      \"type\": \"string\"\n    },\n    \"voided_date\": {\n      \"type\": \"string\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"refund_of_payment_id\": {\n      \"type\": \"string\",\n      \"description\": \"On refund rows: id of the original Payment this refund reverses.\"\n    },\n    \"refunded_amount\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"On original payments: cumulative refunded dollars so far (partial refunds allowed).\"\n    },\n    \"reconciliation_batch_id\": {\n      \"type\": \"string\",\n      \"description\": \"ReconciliationBatch this payment was swept into at cash close. Empty = still unreconciled. Set only by manageReconciliation.\"\n    },\n    \"created_by\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"invoice_id\",\n    \"amount\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__payment_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__payment_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__payment_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__payment_backend_only__\"\n      }\n    }\n  }\n}",
      "startLine": 1,
      "endLine": 118,
      "totalLines": 118,
      "truncated": false
    },
