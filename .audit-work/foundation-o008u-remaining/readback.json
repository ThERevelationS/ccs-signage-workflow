    {
      "path": "src/components/masterInventory/InventoryTable.jsx",
      "content": "import { useEffect, useRef, useState, Fragment } from \"react\";\nimport { Button } from \"@/components/ui/button\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Switch } from \"@/components/ui/switch\";\nimport { ArrowDown, ArrowUp, ArrowUpDown, Edit, Trash2, Package } from \"lucide-react\";\nimport { expectedEntityFields, replaceEntityFieldsIfUnchanged } from \"@/components/estimator/builder/builderEntityPersistence\";\nimport { findInventoryEstimateUsage } from \"./inventoryPersistence\";\n// groupInventoryBySupplier (CMP-A08 tail) renders the explicit supply\n// grouping in the generic table — rows section by canonical supplier key;\n// \"—\" (unrecorded) sorts last instead of silently merging vendors.\nimport { groupInventoryBySupplier } from \"./inventoryNormalization\";\nimport { base44 } from \"@/api/base44Client\";\n\n// Lazily resolves how many estimates consume this item's inventory row via\n// BuilderPart → BuilderProduct joins. Clicking expands which estimates.\nfunction UsageBadge({ itemId }) {\n  const [usage, setUsage] = useState(null);\n  const [expanded, setExpanded] = useState(false);\n  const [names, setNames] = useState(null);\n  useEffect(() => {\n    let active = true;\n    findInventoryEstimateUsage(itemId)\n      .then((u) => { if (active && u?.estimates > 0) setUsage(u); })\n      .catch(() => {});\n    return () => { active = false; };\n  }, [itemId]);\n  useEffect(() => {\n    if (!expanded || names !== null || !usage?.estimateIds?.length) return;\n    let active = true;\n    (async () => {\n      const out = [];\n      for (const id of usage.estimateIds) {\n        const row = await base44.entities.AllInOneEstimate.get(id).catch(() => null);\n        out.push(row?.estimate_name || row?.name || row?.project_name || id);\n      }\n      if (active) setNames(out);\n    })();\n    return () => { active = false; };\n  }, [expanded, names, usage]);\n  if (!usage) return null;\n  return (\n    <span className=\"relative inline-block\">\n      <button type=\"button\" onClick={() => setExpanded(!expanded)}\n        className=\"ml-1.5 inline-flex items-center rounded bg-sky-100 px-1 py-0.5 text-[9px] font-semibold text-sky-800 align-middle hover:bg-sky-200\"\n        title={`Used in ${usage.estimates} estimate${usage.estimates === 1 ? \"\" : \"s\"} across ${usage.products} product${usage.products === 1 ? \"\" : \"s\"} — click to list`}>\n        {usage.estimates} est\n      </button>\n      {expanded && (\n        <span className=\"absolute left-0 top-full z-20 mt-1 block w-52 rounded border border-slate-200 bg-white p-2 text-[10px] text-slate-700 shadow-lg normal-case\">\n          <span className=\"block font-semibold mb-1\">Estimates using this item:</span>\n          {names === null\n            ? <span className=\"text-slate-400\">Resolving…</span>\n            : <span className=\"block space-y-0.5\">{names.map((n, i) => <span key={i} className=\"block truncate\">• {n}</span>)}</span>}\n        </span>\n      )}\n    </span>\n  );\n}\n\nconst formatCell = (val, field) => {\n  if (val === null || val === undefined || val === \"\") return \"—\";\n  if (field.type === \"number\") {\n    const n = parseFloat(val);\n    if (Number.isNaN(n)) return \"—\";\n    if (field.label.includes(\"$\") || field.name.includes(\"cost\")) {\n      return `$${n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\n    }\n    return n.toLocaleString();\n  }\n  if (field.type === \"boolean\") return val ? \"Yes\" : \"No\";\n  return String(val).replace(/_/g, \" \");\n};\n\nexport default function InventoryTable({ source, items, canEdit, onEdit, onDelete, onInlineToggle, bulkField = null, onBulkMove }) {\n  const tableFields = source.fields.filter((f) => f.table);\n  const toggleRef = useRef(new Set());\n  const [sort, setSort] = useState(null);\n  const [selectedIds, setSelectedIds] = useState(new Set());\n  const [bulkValue, setBulkValue] = useState(\"\");\n\n  const toggleSelect = (id) => setSelectedIds((prev) => {\n    const next = new Set(prev);\n    if (next.has(id)) next.delete(id); else next.add(id);\n    return next;\n  });\n\n  const toggleSort = (name) => {\n    setSort((prev) => {\n      if (!prev || prev.name !== name) return { name, dir: \"asc\" };\n      if (prev.dir === \"asc\") return { name, dir: \"desc\" };\n      return null;\n    });\n  };\n\n  const sortedItems = !sort ? items : [...items].sort((a, b) => {\n    const field = tableFields.find((f) => f.name === sort.name);\n    const av = a[sort.name], bv = b[sort.name];\n    if (field?.type === \"number\") {\n      const an = parseFloat(av), bn = parseFloat(bv);\n      if (Number.isNaN(an) && Number.isNaN(bn)) return 0;\n      if (Number.isNaN(an)) return 1;\n      if (Number.isNaN(bn)) return -1;\n      return sort.dir === \"asc\" ? an - bn : bn - an;\n    }\n    const as = (av === null || av === undefined) ? \"\" : String(av);\n    const bs = (bv === null || bv === undefined) ? \"\" : String(bv);\n    const cmp = as.localeCompare(bs, undefined, { numeric: true, sensitivity: \"base\" });\n    return sort.dir === \"asc\" ? cmp : -cmp;\n  });\n\n  const allVisibleSelected = sortedItems.length > 0 && sortedItems.every((it) => selectedIds.has(it.id));\n  const toggleSelectAll = () => setSelectedIds((prev) => {\n    if (allVisibleSelected) return new Set();\n    const next = new Set(prev);\n    sortedItems.forEach((it) => next.add(it.id));\n    return next;\n  });\n\n  // CMP-A08 tail: the authored supplier field per row — `supplier` on the\n  // declarative catalog entities; raw LaborServiceInventory rows group on\n  // vendor_name (service_name fallback), matching the boundary contract.\n  const tableSupplier = (row) => row?.supplier || row?.vendor_name || row?.service_name;\n\n  const handleToggle = async (item, field, next) => {\n    const lockKey = `${item.id}:${field.name}`;\n    if (!canEdit || toggleRef.current.has(lockKey)) return;\n    toggleRef.current.add(lockKey);\n    try {\n      // Per-row entity routing for combined-view tabs (e.g. Extruded Metals & Poles).\n      // The row may carry an explicit `_entity` reference; otherwise fall back to source.entity.\n      const entity = item._entity || source.entity;\n      if (!entity) {\n        console.warn(\"No entity available for inline toggle on\", item);\n        return;\n      }\n      const live = await entity.get(item.id);\n      if (live?.[field.name] !== item[field.name]) {\n        onInlineToggle?.(item.id, field.name, live?.[field.name]);\n        alert(\"This inventory toggle changed in another session. The latest value has been restored; review it before changing again.\");\n        return;\n      }\n      const togglePatch = { [field.name]: next };\n      const saved = await replaceEntityFieldsIfUnchanged({\n        entity,\n        id: item.id,\n        expectedFields: expectedEntityFields(live, togglePatch),\n        nextFields: togglePatch,\n        label: `Inventory ${field.label || field.name} toggle`,\n      });\n      onInlineToggle?.(item.id, field.name, saved?.[field.name] ?? next);\n    } catch (e) {\n      console.error(\"Toggle failed:\", e);\n      alert(\"Failed to update toggle.\");\n    } finally {\n      toggleRef.current.delete(lockKey);\n    }\n  };\n\n  if (!items.length) {\n    return (\n      <div className=\"text-center py-16 text-slate-500\">\n        <Package className=\"w-12 h-12 mx-auto mb-4 text-slate-300\" />\n        <p className=\"font-medium\">No items found</p>\n        <p className=\"text-sm\">\n          {canEdit ? \"Click \\\"Add Item\\\" to create your first one.\" : \"Ask an admin to add items here.\"}\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"w-full\">\n      {bulkField && canEdit && (\n        <div className=\"flex flex-wrap items-center gap-2 border-b bg-slate-50 px-2 py-1.5 text-xs\">\n          <span className=\"font-semibold text-slate-600\">{selectedIds.size} selected</span>\n          <select value={bulkValue} onChange={(e) => setBulkValue(e.target.value)}\n            className=\"h-7 rounded border border-slate-300 bg-white px-1.5 text-xs\">\n            <option value=\"\">Move {bulkField.label || bulkField.name} to…</option>\n            {(bulkField.options || []).map((opt) => (\n              <option key={typeof opt === \"object\" ? opt.value : opt} value={typeof opt === \"object\" ? opt.value : opt}>{typeof opt === \"object\" ? (opt.label || opt.value) : String(opt).replace(/_/g, \" \")}</option>\n            ))}\n          </select>\n          <button type=\"button\" disabled={!selectedIds.size || !bulkValue}\n            onClick={() => { onBulkMove?.([...selectedIds], bulkField.name, bulkValue); setSelectedIds(new Set()); }}\n            className=\"h-7 rounded bg-sky-600 px-2.5 font-semibold text-white hover:bg-sky-700 disabled:opacity-40\">\n            Move {selectedIds.size > 0 ? `${selectedIds.size} ` : \"\"}selected\n          </button>\n          {selectedIds.size > 0 && (\n            <button type=\"button\" onClick={() => setSelectedIds(new Set())} className=\"text-slate-500 underline\">Clear</button>\n          )}\n        </div>\n      )}\n      <table className=\"w-full text-sm table-fixed\">\n        <thead className=\"border-b bg-slate-50\">\n          <tr className=\"text-left\">\n            {bulkField && canEdit && (\n              <th className=\"w-8 px-2 py-3\">\n                <input type=\"checkbox\" checked={allVisibleSelected} onChange={toggleSelectAll}\n                  title={allVisibleSelected ? \"Deselect all visible\" : \"Select all visible\"} />\n              </th>\n            )}\n            {tableFields.map((f) => (\n              <th key={f.name} className=\"px-2 py-3 font-medium text-slate-600 text-xs\">\n                <button type=\"button\" onClick={() => toggleSort(f.name)} className=\"inline-flex items-center gap-1 hover:text-slate-900\" title={`Sort by ${f.label}`}>\n                  {f.label}\n                  {sort?.name === f.name\n                    ? (sort.dir === \"asc\" ? <ArrowUp className=\"w-3 h-3\" /> : <ArrowDown className=\"w-3 h-3\" />)\n                    : <ArrowUpDown className=\"w-3 h-3 opacity-40\" />}\n                </button>\n              </th>\n            ))}\n            {canEdit && <th className=\"px-2 py-3 font-medium text-slate-600 text-right text-xs w-20\">Actions</th>}\n          </tr>\n        </thead>\n        <tbody className=\"divide-y\">\n          {groupInventoryBySupplier(sortedItems, tableSupplier).map((group) => (\n            // CMP-A08 tail: explicit supply grouping — a supplier header row\n            // sections the table by canonical supplier key; unrecorded\n            // suppliers stay visible last, never merged.\n            <Fragment key={group.key ?? \"__unassigned__\"}>\n              <tr className=\"bg-slate-50/80\">\n                <td colSpan={tableFields.length + (canEdit ? 1 : 0) + (bulkField && canEdit ? 1 : 0)} className=\"px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-500\">\n                  Supplier: <span className=\"text-slate-700 normal-case\">{group.label || \"— not recorded\"}</span>\n                  <span className=\"ml-2 font-normal normal-case text-slate-400\">({group.rows.length})</span>\n                </td>\n              </tr>\n              {group.rows.map((item) => (\n            <tr key={item.id} className=\"hover:bg-slate-50 transition-colors\">\n              {bulkField && canEdit && (\n                <td className=\"w-8 px-2 py-3 align-top\">\n                  <input type=\"checkbox\" checked={selectedIds.has(item.id)} onChange={() => toggleSelect(item.id)}\n                    title=\"Select for bulk move\" />\n                </td>\n              )}\n              {tableFields.map((f, idx) => (\n                <td key={f.name} className=\"px-2 py-3 align-top\">\n                  {idx === 0 ? (\n                    <span className=\"font-medium text-slate-900\">{formatCell(item[f.name], f)}<UsageBadge itemId={item.id} /></span>\n                  ) : f.type === \"boolean\" ? (\n                    canEdit ? (\n                      <Switch\n                        checked={!!item[f.name]}\n                        onCheckedChange={(next) => handleToggle(item, f, next)}\n                      />\n                    ) : (\n                      <span className=\"text-slate-700\">{formatCell(item[f.name], f)}</span>\n                    )\n                  ) : f.type === \"select\" ? (\n                    <Badge variant=\"outline\" className=\"font-normal\">\n                      {formatCell(item[f.name], f)}\n                    </Badge>\n                  ) : (\n                    <span className=\"text-slate-700\">{formatCell(item[f.name], f)}</span>\n                  )}\n                </td>\n              ))}\n              {canEdit && (\n                <td className=\"px-2 py-3 text-right whitespace-nowrap\">\n                  <Button variant=\"ghost\" size=\"icon\" className=\"h-7 w-7\" onClick={() => onEdit(item)}>\n                    <Edit className=\"w-3.5 h-3.5\" />\n                  </Button>\n                  <Button\n                    variant=\"ghost\"\n                    size=\"icon\"\n                    className=\"h-7 w-7 text-red-500 hover:text-red-700 hover:bg-red-50\"\n                    onClick={() => onDelete(item)}\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </Button>\n                </td>\n              )}\n            </tr>\n              ))}\n            </Fragment>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  );\n}",
      "startLine": 1,
      "endLine": 280,
      "totalLines": 280,
      "truncated": false
    },
    {
      "path": "src/pages/FoundationCatalog.jsx",
      "content": "import { useState, useEffect, useRef } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { base44 } from \"@/api/base44Client\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { ArrowLeft, Plus, Pencil, Trash2, Search } from \"lucide-react\";\nimport { MATERIAL_TYPES, typeLabel } from \"@/components/masterInventory/foundationFieldSchema\";\n// groupInventoryBySupplier (CMP-A08 tail) sections the catalog list by\n// canonical supplier key — \"No supplier recorded\" stays visible last.\nimport { groupInventoryBySupplier } from \"@/components/masterInventory/inventoryNormalization\";\nimport FoundationMaterialDialog from \"@/components/masterInventory/FoundationMaterialDialog\";\nimport { deleteEntityIfUnchanged } from \"@/components/estimator/builder/builderEntityPersistence\";\nimport { loadAllEntityRows } from \"@/components/estimator/loadAllEntityRows\";\nimport { ListSkeleton } from \"@/components/ui/list-skeleton\";\nimport { staffEntities } from \"@/components/staff/staffEntities\";\n\nexport default function FoundationCatalog() {\n  const [rows, setRows] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [activeType, setActiveType] = useState(() => new URLSearchParams(window.location.search).get(\"type\") || \"concrete_service\");\n  const [search, setSearch] = useState(() => new URLSearchParams(window.location.search).get(\"q\") || \"\");\n  const writeParam = (key, value, defaultValue = \"\") => {\n    try {\n      const next = new URLSearchParams(window.location.search);\n      if (value && value !== defaultValue) next.set(key, value); else next.delete(key);\n      window.history.replaceState(null, \"\", `${window.location.pathname}?${next}`);\n    } catch {}\n  };\n  const [editing, setEditing] = useState(null);\n  const [dialogOpen, setDialogOpen] = useState(false);\n  const [loadError, setLoadError] = useState(\"\");\n  const deleteRef = useRef(new Set());\n\n  const load = async () => {\n    setLoading(true);\n    setLoadError(\"\");\n    try {\n      const res = await loadAllEntityRows({ entity: staffEntities.FoundationInventory, sort: \"-created_date\", label: \"Foundation Catalog inventory\" });\n      setRows(res || []);\n    } catch (error) {\n      console.error(\"Foundation catalog load failed:\", error);\n      setLoadError(error?.message || \"Foundation Catalog could not be verified.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    load();\n  }, []);\n\n  const q = search.trim().toLowerCase();\n  const visible = rows.filter((r) => {\n    if (r.material_type !== activeType) return false;\n    if (!q) return true;\n    return [r.material_name, r.material_description, r.supplier, r.unit]\n      .filter(Boolean).join(\" \").toLowerCase().includes(q);\n  });\n\n  // (#421) The catalog fetches paged via loadAllEntityRows and the type chips\n  // need whole-table counts; the rendered list windows instead of mounting\n  // every row at once. Resets when the type or search changes.\n  const ROW_PAGE = 60;\n  const [visibleCount, setVisibleCount] = useState(ROW_PAGE);\n  useEffect(() => { setVisibleCount(ROW_PAGE); }, [activeType, q]);\n\n  // CMP-A08 tail: the filtered list sections by canonical supplier key\n  // (unrecorded suppliers sort last, never merged). The visibleCount window\n  // still caps rendered ROWS — group headers don't count against it.\n  const catalogSections = (() => {\n    let budget = visibleCount;\n    const out = [];\n    for (const group of groupInventoryBySupplier(visible)) {\n      if (budget <= 0) break;\n      const groupRows = group.rows.slice(0, budget);\n      budget -= groupRows.length;\n      out.push({ ...group, rows: groupRows });\n    }\n    return out;\n  })();\n\n  const handleDelete = async (row) => {\n    if (!row?.id || loadError || deleteRef.current.has(row.id)) return;\n    deleteRef.current.add(row.id);\n    if (!window.confirm(`Delete \"${row.material_name || \"this material\"}\"? This cannot be undone.`)) {\n      deleteRef.current.delete(row.id);\n      return;\n    }\n    try {\n      const live = await staffEntities.FoundationInventory.get(row.id);\n      if (row.updated_date && live?.updated_date && row.updated_date !== live.updated_date) {\n        alert(\"This Foundation Catalog item changed in another session and was not deleted. The latest catalog will be reloaded first.\");\n        await load();\n        return;\n      }\n      await deleteEntityIfUnchanged({\n        entity: staffEntities.FoundationInventory,\n        record: live,\n        label: `Foundation Catalog item \"${live.material_name || row.material_name || \"Material\"}\"`,\n      });\n      await load();\n    } catch (error) {\n      console.error(\"Foundation catalog delete failed:\", error);\n      alert(error?.message || \"Foundation Catalog item could not be deleted.\");\n      await load();\n    } finally {\n      deleteRef.current.delete(row.id);\n    }\n  };\n\n  return (\n    <div className=\"clay-scope min-h-full bg-gradient-to-br from-rose-50 to-orange-50\">\n      <div className=\"max-w-5xl mx-auto p-4 sm:p-6\">\n        <div className=\"flex items-center justify-between gap-3 mb-4\">\n          <Link to=\"/Estimator\" className=\"flex items-center gap-1 text-sm text-gray-600 hover:text-red-600\">\n            <ArrowLeft className=\"w-4 h-4\" aria-hidden=\"true\" /> Estimator\n          </Link>\n          <div className=\"relative flex-1 max-w-xs\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400\" aria-hidden=\"true\" />\n            <Input\n              placeholder=\"Search name, description, supplier…\"\n              aria-label=\"Search catalog materials\"\n              value={search}\n              onChange={(e) => { const v = e.target.value; setSearch(v); writeParam(\"q\", v); }}\n              className=\"pl-9 h-9\"\n            />\n          </div>\n          <Button\n            disabled={!!loadError}\n            onClick={() => {\n              setEditing(null);\n              setDialogOpen(true);\n            }}\n            className=\"bg-red-600 hover:bg-red-700 text-white disabled:opacity-50\"\n          >\n            <Plus className=\"w-4 h-4\" aria-hidden=\"true\" /> New Material\n          </Button>\n        </div>\n\n        <h1 className=\"text-2xl font-bold text-gray-900 mb-1\">Foundation Catalog</h1>\n        <p className=\"text-sm text-gray-500 mb-4\">\n          Materials, poles, walls and equipment used by the Concrete | Masonry | Poles estimator.\n        </p>\n\n        <div className=\"flex gap-2 overflow-x-auto pb-2 mb-4\" role=\"tablist\" aria-label=\"Material type filter\"\n          onKeyDown={(e) => {\n            if (![\"ArrowLeft\", \"ArrowRight\", \"Home\", \"End\"].includes(e.key)) return;\n            const tabs = [...e.currentTarget.querySelectorAll('button[role=\"tab\"]')];\n            const i = tabs.indexOf(document.activeElement);\n            if (i < 0) return;\n            e.preventDefault();\n            const next = e.key === \"Home\" ? tabs[0] : e.key === \"End\" ? tabs[tabs.length - 1] : tabs[(i + (e.key === \"ArrowRight\" ? 1 : -1) + tabs.length) % tabs.length];\n            next?.focus();\n          }}>\n          {MATERIAL_TYPES.map((t) => (\n            <button type=\"button\"\n              key={t.value}\n              role=\"tab\"\n              aria-selected={activeType === t.value}\n              onClick={() => { const v = t.value; setActiveType(v); writeParam(\"type\", v, \"concrete_service\"); }}\n              className={`px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap border ${\n                activeType === t.value\n                  ? \"bg-red-600 text-white border-red-600\"\n                  : \"bg-white text-gray-600 border-gray-200 hover:border-red-300\"\n              }`}\n            >\n              {t.label} ({rows.filter((r) => r.material_type === t.value).length})\n            </button>\n          ))}\n        </div>\n\n        {loading ? (\n          <ListSkeleton rows={6} />\n        ) : loadError ? (\n          <div role=\"alert\" className=\"py-8 text-center bg-red-50 rounded-xl border border-red-200 text-red-700\">\n            <div className=\"font-semibold\">Foundation Catalog could not be verified.</div>\n            <div className=\"text-xs mt-1\">{loadError}</div>\n            <Button variant=\"outline\" size=\"sm\" className=\"mt-3\" onClick={load}>Retry</Button>\n          </div>\n        ) : visible.length === 0 ? (\n          <div className=\"py-12 text-center bg-white rounded-xl border border-dashed border-gray-300 text-gray-500\">\n            No {typeLabel(activeType)} entries yet.\n          </div>\n        ) : (\n          <div className=\"space-y-4\">\n            {catalogSections.map((group) => (\n              <div key={group.key ?? \"__unassigned__\"} className=\"space-y-2\">\n                {/* CMP-A08 tail: explicit supply grouping — rows split by their\n                    canonical supplier key; unrecorded suppliers stay visible\n                    last instead of silently merging into another vendor. */}\n                <div className=\"text-xs font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 pb-1\">\n                  {group.label ? <>Supplier: <span className=\"text-slate-700 normal-case\">{group.label}</span></> : 'No supplier recorded'}\n                </div>\n                {group.rows.map((row) => (\n              <div\n                key={row.id}\n                className=\"bg-white rounded-xl border border-gray-200 p-3 flex items-center justify-between gap-3\"\n              >\n                <div className=\"min-w-0\">\n                  <div className=\"font-medium text-gray-900 truncate\">{row.material_name}</div>\n                  <div className=\"text-xs text-gray-500 truncate\">\n                    {row.material_description || row.supplier || \"—\"}\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-3 flex-shrink-0\">\n                  <div className=\"text-sm font-semibold text-gray-800\">\n                    ${Number(row.cost_per_unit || row.cost_per_day || row.pole_stock_price || 0).toFixed(2)}\n                    <span className=\"text-xs text-gray-400 font-normal\">\n                      {row.unit ? ` / ${row.unit}` : \"\"}\n                    </span>\n                  </div>\n                  <button type=\"button\"\n                    disabled={!!loadError}\n                    onClick={() => {\n                      setEditing(row);\n                      setDialogOpen(true);\n                    }}\n                    title={`Edit ${row.material_name || \"material\"}`}\n                    aria-label={`Edit ${row.material_name || \"material\"}`}\n                    className=\"min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-gray-400 hover:text-red-600\"\n                  >\n                    <Pencil className=\"w-4 h-4\" aria-hidden=\"true\" />\n                  </button>\n                  <button type=\"button\" onClick={() => handleDelete(row)} title={`Delete ${row.material_name || \"material\"}`} aria-label={`Delete ${row.material_name || \"material\"}`} className=\"min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-gray-400 hover:text-red-600\">\n                    <Trash2 className=\"w-4 h-4\" aria-hidden=\"true\" />\n                  </button>\n                </div>\n              </div>\n                ))}\n              </div>\n            ))}\n            {visible.length > visibleCount && (\n              <button\n                type=\"button\"\n                onClick={() => setVisibleCount((c) => c + ROW_PAGE)}\n                className=\"w-full h-[30px] rounded-lg border border-gray-300 bg-white text-[11px] font-bold text-gray-600 hover:bg-gray-50\"\n              >\n                Show {Math.min(ROW_PAGE, visible.length - visibleCount)} more ({visible.length - visibleCount} remaining)\n              </button>\n            )}\n          </div>\n        )}\n      </div>\n\n      <FoundationMaterialDialog\n        open={dialogOpen}\n        record={editing}\n        defaultType={activeType}\n        onClose={() => setDialogOpen(false)}\n        onSaved={() => {\n          setDialogOpen(false);\n          load();\n        }}\n      />\n    </div>\n  );\n}",
      "startLine": 1,
      "endLine": 257,
      "totalLines": 257,
      "truncated": false
    }
  ]
}
