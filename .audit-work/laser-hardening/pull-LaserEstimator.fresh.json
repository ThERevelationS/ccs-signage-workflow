   border-top: 3px solid #667eea;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n    \n    .total-label {\n      font-size: 24px;\n      font-weight: 700;\n      color: #1e293b;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n    \n    .total-value {\n      font-size: 36px;\n      font-weight: 800;\n      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n    }\n    \n    .notes {\n      background: #fef3c7;\n      border: 2px solid #fbbf24;\n      border-radius: 12px;\n      padding: 25px;\n      margin-top: 30px;\n    }\n    \n    .notes h3 {\n      color: #92400e;\n      font-size: 16px;\n      font-weight: 700;\n      margin-bottom: 15px;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n    \n    .notes p {\n      color: #78350f;\n      line-height: 1.6;\n      font-size: 14px;\n    }\n    \n    .footer {\n      background: #1e293b;\n      color: white;\n      padding: 20px;\n      text-align: center;\n      font-size: 12px;\n    }\n    \n    @media print {\n      body { \n        background: white;\n        padding: 0;\n      }\n      .container {\n        box-shadow: none;\n        border-radius: 0;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>⚡ Laser Estimate</h1>\n      <div class=\"subtitle\">Precision Cutting & Engraving Services</div>\n    </div>\n    \n    <div class=\"project-info\">\n      <h2>Project Details</h2>\n      <div class=\"info-grid\">\n        <div class=\"info-item\">\n          <span class=\"info-label\">Project:</span>\n          <span class=\"info-value\">${escHtml(project.project_name)}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">Client:</span>\n          <span class=\"info-value\">${escHtml(project.client_name)}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">Estimate #:</span>\n          <span class=\"info-value\">${escHtml(project.estimate_number)}</span>\n        </div>\n        <div class=\"info-item\">\n          <span class=\"info-label\">Date:</span>\n          <span class=\"info-value\">${new Date().toLocaleDateString()}</span>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"content\">\n      <div class=\"section-title\">Items Breakdown</div>\n      \n      ${project.items.map((item, i) => `\n        <div class=\"item\">\n          <div class=\"item-header\">\n            Item ${i + 1}: ${escHtml(item.description || item.item_type + \" item\")}\n          </div>\n          \n          <div class=\"item-details\">\n            <div class=\"detail-row\">\n              <span class=\"detail-label\">Type:</span>\n              <span class=\"detail-value\">${escHtml(item.item_type)}</span>\n            </div>\n            <div class=\"detail-row\">\n              <span class=\"detail-label\">Material:</span>\n              <span class=\"detail-value\">${escHtml(item.material_type)} - ${escHtml(item.material_thickness)}\"</span>\n            </div>\n            <div class=\"detail-row\">\n              <span class=\"detail-label\">Quantity:</span>\n              <span class=\"detail-value\">${escHtml(item.quantity)}</span>\n            </div>\n            ${item.item_type === 'panel' || item.item_type === 'engrave_and_cut' ? `\n            <div class=\"detail-row\">\n              <span class=\"detail-label\">Dimensions:</span>\n              <span class=\"detail-value\">${escHtml(item.length)}\" × ${escHtml(item.width)}\"</span>\n            </div>\n            ` : ''}\n            ${item.item_type === 'lettering' ? `\n            <div class=\"detail-row\">\n              <span class=\"detail-label\">Letter Height:</span>\n              <span class=\"detail-value\">${escHtml(item.letter_height)}