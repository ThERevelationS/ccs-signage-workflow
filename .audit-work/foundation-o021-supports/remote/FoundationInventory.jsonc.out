      "path": "base44/entities/FoundationInventory.jsonc",
      "content": "{\n  \"name\": \"FoundationInventory\",\n  \"type\": \"object\",\n  \"description\": \"Catalog for the Concrete | Masonry | Poles estimator: ready-mix and bagged concrete (with mix/admix/small-load pricing), rebar, forming lumber, excavation equipment with attachment trees, poles, brick/stone, fill, wall material and wall caps.\",\n  \"properties\": {\n    \"material_name\": {\n      \"type\": \"string\",\n      \"description\": \"Name of the material or equipment\"\n    },\n    \"material_description\": {\n      \"type\": \"string\",\n      \"description\": \"Detailed description shown in dropdowns\"\n    },\n    \"material_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"concrete_service\",\n        \"bagged_concrete\",\n        \"rebar\",\n        \"forming_material\",\n        \"excavation_equipment\",\n        \"attachment\",\n        \"sub_attachment\",\n        \"pole\",\n        \"brick_stone\",\n        \"fill_material\",\n        \"wall_material\",\n        \"wall_cap\",\n        \"rebar_support\"\n      ],\n      \"description\": \"Type of material\"\n    },\n    \"foundation_usage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"spread_foot\",\n        \"pillar\",\n        \"general\"\n      ]\n    },\n    \"lumber_size\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"2x4\",\n        \"2x6\",\n        \"2x8\",\n        \"2x10\",\n        \"2x12\",\n        \"plywood_3/4\",\n        \"custom\"\n      ]\n    },\n    \"thickness_inches\": {\n      \"type\": \"number\"\n    },\n    \"pole_shape\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"square\",\n        \"round\"\n      ]\n    },\n    \"pole_width_inches\": {\n      \"type\": \"number\"\n    },\n    \"pole_depth_inches\": {\n      \"type\": \"number\"\n    },\n    \"pole_wall_thickness_inches\": {\n      \"type\": \"number\"\n    },\n    \"pole_stock_length_ft\": {\n      \"type\": \"number\"\n    },\n    \"pole_stock_price\": {\n      \"type\": \"number\"\n    },\n    \"pole_pricing_mode\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"per_foot\",\n        \"stock_price\"\n      ]\n    },\n    \"paint_rate_per_linear_ft\": {\n      \"type\": \"number\"\n    },\n    \"brick_length_inches\": {\n      \"type\": \"number\"\n    },\n    \"brick_width_inches\": {\n      \"type\": \"number\"\n    },\n    \"brick_height_inches\": {\n      \"type\": \"number\"\n    },\n    \"brick_color\": {\n      \"type\": \"string\"\n    },\n    \"brick_texture\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"smooth\",\n        \"rough\",\n        \"textured\",\n        \"glazed\"\n      ]\n    },\n    \"fill_material_subtype\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"cinder_block\",\n        \"poured_concrete\",\n        \"gravel\",\n        \"foam\",\n        \"sand\"\n      ]\n    },\n    \"wall_material_subtype\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"brick\",\n        \"cinderblock\",\n        \"stone\",\n        \"concrete\"\n      ]\n    },\n    \"wall_unit_length_inches\": {\n      \"type\": \"number\"\n    },\n    \"wall_unit_width_inches\": {\n      \"type\": \"number\"\n    },\n    \"wall_unit_height_inches\": {\n      \"type\": \"number\"\n    },\n    \"wall_color\": {\n      \"type\": \"string\"\n    },\n    \"wall_texture\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"smooth\",\n        \"rough\",\n        \"textured\",\n        \"glazed\"\n      ]\n    },\n    \"cap_stock_length_inches\": {\n      \"type\": \"number\"\n    },\n    \"cap_width_inches\": {\n      \"type\": \"number\"\n    },\n    \"cap_height_inches\": {\n      \"type\": \"number\"\n    },\n    \"cap_profile\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"flat\",\n        \"beveled\",\n        \"rounded\",\n        \"peaked\",\n        \"stepped\"\n      ]\n    },\n    \"cap_color\": {\n      \"type\": \"string\"\n    },\n    \"cap_stock_price\": {\n      \"type\": \"number\"\n    },\n    \"is_cuttable\": {\n      \"type\": \"boolean\"\n    },\n    \"equipment_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ladder\",\n        \"scissor_lift\",\n        \"boom_lift\",\n        \"boom_truck\",\n        \"scaffold\",\n        \"truck\",\n        \"car\",\n        \"van\",\n        \"flatbed\",\n        \"hand_tool\",\n        \"power_tool\",\n        \"safety\",\n        \"other\"\n      ],\n      \"description\": \"Equipment sub-type for excavation_equipment / attachment rows. Drives icon + fuel-cost fields.\"\n    },\n    \"supports_attachments\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"When true, this top-level equipment exposes the attachment / sub-attachment tree.\"\n    },\n    \"compatible_equipment_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"compatible_attachment_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"compatible_sub_attachment_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"parent_attachment_ids\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"allow_multiple\": {\n      \"type\": \"boolean\"\n    },\n    \"supplier\": {\n      \"type\": \"string\"\n    },\n    \"rental_company\": {\n      \"type\": \"string\"\n    },\n    \"unit\": {\n      \"type\": \"string\"\n    },\n    \"cost_per_unit\": {\n      \"type\": \"number\"\n    },\n    \"minimum_order_yards\": {\n      \"type\": \"number\"\n    },\n    \"below_minimum_cost_per_cy\": {\n      \"type\": \"number\"\n    },\n    \"minimum_cost\": {\n      \"type\": \"number\"\n    },\n    \"cost_per_day\": {\n      \"type\": \"number\"\n    },\n    \"cost_per_week\": {\n      \"type\": \"number\"\n    },\n    \"cost_per_month\": {\n      \"type\": \"number\"\n    },\n    \"pickup_delivery_cost\": {\n      \"type\": \"number\"\n    },\n    \"rebar_size\": {\n      \"type\": \"string\"\n    },\n    \"rebar_diameter_inches\": {\n      \"type\": \"number\",\n      \"description\": \"Explicit nominal bar diameter in inches for preliminary version-2 reinforcement. No inferred default from the size label.\"\n    },\n    \"rebar_weight_lb_per_ft\": {\n      \"type\": \"number\",\n      \"description\": \"Explicit verified steel weight in pounds per foot. Missing metadata is unknown, never an authored zero or a guessed conversion.\"\n    },\n    \"rebar_support_kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"chair\",\n        \"stand\",\n        \"bolster\"\n      ],\n      \"description\": \"Support style for a rebar_support catalog row (chair, stand, or bolster); other hardware stays untyped until modeled.\"\n    },\n    \"rebar_support_height_inches\": {\n      \"type\": \"number\",\n      \"description\": \"Nominal support height in inches from the resting plane to the supported bar.\"\n    },\n    \"rebar_support_height_min_inches\": {\n      \"type\": \"number\",\n      \"description\": \"Lowest usable support height in inches for an adjustable or range-rated support.\"\n    },\n    \"rebar_support_height_max_inches\": {\n      \"type\": \"number\",\n      \"description\": \"Highest usable support height in inches for an adjustable or range-rated support.\"\n    },\n    \"rebar_support_footprint_length_inches\": {\n      \"type\": \"number\",\n      \"description\": \"Resting footprint length in inches; used for cover and clearance checks, never structural approval.\"\n    },\n    \"rebar_support_footprint_width_inches\": {\n      \"type\": \"number\",\n      \"description\": \"Resting footprint width in inches; used for cover and clearance checks, never structural approval.\"\n    },\n    \"rebar_support_material\": {\n      \"type\": \"string\",\n      \"description\": \"Support material as cataloged (for example steel, plastic, concrete); free text, never inferred.\"\n    },\n    \"rebar_support_pack_size\": {\n      \"type\": \"integer\",\n      \"description\": \"Units per purchased pack; cost_per_unit remains the per-unit catalog price basis.\"\n    },\n    \"rebar_support_compatible_bar_sizes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Bar sizes this support is rated to carry (for example #3, #4); empty means compatibility is unknown, not universal.\"\n    },\n    \"rebar_support_placement_notes\": {\n      \"type\": \"string\",\n      \"description\": \"Cataloged placement constraints or manufacturer notes; free text, not a derived spacing rule.\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"is_pillar_excavation\": {\n      \"type\": \"boolean\"\n    },\n    \"is_spread_foot_excavation\": {\n      \"type\": \"boolean\"\n    },\n    \"is_non_excavation_equipment\": {\n      \"type\": \"boolean\"\n    },\n    \"is_miscellaneous_attachment\": {\n      \"type\": \"boolean\"\n    },\n    \"sort_order\": {\n      \"type\": \"number\"\n    },\n    \"mix_3500_price\": {\n      \"type\": \"number\"\n    },\n    \"mix_4000_price\": {\n      \"type\": \"number\"\n    },\n    \"mix_4500_price\": {\n      \"type\": \"number\"\n    },\n    \"mix_5000_price\": {\n      \"type\": \"number\"\n    },\n    \"mix_fast_set_price\": {\n      \"type\": \"number\"\n    },\n    \"admix_calcium_chloride_price\": {\n      \"type\": \"number\"\n    },\n    \"admix_set_retarding_price\": {\n      \"type\": \"number\"\n    },\n    \"admix_water_reducing_price\": {\n      \"type\": \"number\"\n    },\n    \"admix_fibers_price\": {\n      \"type\": \"number\"\n    },\n    \"admix_winter_service_price\": {\n      \"type\": \"number\"\n    },\n    \"small_load_fee_1_1_75\": {\n      \"type\": \"number\"\n    },\n    \"small_load_fee_2_2_75\": {\n      \"type\": \"number\"\n    },\n    \"small_load_fee_3_3_75\": {\n      \"type\": \"number\"\n    },\n    \"small_load_fee_4_4_25\": {\n      \"type\": \"number\"\n    },\n    \"small_load_fee_4_5_4_75\": {\n      \"type\": \"number\"\n    },\n    \"fuel_surcharge\": {\n      \"type\": \"number\"\n    },\n    \"ownership\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"owned\",\n        \"rented\"\n      ],\n      \"default\": \"rented\",\n      \"description\": \"Equipment ownership. Applies to excavation_equipment / attachment / sub_attachment rows.\"\n    },\n    \"mpg\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Vehicle / boom fuel economy in miles per gallon (used for driving fuel cost on trips).\"\n    },\n    \"fuel_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"na\",\n        \"gasoline\",\n        \"diesel\"\n      ],\n      \"default\": \"na\",\n      \"description\": \"Fuel type \\u2014 drives which fuel-price setting is used for driving + idle cost.\"\n    },\n    \"idle_running_cost_per_hour\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Fuel + wear cost per hour while running idle on-site (e.g. boom lift hold position).\"\n    },\n    \"show_in_channel_letters\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Show this item in the Channel & Dimensional Letters estimator's equipment / supplies pickers.\"\n    },\n    \"show_in_foundation\": {\n      \"type\": \"boolean\",\n      \"default\": true,\n      \"description\": \"Show this item in the Concrete | Masonry | Poles estimator.\"\n    },\n    \"show_in_sign_maintenance\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Show this item in the Sign Maintenance estimator's equipment / supplies pickers.\"\n    },\n    \"image_url\": {\n      \"type\": \"string\",\n      \"description\": \"Optional image URL for this catalog material.\"\n    }\n  },\n  \"required\": [\n    \"material_name\",\n    \"material_type\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"admin\"\n      }\n    },\n    \"read\": {\n      \"$or\": [\n        {\n          \"user_condition\": {\n            \"role\": \"admin\"\n          }\n        },\n        {\n          \"user_condition\": {\n            \"role\": \"user\"\n          }\n        }\n      ]\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"admin\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"admin\"\n      }\n    }\n  }\n}",
