      "path": "src/components/estimator/SectionRow.jsx",
      "content": "import { Input } from \"@/components/ui/input\";\nimport { Trash2, Layers } from \"lucide-react\";\nimport { Link } from \"react-router-dom\";\nimport { getModule, getModuleLabel } from \"./moduleRegistry\";\nimport { money as fmt } from \"./aioPricing\";\nimport { acceptedCustomerUnitPrice } from \"./customerPricing\";\n\nexport default function SectionRow({ line, index, estimateId, onChange, onRemove }) {\n  const set = (patch) => onChange(index, patch);\n  const editorPage = getModule(line.module_key)?.page;\n\n  return (\n    <div className=\"clay-card p-4 border-l-4 border-l-red-400\">\n      <div className=\"flex items-start justify-between gap-3 mb-3\">\n        <div className=\"flex items-center gap-2 min-w-0\">\n          <Layers className=\"w-4 h-4 text-red-500 flex-shrink-0\" aria-hidden=\"true\" />\n          <div className=\"min-w-0\">\n            {editorPage ? (\n              <Link\n                to={`/${editorPage}?id=${line.project_id}&estimateId=${estimateId}`}\n                className=\"font-semibold text-gray-900 truncate hover:text-red-600 block\"\n              >\n                {getModuleLabel(line.module_key)} →\n              </Link>\n            ) : (\n              <div className=\"font-semibold text-gray-900 truncate\">{getModuleLabel(line.module_key)}</div>\n            )}\n            <div className=\"text-xs text-gray-400\">{line.project_name}</div>\n          </div>\n        </div>\n        <div className=\"text-right\">\n          <div className=\"text-base font-bold text-gray-900\">\n            {fmt(acceptedCustomerUnitPrice(line) * Math.max(0, Number(line.customer_quantity ?? 1) || 0) * (1 + Number(line.adjustment_percent || 0) / 100))}\n          </div>\n          <button type=\"button\"\n            onClick={() => {\n              if (window.confirm(`Remove \"${line.project_name || getModuleLabel(line.module_key)}\" from this estimate?`)) {\n                onRemove(index);\n              }\n            }}\n            className=\"mt-1 p-1 rounded text-gray-400 hover:text-red-600 hover:bg-red-50\"\n            title=\"Remove section\"\n          >\n            <Trash2 className=\"w-4 h-4\" aria-hidden=\"true\" />\n          </button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n        <label className=\"text-xs text-gray-500\">\n          Customer base price\n          <Input\n            type=\"number\"\n            value={acceptedCustomerUnitPrice(line)}\n            onChange={(e) => set({ customer_price_snapshot: parseFloat(e.target.value) || 0 })}\n          />\n        </label>\n        <label className=\"text-xs text-gray-500\">\n          Adjustment %\n          <Input\n            type=\"number\"\n            value={line.adjustment_percent ?? 0}\n            onChange={(e) => set({ adjustment_percent: parseFloat(e.target.value) || 0 })}\n          />\n        </label>\n        <label className=\"text-xs text-gray-500\">\n          Quantity\n          <Input\n            type=\"number\"\n            value={line.customer_quantity ?? 1}\n            onChange={(e) => set({ customer_quantity: parseFloat(e.target.value) || 1 })}\n          />\n        </label>\n        <label className=\"text-xs text-gray-500\">\n          Status\n          <select\n            value={line.section_status || \"in_progress\"}\n            onChange={(e) => set({ section_status: e.target.value })}\n            className=\"flex h-9 w-full rounded-md border border-input bg-transparent px-2 text-sm shadow-sm\"\n          >\n            <option value=\"in_progress\">In progress</option>\n            <option value=\"complete\">Complete</option>\n          </select>\n        </label>\n      </div>\n\n      <label className=\"block text-xs text-gray-500 mt-3\">\n        Customer description\n        <Input\n          value={line.customer_description || \"\"}\n          onChange={(e) => set({ customer_description: e.target.value })}\n          placeholder=\"Shown to the customer on the quote\"\n        />\n      </label>\n    </div>\n  );\n}",
