      "path": "src/components/estimator/PricingSummary.jsx",
      "content": "import { useMemo } from \"react\";\nimport { Input } from \"@/components/ui/input\";\nimport { money } from \"./aioPricing\";\nimport { computeEstimateProfitability } from \"./profitability\";\n\nconst PERCENT_FIELDS = [\n  { key: \"discount_percent\", label: \"Discount %\" },\n  { key: \"contingency_percent\", label: \"Contingency %\" },\n  { key: \"tax_percent\", label: \"Tax %\" },\n  { key: \"deposit_percent\", label: \"Deposit %\" },\n];\n\nconst FEE_FIELDS = [\n  { key: \"shipping_fee\", label: \"Shipping / freight\" },\n  { key: \"permit_fee\", label: \"Permit / admin\" },\n];\n\nexport default function PricingSummary({ estimate, pricing, onChange, readOnly = false, openRevision = null }) {\n  const profitability = useMemo(() => computeEstimateProfitability(estimate, pricing), [estimate, pricing]);\n  const rows = [\n    [\"Sections subtotal\", pricing.subtotal],\n    [\"Discount\", -pricing.discount],\n    ...(Number(pricing.volumeDiscount || 0) > 0.005 ? [[`Volume discount (${Number(pricing.volumeDiscountPercent || 0)}%)`, -pricing.volumeDiscount] ] : []),\n    [\"Contingency\", pricing.contingency],\n    [\"Fees\", pricing.fees],\n    [\"Tax\", pricing.tax],\n  ];\n\n  return (\n    <div className=\"bg-white rounded-md border border-gray-200 p-4\">\n      <div className=\"mb-4 rounded border border-gray-200 bg-gray-50 p-3\">\n        <div className=\"text-[10px] font-bold tracking-wider text-gray-500 mb-2\">INTERNAL PROFITABILITY</div>\n        <div className=\"grid grid-cols-2 xl:grid-cols-4 gap-2\">\n          <Metric label=\"Internal product cost\" value={money(profitability.internalCost)} />\n          <Metric label=\"Customer revenue\" value={money(profitability.customerRevenueBeforeFeesTax)} />\n          <Metric label=\"Gross profit\" value={money(profitability.grossProfit)} emphasis={profitability.grossProfit < 0 ? \"negative\" : \"positive\"} />\n          <Metric label=\"Gross margin\" value={`${profitability.grossMarginPercent.toFixed(1)}%`} emphasis={profitability.grossProfit < 0 ? \"negative\" : \"positive\"} />\n        </div>\n        <div className=\"mt-2 text-[9px] leading-4 text-gray-400\">\n          Uses accepted frozen Product cost. Customer revenue includes Product adjustments, estimate discount and contingency; shipping, permit/admin fees and tax are excluded because their internal costs are not tracked here.\n        </div>\n      </div>\n\n      {profitability.internalCost > 0 && Number(pricing.quoteTotal || 0) > 0 && profitability.internalCost > Number(pricing.quoteTotal) && (\n        <div className=\"mb-4 rounded border border-red-300 bg-red-50 p-2.5 text-[10px] font-semibold text-red-700\">\n          Cost ceiling exceeded — internal product cost ({money(profitability.internalCost)}) exceeds the customer quote total ({money(Number(pricing.quoteTotal))}). Review product pricing or markup before sending this quote.\n        </div>\n      )}\n\n      <div className=\"text-[11px] font-bold tracking-wider text-red-600 mb-3\">CUSTOMER PRICING</div>\n\n      <div className=\"grid grid-cols-2 gap-3 mb-4\">\n        {[...PERCENT_FIELDS, ...FEE_FIELDS].map((f) => (\n          <label key={f.key} className=\"text-xs text-gray-500\">\n            {f.label}\n            <Input\n              type=\"number\"\n              value={estimate[f.key] ?? 0}\n              onChange={(e) => onChange({ [f.key]: parseFloat(e.target.value) || 0 })}\n              readOnly={readOnly}\n              className={readOnly ? \"bg-gray-50 text-gray-500\" : \"\"}\n            />\n          </label>\n        ))}\n      </div>\n\n      {(() => {\n        const categories = [...new Set((estimate.line_items || []).map((l) => String(l.product_category || \"\").trim()).filter(Boolean))].sort();\n        if (!categories.length) return null;\n        const overrides = estimate.category_adjustments || {};\n        return (\n          <div className=\"mb-4\">\n            <div className=\"text-[10px] font-bold tracking-wider text-gray-500 mb-2\">PER-CATEGORY ADJUSTMENT (this estimate only)</div>\n            <div className=\"grid grid-cols-2 gap-3\">\n              {categories.map((cat) => (\n                <label key={cat} className=\"text-xs text-gray-500\">\n                  {cat} %\n                  <Input\n                    type=\"number\"\n                    value={overrides[cat] ?? 0}\n                    onChange={(e) => onChange({ category_adjustments: { ...overrides, [cat]: parseFloat(e.target.value) || 0 } })}\n                    readOnly={readOnly}\n                    className={readOnly ? \"bg-gray-50 text-gray-500\" : \"\"}\n                  />\n                </label>\n              ))}\n            </div>\n          </div>\n        );\n      })()}\n\n      <div className=\"space-y-1.5 text-sm border-t border-gray-100 pt-3\">\n        {rows.map(([label, value]) => (\n          <div key={label} className=\"flex justify-between text-gray-600\">\n            <span>{label}</span>\n            <span>{money(value)}</span>\n          </div>\n        ))}\n        <div className=\"flex justify-between font-bold text-gray-900 text-base border-t border-gray-200 pt-2\">\n          <span>Quote total</span>\n          {/* Revision diff highlight: when an open revision's before-snapshot\n              differs from the live total, mark it so the change stands out. */}\n          {(() => {\n            const beforeTotal = Number(openRevision?.estimate_snapshot_before?.quote_total || 0);\n            const differs = openRevision && Math.abs(beforeTotal - Number(pricing.quoteTotal || 0)) > 0.005;\n            return (\n              <span className={differs ? \"text-amber-700 underline decoration-amber-400 decoration-2 underline-offset-2\" : \"text-red-600\"}>\n                {money(pricing.quoteTotal)}\n                {differs && <span className=\"ml-1 text-[9px] font-normal text-amber-600\">was {money(beforeTotal)}</span>}\n              </span>\n            );\n          })()}\n        </div>\n        <div className=\"flex justify-between text-gray-600\">\n          <span>Deposit due</span>\n          <span>{money(pricing.deposit)}</span>\n        </div>\n        <div className=\"flex justify-between text-gray-600\">\n          <span>Balance</span>\n          <span>{money(pricing.balance)}</span>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction Metric({ label, value, emphasis }) {\n  const valueClass = emphasis === \"negative\"\n    ? \"text-red-700\"\n    : emphasis === \"positive\"\n      ? \"text-emerald-700\"\n      : \"text-gray-900\";\n  return (\n    <div className=\"rounded border border-gray-200 bg-white px-2.5 py-2\">\n      <div className=\"text-[9px] font-semibold uppercase tracking-wide text-gray-400\">{label}</div>\n      <div className={`mt-0.5 text-[14px] font-bold tabular-nums ${valueClass}`}>{value}</div>\n    </div>\n  );\n}",
      "startLine": 1,
