{
  "files": [
    {
      "path": "base44/entities/AllInOneEstimate.jsonc",
      "content": "{\n  \"name\": \"AllInOneEstimate\",\n  \"type\": \"object\",\n  \"description\": \"A multifaceted estimate BUILT from sections. Each section is a dedicated sub-estimate created by (and owned by) this estimate in its module's own entity, edited with that module's full estimator INLINE on the same page. Project info (client, estimate #, hyperlink, site address) is shared down to every owned section automatically. Totals live-sync from the source projects via real-time subscriptions and refresh-on-open. Customer pricing waterfall (per-section adjustments \\u2192 discount \\u2192 contingency \\u2192 fees \\u2192 tax \\u2192 deposit) is computed by components/estimator/allInOne/aioPricing.js. Step 1 fields come from the shared Customer / TaxGroup / EstimateOption entities. Links to the workflow through customer_id (shared Client) and work_order_id.\",\n  \"properties\": {\n    \"project_name\": {\n      \"type\": \"string\",\n      \"description\": \"Estimate description shown in Step 1.\"\n    },\n    \"creation_request_key\": {\n      \"type\": \"string\",\n      \"description\": \"Internal random receipt used only to make one New Estimate create action retry-safe. It is not derived from client/project names, so legitimate separate estimates with identical names remain allowed.\"\n    },\n    \"client_name\": {\n      \"type\": \"string\",\n      \"description\": \"Customer company name.\"\n    },\n    \"customer_id\": {\n      \"type\": \"string\",\n      \"description\": \"Linked shared Customer record id.\"\n    },\n    \"opportunity_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional canonical Opportunity link. Blank is valid for legacy/direct-created Estimates.\"\n    },\n    \"split_from_estimate_id\": {\n      \"type\": \"string\",\n      \"description\": \"Parent estimate id when this estimate was created via Split \\u2014 links the child back to its source for traceability.\"\n    },\n    \"duplicated_from_estimate_id\": {\n      \"type\": \"string\",\n      \"description\": \"Source estimate id when this estimate was created via Duplicate \\u2014 links the clone back to its source for traceability.\"\n    },\n    \"estimating_request_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional EstimatingRequest link preserving the pre-estimate handoff identity.\"\n    },\n    \"work_order_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional linked WorkOrder id \\u2014 ties this estimate to a job in the workflow.\"\n    },\n    \"sales_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"lead\",\n        \"quoted\",\n        \"follow_up\",\n        \"won\",\n        \"lost\",\n        \"on_hold\"\n      ],\n      \"description\": \"Mirror of the linked WorkOrder's sales_status, written back when the pipeline stage changes (WorkOrder to estimate reverse sync). Distinct from the estimate lifecycle status field; absent on estimates that were never pipeline-linked.\"\n    },\n    \"sales_stage_changed_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Timestamp of the most recent sales_stage write-back from the linked WorkOrder.\"\n    },\n    \"estimate_number\": {\n      \"type\": \"string\"\n    },\n    \"po_number\": {\n      \"type\": \"string\",\n      \"description\": \"Customer purchase order number, shown on the customer quote.\"\n    },\n    \"delivery_method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"pickup\",\n        \"installation\",\n        \"shipping\",\n        \"delivery\"\n      ],\n      \"description\": \"Requested fulfillment/delivery method captured at quote time (A-28); seeds WorkOrder.fulfillment_method on conversion.\"\n    },\n    \"terms\": {\n      \"type\": \"string\",\n      \"description\": \"Payment terms selected from the admin-managed terms list.\"\n    },\n    \"order_contact\": {\n      \"type\": \"string\",\n      \"description\": \"Contact on the order (from the customer's contacts).\"\n    },\n    \"office_phone\": {\n      \"type\": \"string\"\n    },\n    \"office_phone_ext\": {\n      \"type\": \"string\"\n    },\n    \"salesperson\": {\n      \"type\": \"string\"\n    },\n    \"sales_center\": {\n      \"type\": \"string\"\n    },\n    \"tax_group\": {\n      \"type\": \"string\",\n      \"description\": \"Name of the selected TaxGroup \\u2014 sets tax_percent.\"\n    },\n    \"hyperlink\": {\n      \"type\": \"string\"\n    },\n    \"site_address\": {\n      \"type\": \"string\",\n      \"description\": \"Job site address \\u2014 shared down to sections whose module supports it.\"\n    },\n    \"contact_name\": {\n      \"type\": \"string\"\n    },\n    \"contact_email\": {\n      \"type\": \"string\"\n    },\n    \"contact_phone\": {\n      \"type\": \"string\"\n    },\n    \"target_install_date\": {\n      \"type\": \"string\",\n      \"description\": \"Target install/completion date (YYYY-MM-DD).\"\n    },\n    \"accepted_at\": {\n      \"type\": \"string\",\n      \"description\": \"ISO timestamp of the canonical customer acceptance (mirrors the EstimateAcceptance row).\"\n    },\n    \"accepted_by_name\": {\n      \"type\": \"string\",\n      \"description\": \"Name recorded on the canonical customer acceptance.\"\n    },\n    \"accepted_by_email\": {\n      \"type\": \"string\",\n      \"description\": \"Email recorded on the canonical customer acceptance.\"\n    },\n    \"attachment_refs\": {\n      \"type\": \"array\",\n      \"description\": \"References to files/photos carried from the opportunity handoff (no binary copies).\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"normal\",\n        \"high\",\n        \"rush\"\n      ],\n      \"default\": \"normal\"\n    },\n    \"tags\": {\n      \"type\": \"string\",\n      \"description\": \"Comma-separated tags for filtering/search (e.g. 'pylon, rebrand, phase 1').\"\n    },\n    \"tax_percent\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Sales tax % \\u2014 tax = taxable base \\u00d7 tax%.\"\n    },\n    \"deposit_percent\": {\n      \"type\": \"number\",\n      \"default\": 50,\n      \"description\": \"Deposit % \\u2014 deposit = quote total \\u00d7 deposit%.\"\n    },\n    \"discount_percent\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Project-level discount % applied to the adjusted sections subtotal.\"\n    },\n    \"contingency_percent\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Contingency % applied AFTER discount: contingency = (subtotal \\u2212 discount) \\u00d7 contingency%.\"\n    },\n    \"shipping_fee\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Flat project-level shipping/freight fee added before tax.\"\n    },\n    \"permit_fee\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Flat project-level permit/admin fee added before tax.\"\n    },\n    \"round_quote_total\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Round the computed quote total to the nearest whole dollar.\"\n    },\n    \"quote_valid_days\": {\n      \"type\": \"number\",\n      \"default\": 30,\n      \"description\": \"How many days the customer quote stays valid.\"\n    },\n    \"quote_issue_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Customer-facing issue date of the currently issued quote version. Updated when the estimate transitions into sent or when an intentional revision is completed while remaining sent; historical sent estimates are not automatically backfilled.\"\n    },\n    \"quote_expiration_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Optional per-estimate override of the quote expiration date. When blank, expiry is computed as quote_issue_date + quote_valid_days.\"\n    },\n    \"quote_expired\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Persisted mirror of the computed expiry check (sent past quote_issue_date + quote_valid_days) so expired quotes are reportable by filter without recomputing per row.\"\n    },\n    \"quote_valid_until\": {\n      \"type\": \"string\",\n      \"description\": \"Derived expiry alias read by quote delivery + workspace views (K-10); mirrors quote_expiration_date/computed expiry.\"\n    },\n    \"email_signature\": {\n      \"type\": \"string\",\n      \"description\": \"Per-estimate copy of the QuoteDefaults email signature snapshot for delivery emails (K-10).\"\n    },\n    \"email_subject_template\": {\n      \"type\": \"string\",\n      \"description\": \"Per-estimate email subject template snapshot (K-10).\"\n    },\n    \"email_message_template\": {\n      \"type\": \"string\",\n      \"description\": \"Per-estimate email body template snapshot (K-10).\"\n    },\n    \"default_tax_group\": {\n      \"type\": \"string\",\n      \"description\": \"TaxGroup name resolved for this estimate when no manual tax pick exists (K-10 chain: manual > customer > defaults > TaxGroup.is_default).\"\n    },\n    \"signature_text\": {\n      \"type\": \"string\",\n      \"description\": \"Print-surface signature block text snapshot (K-10).\"\n    },\n    \"disclaimer_text\": {\n      \"type\": \"string\",\n      \"description\": \"Print-footer disclaimer line snapshot (K-10).\"\n    },\n    \"tax_rate_source\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"auto\",\n        \"customer_default\",\n        \"shop_default\",\n        \"group_default\",\n        \"manual\",\n        \"none\"\n      ],\n      \"description\": \"Which hop of the tax-rate resolution chain this estimate used (K-10).\"\n    },\n    \"quote_version\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"minimum\": 0,\n      \"description\": \"Customer-facing quote issue version. Starts at 1 on the first transition into sent and increments on each later transition into sent or completed revision that remains sent. Separate from EstimateRevision.revision_number.\"\n    },\n    \"payment_terms\": {\n      \"type\": \"string\",\n      \"description\": \"Payment terms text shown on the customer quote.\"\n    },\n    \"scope_inclusions\": {\n      \"type\": \"string\",\n      \"description\": \"Newline-separated list of what's INCLUDED \\u2014 rendered as bullets on the customer quote.\"\n    },\n    \"scope_exclusions\": {\n      \"type\": \"string\",\n      \"description\": \"Newline-separated list of what's EXCLUDED \\u2014 rendered as bullets on the customer quote.\"\n    },\n    \"scope_auto_apply\": {\n      \"type\": \"boolean\",\n      \"default\": true,\n      \"description\": \"When true, scope library lines flagged always_include, or whose auto_modules match a section on this estimate, are added automatically.\"\n    },\n    \"hide_section_prices\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"When true the customer quote shows ONE bundled project price instead of per-section pricing.\"\n    },\n    \"section_acceptance_mode\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"When true the customer portal lets the customer accept, decline, or question each quote section individually rather than only approving the whole quote.\"\n    },\n    \"company_name\": {\n      \"type\": \"string\",\n      \"description\": \"Your company name shown in the customer quote header.\"\n    },\n    \"company_phone\": {\n      \"type\": \"string\"\n    },\n    \"company_email\": {\n      \"type\": \"string\"\n    },\n    \"company_address\": {\n      \"type\": \"string\"\n    },\n    \"company_website\": {\n      \"type\": \"string\"\n    },\n    \"company_license\": {\n      \"type\": \"string\",\n      \"description\": \"License / registration number printed under the company block.\"\n    },\n    \"company_logo_url\": {\n      \"type\": \"string\"\n    },\n    \"quote_title\": {\n      \"type\": \"string\",\n      \"default\": \"Project Estimate\",\n      \"description\": \"Headline printed at the top of the quote.\"\n    },\n    \"quote_accent_color\": {\n      \"type\": \"string\",\n      \"default\": \"#4f46e5\",\n      \"description\": \"Hex accent color for the quote header rule and highlight text.\"\n    },\n    \"quote_intro_text\": {\n      \"type\": \"string\",\n      \"description\": \"Optional paragraph printed above the pricing table.\"\n    },\n    \"quote_footer_text\": {\n      \"type\": \"string\",\n      \"description\": \"Optional paragraph printed at the very bottom of the quote.\"\n    },\n    \"quote_terms_conditions\": {\n      \"type\": \"string\",\n      \"description\": \"Terms & conditions block printed on the quote.\"\n    },\n    \"warranty_text\": {\n      \"type\": \"string\",\n      \"description\": \"Warranty statement printed on the quote.\"\n    },\n    \"lead_time_text\": {\n      \"type\": \"string\",\n      \"description\": \"Production / install lead time statement printed on the quote.\"\n    },\n    \"show_company_block\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_logo\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"show_contact_block\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_estimate_number\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_po_number\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_site_address\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_dates\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_category_column\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_section_descriptions\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_quantity_column\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"show_scope_lists\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_subtotal_line\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_discount_line\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_fees_line\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_tax_line\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_deposit_lines\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_notes_on_quote\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"When true, estimate-level notes are included on the customer quote. Defaults off because estimate notes may contain internal project context.\"\n    },\n    \"show_terms_block\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_warranty_block\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_lead_time_block\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_signature_block\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"show_validity_footer\": {\n      \"type\": \"boolean\",\n      \"default\": true\n    },\n    \"round_prices_to_dollar\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"Display-only: rounds every price shown on the customer quote to the nearest dollar.\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"draft\",\n        \"calculated\",\n        \"sent\",\n        \"approved\",\n        \"archived\",\n        \"cancelled\"\n      ],\n      \"default\": \"draft\"\n    },\n    \"is_template\": {\n      \"type\": \"boolean\",\n      \"description\": \"Marks the estimate as a reusable template \\u2014 duplicated into new estimates via the New Estimate template picker.\"\n    },\n    \"cancel_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Reason captured when the estimate is cancelled (from the Cancel Estimate modal).\"\n    },\n    \"cancelled_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"UTC timestamp of the cancellation. The cancelling actor is recorded on the lifecycle EstimateRevision.\"\n    },\n    \"archived_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"UTC timestamp the estimate was archived.\"\n    },\n    \"archived_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Optional reason for archiving (e.g. lost, superseded, test, merged).\"\n    },\n    \"line_items\": {\n      \"type\": \"array\",\n      \"description\": \"Estimate sections. Totals are refreshed from the source projects whenever the estimate is opened, and in real time while it is open.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"line_id\": {\n            \"type\": \"string\",\n            \"description\": \"Stable id for this estimate product line. Used to link the persistent BuilderProduct record.\"\n          },\n          \"builder_product_id\": {\n            \"type\": \"string\",\n            \"description\": \"Persistent BuilderProduct id for frozen pricing, parts, groups, and full builder snapshots.\"\n          },\n          \"module_key\": {\n            \"type\": \"string\",\n            \"description\": \"Key from the estimator registry (e.g. 'painting', 'foundation').\"\n          },\n          \"builder_name\": {\n            \"type\": \"string\",\n            \"description\": \"Internal/estimator-facing builder identity or product type.\"\n          },\n          \"client_product_name\": {\n            \"type\": \"string\",\n            \"description\": \"Editable client-facing name for this product; kept distinct from builder_name/project_name.\"\n          },\n          \"product_category\": {\n            \"type\": \"string\",\n            \"description\": \"User-defined Product Category used for estimate organization and customer quote categorization.\"\n          },\n          \"production_product_type\": {\n            \"type\": \"string\",\n            \"description\": \"Optional production/SIP Product Type selected from GlobalSettings.productTypes. Blank means intentionally unclassified.\"\n          },\n          \"product_notes\": {\n            \"type\": \"string\",\n            \"description\": \"Estimator-facing Product notes. Separate from customer_description.\"\n          },\n          \"project_id\": {\n            \"type\": \"string\"\n          },\n          \"project_name\": {\n            \"type\": \"string\"\n          },\n          \"client_name\": {\n            \"type\": \"string\"\n          },\n          \"total_snapshot\": {\n            \"type\": \"number\",\n            \"default\": 0,\n            \"description\": \"Accepted/frozen UNIT Product cost snapshot. Estimate pricing extends this unit amount by customer_quantity, then applies adjustment_percent. Live inventory changes do not replace it until Update Price is accepted.\"\n          },\n          \"live_total_snapshot\": {\n            \"type\": \"number\",\n            \"default\": 0,\n            \"description\": \"Most recently detected/recalculated live cost used only for price-change comparison.\"\n          },\n          \"price_state\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"unchecked\",\n              \"current\",\n              \"changed\",\n              \"detached_parts\",\n              \"legacy_frozen\",\n              \"manual\"\n            ],\n            \"default\": \"unchecked\"\n          },\n          \"price_recalc_required\": {\n            \"type\": \"boolean\",\n            \"default\": false,\n            \"description\": \"True when Master Inventory changed after this Builder was last calculated and Update Price must wait until the Builder is reopened/saved.\"\n          },\n          \"price_recalc_reason\": {\n            \"type\": \"string\",\n            \"description\": \"Human-readable reason this Product requires Builder recalculation before Update Price.\"\n          },\n          \"price_acceptance_pending\": {\n            \"type\": \"object\",\n            \"additionalProperties\": true,\n            \"description\": \"Durable retry marker for a Builder/Product multi-record mutation such as initial freeze, Update Price, detached-Part changes, Saved Part insertion, or whole Quick Product insertion. Stores the exact recovery target until the final Estimate line write completes.\"\n          },\n          \"quick_product_insert_key\": {\n            \"type\": \"string\",\n            \"description\": \"Stable provenance/idempotency key retained only after a Quick Product or copied Product insertion completes successfully.\"\n          },\n          \"quick_product_source_type\": {\n            \"type\": \"string\",\n            \"description\": \"Origin of a completed reusable Product insertion, such as quick_product or clipboard_product.\"\n          },\n          \"quick_product_source_id\": {\n            \"type\": \"string\",\n            \"description\": \"Source QuickProduct or EstimateClipboardItem id for a completed reusable Product insertion when available.\"\n          },\n          \"last_part_group_mutation_key\": {\n            \"type\": \"string\",\n            \"description\": \"Idempotency receipt for the most recently completed structural Part Group create/dissolve action on this Product.\"\n          },\n          \"last_part_group_mutation_kind\": {\n            \"type\": \"string\",\n            \"description\": \"Kind of the most recently completed structural Part Group action, such as create or dissolve.\"\n          },\n          \"blank_product_insert_key\": {\n            \"type\": \"string\",\n            \"description\": \"Idempotency receipt for a completed blank Builder-backed or Custom Product insertion.\"\n          },\n          \"blank_product_insert_kind\": {\n            \"type\": \"string\",\n            \"description\": \"Completed blank Product insertion type: builder or custom.\"\n          },\n          \"detached_part_count\": {\n            \"type\": \"number\",\n            \"default\": 0\n          },\n          \"needs_reattach_review\": {\n            \"type\": \"boolean\",\n            \"default\": false\n          },\n          \"last_price_check_at\": {\n            \"type\": \"string\"\n          },\n          \"last_price_update_at\": {\n            \"type\": \"string\"\n          },\n          \"adjustment_percent\": {\n            \"type\": \"number\",\n            \"default\": 0,\n            \"description\": \"Per-section price adjustment %. Positive = markup, negative = discount. adjusted = total \\u00d7 (1 + adj%/100).\"\n          },\n          \"section_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"in_progress\",\n              \"complete\"\n            ],\n            \"default\": \"in_progress\",\n            \"description\": \"Estimating workflow status of this section.\"\n          },\n          \"section_note\": {\n            \"type\": \"string\",\n            \"description\": \"Internal note about this section (not shown to the customer).\"\n          },\n          \"customer_description\": {\n            \"type\": \"string\",\n            \"description\": \"Customer-facing description shown under the section on the quote.\"\n          },\n          \"customer_quantity\": {\n            \"type\": \"number\",\n            \"default\": 1,\n            \"description\": \"Product quantity. Estimate pricing extends each Product as total_snapshot \\u00d7 customer_quantity before adjustment_percent; this quantity can also be shown on the customer quote when the quantity column is enabled.\"\n          },\n          \"include_in_customer\": {\n            \"type\": \"boolean\",\n            \"default\": true,\n            \"description\": \"When false, this section's price is bundled into a single 'Additional project scope' quote line instead of being listed.\"\n          },\n          \"owned\": {\n            \"type\": \"boolean\",\n            \"default\": false,\n            \"description\": \"True when this sub-estimate was created BY this All-In-One estimate (a built-in section). Owned sections are deleted together with the section / estimate.\"\n          },\n          \"linked_date\": {\n            \"type\": \"string\"\n          },\n          \"updated_date_snapshot\": {\n            \"type\": \"string\",\n            \"description\": \"Last-known updated_date of the source sub-estimate.\"\n          }\n        }\n      }\n    },\n    \"total_cost\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Sum of raw section totals (before adjustments/discount/tax).\"\n    },\n    \"quote_total\": {\n      \"type\": \"number\",\n      \"default\": 0,\n      \"description\": \"Customer-facing quote total after the full pricing waterfall (adjustments, discount, contingency, fees, tax).\"\n    },\n    \"internal_approval\": {\n      \"type\": \"object\",\n      \"description\": \"Manager sign-off recorded when the quote total exceeds the internal approval threshold (GlobalSettings key quote_approval_threshold). Written by the approve_quote action before a quote can be sent.\",\n      \"properties\": {\n        \"approved_by_user_id\": {\n          \"type\": \"string\"\n        },\n        \"approved_by_email\": {\n          \"type\": \"string\"\n        },\n        \"approved_at\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"threshold_at_approval\": {\n          \"type\": \"number\"\n        },\n        \"quote_total_at_approval\": {\n          \"type\": \"number\"\n        },\n        \"quote_version\": {\n          \"type\": \"number\"\n        }\n      }\n    },\n    \"volume_discount_tiers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"min_subtotal\": {\n            \"type\": \"number\"\n          },\n          \"discount_percent\": {\n            \"type\": \"number\"\n          }\n        }\n      },\n      \"description\": \"Snapshot of the linked customer's volume discount tiers captured at customer-select time.\"\n    },\n    \"category_adjustments\": {\n      \"type\": \"object\",\n      \"description\": \"Per-category price adjustments for this estimate only \\u2014 {'Category': percent} stacked on top of each section's own adjustment_percent.\"\n    },\n    \"pricing_tier\": {\n      \"type\": \"number\",\n      \"default\": 1,\n      \"description\": \"Markup pricing tier auto-applied from the linked Customer (Customer.pricing_tier).\"\n    },\n    \"personal_tags\": {\n      \"type\": \"object\",\n      \"description\": \"Per-user color/label tags for personal organization \\u2014 keyed by staff email, e.g. {'brett@cincisigns.com': {'color': 'red'}}. Not customer-visible; each user only sees their own tag.\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"notes_log\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"text\": {\n            \"type\": \"string\"\n          },\n          \"by\": {\n            \"type\": \"string\"\n          },\n          \"at\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"description\": \"Timestamped internal note entries appended over the estimate's life \\u2014 the single notes field stays the freeform scratch field.\"\n    },\n    \"edit_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Pending lifecycle reason used when a draft/calculated estimate is moved into or out of a protected status. The reason is written to EstimateRevision history and this temporary field is cleared after save.\"\n    },\n    \"pipeline_sync_pending\": {\n      \"type\": \"boolean\",\n      \"default\": false,\n      \"description\": \"True only when the estimate/lifecycle audit saved successfully but synchronization to the shared Customer/Sales Pipeline did not complete. Cleared after a successful retry.\"\n    },\n    \"pipeline_sync_error\": {\n      \"type\": \"string\",\n      \"description\": \"Last downstream Customer/Sales Pipeline synchronization error for a pending retry. Internal recovery metadata; never shown on the customer quote.\"\n    },\n    \"last_product_removal_key\": {\n      \"type\": \"string\",\n      \"description\": \"Idempotency receipt for the most recently completed Estimate Product removal.\"\n    },\n    \"last_product_removal_line_id\": {\n      \"type\": \"string\",\n      \"description\": \"Estimate line id removed by the most recently completed Product removal.\"\n    },\n    \"last_product_removal_at\": {\n      \"type\": \"string\",\n      \"description\": \"Timestamp of the most recently completed Product removal.\"\n    },\n    \"deleted\": {\n      \"type\": \"boolean\",\n      \"default\": false\n    },\n    \"deleted_at\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\"\n    },\n    \"deleted_by\": {\n      \"type\": \"string\"\n    },\n    \"entered_by_display\": {\n      \"type\": \"string\",\n      \"description\": \"Display name of the staff member who entered the order (CoreBridge 'Entered By').\"\n    },\n    \"follow_up_date\": {\n      \"type\": \"string\",\n      \"format\": \"date\",\n      \"description\": \"Scheduled sales follow-up date (YYYY-MM-DD).\"\n    },\n    \"follow_up_state\": {\n      \"type\": \"object\",\n      \"description\": \"Follow-up state machine snapshot (H-04): {stage: none|fu1_sent|fu2_sent|answered|closed, last_sent_at, next_due_at, anchor_at, fu1_sent_at, fu2_sent_at, answered_at, closed_reason}.\"\n    },\n    \"payment_terms_label\": {\n      \"type\": \"string\",\n      \"description\": \"Payment terms display label printed on documents (e.g. 'Balance Due Upon Receipt'). Complements the payment_terms/terms text fields.\"\n    },\n    \"internal_discount\": {\n      \"type\": \"number\",\n      \"description\": \"Internal (non-customer-facing) discount amount tracked for margin reporting; separate from the customer-facing discount_percent waterfall.\"\n    },\n    \"fee_lines\": {\n      \"type\": \"array\",\n      \"description\": \"Canonical OrderFee lines (shipping, postage, discount, misc fee) carried through order-to-invoice. Each line: {label, kind, amount, taxable, income_account_code}. Mirrored identically on AllInOneEstimate and Invoice.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"label\": {\n            \"type\": \"string\",\n            \"description\": \"Display label for the fee line.\"\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"shipping\",\n              \"postage\",\n              \"discount\",\n              \"fee\"\n            ],\n            \"description\": \"Fee classification.\"\n          },\n          \"amount\": {\n            \"type\": \"number\",\n            \"description\": \"Signed amount; discounts are negative.\"\n          },\n          \"taxable\": {\n            \"type\": \"boolean\",\n            \"description\": \"Whether this line is included in the taxable base.\"\n          },\n          \"income_account_code\": {\n            \"type\": \"string\",\n            \"description\": \"GL income account code for accounting export.\"\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"project_name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__allinoneestimate_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__allinoneestimate_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__allinoneestimate_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__allinoneestimate_backend_only__\"\n      }\n    }\n  }\n}",
