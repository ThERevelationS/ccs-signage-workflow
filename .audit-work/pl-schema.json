      "path": "base44/entities/PermitLocality.jsonc",
      "content": "{\n  \"name\": \"PermitLocality\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\",\n      \"description\": \"Locality name\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"description\": \"State abbreviation\"\n    },\n    \"county_name\": {\n      \"type\": \"string\",\n      \"description\": \"County this jurisdiction sits in (multi-county municipalities: ' / '-joined, e.g. 'Boyle County / Lincoln County'). Identity field \\u2014 same-name localities in different counties are different jurisdictions and must never merge.\"\n    },\n    \"jurisdiction_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"county\",\n        \"city\",\n        \"village\",\n        \"township\",\n        \"municipality\",\n        \"unincorporated_community\"\n      ],\n      \"description\": \"Kind of jurisdiction, from the linked JurisdictionProfile.type. Township vs city/village never merge.\"\n    },\n    \"zip\": {\n      \"type\": \"string\",\n      \"description\": \"ZIP / postal code\"\n    },\n    \"jurisdiction_profile_id\": {\n      \"type\": \"string\",\n      \"description\": \"Optional canonical JurisdictionProfile ID this tracker locality was explicitly created from. Existing legacy localities may remain unlinked until staff verifies the relationship.\"\n    },\n    \"office_change_log\": {\n      \"type\": \"array\",\n      \"description\": \"Append-only (cap 20) log of detected changes to this locality's offices[] \\u2014 entries {at, summary, office_count, verified_count} written by the office-diff worker. Powers the offices-updated alerts.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"at\": {\n            \"type\": \"string\"\n          },\n          \"summary\": {\n            \"type\": \"string\"\n          },\n          \"office_count\": {\n            \"type\": \"number\"\n          },\n          \"verified_count\": {\n            \"type\": \"number\"\n          }\n        }\n      }\n    },\n    \"observed_outcomes\": {\n      \"type\": \"object\",\n      \"description\": \"Observed-vs-claimed aggregation from real filed permits: permits_observed, avg_decision_days, fee_min/max/avg, denial_count. Stamped by the office-diff worker from the PermitLineItem mirror.\",\n      \"properties\": {\n        \"permits_observed\": {\n          \"type\": \"number\"\n        },\n        \"avg_decision_days\": {\n          \"type\": \"number\"\n        },\n        \"fee_min\": {\n          \"type\": \"number\"\n        },\n        \"fee_max\": {\n          \"type\": \"number\"\n        },\n        \"fee_avg\": {\n          \"type\": \"number\"\n        },\n        \"denial_count\": {\n          \"type\": \"number\"\n        },\n        \"computed_at\": {\n          \"type\": \"string\"\n        },\n        \"sample_window\": {\n          \"type\": \"string\"\n        }\n      }\n    },\n    \"governing_body\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY \\u2014 Governing body name\"\n    },\n    \"office_type\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY \\u2014 Default office type\"\n    },\n    \"contact_phone\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY\"\n    },\n    \"contact_email\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY\"\n    },\n    \"contact_website\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY\"\n    },\n    \"contact_address\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY\"\n    },\n    \"contact_department\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY\"\n    },\n    \"contact_notes\": {\n      \"type\": \"string\",\n      \"description\": \"LEGACY\"\n    },\n    \"offices\": {\n      \"type\": \"array\",\n      \"description\": \"Offices belonging to this locality. Each office has its own workflow steps and is applied as a separate line when the locality is selected.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"catalog_office_id\": {\n            \"type\": \"string\",\n            \"description\": \"Optional ID of the reusable office catalog entry copied into this locality. Provenance only; not verification of legal permitting authority.\"\n          },\n          \"government_office_id\": {\n            \"type\": \"string\",\n            \"description\": \"Stable canonical identity of the government office represented by this locality-specific workflow copy. This identity does not itself prove that the office has authority for this locality.\"\n          },\n          \"authority_roles\": {\n            \"type\": \"array\",\n            \"description\": \"Explicit staff-reviewed authority roles this office performs for this locality. Empty or absent means authority has not been established; office_type/office_types must not be treated as legal authority.\",\n            \"items\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"sign_permit\",\n                \"zoning\",\n                \"building\",\n                \"electrical\",\n                \"electrical_permit\",\n                \"electrical_inspection\",\n                \"right_of_way\",\n                \"historic_review\",\n                \"planning\",\n                \"transportation\",\n                \"other\"\n              ]\n            }\n          },\n          \"authority_verification_status\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"needs_verification\",\n              \"staff_verified\"\n            ],\n            \"description\": \"Review state for this locality-to-office authority relationship. staff_verified means staff confirmed the listed authority_roles; it does not verify unrelated office contact or repository facts.\"\n          },\n          \"authority_verified_at\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\",\n            \"description\": \"When staff last verified this locality-to-office authority relationship.\"\n          },\n          \"authority_verified_by\": {\n            \"type\": \"string\",\n            \"description\": \"Employee who last verified this locality-to-office authority relationship.\"\n          },\n          \"authority_verification_notes\": {\n            \"type\": \"string\",\n            \"description\": \"Optional staff notes or source context supporting this locality-to-office authority relationship.\"\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"description\": \"Display name for this office (e.g. 'Hamilton County Zoning')\"\n          },\n          \"office_type\": {\n            \"type\": \"string\",\n            \"description\": \"LEGACY single office category. Use office_types (array) for multi-select.\"\n          },\n          \"office_types\": {\n            \"type\": \"array\",\n            \"description\": \"Office categories this office covers (e.g. ['Zoning', 'Building']).\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          },\n          \"contact_phone\": {\n            \"type\": \"string\"\n          },\n          \"contact_email\": {\n            \"type\": \"string\"\n          },\n          \"contact_website\": {\n            \"type\": \"string\"\n          },\n          \"contact_address\": {\n            \"type\": \"string\"\n          },\n          \"hours\": {\n            \"type\": \"string\",\n            \"description\": \"Office hours in plain text ('Mon-Fri 8a-4:30p') \\u2014 'open now?' is a display concern.\"\n          },\n          \"contact_notes\": {\n            \"type\": \"string\"\n          },\n          \"workflow_steps\": {\n            \"type\": \"array\",\n            \"description\": \"Workflow steps for this office\",\n            \"items\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"id\": {\n                  \"type\": \"string\"\n                },\n                \"name\": {\n                  \"type\": \"string\"\n                },\n                \"type\": {\n                  \"type\": \"string\",\n                  \"enum\": [\n                    \"checkbox\",\n                    \"submitted_date\",\n                    \"followup_date\",\n                    \"permit_received_date\",\n                    \"text\"\n                  ]\n                },\n                \"followup_interval_days\": {\n                  \"type\": \"number\",\n                  \"default\": 14\n                },\n                \"order\": {\n                  \"type\": \"number\"\n                },\n                \"tied_to_step_id\": {\n                  \"type\": \"string\",\n                  \"description\": \"Optional \\u2014 links a non-checkbox step to a checkbox step that marks completion.\"\n                }\n              }\n            }\n          },\n          \"order\": {\n            \"type\": \"number\",\n            \"default\": 0\n          }\n        }\n      }\n    },\n    \"workflow_steps\": {\n      \"type\": \"array\",\n      \"description\": \"LEGACY \\u2014 kept for backwards compatibility. New data lives in offices[].workflow_steps.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"checkbox\",\n              \"submitted_date\",\n              \"followup_date\",\n              \"permit_received_date\",\n              \"text\"\n            ]\n          },\n          \"followup_interval_days\": {\n            \"type\": \"number\",\n            \"default\": 14\n          },\n          \"order\": {\n            \"type\": \"number\"\n          }\n        }\n      }\n    },\n    \"categories\": {\n      \"type\": \"array\",\n      \"description\": \"LEGACY \\u2014 kept for backwards compatibility.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"order\": {\n      \"type\": \"number\",\n      \"default\": 0\n    },\n    \"change_log\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"at\": {\n            \"type\": \"string\"\n          },\n          \"by\": {\n            \"type\": \"string\"\n          },\n          \"changed_fields\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      },\n      \"description\": \"Audit trail of edits to this jurisdiction \\u2014 server-appended on each gateway update: {at, by, changed_fields}.\"\n    },\n    \"pending_applies\": {\n      \"type\": \"array\",\n      \"description\": \"Deferred office applies \\u2014 Apply-when-verified queues {work_order_id, requested_by, requested_at, exclude_electrical} here; the verification worker creates the permit lines the moment sign+zoning verify, then removes the entry.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"work_order_id\": {\n            \"type\": \"string\"\n          },\n          \"requested_by\": {\n            \"type\": \"string\"\n          },\n          \"requested_at\": {\n            \"type\": \"string\"\n          },\n          \"exclude_electrical\": {\n            \"type\": \"boolean\"\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__permitlocality_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__permitlocality_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__permitlocality_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__permitlocality_backend_only__\"\n      }\n    }\n  }\n}",
