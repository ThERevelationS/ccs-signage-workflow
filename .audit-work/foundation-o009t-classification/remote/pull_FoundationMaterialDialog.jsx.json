      "content": "import { useState, useEffect, useRef } from \"react\";\nimport { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from \"@/components/ui/dialog\";\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport { base44 } from \"@/api/base44Client\";\nimport { MATERIAL_TYPES, fieldsFor, listFieldDraft, listFieldValue } from \"./foundationFieldSchema\";\nimport { expectedEntityFields, replaceEntityFieldsIfUnchanged } from \"@/components/estimator/builder/builderEntityPersistence\";\nimport { createInventoryRecordWithRecovery } from \"./inventoryPersistence\";\n\n// catalogNumberInput is the boundary's numeric catalog draft (CMP-A08): blank\n// clears to null (\"not cataloged\" — never a silent free price), a numeric\n// draft coerces to Number, anything else stays verbatim so availability\n// validation reports it instead of a NaN or minted 0 leaking into records.\nimport { inventoryNumberInput as catalogNumberInput } from \"./inventoryNormalization\";\n\nexport default function FoundationMaterialDialog({ open, record, defaultType, onClose, onSaved }) {\n  const [form, setForm] = useState({});\n  const [saving, setSaving] = useState(false);\n  const saveRef = useRef(false);\n\n  useEffect(() => {\n    if (open) {\n      setForm(record || { material_type: defaultType, show_in_foundation: true });\n    }\n  }, [open, record, defaultType]);\n\n  const type = form.material_type || defaultType;\n  const set = (patch) => setForm((prev) => ({ ...prev, ...patch }));\n\n  const handleSave = async () => {\n    if (!form.material_name?.trim() || saveRef.current) return;\n    saveRef.current = true;\n    setSaving(true);\n    try {\n      const id = form.id;\n      const updated_date = form.updated_date;\n      const data = { ...form };\n      [\"id\", \"created_date\", \"updated_date\", \"created_by_id\", \"created_by\"].forEach((key) => delete data[key]);\n      data.material_type = type;\n      data.show_in_foundation = true;\n      // `list` fields hold comma-separated drafts while editing; tokenize on\n      // save (blank -> [] = \"unknown\", never universal). A stored non-string\n      // value stays verbatim so validation can report it (fail-closed).\n      for (const f of fieldsFor(type)) {\n        if (f.type === \"list\") data[f.key] = listFieldValue(data[f.key]);\n      }\n      if (id) {\n        const live = await base44.entities.FoundationInventory.get(id);\n        if (!live) {\n          alert(\"This Foundation Catalog item no longer exists. The catalog will reload.\");\n          onSaved();\n          return;\n        }\n        if (updated_date && live.updated_date && updated_date !== live.updated_date) {\n          alert(\"This Foundation Catalog item changed in another session. Your changes were not saved; the latest catalog will reload.\");\n          onSaved();\n          return;\n        }\n        await replaceEntityFieldsIfUnchanged({\n          entity: base44.entities.FoundationInventory,\n          id,\n          expectedUpdatedAt: live.updated_date || \"\",\n          expectedFields: expectedEntityFields(live, data),\n          nextFields: data,\n          label: \"Foundation Catalog item\",\n        });\n      } else {\n        await createInventoryRecordWithRecovery({\n          entity: base44.entities.FoundationInventory,\n          data,\n          nameField: \"material_name\",\n          label: `Foundation Catalog item “${data.material_name || \"Material\"}”`,\n        });\n      }\n      onSaved();\n    } catch (error) {\n      console.error(\"Foundation Catalog save failed:\", error);\n      alert(error?.message || \"Foundation Catalog item could not be saved.\");\n    } finally {\n      saveRef.current = false;\n      setSaving(false);\n    }\n  };\n\n  return (\n    <Dialog open={open} onOpenChange={(o) => !o && !saving && onClose()}>\n      <DialogContent className=\"sm:max-w-xl max-h-[85vh] overflow-y-auto\">\n        <DialogHeader>\n          <DialogTitle>{record?.id ? \"Edit Material\" : \"New Material\"}</DialogTitle>\n        </DialogHeader>\n\n        <div className=\"space-y-3 py-1\">\n          <label className=\"text-xs text-gray-500 block\">\n            Material type\n            <select\n              value={type}\n              onChange={(e) => set({ material_type: e.target.value })}\n              className=\"flex h-9 w-full rounded-md border border-input bg-transparent px-2 text-sm shadow-sm\"\n            >\n              {MATERIAL_TYPES.map((t) => (\n                <option key={t.value} value={t.value}>\n                  {t.label}\n                </option>\n              ))}\n            </select>\n          </label>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            {fieldsFor(type).map((f) => (\n              <label key={f.key} className=\"text-xs text-gray-500\">\n                {f.label}\n                {f.type === \"select\" ? (\n                  <select\n                    value={form[f.key] ?? \"\"}\n                    onChange={(e) => set({ [f.key]: e.target.value === \"\" ? null : e.target.value })}\n                    className=\"flex h-9 w-full rounded-md border border-input bg-transparent px-2 text-sm shadow-sm\"\n                  >\n                    <option value=\"\">—</option>\n                    {(f.options || []).map((o) => (\n                      <option key={o.value} value={o.value}>\n                        {o.label}\n                      </option>\n                    ))}\n                    {/* A stored value outside the declared options stays\n                        verbatim so it is never silently remapped. */}\n                    {form[f.key] !== null && form[f.key] !== undefined && form[f.key] !== \"\" && !(f.options || []).some((o) => o.value === form[f.key]) && (\n                      <option value={form[f.key]}>{String(form[f.key])}</option>\n                    )}\n                  </select>\n                ) : f.type === \"list\" ? (\n                  <Input\n                    type=\"text\"\n                    value={listFieldDraft(form[f.key])}\n                    onChange={(e) => set({ [f.key]: e.target.value })}\n                  />\n                ) : (\n                  <Input\n                    type={f.type}\n                    value={form[f.key] ?? \"\"}\n                    onChange={(e) =>\n                      set({ [f.key]: f.type === \"number\" ? catalogNumberInput(e.target.value) : e.target.value })\n                    }\n                  />\n                )}\n              </label>\n            ))}\n          </div>\n\n          <label className=\"text-xs text-gray-500 block\">\n            Notes\n            <Input value={form.notes ?? \"\"} onChange={(e) => set({ notes: e.target.value })} />\n          </label>\n          <label className=\"text-xs text-gray-500 block\">\n            Image URL <span className=\"font-normal text-gray-400\">(optional)</span>\n            <Input value={form.image_url ?? \"\"} onChange={(e) => set({ image_url: e.target.value })} placeholder=\"https://…\" />\n          </label>\n        </div>\n\n        <DialogFooter>\n          <Button variant=\"outline\" onClick={onClose} disabled={saving}>\n            Cancel\n          </Button>\n          <Button\n            onClick={handleSave}\n            disabled={saving || !form.material_name?.trim()}\n            className=\"bg-red-600 hover:bg-red-700 text-white\"\n          >\n            {saving ? \"Saving…\" : \"Save\"}\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  );\n}",
      "startLine": 1,
