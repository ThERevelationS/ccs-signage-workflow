{"status":200,"contentType":"text/html; charset=utf-8","body":"<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <script>self[\"MonacoEnvironment\"] = (function (paths) {\n          return {\n            globalAPI: false,\n            getWorkerUrl : function (moduleId, label) {\n              var result =  paths[label];\n              if (/^((http:)|(https:)|(file:)|(\\/\\/))/.test(result)) {\n                var currentUrl = String(window.location);\n                var currentOrigin = currentUrl.substr(0, currentUrl.length - window.location.hash.length - window.location.search.length - window.location.pathname.length);\n                if (result.substring(0, currentOrigin.length) !== currentOrigin) {\n                  var js = '/*' + label + '*/importScripts(\"' + result + '\");';\n                  var blob = new Blob([js], { type: 'application/javascript' });\n                  return URL.createObjectURL(blob);\n                }\n              }\n              return result;\n            }\n          };\n        })({\n  \"editorWorkerService\": \"/monacoeditorwork/editor.worker.bundle.js\",\n  \"typescript\": \"/monacoeditorwork/ts.worker.bundle.js\",\n  \"json\": \"/monacoeditorwork/json.worker.bundle.js\",\n  \"css\": \"/monacoeditorwork/css.worker.bundle.js\",\n  \"html\": \"/monacoeditorwork/html.worker.bundle.js\",\n  \"javascript\": \"/monacoeditorwork/ts.worker.bundle.js\",\n  \"less\": \"/monacoeditorwork/css.worker.bundle.js\",\n  \"scss\": \"/monacoeditorwork/css.worker.bundle.js\",\n  \"handlebars\": \"/monacoeditorwork/html.worker.bundle.js\",\n  \"razor\": \"/monacoeditorwork/html.worker.bundle.js\"\n});</script>\n\n    <!-- Runtime config — must execute before the Vite module scripts read\n         window.__APP_CONFIG__. `defer` keeps that order (deferred classic\n         scripts and module scripts run in document order after parsing) while\n         unblocking the HTML parser, so asset preloads start immediately\n         instead of stalling ~160ms (p75) on this API round trip.\n         Back on the .js path: Render's extension-keyed edge cache rule twice\n         pinned a wrong body under this URL despite `no-store` (2026-08-20 and\n         2026-08-24); Render has since removed that cache rule for us, so the\n         suffix is safe again. If poisoning recurs: bump the `?v=` cache key,\n         or switch the src to the extension-less /api/frontend-config route\n         (kept serving as an escape hatch). -->\n    <script src=\"/api/frontend-config.js?v=3\" defer></script>\n    <script src=\"https://accounts.google.com/gsi/client\" async></script>\n    <meta charset=\"utf-8\" />\n    <!-- Platform favicon: a real multi-size ICO (16/32/48) of the current sun\n         mark, served from public/. This is the ONLY rel=\"icon\" link, and it\n         must stay that way — App.js rewrites the first match for backoffice.\n         Crawlers and link scrapers read this tag (and probe /favicon.ico\n         directly) with no JS, so the brand has to be correct statically. -->\n    <link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\" />\n    <script>\n      // Pre-paint theme stamp for the Appearance (appearance-themes) cohort: on\n      // a hard load the theme is applied by React (AppearanceThemeApplier) only after\n      // auth resolves, so the document boots light — a white flash,\n      // then light route skeletons (the FOUC this removes). AppearanceThemeApplier\n      // persists 'appearance-theme-applied' only while the feature is active,\n      // so every other cohort (flag-off, native, backoffice, runtime apps)\n      // never sets it and this stays a no-op. React stays the source of truth\n      // after mount: AppearanceThemeApplier\n      // re-applies or clears these exact attributes. Keys must stay byte-identical\n      // with components/settings/useAppearanceTheme.ts — BOOT_STAMP_CONTRACT there is\n      // asserted against this file by useAppearanceTheme.spec.ts, so update both.\n      //\n      // Kill-switch caveat: the marker is written while the feature is active and\n      // only cleared once /me resolves. On the FIRST load after a user loses the\n      // flag — or after the kill switch is flipped mid-incident — this still\n      // stamps dark, then React settles to light: one dark→light flash, which\n      // self-heals from the next load on. Flipping the switch does not repaint\n      // already-open tabs pre-paint; it collapses them on their next load.\n      try {\n        if ((localStorage.getItem('appearance-theme-applied') || localStorage.getItem('demo-display-theme-applied')) === '1') {\n          var appearanceTheme = localStorage.getItem('appearance-theme') || localStorage.getItem('demo-display-theme');\n          var appearanceDark = appearanceTheme === 'dark' ||\n            (appearanceTheme !== 'light' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);\n          if (appearanceDark) {\n            var appearanceRoot = document.documentElement;\n            appearanceRoot.setAttribute('data-ds', 'base44');\n            appearanceRoot.setAttribute('data-theme', 'dark');\n            appearanceRoot.classList.add('dark');\n            // Kill the pre-CSS white document flash; the app paints over it.\n            appearanceRoot.style.backgroundColor = '#09090b';\n          }\n        }\n      } catch (e) {}\n    </script>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n\n    <meta name=\"theme-color\" content=\"#000000\" />\n    <meta\n      name=\"description\"\n      content=\"Build useful apps, fast with Base44.\"\n    />\n\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"Base44\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\">\n    <link rel=\"manifest\" href=\"/man