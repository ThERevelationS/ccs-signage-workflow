\",\n      \"description\": \"F-23h: optional pricing-engine context block \\u2014 {customer_tier, tier_rules[], templates[], default_markup_pct, tax_percent, setup_fee, minimum_charge}. When present, foundationPricingWire routes the sell side through the shared engine; absent = legacy pricing verbatim.\",\n      \"additionalProperties\": true\n    },\n    \"selected_equipment\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"equipment_id\": {\n            \"type\": \"string\"\n          },\n          \"rental_period\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"day\",\n              \"week\",\n              \"month\"\n            ]\n          },\n          \"rental_duration\": {\n            \"type\": \"number\"\n          },\n          \"include_delivery\": {\n            \"type\": \"boolean\"\n          },\n          \"equipment_cost\": {\n            \"type\": \"number\"\n          },\n          \"attachments\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"object\"\n            }\n          }\n        }\n      }\n    },\n    \"selected_concrete_id\": {\n      \"type\": \"string\"\n    },\n    \"excavation_method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"hand_dig\",\n        \"equipment_excavation\"\n      ]\n    },\n    \"concrete_cost_per_cy\": {\n      \"type\": \"number\",\n      \"default\": 135\n    },\n    \"rebar_cost_per_ft\": {\n      \"type\": \"number\",\n      \"default\": 0.75\n    },\n    \"forming_materials_cost_spread_foot\": {\n      \"type\": \"number\",\n      \"default\": 0.5\n    },\n    \"forming_materials_cost_pillar\": {\n      \"type\": \"number\",\n      \"default\": 0.75\n    },\n    \"min_excavation_time_hours\": {\n      \"type\": \"number\",\n      \"default\": 1\n    },\n    \"hand_dig_excavation_cost_per_cy\": {\n      \"type\": \"number\",\n      \"default\