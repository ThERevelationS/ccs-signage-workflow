"total_excavation_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_labor_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_equipment_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_forming_materials_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_pole_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_pole_painting_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_brick_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_fill_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_wall_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_wall_cap_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_signage_cabinet_cost\": {\n      \"type\": \"number\"\n    },\n    \"total_landscape_cost\": {\n      \"type\": \"number\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"ai_engineering_recommendation\": {\n      \"type\": \"string\"\n    },\n    \"ai_engineering_data\": {\n      \"type\": \"object\",\n      \"additionalProperties\": true\n    },\n    \"design_basis\": {\n      \"type\": \"object\",\n      \"description\": \"O-104/CMP-I03 \\u2014 the project's recorded design basis: which locally adopted code edition and jurisdiction the preliminary foundation engineering stands on. Captured explicitly per project \\u2014 the newest published edition is never assumed to equal the locally adopted one. Written only through the design-basis surface with basis_source/timestamp provenance; nothing rewrites an existing project's basis silently.\",\n      \"properties\": {\n        \"version\": {\n          \"type\": \"integer\",\n          \"description\": \"Block shape version; 1 = the O-104 capture layout.\"\n        },\n        \"code_edition\": {\n          \"type\": \"string\",\n          \"description\": \"The locally adopted code/standard edition this project's preliminary basis uses (e.g. 'ASCE 7-16', 'ASCE 7-22', 'OBC 2019'). Authored only \\u2014 never auto-filled with a newest-published value.\"\n        },\n        \"code_edition_prior\": {\n          \"type\": \"string\",\n          \"description\": \"Superseded edition preserved when code_edition changes after a basis was captured \\u2014 the recorded trail that keeps an edition change visible instead of silent.\"\n        },\n        \"jurisdiction\": {\n          \"type\": \"string\",\n          \"description\": \"Free-text adopted-code locality (e.g. 'City of Milford, Clermont County, OH'). A future PermitLocality/JurisdictionProfile link may refine this text, never replace it.\"\n        },\n        \"basis_notes\": {\n          \"type\": \"string\",\n          \"description\": \"Adopted-code nuance a bare edition cannot hold \\u2014 local amendments, ordinance references, partial adoptions (CMP-I02 keeps these distinct from the referenced standards).\"\n        },\n        \"basis_source\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"manual\",\n            \"official_report\",\n            \"api\"\n          ],\n          \"description\": \"How this basis was recorded. 'api' is reserved \\u2014 no current writer; any authored content edit re-marks the block 'manual' unless an official-report transcription is explicitly selected.\"\n        },\n        \"basis_captured_at\": {\n          \"type\": \"string\",\n          \"description\": \"ISO-8601 timestamp of the FIRST authored basis capture; not rewritten by later edits.\"\n        },\n        \"basis_updated_at\": {\n          \"type\": \"string\",\n          \"description\": \"ISO-8601 timestamp of the most recent authored basis edit \\u2014 a basis never changes without a recorded when.\"\n        },\n        \"basis_locked\": {\n          \"type\": \"boolean\",\n          \"description\": \"Operator lock on a captured basis: while true, basis edits require an explicit re-capture confirmation. Stripped when no basis content remains.\"\n        }\n      }\n    },\n    \"site_hazard\": {\n      \"type\": \"object\",\n      \"description\": \"O-105/CMP-I04 \\u2014 site/hazard inputs recorded for this project: coordinates, unit system, risk category, exposure assumptions, and entry provenance/timestamp. Manual and official-report transcription are supported now; 'api' is a reserved enum value with no current writer. The adopted standard edition is recorded once in design_basis.code_edition, not duplicated here.\",\n      \"properties\": {\n        \"version\": {\n          \"type\": \"integer\",\n          \"description\": \"Block shape version; 1 = the O-105 capture layout.\"\n        },\n        \"latitude\": {\n          \"type\": \"number\",\n          \"description\": \"Site latitude in decimal degrees (-90..90); null = recorded-but-unset, absent = never captured \\u2014 never zero-filled.\"\n        },\n        \"longitude\": {\n          \"type\": \"number\",\n          \"description\": \"Site longitude in decimal degrees (-180..180); null = recorded-but-unset, absent = never captured.\"\n        },\n        \"units\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"imperial\",\n            \"metric\"\n          ],\n          \"description\": \"Unit system the site/hazard values are authored in. Absent = unstated; never assumed.\"\n        },\n        \"risk_category\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"I\",\n            \"II\",\n            \"III\",\n            \"IV\"\n          ],\n          \"description\": \"Risk category I\\u2013IV recorded for the structure (ASCE 7-style). Absent = unrecorded.\"\n        },\n        \"exposure_category\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"B\",\n            \"C\",\n            \"D\"\n          ],\n          \"description\": \"Wind exposure category recorded for the site. Absent = unrecorded.\"\n        },\n        \"exposure_assumption\": {\n          \"type\": \"string\",\n          \"description\": \"Free-text exposure/terrain assumption (e.g. 'Exposure C assumed \\u2014 open terrain, verify on site').\"\n        },\n        \"entry_method\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"manual\",\n            \"official_report\",\n            \"api\"\n          ],\n          \"description\": \"How these inputs were entered; only manual/official_report are written today \\u2014 'api' reserved for a future automation writer.\"\n        },\n        \"input_timestamp\": {\n          \"type\": \"string\",\n          \"description\": \"ISO-8601 timestamp of the most recent authored change to this block.\"\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"project_name\",\n    \"client_name\"\n  ],\n  \"rls\": {\n    \"create\": {\n      \"user_condition\": {\n        \"role\": \"__foundationproject_backend_only__\"\n      }\n    },\n    \"read\": {\n      \"user_condition\": {\n        \"role\": \"__foundationproject_backend_only__\"\n      }\n    },\n    \"update\": {\n      \"user_condition\": {\n        \"role\": \"__foundationproject_backend_only__\"\n      }\n    },\n    \"delete\": {\n      \"user_condition\": {\n        \"role\": \"__foundationproject_backend_only__\"\n      }\n    }\n  }\n}",
